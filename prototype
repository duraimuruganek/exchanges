span>\u003c/td>'+\n     '\u003ctd style=\"font-size:11.5px\">'+b.assignedTo+'\u003c/td>'+\n     '\u003ctd>\u003cbutton class=\"kebab\" onclick=\"event.stopPropagation();openBreakDrawer(\\''+b.id+'\\')\">&#8942;\u003c/button>\u003c/td>\u003c/tr>';\n  }).join('');\n  return '\u003cdiv class=\"card\" style=\"padding:14px 16px\">'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>Breaks / Exceptions\u003c/h3>\u003cspan class=\"pill bad\">'+openBreaks().length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Break ID\u003c/th>\u003cth>Source\u003c/th>\u003cth>Variance\u003c/th>\u003cth>Reason\u003c/th>\u003cth>Status\u003c/th>\u003cth>Assigned To\u003c/th>\u003cth>\u003c/th>\u003c/tr>\u003c/thead>'+\n   '\u003ctbody>'+(rows||'\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--green);font-weight:700;padding:16px\">&#10003; No open breaks - register and DLT match\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>'+\n   (compact?resolvedMini():'')+\n   (compact?'\u003cdiv style=\"margin-top:10px\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'breaks\\')\">View all breaks &rarr;\u003c/button>\u003c/div>':'')+'\u003c/div>';\n}\nfunction act(ic,label,fn){return '\u003cbutton class=\"actbtn\" onclick=\"'+fn+'\">\u003cspan class=\"ic\">'+ic+'\u003c/span>'+label+'\u003c/button>';}\nfunction railHtml(){\n  const ap=pendingAppr();\n  const mcHtml=ap.length?ap.slice(0,2).map(function(t){\n    return '\u003cdiv class=\"mc\">\u003cdiv class=\"t\">\u003cb>&#9203; Awaiting Checker Approval\u003c/b>\u003cspan class=\"id\">'+t.id+'\u003c/span>\u003c/div>'+\n     '\u003cdiv class=\"d\">'+TYPES[t.type].name+' &ndash; Aisyah (retail)\u003c/div>\u003cdiv class=\"m\">Submitted '+t.submitted+'\u003c/div>'+\n     '\u003cdiv class=\"m\" style=\"font-weight:700;color:var(--text)\">'+pointsSummary(t)+'\u003c/div>'+\n     '\u003cdiv class=\"mcflow\">\u003cdiv class=\"mcbox\">\u003cdiv class=\"r\">Maker\u003c/div>\u003cdiv class=\"n\">Ops Analyst\u003c/div>\u003cspan class=\"pill ok\">Submitted\u003c/span>\u003c/div>'+\n     '\u003cdiv style=\"color:var(--muted)\">&rarr;\u003c/div>'+\n     '\u003cdiv class=\"mcbox\">\u003cdiv class=\"r\">Checker\u003c/div>\u003cdiv class=\"n\">Treasury Manager\u003c/div>\u003cspan class=\"pill wait\">Pending\u003c/span>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"approveAct(\\''+t.id+'\\')\">Approve\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"rejectAct(\\''+t.id+'\\')\">Reject\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"openActDrawer(\\''+t.id+'\\')\">Details\u003c/button>\u003c/div>\u003c/div>';\n  }).join(''):'\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">Nothing awaiting checker approval. Maker-checker is off by default for this demo.\u003c/div>';\n  return '\u003cdiv class=\"rail\">'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">4) Treasury Actions\u003c/div>\u003cdiv class=\"actgrid\">'+\n    act('&#128101;','Maker-Checker Approval','setNav(\\'appr\\')')+\n    act('&#9208;',(S.flags.issuancePaused?'Resume On-chain Ops':'Pause On-chain Ops'),'toggleIssuance()')+\n    act('&#128274;','Open Liminal Vaults','setNav(\\'vaults\\')')+\n    act('&#128100;','Assign Break','setNav(\\'breaks\\')')+\n    act('&#9888;','Escalate Break','setNav(\\'breaks\\')')+\n    act('&#11015;','Download Reconciliation Report','downloadRecon()')+\n    '\u003cbutton class=\"actbtn wide\" onclick=\"setNav(\\'audit\\')\">\u003cspan class=\"ic\">&#128220;\u003c/span>Open Audit Trail\u003c/button>'+\n   '\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">&#8645; Maker-Checker Approval\u003cspan class=\"rt\" onclick=\"setNav(\\'appr\\')\">View all\u003c/span>\u003c/div>'+mcHtml+'\u003c/div>'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">Recent Activity / Audit Log\u003cspan class=\"rt\" onclick=\"setNav(\\'audit\\')\">View all\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"audit\">'+(auditAll().slice(0,6).map(function(x){return '\u003cdiv class=\"row\">\u003cspan class=\"tm\">'+x.time+'\u003c/span>\u003cspan>'+x.actor+' '+x.text+'\u003c/span>\u003c/div>';}).join('')||'\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">No activity yet.\u003c/div>')+'\u003c/div>'+\n    '\u003cdiv style=\"margin-top:9px\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'audit\\')\">Open full audit trail &rarr;\u003c/button>\u003c/div>\u003c/div>'+\n  '\u003c/div>';\n}\n/* ---- wallet helpers ---- */\nfunction histTable(h){\n  return '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>Type\u003c/th>\u003cth>Token\u003c/th>\u003cth>Amount\u003c/th>\u003cth>Counterparty\u003c/th>\u003cth>Method\u003c/th>\u003cth>Tx Hash\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (h.map(function(x){\n     const cls={IN:'in',OUT:'out',ISSUE:'mint'}[x.type];\n     const sign=(x.type==='IN'||x.type==='ISSUE')?'+':'-';\n     return '\u003ctr>\u003ctd class=\"mono\" style=\"font-size:11px\">'+shortTime(x.tx.time)+'\u003c/td>\u003ctd>\u003cspan class=\"dpill '+cls+'\">'+x.type+'\u003c/span>\u003c/td>\u003ctd>'+tl(x.token)+'\u003c/td>'+\n       '\u003ctd class=\"mono\">'+sign+' '+pts(x.amount)+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+esc(x.other==='Mint'?x.other:lbl(x.other))+'\u003c/td>'+\n       '\u003ctd class=\"mono\" style=\"font-size:11px\">'+x.tx.method+'\u003c/td>\u003ctd>'+hashLink(x.tx.hash)+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--muted2);padding:14px\">No transactions yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>';\n}\nfunction balBox(t,v,tok){return '\u003cdiv class=\"tile\">\u003cdiv class=\"th\">'+t+'\u003c/div>\u003cdiv class=\"tv\">\u003cdiv>\u003cspan class=\"amt\">'+pts(v)+'\u003c/span>\u003cspan class=\"cur\">'+tok+'\u003c/span>\u003c/div>\u003c/div>\u003c/div>';}\nfunction walletCard(w){\n  const empty=addrHistory(w.addr).length===0;\n  return '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>'+w.name+'\u003c/h3>\u003cdiv style=\"font-size:11px;color:var(--muted)\">'+w.sub+'\u003c/div>\u003cdiv class=\"addrline\">'+w.addr+'\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+w.addr+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n   (empty?'\u003cdiv class=\"callout\" style=\"margin-top:12px\">Nothing has been minted or sent to this wallet yet: every balance is 0.\u003c/div>':'')+\n   '\u003cdiv class=\"walbox\">'+balBox('Sukuk balance',balance(w.addr,'SUKUK'),'sukuk')+balBox('tMYR balance',balance(w.addr,'TMYR'),'tMYR')+'\u003c/div>'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>Transaction History\u003c/h3>\u003c/div>'+histTable(addrHistory(w.addr))+'\u003c/div>';\n}\nfunction dvpCard(){\n  const p=position();\n  return '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>DvP Swap Contract (escrow)\u003c/h3>\u003cdiv style=\"font-size:11px;color:var(--muted)\">Shared by both organisations. Holds assets only while a swap is in progress.\u003c/div>\u003cdiv class=\"addrline\">'+ADDR.dvp+'\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+ADDR.dvp+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"walbox\">'+balBox('Sukuk in escrow',p.dvpS,'sukuk')+balBox('tMYR in escrow',p.dvpT,'tMYR')+'\u003c/div>\u003c/div>';\n}\nfunction delta(v,tok){return v?'\u003cspan class=\"'+(v>0?'dlt-up':'dlt-dn')+'\">'+(v>0?'+':'-')+pts(Math.abs(v))+' '+tok+'\u003c/span>':'';}\nfunction swapView(a){\n  const sw=a.legs[a.legs.length-1],done=sw.st.chain==='CONFIRMED';\n  const bS=sw.sukukTo===ADDR.buyer?sw.sukuk:-sw.sukuk,bT=sw.tmyrTo===ADDR.buyer?sw.tmyr:-sw.tmyr;\n  const pen='\u003cspan style=\"color:var(--muted2)\">pending\u003c/span>';\n  return '\u003cdiv style=\"margin-top:14px\">\u003cdiv style=\"display:flex;align-items:center;gap:10px;font-size:12px\">\u003cb>'+a.id+'\u003c/b>\u003cspan style=\"color:var(--muted)\">'+TYPES[a.type].name+'\u003c/span>'+pill(sw.st.chain)+'\u003cspan style=\"margin-left:auto\">'+hashLink(sw.refs.hash)+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"swapgrid\">\u003cdiv class=\"sb\">\u003cdiv class=\"h\">Buyer (Aisyah)\u003c/div>\u003cdiv class=\"l\">\u003cspan>sukuk\u003c/span>'+(done?delta(bS,'sukuk'):pen)+'\u003c/div>\u003cdiv class=\"l\">\u003cspan>tMYR\u003c/span>'+(done?delta(bT,'tMYR'):pen)+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"sb\">\u003cdiv class=\"h\">HL Islamic Bank\u003c/div>\u003cdiv class=\"l\">\u003cspan>sukuk\u003c/span>'+(done?delta(-bS,'sukuk'):pen)+'\u003c/div>\u003cdiv class=\"l\">\u003cspan>tMYR\u003c/span>'+(done?delta(-bT,'tMYR'):pen)+'\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Step\u003c/th>\u003cth>Method\u003c/th>\u003cth>Status\u003c/th>\u003cth>Tx Hash\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   a.legs.filter(function(l){return l.op!=='ISSUE';}).map(function(l){return '\u003ctr>\u003ctd style=\"font-size:11.5px\">'+legLabel(l)+'\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+METHOD[l.op]+'\u003c/td>\u003ctd>'+pill(l.st.chain)+'\u003c/td>\u003ctd>'+hashLink(l.refs.hash)+'\u003c/td>\u003c/tr>';}).join('')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';\n}\n/* ============ NAV VIEWS ============ */\nconst VIEWS={\n control:function(){return filtersHtml()+tilesHtml()+chartsHtml()+queueHtml(false)+'\u003cdiv class=\"two\" style=\"margin-top:16px\">'+reconHtml()+breaksTableHtml(true)+'\u003c/div>';},\n sysint:function(){\n   const flow1='\u003cspan class=\"n\">Customer App\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Core Banking (HLB CORE)\u003c/span>';\n   const flow2='\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Custody, Tokenization &amp; DvP\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">DLT (Etherscan-indexed)\u003c/span>';\n   const flow3='\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Holdings Register\u003c/span>\u003cspan>&nbsp;&middot;&nbsp;\u003c/span>\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Pricing &amp; Notifications\u003c/span>';\n   return '\u003cdiv class=\"sec-h\">\u003ch3>System Integration &ndash; Interconnectivity\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">The SI Orchestrator is the single integration layer between the investor channel, core banking, the DvP swap contract and the digital asset custody / tokenization provider. No channel or custody vendor ever talks to core banking directly &mdash; every hop is authenticated, correlated and replay-safe, which is what lets the tokenised sukuk settle even on a Sunday when the bank itself is closed.\u003c/div>'+\n   '\u003cdiv class=\"card wcard\" style=\"padding:16px\">\u003ch4 style=\"margin-bottom:8px\">Request lifecycle\u003c/h4>'+\n   '\u003cdiv class=\"stepflow\">'+flow1+'\u003c/div>\u003cdiv class=\"stepflow\">'+flow2+'\u003c/div>\u003cdiv class=\"stepflow\">'+flow3+'\u003c/div>'+\n   '\u003cdiv class=\"kv\" style=\"margin-top:14px\">'+\n     kv('Perimeter security','Mutual TLS (client + server certificate verification) on every external hop, starting with the investor app&#39;s first request')+\n     kv('Application security','OAuth 2.0 client-credentials, short-lived bearer tokens (5 min), scoped per downstream system')+\n     kv('Idempotency','X-Idempotency-Key on every write so a retried call cannot double-post or double-mint')+\n     kv('Correlation','X-Correlation-Id ties the order, the Liminal mint / DvP swap and the holdings register sync back to one activity')+\n     kv('Async confirmation','On-chain finality and DvP settlement arrive as signed webhooks, not polling, which is why settlement is not limited to banking hours')+\n     kv('Core banking connectivity','SI supports both directions: \u003cb>synchronous\u003c/b> request/response (e.g. POST /core/accounts/debit, answered immediately) and \u003cb>asynchronous\u003c/b> webhook/event delivery for calls core banking fires independently. Exactly which pattern a given core banking system uses is decided per integration &mdash; SI does not assume either one.')+\n     kv('Reconciliation','Holdings register vs DLT balances are compared after every activity; a variance raises a case automatically')+\n     kv('Segregation of duties','Maker-checker approval gate in front of every on-chain mint / DvP operation')+\n   '\u003c/div>\u003cdiv class=\"note\" style=\"margin-top:12px\">Click \u003cb>&#128274; Inspect integration\u003c/b> on a MINT, LEDGER UPDATE, CORE BANKING or APP REQUEST event in the Event Stream to see the full simulated mTLS handshake, the OAuth 2.0 token and the request/response headers, payload and footer for that call. (This use case has no burn leg: selling the sukuk back transfers it to the issuer instead of destroying it.)\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\" style=\"padding:16px;margin-top:16px\">\u003ch4 style=\"margin-bottom:6px\">Custody &amp; tokenization: the vendor is pluggable behind SI\u003c/h4>'+\n   '\u003cdiv class=\"note\" style=\"margin:0 0 12px\">This rehearsal is scripted against \u003cb>Liminal\u003c/b> (managed MPC custody) for the sukuk token and DvP swap. Because SI owns the mint / DvP contract, an open-source stack can sit behind the same contract without the customer app, core banking or the holdings register ever changing.\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Capability\u003c/th>\u003cth>Liminal (used in this demo)\u003c/th>\u003cth>Open-source alternative\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   '\u003ctr>\u003ctd>Token issuance API\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">POST /liminal/tokenization/mint\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">POST /fireflyapi/v1/tokens/mint\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Key custody\u003c/td>\u003ctd>MPC 2-of-3, managed HSM\u003c/td>\u003ctd>Hyperledger Fabric MSP identities signed via HSM / PKCS#11\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Ledger / network\u003c/td>\u003ctd>EVM network (Liminal-operated)\u003c/td>\u003ctd>Hyperledger Fabric channel (permissioned) fronted by a Hyperledger FireFly supernode\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>DvP settlement\u003c/td>\u003ctd>Liminal atomic swap contract\u003c/td>\u003ctd>Fabric chaincode escrow, released by a FireFly multi-party workflow\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Auth to SI\u003c/td>\u003ctd>Mutual TLS + OAuth 2.0 client-credentials\u003c/td>\u003ctd>Mutual TLS + OAuth 2.0 client-credentials (same contract)\u003c/td>\u003c/tr>'+\n   '\u003c/tbody>\u003c/table>\u003c/div>'+\n   '\u003cdiv class=\"note\" style=\"margin-top:12px\">That is the SI role in one sentence: \u003cb>the DLT / custody vendor is a plug-in behind a stable, secured contract\u003c/b> &mdash; core banking, the holdings register and the customer app never need to know which one is live.\u003c/div>\u003c/div>';\n },\n acts:function(){return filtersHtml()+queueHtml(true);},\n members:function(){\n   const m=S.member,p=position();\n   const chk=function(t){const dlt=balance(ADDR.buyer,t);return m.ledger[t]===dlt?'\u003cspan class=\"pill ok\">Matched\u003c/span>':'\u003cspan class=\"pill bad\">Variance '+pts(m.ledger[t]-dlt)+'\u003c/span>';};\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Investors\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:12px\">\u003cdiv class=\"av\" style=\"width:44px;height:44px;font-size:16px\">A\u003c/div>\u003cdiv>\u003ch3>Aisyah\u003c/h3>\u003cdiv style=\"font-size:11px;color:var(--muted)\">'+m.id+' &middot; '+m.segment+'\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cspan class=\"pill '+(p.buyerS>0?'ok':'wait')+'\">'+(p.buyerS>0?'Holds sukuk':'No sukuk held')+'\u003c/span>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"kv\" style=\"margin-top:14px\">'+kv('KYC',m.kyc)+kv('Account','HLB Premier Account')+kv('Account balance',rm(m.rm))+kv('Liminal org','HLB Malaysia')+kv('Liminal wallet','Buyer &middot; '+addrLink(ADDR.buyer))+\n   kv('Instrument',SUKUK_NAME+' (1 unit = '+rm(DEAL.price)+')')+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv class=\"sec-h\">\u003ch3>Holdings\u003c/h3>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Asset\u003c/th>\u003cth>Holdings Register (SI)\u003c/th>\u003cth>DLT (Buyer wallet)\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   '\u003ctr>\u003ctd>'+SUKUK_NAME+'\u003c/td>\u003ctd class=\"mono\">'+pts(m.ledger.SUKUK)+'\u003c/td>\u003ctd class=\"mono\">'+pts(p.buyerS)+'\u003c/td>\u003ctd>'+chk('SUKUK')+'\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>tMYR\u003c/td>\u003ctd class=\"mono\">'+pts(m.ledger.TMYR)+'\u003c/td>\u003ctd class=\"mono\">'+pts(p.buyerT)+'\u003c/td>\u003ctd>'+chk('TMYR')+'\u003c/td>\u003c/tr>\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv class=\"sec-h\">\u003ch3>Activity History\u003c/h3>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Activity\u003c/th>\u003cth>Type\u003c/th>\u003cth>Assets\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.acts.map(function(a){return '\u003ctr class=\"trow\" onclick=\"openActDrawer(\\''+a.id+'\\')\">\u003ctd class=\"txid\">'+a.id+'\u003c/td>\u003ctd>'+TYPES[a.type].name+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+pointsSummary(a)+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+statusPill(a.status)+'\">'+STATUS_LBL(a.status)+'\u003c/span>\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"4\" style=\"color:var(--muted2);padding:14px\">No activity yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n vaults:function(){\n   const ws=WALLETS.filter(function(w){return w.org===S.org;});\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Liminal Vaults\u003c/h3>\u003cspan class=\"pill vio\">'+ORGS[S.org].name+'\u003c/span>\u003c/div>'+\n     '\u003cdiv class=\"crumb\">Liminal Vaults &rsaquo; Org: \u003cb>'+ORGS[S.org].name+'\u003c/b> &rsaquo; Wallet: \u003cb>'+ws[0].name+'\u003c/b>\u003c/div>'+\n     '\u003cdiv class=\"note\">Use the organisation chips in the top bar to switch between the investor wallet (HLB Malaysia) and the issuer wallet (HL Islamic Bank). Each organisation sees only its own wallets.\u003c/div>'+\n     ws.map(walletCard).join('')+dvpCard();},\n swaps:function(){\n   const sw=S.acts.filter(function(a){return a.legs.some(function(l){return l.op==='SWAP';});}).slice().reverse();\n   return '\u003cdiv class=\"sec-h\">\u003ch3>DvP Swaps\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>DvP Swap Contract\u003c/h3>\u003cdiv class=\"addrline\">'+ADDR.dvp+'\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+ADDR.dvp+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"note\" style=\"margin-top:12px\">Both sides are first sent into the contract, then exchanged in a single transaction: either both move or neither does. Pricing is static at '+pts(DEAL.price)+' tMYR per sukuk (an oracle for dynamic pricing is planned).\u003c/div>'+\n   (sw.length?sw.map(swapView).join(''):'\u003cdiv style=\"padding:14px;color:var(--muted2)\">No swaps yet. The first swap runs when the investment is completed.\u003c/div>')+'\u003c/div>';},\n ledger:function(){\n   const tokRows=['SUKUK','TMYR'].map(function(t){\n     return '\u003ctr>\u003ctd>'+TOK[t].name+'\u003c/td>\u003ctd class=\"mono\">'+pts(minted(t)+seedTok(t))+'\u003c/td>\u003ctd class=\"mono\">'+pts(burned(t))+'\u003c/td>\u003ctd class=\"mono\">\u003cb>'+pts(supply(t)+seedTok(t))+'\u003c/b>\u003c/td>'+\n      '\u003ctd class=\"mono\">'+pts(balance(ADDR.buyer,t))+'\u003c/td>\u003ctd class=\"mono\">'+pts(balance(ADDR.hlib,t))+'\u003c/td>\u003ctd class=\"mono\">'+pts(balance(ADDR.dvp,t))+'\u003c/td>\u003ctd class=\"mono\">'+pts(seedTok(t))+'\u003c/td>\u003c/tr>';}).join('');\n   const reg=S.chain.slice().reverse().map(function(t){\n     const mv=t.moves.map(function(m){return (m.from===ZERO?'+':'')+pts(m.amount)+' '+tl(m.token)+' '+(m.from===ZERO?'to '+wn(m.to):wn(m.from)+' &rarr; '+wn(m.to));}).join('\u003cbr>');\n     return '\u003ctr class=\"trow\" onclick=\"openExplorerTx(\\''+t.hash+'\\')\">\u003ctd class=\"mono\" style=\"font-size:11px\">'+shortTime(t.time)+'\u003c/td>\u003ctd class=\"txid\">'+t.actId+'\u003c/td>'+\n      '\u003ctd>\u003cspan class=\"pill '+({ISSUE:'ok',SWAP:'vio',TRANSFER:'pend'}[t.kind])+'\">'+t.kind+'\u003c/span>\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+t.method+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+mv+'\u003c/td>\u003ctd>'+hashLink(t.hash)+'\u003c/td>\u003ctd class=\"mono\">'+t.block+'\u003c/td>\u003c/tr>';}).join('');\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Token Ledger &ndash; Issue / Send / Swap Register\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-bottom:16px\">\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>On-chain Operations\u003c/b>\u003cdiv class=\"d\">Pausing blocks new issue, send and swap transactions for waiting activities\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cspan class=\"pill '+(S.flags.issuancePaused?'bad':'ok')+'\">'+(S.flags.issuancePaused?'PAUSED':'OPEN')+'\u003c/span>'+\n   '\u003cbutton class=\"'+(S.flags.issuancePaused?'pri':'')+'\" onclick=\"toggleIssuance()\">'+(S.flags.issuancePaused?'Resume On-chain Ops':'Pause On-chain Ops')+'\u003c/button>\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-bottom:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Supply by Token\u003c/h3>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Token\u003c/th>\u003cth>Issued\u003c/th>\u003cth>Burned\u003c/th>\u003cth>Outstanding\u003c/th>\u003cth>Buyer\u003c/th>\u003cth>HL Islamic Bank\u003c/th>\u003cth>DvP escrow\u003c/th>\u003cth>Other holders\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+tokRows+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"sec-h\">\u003ch3>On-chain Register\u003c/h3>\u003cspan class=\"pill pend\">'+S.chain.length+'\u003c/span>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>Activity\u003c/th>\u003cth>Type\u003c/th>\u003cth>Method\u003c/th>\u003cth>Movement\u003c/th>\u003cth>Tx Hash\u003c/th>\u003cth>Block\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (reg||'\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--muted2);padding:14px\">No on-chain transactions yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n recon:function(){return '\u003cdiv class=\"sec-h\">\u003ch3>Reconciliation\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">Not part of the rehearsal script. The holdings register is compared with the on-chain wallet balances after every activity, and the DvP escrow should be empty once a swap settles. Use \u003cb>Raise a register break\u003c/b> in Configuration to see a variance case.\u003c/div>'+reconHtml()+\n   '\u003cdiv style=\"margin-top:16px\">'+breaksTableHtml(false)+'\u003c/div>';},\n breaks:function(){return '\u003cdiv class=\"sec-h\">\u003ch3>Breaks &amp; Exceptions\u003c/h3>\u003cdiv class=\"i\" title=\"Detection, assignment, investigation, maker-checker remediation\">i\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"note\">\u003cb>Remediation lifecycle:\u003c/b> Open &rarr; Assigned &rarr; Investigating &rarr; Remediation Proposed (maker) &rarr; Checker Approval &rarr; Resolved. Not part of the rehearsal script: use the failure switches in Configuration to raise a case on demand.\u003c/div>'+\n   breaksTableHtml(false)+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Resolved Cases\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Break ID\u003c/th>\u003cth>Source\u003c/th>\u003cth>Original Variance\u003c/th>\u003cth>Remediation\u003c/th>\u003cth>Approved By\u003c/th>\u003cth>Resolved\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.breaks.filter(function(b){return b.status==='RESOLVED';}).map(function(b){\n     return '\u003ctr class=\"trow\" onclick=\"openBreakDrawer(\\''+b.id+'\\')\">\u003ctd class=\"txid\">'+b.id+'\u003c/td>\u003ctd>'+b.source+'\u003c/td>\u003ctd class=\"mono\">'+pts(b.varianceBefore||0)+' '+tl(b.token)+'\u003c/td>'+\n      '\u003ctd style=\"font-size:11.5px\">'+(b.remediation?b.remediation.label:'&mdash;')+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+(b.remediation&&b.remediation.approvedBy?b.remediation.approvedBy:'&mdash;')+'\u003c/td>\u003ctd class=\"mono\">'+(b.resolvedAt||'&mdash;')+'\u003c/td>\u003c/tr>';\n   }).join('')+seedResolvedRows()||'\u003ctr>\u003ctd colspan=\"6\" style=\"color:var(--muted2);padding:16px\">No resolved cases yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n appr:function(){const ap=pendingAppr();\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Approvals &ndash; Maker / Checker\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">Not part of the rehearsal script. When \u003cb>Maker-checker approval before on-chain operations\u003c/b> is on in Configuration, each activity waits here for a second-person approval before any Liminal call.\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Activity\u003c/th>\u003cth>Type\u003c/th>\u003cth>Assets\u003c/th>\u003cth>Maker\u003c/th>\u003cth>Checker\u003c/th>\u003cth>Actions\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (ap.map(function(t){return '\u003ctr>\u003ctd class=\"txid\">'+t.id+'\u003c/td>\u003ctd>'+TYPES[t.type].name+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+pointsSummary(t)+'\u003c/td>'+\n     '\u003ctd>Ops Analyst \u003cspan class=\"pill ok\">Submitted\u003c/span>\u003c/td>\u003ctd>Treasury Manager \u003cspan class=\"pill wait\">Pending\u003c/span>\u003c/td>'+\n     '\u003ctd>\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"approveAct(\\''+t.id+'\\')\">Approve\u003c/button>\u003cbutton class=\"sm\" onclick=\"rejectAct(\\''+t.id+'\\')\">Reject\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"openActDrawer(\\''+t.id+'\\')\">Details\u003c/button>\u003c/div>\u003c/td>\u003c/tr>';}).join('')||\n     '\u003ctr>\u003ctd colspan=\"6\" style=\"color:var(--muted2);padding:16px\">Nothing awaiting approval.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n reports:function(){\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Reports\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px\">\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Reconciliation Report\u003c/b>\u003cdiv class=\"d\">Register comparison, variances and open breaks (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"downloadRecon()\">Download\u003c/button>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Activity Control Queue\u003c/b>\u003cdiv class=\"d\">All activities and legs with stage-level status (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"exportCsv()\">Download\u003c/button>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Token Register\u003c/b>\u003cdiv class=\"d\">Every on-chain issue, send and swap movement (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"downloadIssuance()\">Download\u003c/button>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Audit Trail Export\u003c/b>\u003cdiv class=\"d\">Full operator action log (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"downloadAudit()\">Download\u003c/button>\u003c/div>\u003c/div>';},\n audit:function(){\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Audit Trail\u003c/h3>\u003cdiv class=\"rt\">\u003cbutton class=\"sm\" onclick=\"downloadAudit()\">Export CSV\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>Actor\u003c/th>\u003cth>Action\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (auditAll().map(function(a){return '\u003ctr>\u003ctd class=\"mono\" style=\"width:90px\">'+a.time+'\u003c/td>\u003ctd style=\"width:150px;font-weight:600\">'+a.actor+'\u003c/td>\u003ctd>'+a.text+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"3\" style=\"padding:16px;color:var(--muted2)\">No activity yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>API / Message Log\u003c/h3>\u003cspan class=\"pill pend\">'+S.events.length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>From\u003c/th>\u003cth>To\u003c/th>\u003cth>Operation\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.events.slice().reverse().slice(0,40).map(function(e){\n     const sb=e.status==='SUCCESS'?'ok':(e.status==='WEBHOOK'?'vio':(e.status==='FAILED'?'bad':'wait'));\n     return '\u003ctr class=\"trow\" onclick=\"selEvent('+e.id+');setMode(\\'split\\')\">\u003ctd class=\"mono\">'+e.time+'\u003c/td>\u003ctd>'+e.from+'\u003c/td>\u003ctd>'+e.to+'\u003c/td>'+\n      '\u003ctd class=\"mono\" style=\"font-size:10.5px\">'+e.op+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+sb+'\">'+e.status+'\u003c/span>\u003c/td>\u003c/tr>';}).join('')||\n     '\u003ctr>\u003ctd colspan=\"5\" style=\"padding:16px;color:var(--muted2)\">No API activity yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n config:function(){\n   const t=function(k,label,desc){return '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>'+label+'\u003c/b>\u003cdiv class=\"d\">'+desc+'\u003c/div>\u003c/div>'+\n     '\u003cbutton class=\"tg'+(S.flags[k]?' on':'')+'\" onclick=\"toggleFlag(\\''+k+'\\')\">\u003c/button>\u003c/div>';};\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Configuration &amp; Demo Controls\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">These switches shape the \u003cb>next activity\u003c/b>. Everything below the first row is outside the rehearsal script and is off by default.\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px\">'+t('autoRun','Auto-run the scripts','Runs both Liminal scripts without waiting for the presenter. Off by default so each step can be narrated.')+'\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Optional controls\u003c/h3>\u003c/div>'+\n   t('makerChecker','Maker-checker approval before on-chain operations','Each activity waits for a checker before any Liminal call.')+\n   t('forceDltFail','Simulate a DLT mint failure on the next mint','The issue transaction reverts on-chain and raises a DLT Execution exception for remediation.')+\n   t('forceSwapFail','Simulate an atomic swap revert on the next swap','The DvP swap reverts as a whole: nothing moves and both sides stay in escrow until it is retried.')+\n   t('forceBreak','Raise a register break on the next activity','The holdings register posts short of the DLT balance, creating a Register vs DLT case.')+\n   t('issuancePaused','Pause on-chain operations','Blocks issue, send and swap transactions.')+'\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Reset\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Reset demo data\u003c/b>\u003cdiv class=\"d\">Clears activities, on-chain history, breaks and the API log, and restores the investor to the pre-investment state (Monday).\u003c/div>\u003c/div>'+\n   '\u003cbutton class=\"dgr\" onclick=\"resetAll()\">Reset Demo\u003c/button>\u003c/div>\u003c/div>';}\n};\n/* ============ DRAWERS ============ */\nfunction closeDrawer(){\n  if(S.inspectingEvent!=null){\n    const evId=S.inspectingEvent;S.inspectingEvent=null;\n    const ev=S.events.find(function(x){return x.id===evId;});\n    const a=ev&&ev.actId!=null?actById(ev.actId):null;\n    if(a&&a.pendingInspect){\n      const idx=a.pendingInspect.indexOf(evId);if(idx>-1)a.pendingInspect.splice(idx,1);\n      if(!a.pendingInspect.length&&a.status==='AWAITING_INSPECTION'){\n        a.status='IN_PROGRESS';setTimeout(function(){runStep(a.id);},250);\n      }\n    }\n  }\n  S.drawer=null;S.drawerRef=null;document.getElementById('overlay').classList.add('hidden');renderAll();\n}\nfunction showDrawer(title,html){S.drawer=title;document.getElementById('drTitle').innerHTML=title;\n  document.getElementById('drBody').innerHTML=html;document.getElementById('overlay').classList.remove('hidden');}\nfunction kv(k,v){return '\u003cdiv class=\"k\">'+k+'\u003c/div>\u003cdiv class=\"v\">'+v+'\u003c/div>';}\n/* ============ INTEGRATION TRACE DRAWER (mint / ledger / core banking / app request) ============ */\nfunction openIntegrationDrawer(id){\n  const ev=S.events.find(function(x){return x.id===id;});\n  if(!ev||!ev.auth){toast('No integration security trace captured for this event');return;}\n  S.sel.event=id;S.inspectingEvent=id;renderInspector();\n  const au=ev.auth,mt=au.mtls,oa=au.oauth,ft=au.footer;\n  const stb=({SUCCESS:'ok',WEBHOOK:'vio',FAILED:'bad',WARN:'wait'})[ev.status]||'mute';\n  const h='\u003cdiv class=\"note\" style=\"margin-bottom:14px\">\u003cb>Simulated for this demo.\u003c/b> The certificate, token and signature values below are illustrative. They are not issued by a real PKI or OAuth server and are not connected to a live blockchain network.\u003c/div>'+\n    '\u003cdiv class=\"sec-h\">\u003ch3>Route\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('From',ev.from)+kv('To',ev.to)+kv('Operation',esc(ev.op))+\n      kv('Category','\u003cspan class=\"pill '+MAJOR_COLOR[ev.major]+'\">'+MAJOR_LABEL[ev.major]+'\u003c/span>')+\n      (ev.status==='WEBHOOK'&&ev.to==='SI'?kv('Direction','\u003cspan class=\"pill vio\">&#8595; PULL (SI pulling in an async event)\u003c/span>'):'')+\n      kv('Status','\u003cspan class=\"pill '+stb+'\">'+ev.status+'\u003c/span>')+kv('Time',ev.time+' MYT')+'\u003c/div>'+\n    (ev.major==='COREBANK'?('\u003cdiv class=\"note\" style=\"margin-top:10px\">\u003cb>Core banking connectivity is bidirectional.\u003c/b> SI supports both patterns, since not every core banking system offers the same integration options: \u003cb>synchronous\u003c/b> request/response for calls that need an immediate answer, and \u003cb>asynchronous\u003c/b> webhook/event delivery for calls the core system fires independently. This particular call is '+(ev.status==='WEBHOOK'?'\u003cb>asynchronous\u003c/b> &mdash; an event pushed by core banking, not requested by SI.':'\u003cb>synchronous\u003c/b> &mdash; SI called core banking directly and got this response back immediately.')+'\u003c/div>'):'')+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#128274; Transport security &mdash; mutual TLS\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('TLS version',mt.tlsVersion)+kv('Cipher suite',mt.cipherSuite)+\n      kv('Client certificate',esc(mt.clientCert.subject))+kv('Client cert issuer',esc(mt.clientCert.issuer))+\n      kv('Client cert serial',mt.clientCert.serial)+kv('Client cert SHA-256',mt.clientCert.sha256Thumbprint)+\n      kv('Server certificate',esc(mt.serverCert.subject))+kv('Mutual auth result','\u003cspan class=\"pill ok\">'+mt.mutualAuth+'\u003c/span>')+'\u003c/div>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#128273; Application security &mdash; OAuth 2.0\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('Token endpoint',esc(oa.tokenEndpoint))+kv('Grant type',oa.grantType)+kv('Client ID',oa.clientId)+\n      kv('Scope',esc(oa.scope))+kv('Token type',oa.tokenType)+kv('Expires in',oa.expiresIn+'s')+'\u003c/div>'+\n    '\u003cdiv style=\"margin-top:10px\">\u003cdiv class=\"k\" style=\"margin-bottom:4px\">Decoded access token (JWT)\u003c/div>\u003cpre>'+json({header:oa.decoded.header,payload:oa.decoded.payload})+'\u003c/pre>\u003c/div>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#8593; Request\u003c/h3>\u003c/div>'+\n    '\u003cpre>'+hblock(ev.headers)+'\u003c/pre>'+\n    '\u003cpre style=\"margin-top:8px\">'+(ev.req?(typeof ev.req==='string'?esc(ev.req):json(ev.req)):'No request body (asynchronous inbound event).')+'\u003c/pre>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#8595; Response\u003c/h3>\u003c/div>'+\n    '\u003cpre>'+(ev.res?(typeof ev.res==='string'?esc(ev.res):json(ev.res)):'No response captured.')+'\u003c/pre>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>Response footer / trailer\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('Trace ID',ft.traceId)+kv('Processing time','~'+ft.responseTimeMs+' ms')+\n      kv('Content digest','sha256:'+ft.contentSha256)+kv('Response signature',ft.signature)+'\u003c/div>';\n  showDrawer('&#128274; Integration trace &middot; '+MAJOR_LABEL[ev.major],h);\n}\nfunction stageClass(v){return (v==='PENDING'||v==='NA')?'':(v==='BREAK'||v==='ON_HOLD'||v==='FAILED'||v==='REJECTED'?'bd':(v==='AWAITING'||v==='AWAITING_CHECKER'?'on':'dn'));}\nfunction openActDrawer(id){\n  const a=actById(id);if(!a)return;S.drawerRef={type:'act',id:id};\n  const flow=ACT_STAGES.map(function(s){return '\u003cspan class=\"n '+stageClass(a.st[s])+'\">'+STAGE_LBL[s]+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n  const evs=S.events.filter(function(e){return (e.headers&&e.headers['X-Correlation-Id']==='COR-'+id);});\n  let h='\u003cdiv class=\"blk\">\u003ch4>Activity\u003c/h4>\u003cdiv class=\"kv\">'+\n    kv('Activity ID',a.id)+kv('Type',TYPES[a.type].name)+kv('Investor','Aisyah, '+S.member.id)+kv('Assets',pointsSummary(a))+\n    kv('Buyer wallet','Buyer &middot; '+addrLink(ADDR.buyer))+kv('Submitted',a.submitted)+kv('Owner',a.owner)+\n    kv('Status','\u003cspan class=\"pill '+statusPill(a.status)+'\">'+STATUS_LBL(a.status)+'\u003c/span>')+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Activity-level Stages\u003c/h4>\u003cdiv class=\"stepflow\">'+flow+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>On-chain Legs\u003c/h4>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Leg\u003c/th>\u003cth>Operation\u003c/th>\u003cth>Method\u003c/th>\u003cth>Signed\u003c/th>\u003cth>On-chain\u003c/th>\u003cth>Tx Hash\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n    a.legs.map(function(l){return '\u003ctr>\u003ctd class=\"txid\">'+l.id+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+legLabel(l)+'\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+METHOD[l.op]+'\u003c/td>'+\n      '\u003ctd>'+pill(l.st.sign)+'\u003c/td>\u003ctd>'+pill(l.st.chain)+'\u003c/td>\u003ctd>'+hashLink(l.refs.hash)+'\u003c/td>\u003c/tr>';}).join('')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';\n  const refs=[];\n  if(a.refs.partnerRef)refs.push(kv('HL Islamic Bank Ref',a.refs.partnerRef));\n  if(a.refs.apprRef)refs.push(kv('Approval Ref',a.refs.apprRef));\n  a.legs.forEach(function(l){if(l.refs.liminalId)refs.push(kv('L'+l.n+' Liminal Tx',l.refs.liminalId));});\n  if(refs.length)h+='\u003cdiv class=\"blk\">\u003ch4>References\u003c/h4>\u003cdiv class=\"kv\">'+refs.join('')+'\u003c/div>\u003c/div>';\n  if(a.breakId){const b=brkById(a.breakId);\n    if(b)h+='\u003cdiv class=\"blk\" style=\"border-color:var(--red-bd);background:var(--red-bg)\">\u003ch4>Linked Exception\u003c/h4>'+\n      '\u003cdiv class=\"kv\">'+kv('Case',b.id)+kv('Source',b.source)+kv('Variance',pts(b.variance)+' '+tl(b.token))+kv('Status',b.status.replace('_',' '))+'\u003c/div>'+\n      '\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"closeDrawer();openBreakDrawer(\\''+b.id+'\\')\">Open Case\u003c/button>\u003c/div>\u003c/div>';}\n  h+='\u003cdiv class=\"blk\">\u003ch4>Activity History\u003c/h4>\u003cdiv class=\"tl\">'+\n    (a.history.length?a.history.map(function(x){return '\u003cdiv class=\"it\">\u003cdiv class=\"tm\">'+x.t+'\u003c/div>'+x.x+'\u003c/div>';}).join(''):'\u003cdiv style=\"color:var(--muted2)\">No history yet.\u003c/div>')+'\u003c/div>\u003c/div>';\n  let acts='';\n  if(a.status==='AWAITING_APPROVAL')acts+='\u003cbutton class=\"pri\" onclick=\"approveAct(\\''+a.id+'\\')\">Approve (Checker)\u003c/button>\u003cbutton onclick=\"rejectAct(\\''+a.id+'\\')\">Reject\u003c/button>';\n  if(a.awaiting&&!a.manualHold)acts+='\u003cbutton class=\"pri\" onclick=\"closeDrawer();releaseGate()\">'+GATE_LBL[a.awaiting.key]+'\u003c/button>';\n  if(a.manualHold)acts+='\u003cbutton class=\"pri\" onclick=\"releaseAct(\\''+a.id+'\\')\">Release Hold\u003c/button>';\n  else if(a.status!=='COMPLETED'&&a.status!=='REJECTED'&&a.status!=='EXCEPTION')acts+='\u003cbutton onclick=\"holdAct(\\''+a.id+'\\')\">Place Hold\u003c/button>';\n  if(evs.length)acts+='\u003cbutton onclick=\"closeDrawer();setMode(\\'split\\');selEvent('+evs[evs.length-1].id+')\">View API Calls ('+evs.length+')\u003c/button>';\n  if(acts)h+='\u003cdiv class=\"blk\">\u003ch4>Actions\u003c/h4>\u003cdiv class=\"abar\">'+acts+'\u003c/div>\u003c/div>';\n  showDrawer(a.id+' &middot; '+TYPES[a.type].name,h);\n}\nfunction openBreakDrawer(id){\n  const b=brkById(id);if(!b)return;S.drawerRef={type:'break',id:id};\n  const L=ledgers();\n  const steps=['OPEN','ASSIGNED','INVESTIGATING','PENDING_APPROVAL','RESOLVED'];\n  const cur=steps.indexOf(b.status==='ESCALATED'?'INVESTIGATING':b.status);\n  const flow=steps.map(function(s,i){const c=i\u003ccur?'dn':(i===cur?'on':'');return '\u003cspan class=\"n '+c+'\">'+s.replace('_',' ')+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n  const sc={OPEN:'bad',ASSIGNED:'wait',INVESTIGATING:'pend',PENDING_APPROVAL:'wait',ESCALATED:'bad',RESOLVED:'ok'}[b.status]||'mute';\n  let h='\u003cdiv class=\"blk\">\u003ch4>Exception Case\u003c/h4>\u003cdiv class=\"kv\">'+\n   kv('Case ID',b.id)+kv('Source',b.source)+kv('Variance',(b.variance?pts(b.variance):pts(b.varianceBefore||0)+' (cleared)')+' '+tl(b.token))+\n   kv('Reason',b.reason)+kv('Status','\u003cspan class=\"pill '+sc+'\">'+b.status.replace('_',' ')+'\u003c/span>')+\n   kv('Assigned To',b.assignedTo)+(b.actId?kv('Activity',b.actId):'')+\n   kv('Recovery Method',b.source==='DLT Execution'?'\u003cspan class=\"pill pend\">RESUME\u003c/span> the activity resumes from the failed step':'\u003cspan class=\"pill vio\">CORRECTION\u003c/span> register posting only, no replay')+\n   kv('Customer Re-initiation','\u003cspan class=\"pill ok\">Not required\u003c/span>')+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Remediation Lifecycle\u003c/h4>\u003cdiv class=\"stepflow\">'+flow+'\u003c/div>'+\n   (b.status==='ESCALATED'?'\u003cdiv class=\"warnnote\">Escalated to Treasury Manager - severity raised, SLA clock running.\u003c/div>':'')+'\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Balance Evidence\u003c/h4>\u003cdiv class=\"kv\">'+L.rows.map(function(r){return kv(r.src+' &middot; '+r.unit,pts(r.bal));}).join('')+kv('Net Book Variance',pts(L.net)+' units')+'\u003c/div>\u003c/div>';\n  if(b.remediation){\n    h+='\u003cdiv class=\"blk\">\u003ch4>Proposed Remediation (Maker-Checker)\u003c/h4>\u003cdiv class=\"kv\">'+\n     kv('Action',b.remediation.label)+kv('Target API','\u003cspan class=\"mono\" style=\"font-size:11px\">'+b.remediation.api+'\u003c/span>')+\n     kv('Proposed By',b.remediation.proposedBy+' at '+b.remediation.proposedAt)+\n     kv('Approved By',b.remediation.approvedBy?(b.remediation.approvedBy+' at '+b.remediation.approvedAt):'\u003cspan class=\"pill wait\">Pending checker\u003c/span>')+'\u003c/div>\u003c/div>';\n  }\n  if(b.recovery){\n    const R=b.recovery,done=R.steps.filter(function(x){return x.s==='DONE';}).length;\n    h+='\u003cdiv class=\"blk\" style=\"border-color:'+(R.running?'var(--blue-bd)':'var(--green-bd)')+';background:'+(R.running?'#f7faff':'#f6fdf8')+'\">'+\n     '\u003ch4>'+(R.running?'Post-Remediation Processing - running':'Post-Remediation Processing - complete')+' \u003cspan class=\"pill '+(R.running?'pend':'ok')+'\" style=\"float:right\">'+R.mode+' MODE\u003c/span>\u003c/h4>'+\n     '\u003cdiv style=\"font-size:11.5px;color:var(--muted);margin-bottom:10px\">'+R.note+'\u003c/div>'+\n     R.steps.map(function(x,i){\n       const cu=R.running&&i===R.idx;\n       const mark=x.s==='DONE'?'\u003cspan class=\"pill ok\">&#10003;\u003c/span>':(cu?'\u003cspan class=\"pill pend\">running\u003c/span>':'\u003cspan class=\"pill mute\">queued\u003c/span>');\n       return '\u003cdiv style=\"display:flex;align-items:center;gap:9px;padding:5px 0;font-size:11.8px'+(x.s==='DONE'?'':';color:var(--muted)')+'\">\u003cspan style=\"width:64px;flex-shrink:0\">'+mark+'\u003c/span>\u003cspan>'+(i+1)+'. '+x.l+'\u003c/span>\u003c/div>';}).join('')+\n     '\u003cdiv style=\"margin-top:9px;font-size:11px;color:var(--muted)\">'+done+' of '+R.steps.length+' steps complete'+(R.running?' - SI is driving this automatically':'')+'\u003c/div>\u003c/div>';\n  }\n  h+='\u003cdiv class=\"blk\">\u003ch4>Case History\u003c/h4>\u003cdiv class=\"tl\">'+b.history.map(function(x){return '\u003cdiv class=\"it\">\u003cdiv class=\"tm\">'+x.t+'\u003c/div>'+x.x+'\u003c/div>';}).join('')+'\u003c/div>\u003c/div>';\n  let a='';\n  if(b.status!=='RESOLVED'){\n    a+='\u003cdiv style=\"display:flex;gap:8px;align-items:center;margin-bottom:10px\">\u003cselect id=\"asgSel\">'+\n      OWNERS.map(function(o){return '\u003coption'+(b.assignedTo===o?' selected':'')+'>'+o+'\u003c/option>';}).join('')+'\u003c/select>'+\n      '\u003cbutton class=\"sm\" onclick=\"assignBreak(\\''+b.id+'\\',document.getElementById(\\'asgSel\\').value)\">Assign\u003c/button>\u003c/div>';\n    if(b.status==='OPEN'||b.status==='ASSIGNED')a+='\u003cbutton class=\"pri\" onclick=\"investigateBreak(\\''+b.id+'\\')\">Start Investigation\u003c/button>';\n    if(b.status==='INVESTIGATING'||b.status==='ESCALATED'){\n      a+='\u003cdiv style=\"display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap\">\u003cselect id=\"remSel\">'+\n        (REMEDIATIONS[b.source]||[]).map(function(r){return '\u003coption value=\"'+r.id+'\">'+r.label+'\u003c/option>';}).join('')+'\u003c/select>'+\n        '\u003cbutton class=\"pri\" onclick=\"proposeRemediation(\\''+b.id+'\\',document.getElementById(\\'remSel\\').value)\">Propose Remediation (Maker)\u003c/button>\u003c/div>';\n    }\n    if(b.status==='PENDING_APPROVAL'){\n      a+='\u003cdiv class=\"warnnote\">Segregation of duties: the proposing maker cannot approve. A Treasury Manager (checker) must authorise execution.\u003cbr>\u003cbr>'+\n        'On approval SI runs the recovery automatically - \u003cb>'+(b.source==='DLT Execution'?'the original activity resumes from the failed step':'a correction is posted and reconciliation re-runs')+'\u003c/b>. The investor does not need to do anything again.\u003c/div>'+\n        '\u003cbutton class=\"pri\" onclick=\"approveRemediation(\\''+b.id+'\\')\">Approve &amp; Execute (Checker)\u003c/button>\u003cbutton onclick=\"rejectRemediation(\\''+b.id+'\\')\">Reject\u003c/button>';\n    }\n    if(b.status!=='ESCALATED')a+='\u003cbutton onclick=\"escalateBreak(\\''+b.id+'\\')\">Escalate\u003c/button>';\n  } else a+='\u003cdiv class=\"note\">Case resolved at '+(b.resolvedAt||'')+'. Variance cleared and the linked activity has been reconciled.\u003c/div>';\n  h+='\u003cdiv class=\"blk\">\u003ch4>Case Actions\u003c/h4>\u003cdiv class=\"abar\">'+a+'\u003c/div>\u003c/div>';\n  if(b.actId)h+='\u003cdiv class=\"abar\">\u003cbutton onclick=\"closeDrawer();openActDrawer(\\''+b.actId+'\\')\">Open linked activity '+b.actId+'\u003c/button>\u003c/div>';\n  showDrawer(b.id+' &middot; '+b.source,h);\n}\n/* ---- simulated block explorer (Etherscan-style) ---- */\nfunction openExplorerTx(hash){\n  const t=S.chain.find(function(x){return x.hash===hash;});if(!t)return;\n  S.drawerRef={type:'xtx',id:hash};\n  const logs=t.moves.map(function(m){\n    const what=m.from===ZERO?'Mint (Transfer from the null address)':(m.to===ADDR.dvp?'Transfer into DvP escrow':(m.from===ADDR.dvp?'Transfer out of DvP escrow':'Transfer'));\n    return '\u003cdiv class=\"lg\">\u003cb>'+what+'\u003c/b> &middot; '+pts(m.amount)+' '+tl(m.token)+\n      '\u003cbr>\u003cspan style=\"color:var(--muted)\">From\u003c/span> '+esc(lbl(m.from))+'\u003cbr>\u003cspan style=\"color:var(--muted)\">To\u003c/span> '+esc(lbl(m.to))+'\u003c/div>';}).join('');\n  const callout=t.kind==='ISSUE'?'\u003cdiv class=\"callout\">\u003cb>Method = issue.\u003c/b> Tokens were minted: they were created from the null address. A plain transfer would show method \u003cb>transfer\u003c/b> and an existing holder as the sender.\u003c/div>':\n    (t.kind==='SWAP'?'\u003cdiv class=\"callout\">\u003cb>Atomic DvP swap.\u003c/b> Both token movements below settled in this single transaction, paid out of the escrow held by the swap contract.\u003c/div>':\n    '\u003cdiv class=\"callout\">\u003cb>Sent to the DvP swap contract.\u003c/b> These tokens now sit in escrow until the swap transaction executes.\u003c/div>');\n  const h='\u003cdiv class=\"xpl\">\u003cdiv class=\"note\">Simulated view. It imitates what Etherscan shows for this transaction. Hashes in this demo are generated, so they do not exist on a public chain.\u003c/div>'+callout+\n   '\u003cdiv class=\"blk\">\u003ch4>Transaction Details\u003c/h4>\u003cdiv class=\"kv\">'+\n    kv('Transaction Hash','\u003cspan class=\"mono\" style=\"font-size:11px\">'+t.hash+'\u003c/span>')+\n    kv('Status','\u003cspan class=\"pill ok\">Success\u003c/span>')+kv('Block',t.block+' &middot; Finalized')+kv('Timestamp',t.time+' MYT')+\n    kv('From',esc(lbl(t.from))+'\u003cbr>\u003cspan class=\"mono\" style=\"font-size:10.5px;color:var(--muted)\">'+t.from+'\u003c/span>')+\n    kv('Interacted With (To)',esc(lbl(t.to))+'\u003cbr>\u003cspan class=\"mono\" style=\"font-size:10.5px;color:var(--muted)\">'+t.to+'\u003c/span>')+\n    kv('Method','\u003cspan class=\"pill vio\">'+t.method+'\u003c/span>')+kv('Function','\u003cspan class=\"mono\" style=\"font-size:11px\">'+SIG[t.method]+'\u003c/span>')+\n    kv('Activity',t.actId)+(t.note?kv('Note',esc(t.note)):'')+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Token Transfers &amp; Logs\u003c/h4>'+logs+'\u003c/div>\u003c/div>';\n  showDrawer('Etherscan &middot; Transaction',h);\n}\nfunction openExplorerAddr(a){\n  S.drawerRef={type:'xaddr',id:a};\n  const isTok=(a===ADDR.sukuk||a===ADDR.tmyr),isDvp=(a===ADDR.dvp);\n  const hist=addrHistory(a);\n  const txs=S.chain.filter(function(t){return t.from===a||t.to===a||t.moves.some(function(m){return m.from===a||m.to===a;});}).reverse();\n  let info='';\n  if(isTok){const tk=a===ADDR.sukuk?'SUKUK':'TMYR';info=kv('Total Supply',pts(supply(tk)+seedTok(tk))+' '+tl(tk))+kv('Standard','ERC-1400 security token');}\n  else info=kv('Sukuk balance',pts(balance(a,'SUKUK')))+kv('tMYR balance',pts(balance(a,'TMYR')));\n  const tbl=(isTok?'':'\u003cdiv class=\"blk\">\u003ch4>Token Transfers\u003c/h4>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Tx Hash\u003c/th>\u003cth>Method\u003c/th>\u003cth>From\u003c/th>\u003cth>To\u003c/th>\u003cth>Token\u003c/th>\u003cth>Amount\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (hist.map(function(x){\n     const m=x.tx.moves.find(function(mv){return mv.token===x.token&&mv.amount===x.amount&&(mv.to===a||mv.from===a);});\n     return '\u003ctr>\u003ctd>'+hashLink(x.tx.hash)+'\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+x.tx.method+'\u003c/td>\u003ctd style=\"font-size:11px\">'+esc(m?wn(m.from===ZERO?ZERO:m.from):'')+'\u003c/td>\u003ctd style=\"font-size:11px\">'+esc(m?wn(m.to):'')+'\u003c/td>\u003ctd>'+tl(x.token)+'\u003c/td>\u003ctd class=\"mono\">'+pts(x.amount)+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"6\" style=\"color:var(--muted2);padding:12px\">No token transfers yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>');\n  const h='\u003cdiv class=\"xpl\">\u003cdiv class=\"note\">Simulated view. It imitates an Etherscan address page for demo data.\u003c/div>'+\n   (isDvp?'\u003cdiv class=\"callout\">This is the DvP swap contract. Assets arrive here first (two transfers in) and leave together in a single swap transaction, so the balance returns to nil after every settlement.\u003c/div>':'')+\n   '\u003cdiv class=\"blk\">\u003ch4>Overview\u003c/h4>\u003cdiv class=\"kv\">'+kv('Address','\u003cspan class=\"mono\" style=\"font-size:11px\">'+a+'\u003c/span>')+kv('Label',esc(lbl(a)))+info+kv('Transactions',String(txs.length))+'\u003c/div>\u003c/div>'+tbl+\n   '\u003cdiv class=\"blk\">\u003ch4>Transactions\u003c/h4>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Tx Hash\u003c/th>\u003cth>Method\u003c/th>\u003cth>Block\u003c/th>\u003cth>Time\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (txs.map(function(t){return '\u003ctr>\u003ctd>'+hashLink(t.hash)+'\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+t.method+'\u003c/td>\u003ctd class=\"mono\">'+t.block+'\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+shortTime(t.time)+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"4\" style=\"color:var(--muted2);padding:12px\">No transactions yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>\u003c/div>';\n  showDrawer('Etherscan &middot; '+(isDvp?'DvP Contract':(isTok?'Token Contract':'Address')),h);\n}\n/* ============ TREASURY ACTIONS ============ */\nfunction approveAct(id){\n  const a=actById(id);if(!a)return;\n  a.apprOk=true;a.approval='APPROVED';\n  E(a,'TREASURY MANAGER (CHECKER)','SI','POST /approvals/'+id+'/approve','SUCCESS','json',\n    {activityId:id,decision:'APPROVE',approvedBy:'Treasury Manager',role:'CHECKER'},{activityId:id,status:'APPROVED',releasedToStage:'REQUEST'});\n  addAudit('Treasury Manager','approved '+id);hist(a,'Approved by Treasury Manager (checker)');\n  toast(id+' approved');a.status='IN_PROGRESS';setCap(a,'Approved by the bank - continuing...');\n  closeDrawer();renderAll();setTimeout(function(){runStep(id);},400);\n}\nfunction rejectAct(id){\n  const a=actById(id);if(!a)return;\n  a.approval='REJECTED';a.status='REJECTED';\n  E(a,'TREASURY MANAGER (CHECKER)','SI','POST /approvals/'+id+'/reject','FAILED','json',\n    {activityId:id,decision:'REJECT',rejectedBy:'Treasury Manager',reason:'RISK_REVIEW_REQUIRED'},{activityId:id,status:'REJECTED',onChainOperations:'NONE'});\n  addAudit('Treasury Manager','rejected '+id);hist(a,'Rejected by checker - no on-chain operations were run');\n  setCap(a,'Request declined');toast(id+' rejected');closeDrawer();renderAll();\n}\nfunction holdAct(id){\n  const a=actById(id);if(!a)return;\n  a.manualHold=true;a.status='ON_HOLD';\n  E(a,'TREASURY OPS','SI','POST /activities/'+id+'/hold','WARN','json',{activityId:id,action:'HOLD',reason:'MANUAL_TREASURY_HOLD'},{activityId:id,status:'ON_HOLD'});\n  addAudit('Treasury Ops','placed hold on '+id);hist(a,'Manual hold placed by Treasury Ops');\n  toast(id+' placed on hold');closeDrawer();renderAll();\n}\nfunction releaseAct(id){\n  const a=actById(id);if(!a)return;\n  a.manualHold=false;\n  E(a,'TREASURY OPS','SI','POST /activities/'+id+'/release','SUCCESS','json',{activityId:id,action:'RELEASE',releasedBy:'Treasury Ops'},{activityId:id,status:'RELEASED'});\n  addAudit('Treasury Ops','released '+id);hist(a,'Hold released by Treasury Ops');\n  toast(id+' released');closeDrawer();\n  if(a.awaiting){a.status='AWAITING_SCRIPT';renderAll();}\n  else{a.status='IN_PROGRESS';renderAll();setTimeout(function(){runStep(id);},300);}\n}\nfunction toggleIssuance(){S.flags.issuancePaused=!S.flags.issuancePaused;\n  E({id:'ISSUANCE'},'TREASURY OPS','SI','POST /issuance/'+(S.flags.issuancePaused?'pause':'resume'),'WARN','json',\n    {action:S.flags.issuancePaused?'PAUSE_ON_CHAIN_OPERATIONS':'RESUME_ON_CHAIN_OPERATIONS',scope:'ALL_INSTRUMENTS'},{status:S.flags.issuancePaused?'PAUSED':'OPEN'});\n  addAudit('Treasury Ops',(S.flags.issuancePaused?'paused':'resumed')+' on-chain operations');\n  toast('On-chain operations '+(S.flags.issuancePaused?'paused':'resumed'));\n  if(!S.flags.issuancePaused){\n    S.acts.filter(function(a){return a.status==='ON_HOLD'&&a.holdReason==='ISSUANCE'&&!a.manualHold;}).forEach(function(a){\n      a.status='IN_PROGRESS';a.holdReason=null;runStep(a.id);});\n  }\n  renderAll();}\nconst FLAG_LBL={autoRun:'Auto-run',makerChecker:'Maker-checker approval',forceDltFail:'DLT mint failure on next mint',forceSwapFail:'Atomic swap revert on next swap',forceBreak:'Register break on next activity'};\nfunction toggleFlag(k){\n  if(k==='issuancePaused'){toggleIssuance();return;}\n  S.flags[k]=!S.flags[k];\n  toast((FLAG_LBL[k]||k)+': '+(S.flags[k]?'on':'off'));\n  if(k==='autoRun'&&S.flags.autoRun){const a=activeAct();if(a&&a.awaiting&&!a.manualHold){renderAll();releaseGate();return;}}\n  renderAll();\n}\n/* ============ EXPORTS ============ */\nfunction dl(name,rows){\n  const csv=rows.map(function(r){return r.map(function(c){return '\"'+String(c).replace(/\"/g,'\"\"')+'\"';}).join(',');}).join('\\n');\n  const b=new Blob([csv],{type:'text/csv'});const u=URL.createObjectURL(b);\n  const a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();\n  document.body.removeChild(a);URL.revokeObjectURL(u);toast('Downloaded '+name);\n}\nfunction exportCsv(){\n  const rows=[['Activity / Leg ID','Level','Type / Operation','Assets','Submitted'].concat(STAGES.map(function(s){return STAGE_LBL[s];})).concat(['Owner','Status'])];\n  filtered().forEach(function(a){\n    rows.push([a.id,'Activity',TYPES[a.type].name,pointsSummary(a),a.submitted,a.st.request,a.st.rules,'','',a.st.fulfil,a.st.ledger,a.owner,a.status]);\n    a.legs.forEach(function(l){rows.push([l.id,'Leg',legLabel(l),pts(l.amount)+' '+tl(l.token),'','','',l.st.sign,l.st.chain,'','','','']);});\n  });\n  dl('atom-sukuk-activity-queue.csv',rows);addAudit('Treasury Ops','exported activity control queue');\n}\nfunction downloadRecon(){\n  const L=ledgers();\n  const rows=[['Project ATOM Sukuk - Reconciliation Report'],['Generated',stamp(clock)+' MYT'],[],['Source','Measure','Balance','Variance']];\n  L.rows.forEach(function(r){rows.push([r.src,r.unit,r.bal,r.v]);});\n  rows.push(['Net Variance','',L.net,''],[],['Break ID','Source','Token','Variance','Reason','Status','Assigned To']);\n  S.breaks.forEach(function(b){rows.push([b.id,b.source,tl(b.token),b.variance,b.reason,b.status,b.assignedTo]);});\n  dl('atom-sukuk-reconciliation-report.csv',rows);addAudit('Treasury Ops','downloaded reconciliation report');renderAll();\n}\nfunction downloadIssuance(){\n  const rows=[['Activity','Kind','Method','Token','Amount','From','To','Tx Hash','Block','Time']];\n  S.chain.forEach(function(t){t.moves.forEach(function(m){rows.push([t.actId,t.kind,t.method,tl(m.token),m.amount,lbl(m.from),lbl(m.to),t.hash,t.block,t.time]);});});\n  dl('atom-sukuk-token-register.csv',rows);addAudit('Treasury Ops','downloaded token register');renderAll();\n}\nfunction downloadAudit(){\n  const rows=[['Time','Actor','Action']];S.audit.forEach(function(a){rows.push([a.time,a.actor,a.text]);});\n  dl('atom-sukuk-audit-trail.csv',rows);\n}\n/* ============ MODE / INIT ============ */\nfunction setMode(m){\n  S.mode=m;\n  const pc=document.getElementById('paneCustomer'),pd=document.getElementById('paneDash');\n  pc.classList.toggle('hidden',m==='dash');\n  pd.classList.toggle('hidden',m==='customer');\n  pc.classList.toggle('split',m==='split');\n  ['customer','dash','split'].forEach(function(x){document.getElementById('sw-'+x).classList.toggle('on',S.mode===x);});\n  renderAll();\n}\nfunction refreshDrawer(){if(!S.drawerRef)return;const r=S.drawerRef;\n  if(r.type==='break')openBreakDrawer(r.id);else if(r.type==='act')openActDrawer(r.id);\n  else if(r.type==='xtx')openExplorerTx(r.id);else if(r.type==='xaddr')openExplorerAddr(r.id);}\nfunction renderAll(){renderCustomer();refreshDrawer();if(S.mode!=='customer')renderDash();else{\n  document.getElementById('brkChip').textContent=openBreaks().length;\n  document.getElementById('clockLbl').textContent=stamp(clock)+' MYT';}}\nfunction resetAll(){\n  S.acts=[];S.breaks=[];S.audit=[];S.events=[];S.chain=[];S.sel.event=null;S.inspectingEvent=null;S.exp={};S.filters={status:'All',q:''};\n  S.flags={autoRun:true,makerChecker:false,forceDltFail:false,forceSwapFail:false,forceBreak:false,issuancePaused:false};\n  S.seq={BUY:0,SELL:0,brk:0};S.block=5238400;S.cust={view:'home',pin:0,authFor:null,actId:null,caption:''};\n  S.member=newMember();\n  clock=new Date(2025,4,19,10,32,0);\n  closeDrawer();toast('Demo data reset');\n  buildCustomerShell();renderAll();\n}\ndocument.getElementById('brandLogo').innerHTML=logoHtml();\nbuildCustomerShell();\nsetMode('customer');\n\u003c/script>\n\u003c/body>\n\u003c/html>\n"}};
const frames={};let current=0;
function openUC(n,noHash){
  n=parseInt(n,10);if(!APPS[n])n=1;
  if(!frames[n]){
    const f=document.createElement('iframe');
    f.title=APPS[n].title;f.setAttribute('data-uc',String(n));
    f.srcdoc=APPS[n].html;
    document.getElementById('stage').appendChild(f);
    frames[n]=f;
  }
  Object.keys(frames).forEach(function(k){frames[k].style.display=(String(k)===String(n))?'block':'none';});
  document.querySelectorAll('.tab').forEach(function(t){t.classList.toggle('on',t.getAttribute('data-uc')===String(n));});
  current=n;document.title='Project ATOM — '+APPS[n].title.split(': ')[1];
  if(!noHash&&history.replaceState){try{history.replaceState(null,'','#uc'+n);}catch(e){}}
  try{frames[n].focus();}catch(e){}
}
document.addEventListener('keydown',function(e){if(e.target&&/INPUT|SELECT|TEXTAREA/.test(e.target.tagName))return;
  if(e.key==='1'||e.key==='2'||e.key==='3')openUC(e.key);});
window.addEventListener('hashchange',function(){const m=/^#uc([123])$/.exec(location.hash);if(m&&parseInt(m[1],10)!==current)openUC(m[1],true);});
(function(){const m=/^#uc([123])$/.exec(location.hash);openUC(m?m[1]:1,!m);})();
</script>
