font-size:11px}\n.hb:hover .tr{box-shadow:0 0 0 2px var(--blue-bg)}\n.ctip{position:fixed;z-index:100000;pointer-events:none;background:#0f172a;color:#e5edf8;border-radius:9px;padding:8px 11px;font-size:11.5px;line-height:1.5;box-shadow:0 8px 22px rgba(15,23,42,.32);max-width:290px;min-width:120px}\n.ctip>b{color:#fff;display:block;margin-bottom:2px}\n.ctip .k{color:#9db0c9}\n.ctip .r{display:flex;justify-content:space-between;align-items:center;gap:16px}\n.ctip .r b{color:#fff;font-family:var(--mono);font-size:11px}\n.ctip i{width:8px;height:8px;border-radius:2px;display:inline-block;margin-right:6px}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\n\u003cdiv class=\"topbar\">\n  \u003cdiv class=\"brand\">\n    \u003cdiv class=\"logo\" id=\"brandLogo\">\u003c/div>\n    \u003cdiv>\n      \u003ch1>Project ATOM Treasury &amp; Settlement Control Center\u003c/h1>\n      \u003cdiv class=\"sb\">SI Orchestration &middot; tSGD / tMYR Escrow, Swap &amp; Settlement &middot; SGD to MYR\u003c/div>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv class=\"demoflag\">\n    \u003cb>&#9888; SIMULATED DEMO DATA ONLY\u003c/b>\n    \u003cspan>The data displayed mirrors the Guocoland milestone demo: SGD 120,000 paid in three milestones and converted at 3.3.\u003c/span>\n  \u003c/div>\n  \u003cdiv class=\"switcher\">\n    \u003cbutton id=\"sw-customer\" class=\"on\" onclick=\"setMode('customer')\">Corporate Portal\u003c/button>\n    \u003cbutton id=\"sw-dash\" onclick=\"setMode('dash')\">Control Center\u003c/button>\n    \u003cbutton id=\"sw-split\" onclick=\"setMode('split')\">Split View\u003c/button>\n  \u003c/div>\n  \u003cdiv class=\"orgsw\" title=\"Liminal org context. Filters the Wallets view.\">\n    \u003cbutton id=\"org-SG\" class=\"on\" onclick=\"setOrg('SG')\">HLB Singapore\u003c/button>\n    \u003cbutton id=\"org-MY\" onclick=\"setOrg('MY')\">HLB Malaysia Cross Border\u003c/button>\n  \u003c/div>\n  \u003cdiv class=\"envchip\">\u003cspan>&#128197;\u003c/span>\u003cb id=\"clockLbl\">19 May 2025 10:32:00 SGT\u003c/b>\u003c/div>\n  \u003cdiv class=\"envchip\">\u003cspan class=\"pill vio\">Demo\u003c/span>\u003cspan class=\"pill bad\" id=\"brkChip\">0\u003c/span>\u003cb>Treasury Ops\u003c/b>\u003c/div>\n\u003c/div>\n\n\u003cdiv id=\"runner\" class=\"runner\">\u003c/div>\n\n\u003cdiv class=\"workspace\">\n  \u003cdiv id=\"paneCustomer\" class=\"pane\">\u003c/div>\n  \u003cdiv id=\"paneDash\" class=\"pane hidden\">\u003c/div>\n\u003c/div>\n\n\u003cdiv id=\"overlay\" class=\"ovl hidden\" onclick=\"if(event.target===this)closeDrawer()\">\n  \u003cdiv class=\"drawer\">\n    \u003cdiv class=\"drh\">\u003ch3 id=\"drTitle\">Detail\u003c/h3>\u003cbutton class=\"x\" onclick=\"closeDrawer()\">&times;\u003c/button>\u003c/div>\n    \u003cdiv class=\"drb\" id=\"drBody\">\u003c/div>\n  \u003c/div>\n\u003c/div>\n\u003cdiv id=\"toast\" class=\"toast\">\u003c/div>\n\n\u003cscript>\n/* ============ CONSTANTS ============ */\n/* HLB logo, embedded as a data: URI. Replace the value with another PNG, JPG or SVG data URI to change it. */\nconst HLB_LOGO_URI='data:image/png;base64,';\nconst STEP_DELAY=620;                       /* ms between pipeline steps */\nconst FX=3.3, PLAN_SGD=120000, MILESTONES=[40000,50000,30000], START_BALANCE=1500000;\nconst NETWORK='EVM network (Etherscan-indexed)';\nconst ZERO='0x0000000000000000000000000000000000000000';\nconst ADDR={\n  guoco:'0xA1c9E3f6B8d2A4c7E0f3B6d9A2c5E8f1B4d7A0c3',\n  escrow:'0xD7e5C3a1B9f2846E0c7A5d3B1f9E8c6A4b2D0f13',\n  hlbmy:'0xBE01D4a2C9f3E8b6A1d7C4f2B9e6A3d8C5f1B7e4',\n  swap:'0x5A9c2E7f4B1d8036C5e9A2f7B4d1E8c30A6f95B2',\n  tsgd:'0x7Ea1C4b9D2f60385A7c1E9d4B2f8A6c30E5b97D1',\n  tmyr:'0x3Fc8B5a2E9d17046C8b3F1a5D7e2A9c40B6d8E15',\n  signerSG:'0x2C6d1F9a8E4b7053A9c2D6e1F4b8A7c53D0e9F62',\n  signerMY:'0x8F4a2C7e1B9d5036E8a4C2f7D1b9A5e30C7f6B48'\n};\nconst ADDR_LBL={};\nADDR_LBL[ADDR.guoco]='Guocoland Wallet (HLB Singapore)';\nADDR_LBL[ADDR.escrow]='DvP Escrow Contract';\nADDR_LBL[ADDR.hlbmy]='HL Bank Malaysia Settlement Account (HLB Malaysia Cross Border)';\nADDR_LBL[ADDR.swap]='DvP Swap Contract (tMYR x tSGD)';\nADDR_LBL[ADDR.tsgd]='tSGD Token Contract (ERC-1400)';\nADDR_LBL[ADDR.tmyr]='tMYR Token Contract (ERC-1400)';\nADDR_LBL[ADDR.signerSG]='HLB Singapore MPC Signer';\nADDR_LBL[ADDR.signerMY]='HLB Malaysia MPC Signer';\nADDR_LBL[ZERO]='Null Address (mint / burn)';\nconst WALLETS=[\n  {addr:ADDR.guoco,name:'Guocoland Wallet',org:'SG',orgName:'HLB Singapore'},\n  {addr:ADDR.hlbmy,name:'HL Bank Malaysia Settlement Account',org:'MY',orgName:'HLB Malaysia Cross Border'}\n];\nconst STAGES=['fiatLock','mint','escrow','disburse','swap','burn','glPayout'];\nconst PLAN_STAGES=['fiatLock','mint','escrow'];\nconst LEG_STAGES=['disburse','swap','burn','glPayout'];\nconst STAGE_LBL={fiatLock:'Fiat Lock',mint:'Mint',escrow:'Escrow',disburse:'Disburse',swap:'Swap',burn:'Burn',glPayout:'GL & Payout'};\nconst ST={PENDING:['Pending','pend'],NA:['&mdash;','mute'],AWAITING:['Awaiting','wait'],\n  LOCKED:['Locked','ok'],SIGNED:['Signed','ok'],CONFIRMED:['Confirmed','ok'],CREATED:['Created','ok'],FUNDED:['Funded','ok'],\n  RELEASED:['Released','ok'],SETTLED:['Settled','ok'],POSTED:['Posted','ok'],PAID:['Paid','ok'],\n  PASSED:['Passed','ok'],APPROVED:['Approved','ok'],AWAITING_CHECKER:['Awaiting Checker','wait'],REJECTED:['Rejected','bad'],\n  ON_HOLD:['On Hold','bad'],FAILED:['Failed','bad'],BREAK:['Break','bad'],MATCHED:['Matched','ok']};\nconst OWNERS=['Ops Analyst','Treasury Ops','Accounting Ops','Treasury Manager'];\nconst GATE_LBL={M1:'Mark milestone 1 complete (release 40,000 tSGD)',M2:'Mark milestone 2 complete (release 50,000 tSGD)',\n  M3:'Mark milestone 3 complete (release 30,000 tSGD)',SWAP:'Run the DvP swaps (tSGD to tMYR)',BURN:'Run the tMYR burn and MYR payout'};\nconst STEP_LBL={approval:'Maker-checker approval',compliance:'Compliance screening',lock:'1.1 Fiat lock',escrowCreate:'1.2 Create DvP escrow',\n  mint:'1.3 Mint tSGD (signing)',mintChain:'1.3 Mint tSGD (on-chain)',fund:'1.4 Fund escrow',disburseSign:'2 Milestone release (signing)',disburseChain:'2 Milestone release (on-chain)',\n  swapSign:'3 DvP swap (signing)',swapChain:'3 DvP swap (on-chain)',burnSign:'4.1 Burn tMYR (signing)',burnChain:'4.1 Burn tMYR (on-chain)',gl:'4.2 GL update',payout:'4.3 MYR payout',recon:'Reconciliation',close:'Closing plan'};\nconst REMEDIATIONS={\n 'Core vs DLT':[{id:'RETRY_CORE_POSTING',label:'Retry core banking posting',api:'POST /core/postings/retry'},\n                {id:'DLT_RECONFIRM',label:'Re-confirm DLT finality',api:'GET /dlt/transactions/{hash}'}],\n 'Settlement':[{id:'RETRY_SETTLEMENT_MATCH',label:'Re-run settlement matching',api:'POST /settlement/rematch'},\n               {id:'MANUAL_MATCH',label:'Manually match settlement reference',api:'POST /settlement/manual-match'}],\n 'GL vs Core':[{id:'GL_ADJUSTMENT',label:'Post GL adjustment journal',api:'POST /core/gl/adjustment'},\n               {id:'RETRY_GL_POSTING',label:'Retry GL journal posting',api:'POST /core/gl/postings/retry'}],\n 'DLT Execution':[{id:'RETRY_DLT_SUBMIT',label:'Re-submit signed DLT transaction',api:'POST /liminal/digital-assets/resubmit'},\n                  {id:'DLT_RECONFIRM',label:'Re-confirm DLT finality',api:'GET /dlt/transactions/{hash}'}]\n};\nconst S={mode:'customer',nav:'control',org:'SG',plans:[],chain:[],breaks:[],audit:[],events:[],inspectingEvent:null,\n  flags:{autoRun:true,complianceStep:false,makerChecker:false,reconOnClose:false,forceDltFail:false,forceBreak:false,issuancePaused:false,settlementOnHold:false},\n  sel:{event:null},filters:{status:'All',q:''},exp:{},seq:{plan:0,brk:0},block:5238400,\n  cust:{view:'home',pin:0,planId:null,caption:''},drawer:null,drawerRef:null};\n\n/* ============ HELPERS ============ */\nlet clock=new Date(2025,4,19,10,32,0);\nfunction tick(){clock=new Date(clock.getTime()+1000*(1+Math.floor(Math.random()*2)));return hhmmss(clock);}\nfunction hhmmss(d){return d.toTimeString().slice(0,8);}\nfunction stamp(d){const m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n  return d.getDate()+' '+m[d.getMonth()]+' '+d.getFullYear()+' '+hhmmss(d);}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/\u003c/g,'&lt;').replace(/>/g,'&gt;');}\nfunction money(n,dp){dp=dp===undefined?2:dp;return Number(n).toLocaleString('en-US',{minimumFractionDigits:dp,maximumFractionDigits:dp});}\nfunction sgd(n){return 'SGD '+money(n);}\nfunction myr(n){return 'MYR '+money(n);}\nfunction json(o){return JSON.stringify(o,null,2);}\nfunction hex(n){let s='0x',c='0123456789abcdef';for(let i=0;i\u003c(n||64);i++)s+=c[Math.floor(Math.random()*16)];return s;}\nfunction sa(a){return a.slice(0,8)+'...'+a.slice(-4);}\nfunction lbl(a){return ADDR_LBL[a]||a;}\nfunction pill(code){const d=ST[code]||['&mdash;','mute'];return '\u003cspan class=\"pill '+d[1]+'\">'+d[0]+'\u003c/span>';}\nfunction toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('on');\n  clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('on');},2800);}\nfunction headers(kind,corr,auth){\n  const h={'Content-Type':kind==='xml'?'application/xml; charset=utf-8':'application/json',\n    'X-Correlation-Id':'COR-'+(corr||'ATOM'),'X-Idempotency-Key':'IDEMP-'+Math.random().toString(36).slice(2,10).toUpperCase(),\n    'X-Channel':'SI-ORCHESTRATOR','Authorization':'Bearer ***REDACTED***','User-Agent':'SI-Orchestrator/1.0'};\n  if(auth){h['Authorization']='Bearer '+auth.oauth.accessToken;h['X-TLS-Version']=auth.mtls.tlsVersion;\n    h['X-Cipher-Suite']=auth.mtls.cipherSuite;h['X-Client-Cert-Thumbprint']=auth.mtls.clientCert.sha256Thumbprint;h['X-Mutual-TLS']=auth.mtls.mutualAuth;}\n  return h;\n}\nfunction hblock(h){return Object.keys(h).map(function(k){return k+': '+h[k];}).join('\\n');}\n/* ============ SI INTEGRATION SECURITY (simulated mTLS + OAuth2) ============\n   Illustrative only: certificates, tokens and signatures below are not connected to any real PKI,\n   OAuth server or blockchain network. Only five categories are \"major\": mint, burn, updating the\n   ledger (GL postings), connecting to core banking, and the corporate portal's very first request. */\nconst MAJOR_LABEL={MINT:'MINT',BURN:'BURN',LEDGER:'LEDGER UPDATE',COREBANK:'CORE BANKING',APPAUTH:'APP REQUEST',ESCROW:'ESCROW RELEASE',SWAP:'DVP SWAP'};\nconst MAJOR_COLOR={MINT:'vio',BURN:'or',LEDGER:'tl',COREBANK:'ok',APPAUTH:'pend',ESCROW:'mute',SWAP:'wait'};\nconst COREBANK_RE=/CORE|BANK/i;\nconst APP_RE=/^CORPORATE PORTAL$/;\nfunction classifyMajor(from,to,op){\n  /* Only SI's own integration hops are \"major\" - what a partner does on its own\n     side (e.g. Liminal submitting a signed transaction to the DLT, or a domestic\n     bank-to-bank payout) is that partner's internal process, not part of SI's\n     integration workflow. */\n  if(from!=='SI'&&to!=='SI')return null;\n  if(/mint/i.test(op))return 'MINT';\n  if(/burn/i.test(op))return 'BURN';\n  if(/ledger|gl\\/postings|register\\/sync/i.test(op))return 'LEDGER';\n  if(/disburse/i.test(op))return 'ESCROW';\n  if(/\\bswap\\b/i.test(op))return 'SWAP';\n  if(APP_RE.test(from))return 'APPAUTH';\n  if(COREBANK_RE.test(from)||COREBANK_RE.test(to))return 'COREBANK';\n  return null;\n}\nconst AUTH_PROFILES={\n  LIMINAL:{tokenEndpoint:'https://auth.liminal.example/oauth2/token',clientId:'si-orchestrator-hlb',scope:'liminal.digital-assets.write liminal.vaults.read',\n    audience:'https://api.liminal.example',issuer:'https://auth.liminal.example/',caIssuer:'CN=Liminal Enterprise CA, O=Liminal Custody Inc, C=US',serverSubject:'CN=api.liminal.example, O=Liminal Custody Inc'},\n  DEFAULT_CORE:{tokenEndpoint:'https://auth.corebanking.hlb.internal/oauth2/token',clientId:'si-orchestrator-hlb',scope:'core.postings.write core.fiat.read',\n    audience:'https://api.corebanking.hlb.internal',issuer:'https://auth.corebanking.hlb.internal/',caIssuer:'CN=HLB Enterprise Root CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=api.corebanking.hlb.internal, O=Hong Leong Bank'},\n  'BANK MY':{tokenEndpoint:'https://auth.bankmy.com.my/oauth2/token',clientId:'hlb-correspondent-si',scope:'payments.pacs008.write',\n    audience:'https://api.bankmy.com.my/payments',issuer:'https://auth.bankmy.com.my/',caIssuer:'CN=Correspondent Banking CA (MY), O=Bank MY Berhad, C=MY',serverSubject:'CN=api.bankmy.com.my, O=Bank MY Berhad'},\n  'CORPORATE PORTAL':{tokenEndpoint:'https://auth.hlb.com.sg/oauth2/token',clientId:'hlb-corporate-portal',scope:'si.escrow.write si.escrow.read',\n    audience:'https://si.hlb.com.sg',issuer:'https://auth.hlb.com.sg/',caIssuer:'CN=HLB Corporate Channel CA, O=Hong Leong Bank, C=SG',serverSubject:'CN=si.hlb.com.sg, O=Hong Leong Bank'},\n  DEFAULT:{tokenEndpoint:'https://auth.hlb.internal/oauth2/token',clientId:'si-orchestrator-hlb',scope:'si.default',\n    audience:'https://api.hlb.internal',issuer:'https://auth.hlb.internal/',caIssuer:'CN=HLB Enterprise Root CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=api.hlb.internal, O=Hong Leong Bank'}\n};\nfunction authProfileFor(target){if(AUTH_PROFILES[target])return AUTH_PROFILES[target];if(COREBANK_RE.test(target))return AUTH_PROFILES.DEFAULT_CORE;return AUTH_PROFILES.DEFAULT;}\nfunction authTarget(category,from,to){\n  if(category==='MINT'||category==='BURN')return 'LIMINAL';\n  if(category==='APPAUTH')return from;\n  if(category==='COREBANK'){if(COREBANK_RE.test(to))return to;if(COREBANK_RE.test(from))return from;return to;}\n  return (from==='SI')?to:from;\n}\nfunction fp(bytes){const c='0123456789ABCDEF';const out=[];for(let i=0;i\u003cbytes;i++)out.push(c[Math.floor(Math.random()*16)]+c[Math.floor(Math.random()*16)]);return out.join(':');}\nfunction jwtCompact(payload){\n  const header={alg:'RS256',typ:'JWT',kid:'si-2025-09'};\n  const b64=function(o){return btoa(JSON.stringify(o)).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');};\n  const sig=Math.random().toString(36).slice(2,10)+Math.random().toString(36).slice(2,18);\n  return {compact:b64(header)+'.'+b64(payload)+'.'+sig,header:header,payload:payload};\n}\nfunction buildAuthSim(category,from,to){\n  const target=authTarget(category,from,to),profile=authProfileFor(target);\n  const now=Math.floor(Date.now()/1000);\n  const payload={iss:profile.issuer,sub:'si-orchestrator@hlb-atom',aud:profile.audience,scope:profile.scope,iat:now,exp:now+300,jti:'jti-'+Math.random().toString(36).slice(2,10)};\n  const jwt=jwtCompact(payload);\n  return {category:category,target:target,\n    mtls:{tlsVersion:'TLS 1.3',cipherSuite:'TLS_AES_256_GCM_SHA384',\n      clientCert:{subject:'CN=si-orchestrator.hlb-atom.internal, OU=Digital Integration, O=Hong Leong Bank, C=SG',issuer:profile.caIssuer,serial:fp(8),sha256Thumbprint:fp(32)},\n      serverCert:{subject:profile.serverSubject,issuer:profile.caIssuer},mutualAuth:'PEER_VERIFIED'},\n    oauth:{tokenEndpoint:profile.tokenEndpoint,grantType:'client_credentials',clientId:profile.clientId,scope:profile.scope,tokenType:'Bearer',expiresIn:300,\n      accessToken:jwt.compact,decoded:{header:jwt.header,payload:jwt.payload}},\n    footer:{responseTimeMs:40+Math.floor(Math.random()*180),contentSha256:fp(32).replace(/:/g,'').toLowerCase(),traceId:'trace-'+Math.random().toString(36).slice(2,10),signature:'sig_'+Math.random().toString(36).slice(2,14)}\n  };\n}\nfunction logEvent(e){const id=S.events.length;const ev=Object.assign({id:id,time:tick()},e);S.events.push(ev);S.sel.event=id;return ev;}\nfunction E(p,from,to,op,status,kind,req,res){\n  const major=classifyMajor(from,to,op),auth=major?buildAuthSim(major,from,to):null;\n  const ev=logEvent({from:from,to:to,op:op,status:status,kind:kind,headers:headers(kind,p.id,auth),req:req,res:res,major:major,auth:auth,actId:p.id});\n  if(major&&p&&p.pendingInspect)p.pendingInspect.push(ev.id);\n  return ev;\n}\nconst WH='N/A - asynchronous webhook received from Liminal.';\nfunction addAudit(actor,text){S.audit.unshift({time:hhmmss(clock),actor:actor,text:text});if(S.audit.length>80)S.audit.pop();}\nfunction logoHtml(){return HLB_LOGO_URI?'\u003cimg src=\"'+HLB_LOGO_URI+'\" alt=\"HLB Singapore\">':'\u003cdiv class=\"wm\">HLB\u003csmall>Singapore\u003c/small>\u003c/div>';}\nfunction planById(id){return S.plans.find(function(p){return p.id===id;});}\nfunction brkById(id){return S.breaks.find(function(b){return b.id===id;});}\nfunction activePlan(){return S.plans.find(function(p){return p.status!=='COMPLETED'&&p.status!=='REJECTED';});}\nfunction curPlan(){return planById(S.cust.planId)||activePlan()||S.plans[0]||null;}\nfunction hist(p,x){p.history.push({t:hhmmss(clock),x:x});}\nfunction hashLink(h){return h?'\u003ca class=\"xl\" title=\"Open the simulated Etherscan view\" onclick=\"event.stopPropagation();openExplorerTx(\\''+h+'\\')\">'+h.slice(0,10)+'...'+h.slice(-6)+'\u003c/a>':'&mdash;';}\nfunction addrLink(a){return '\u003ca class=\"xl\" title=\"Open the simulated Etherscan address page\" onclick=\"event.stopPropagation();openExplorerAddr(\\''+a+'\\')\">'+sa(a)+'\u003c/a>';}\n\n/* ============ ON-CHAIN REGISTRY (single source of truth for balances) ============ */\nfunction addChain(p,kind,method,to,moves,from){\n  S.block+=Math.floor(Math.random()*6)+2;\n  const tx={hash:hex(),block:S.block,kind:kind,method:method,planId:p.id,from:from,to:to,moves:moves,time:stamp(clock)};\n  S.chain.push(tx);return tx;\n}\nfunction eachMove(fn){S.chain.forEach(function(t){t.moves.forEach(function(m){fn(m,t);});});}\nfunction balance(addr,token){let b=0;eachMove(function(m){if(m.token!==token)return;if(m.to===addr)b+=m.amount;if(m.from===addr)b-=m.amount;});return b;}\nfunction minted(token){let s=0;eachMove(function(m){if(m.token===token&&m.from===ZERO)s+=m.amount;});return s;}\nfunction burned(token){let s=0;eachMove(function(m){if(m.token===token&&m.to===ZERO)s+=m.amount;});return s;}\nfunction supply(token){return minted(token)-burned(token);}\nfunction addrHistory(addr){\n  const out=[];\n  S.chain.forEach(function(t){t.moves.forEach(function(m){\n    if(m.to===addr||m.from===addr){\n      const inc=m.to===addr;\n      const type=m.from===ZERO?'MINT':(m.to===ZERO?'BURN':(inc?'IN':'OUT'));\n      const other=m.from===ZERO?'Mint':(m.to===ZERO?'Burn':(inc?m.from:m.to));\n      out.push({tx:t,type:type,token:m.token,amount:m.amount,other:other});}\n  });});\n  return out.reverse();\n}\n\n/* ============ POSITION / LEDGER MATH ============ */\nfunction position(){\n  let locked=0;S.plans.forEach(function(p){if(p.st.fiatLock==='LOCKED')locked+=p.sgd;});\n  const tsMint=minted('tSGD');\n  return {locked:locked,tsgdMinted:tsMint,tsgdOut:supply('tSGD'),tsgdEscrow:balance(ADDR.escrow,'tSGD'),tsgdMy:balance(ADDR.hlbmy,'tSGD'),\n    tmyrMinted:minted('tMYR'),tmyrBurned:burned('tMYR'),tmyrOut:supply('tMYR'),coverage:tsMint>0?(locked/tsMint*100):null};\n}\nfunction openBreaks(){return S.breaks.filter(function(b){return b.status!=='RESOLVED';});}\nfunction ledgers(){\n  const p=position();let coreVar=0,glVar=0;\n  openBreaks().forEach(function(b){if(b.source==='Core vs DLT')coreVar+=b.variance;if(b.source==='GL vs Core')glVar+=b.variance;});\n  let glPosted=0;S.plans.forEach(function(pl){pl.legs.forEach(function(l){if(l.st.glPayout==='POSTED'||l.st.glPayout==='PAID')glPosted+=l.myr;});});\n  return {p:p,coreVar:coreVar,glVar:glVar,net:coreVar+glVar,glPosted:glPosted,\n    rows:[\n      {src:'Core Banking (SG)',unit:'SGD locked',bal:p.locked,v:0},\n      {src:'DLT Ledger',unit:'tSGD minted',bal:p.tsgdMinted,v:0},\n      {src:'Escrow + HLB Malaysia wallet',unit:'tSGD pending swap',bal:p.tsgdEscrow+p.tsgdMy,v:0},\n      {src:'DLT Ledger',unit:'tMYR burned',bal:p.tmyrBurned+coreVar,v:coreVar},\n      {src:'General Ledger (MY)',unit:'tMYR burned and posted',bal:glPosted+glVar,v:glVar}\n    ]};\n}\nfunction availableBalance(){\n  let held=0;S.plans.forEach(function(p){if(p.status!=='REJECTED'&&p.st.fiatLock==='LOCKED')held+=p.sgd;});\n  return Math.max(0,START_BALANCE-held);\n}\n\n/* ============ DEMO SAMPLE DATA (presentation only) ============\n   Display-only. It never touches the on-chain registry, wallets, plans, scripts or any calculation.\n   It gives the control center a realistic \"other clients\" backdrop. Set DEMO_SEED=false to remove all of it. */\nconst DEMO_SEED=true;\nconst SEED_PLANS=[\n  {id:'PL-20250516-0006',when:'16 May 15:10:44',cust:'Bayfront Builders',to:'Sarawak Steel',sgd:1100000,kind:'ESCROW'},\n  {id:'PL-20250516-0005',when:'16 May 11:26:09',cust:'Harbourline',to:'Penang Cold Chain',sgd:750000,kind:'ESCROW'},\n  {id:'PL-20250516-0004',when:'16 May 09:48:31',cust:'Kestrel Aviation',to:'Subang Precision',sgd:135000,kind:'DONE'},\n  {id:'PL-20250515-0003',when:'15 May 16:12:05',cust:'Orchid Foods',to:'Perak Agro',sgd:45000,kind:'DONE'},\n  {id:'PL-20250515-0002',when:'15 May 10:03:52',cust:'Merlion Tech',to:'Cyberjaya Systems',sgd:210000,kind:'DONE'},\n  {id:'PL-20250514-0001',when:'14 May 14:37:18',cust:'Raffles Interiors',to:'Johor Timber',sgd:90000,kind:'DONE'}\n];\nconst SEED_STAGES={\n  DONE:{fiatLock:'LOCKED',mint:'CONFIRMED',escrow:'FUNDED',disburse:'RELEASED',swap:'SETTLED',burn:'CONFIRMED',glPayout:'PAID'},\n  ESCROW:{fiatLock:'LOCKED',mint:'CONFIRMED',escrow:'FUNDED',disburse:'PENDING',swap:'PENDING',burn:'PENDING',glPayout:'PENDING'}\n};\nconst SEED_STATUS={DONE:'COMPLETED',ESCROW:'AWAITING_MILESTONE'};\n/* bank-wide totals implied by the sample plans, so every screen agrees */\nconst BASE1=(function(){\n  let done=0,flight=0;SEED_PLANS.forEach(function(p){if(p.kind==='DONE')done+=p.sgd;else flight+=p.sgd;});\n  return {locked:done+flight,tsgdMinted:done+flight,tsgdBurned:done,tsgdEscrow:flight,\n          tmyrMinted:done*FX,tmyrBurned:done*FX,glPosted:done*FX};\n})();\nconst SEED_AUDIT=[\n  {time:'10:24:18',actor:'Reconciliation Engine',text:'completed intraday reconciliation: all 5 control points matched'},\n  {time:'10:05:42',actor:'Treasury Manager',text:'approved the daily reserve attestation (SGD locked vs tSGD minted at 100%)'},\n  {time:'09:47:09',actor:'SI Orchestrator',text:'health check passed: Core Banking (SG), Core Banking (MY), Liminal, DLT node'},\n  {time:'09:31:55',actor:'Ops Analyst',text:'reviewed 2 plans awaiting milestone confirmation'},\n  {time:'09:12:30',actor:'Treasury Ops',text:'opened the settlement window for the day'},\n  {time:'08:58:03',actor:'SI Orchestrator',text:'refreshed the FX rate: 1 SGD = 3.30 MYR'},\n  {time:'08:45:12',actor:'Treasury Ops',text:'signed in to the control center'}\n];\nconst SEED_BREAKS=[\n  {id:'BRK-20250516-0002',source:'Core vs DLT',variance:-1250,label:'Retry core banking posting',by:'Treasury Manager',at:'16 May 14:22:07'},\n  {id:'BRK-20250515-0001',source:'DLT Execution',variance:-45000,label:'Re-submit signed DLT transaction',by:'Treasury Manager',at:'15 May 11:05:40'}\n];\nfunction dpos(){\n  const p=position();if(!DEMO_SEED)return p;const B=BASE1;\n  const locked=p.locked+B.locked,tsMint=p.tsgdMinted+B.tsgdMinted;\n  return Object.assign({},p,{locked:locked,tsgdMinted:tsMint,tsgdOut:p.tsgdOut+B.tsgdMinted-B.tsgdBurned,\n    tsgdEscrow:p.tsgdEscrow+B.tsgdEscrow,tmyrMinted:p.tmyrMinted+B.tmyrMinted,tmyrBurned:p.tmyrBurned+B.tmyrBurned,\n    tmyrOut:p.tmyrOut+B.tmyrMinted-B.tmyrBurned,coverage:tsMint>0?(locked/tsMint*100):null});\n}\nfunction dledgers(){\n  const L=ledgers();if(!DEMO_SEED)return L;const B=BASE1;\n  const add=[B.locked,B.tsgdMinted,B.tsgdEscrow,B.tmyrBurned,B.glPosted];\n  return Object.assign({},L,{rows:L.rows.map(function(r,i){return Object.assign({},r,{bal:r.bal+add[i]});})});\n}\nfunction seedEscrow(){return DEMO_SEED?BASE1.tsgdEscrow:0;}\nfunction seedSupply(tk){return DEMO_SEED?(tk==='tSGD'?BASE1.tsgdMinted-BASE1.tsgdBurned:BASE1.tmyrMinted-BASE1.tmyrBurned):0;}\nfunction seedBurnedTsgd(){return DEMO_SEED?BASE1.tsgdBurned:0;}\nfunction auditAll(){return S.audit.concat(DEMO_SEED?SEED_AUDIT:[]);}\nfunction seedFiltered(){\n  if(!DEMO_SEED)return [];const f=S.filters;\n  return SEED_PLANS.filter(function(s){\n    const st=SEED_STATUS[s.kind];\n    if(f.status!=='All'){\n      if(f.status==='In Progress'&&st!=='AWAITING_MILESTONE')return false;\n      if(f.status==='Completed'&&st!=='COMPLETED')return false;\n      if(f.status==='On Hold'||f.status==='Exception')return false;\n    }\n    if(f.q&&(s.id+' '+s.cust+' '+s.to).toLowerCase().indexOf(f.q.toLowerCase())\u003c0)return false;\n    return true;});\n}\nfunction seedQueueRows(list){\n  return list.map(function(s){\n    const st=SEED_STAGES[s.kind],status=SEED_STATUS[s.kind];\n    return '\u003ctr class=\"seed\">\u003ctd>\u003cbutton class=\"kebab\" style=\"visibility:hidden\">&#9662;\u003c/button>\u003cspan class=\"txid\">'+s.id+'\u003c/span>'+\n      '\u003cdiv class=\"sub\">'+s.when+' &middot; Treasury Ops\u003c/div>\u003c/td>'+\n      '\u003ctd>\u003cdiv class=\"cust\">'+s.cust+'\u003c/div>\u003cdiv class=\"chan\">(to '+s.to+')\u003c/div>\u003c/td>'+\n      '\u003ctd class=\"mono\">'+money(s.sgd,0)+'\u003c/td>'+\n      STAGES.map(function(k){return '\u003ctd>'+pill(st[k])+'\u003c/td>';}).join('')+\n      '\u003ctd>\u003cspan class=\"pill '+statusPill(status)+'\">'+STATUS_LBL(status)+'\u003c/span>\u003c/td>\u003c/tr>';}).join('');\n}\nfunction seedResolvedRows(){\n  if(!DEMO_SEED)return '';\n  return SEED_BREAKS.map(function(b){\n    return '\u003ctr class=\"seed\">\u003ctd class=\"txid\">'+b.id+'\u003c/td>\u003ctd>'+b.source+'\u003c/td>\u003ctd class=\"mono\">'+money(b.variance)+'\u003c/td>'+\n      '\u003ctd style=\"font-size:11.5px\">'+b.label+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+b.by+'\u003c/td>\u003ctd class=\"mono\">'+b.at.slice(7)+'\u003c/td>\u003c/tr>';}).join('');\n}\nfunction resolvedMini(){\n  if(!DEMO_SEED)return '';\n  return '\u003cdiv class=\"resolved-mini\">\u003cdiv class=\"h\">RECENTLY RESOLVED (LAST 7 DAYS)\u003c/div>'+SEED_BREAKS.map(function(b){\n    return '\u003cdiv class=\"r\">\u003cspan class=\"pill ok\">Resolved\u003c/span>\u003cspan class=\"id\">'+b.id+'\u003c/span>\u003cspan class=\"w\">'+b.source+' &middot; '+b.label+'\u003c/span>\u003cspan class=\"t\">'+b.at.slice(0,6)+'\u003c/span>\u003c/div>';}).join('')+'\u003c/div>';\n}\nfunction reconRuns(){\n  if(!DEMO_SEED)return '';\n  return '\u003cdiv class=\"runs\">\u003cspan>Last run \u003cb>10:24:18\u003c/b>\u003c/span>\u003cspan>Result \u003cb style=\"color:var(--green)\">All control points matched\u003c/b>\u003c/span>'+\n    '\u003cspan style=\"margin-left:auto\">Last 7 daily runs\u003c/span>\u003cspan class=\"dots\">\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003c/span>\u003c/div>';\n}\n\n/* ============ INTERACTIVE CHARTS (presentation only) ============\n   Pure inline SVG/HTML, no external library, so the file still works offline.\n   Charts blend the sample history with live demo data and only read state; they never change it.\n   UI choices (range, metric, hidden series) live in CHUI so they survive the control center re-rendering. */\nconst CHUI={};            /* per-chart UI state */\nconst CCACHE={};          /* geometry cache used by the hover handlers */\nconst CH_COL={blue:'#2563eb',teal:'#0e7490',green:'#15803d',orange:'#c2410c',violet:'#6d5ce7',amber:'#d9822b',slate:'#a7b1c2',red:'#b91c1c'};\nconst CHM=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nconst CHD=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];\nconst CH_DAYS=10;\nfunction chui(id,def){if(!CHUI[id])CHUI[id]=Object.assign({hidden:{}},def||{});return CHUI[id];}\nfunction chAttr(s){return esc(s).replace(/\"/g,'&quot;');}\nfunction chFmt(n){\n  const a=Math.abs(n),s=n\u003c0?'-':'';\n  if(a>=1e6)return s+(a/1e6).toFixed(a>=1e7?1:2).replace(/\\.0+$|0+$/,'').replace(/\\.$/,'')+'M';\n  if(a>=1e3)return s+(a/1e3).toFixed(a>=1e5?0:1).replace(/\\.0$/,'')+'k';\n  return s+(Math.round(a*10)/10);\n}\nfunction chRng(seed){let a=0;String(seed).split('').forEach(function(c){a=(a*31+c.charCodeAt(0))>>>0;});\n  return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\n/* a smooth, slightly noisy growth curve of 'days' points that always ends exactly on 'end' */\nfunction chHist(key,end,days,start){\n  const r=chRng(key),o=[];let drift=0;\n  for(let i=0;i\u003cdays;i++){const t=i/(days-1),base=start+(1-start)*Math.pow(t,1.35);\n    drift=drift*.6+(r()-.5)*.05;o.push(end*Math.max(0.02,base*(1+drift*(1-t))));}\n  o[days-1]=end;return o;\n}\nfunction chScale(max){\n  if(!(max>0))return {max:1,ticks:[0,1]};\n  const raw=max/4,p=Math.pow(10,Math.floor(Math.log10(raw))),f=raw/p;\n  const step=(f\u003c=1?1:f\u003c=2?2:f\u003c=2.5?2.5:f\u003c=5?5:10)*p,top=Math.ceil(max/step-1e-9)*step,ticks=[];\n  for(let v=0;v\u003c=top+1e-9;v+=step)ticks.push(v);\n  return {max:top,ticks:ticks};\n}\nfunction chDateOf(daysAgo){return new Date(clock.getFullYear(),clock.getMonth(),clock.getDate()-daysAgo);}\nfunction chDateLbl(daysAgo){const d=chDateOf(daysAgo);return d.getDate()+' '+CHM[d.getMonth()];}\nfunction chDaysList(n){const out=[];for(let k=n-1;k>=0;k--){const d=chDateOf(k);\n  out.push({key:d.getDate()+' '+CHM[d.getMonth()],label:CHD[d.getDay()]+' '+d.getDate(),today:k===0});}return out;}\nfunction chParseDay(s){const m=/(\\d{1,2}) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/.exec(s||'');return m?(+m[1])+' '+m[2]:'';}\nfunction chNums(s){return (String(s).match(/[\\d,]+/g)||[]).map(function(x){return +x.replace(/,/g,'');});}\n/* ---- small UI pieces ---- */\nfunction chSeg(id,k,opts,cur){\n  return '\u003cdiv class=\"seg\">'+opts.map(function(o){return '\u003cbutton class=\"'+(o[0]===cur?'on':'')+'\" onclick=\"chartOpt(\\''+id+'\\',\\''+k+'\\',\\''+o[0]+'\\')\">'+o[1]+'\u003c/button>';}).join('')+'\u003c/div>';\n}\nfunction chLegend(id,items,ui){\n  return items.map(function(it){return '\u003cbutton class=\"lg'+(ui.hidden[it.key]?' off':'')+'\" onclick=\"chartToggle(\\''+id+'\\',\\''+it.key+'\\')\">\u003ci style=\"background:'+it.color+'\">\u003c/i>'+it.label+'\u003c/button>';}).join('');\n}\nfunction chTipRows(rows,total,fmt){\n  return rows.map(function(r){return '\u003cdiv class=\"r\">\u003cspan>\u003ci style=\"background:'+r.color+'\">\u003c/i>\u003cspan class=\"k\">'+r.label+'\u003c/span>\u003c/span>\u003cb>'+fmt(r.value)+'\u003c/b>\u003c/div>';}).join('')+\n    (total!==null&&rows.length>1?'\u003cdiv class=\"r\" style=\"border-top:1px solid #33435c;margin-top:3px;padding-top:3px\">\u003cspan class=\"k\">Total\u003c/span>\u003cb>'+fmt(total)+'\u003c/b>\u003c/div>':'');\n}\n/* ---- line / area chart with crosshair ---- */\nfunction chLine(id,spec,ui){\n  const W=480,H=214,L=50,R=14,T=12,B=26,pw=W-L-R,ph=H-T-B;\n  const days=({'7D':7,'30D':30,'90D':90})[ui.range]||30;\n  const vis=spec.series.filter(function(s){return !ui.hidden[s.key];});\n  const data=vis.map(function(s){return s.values.slice(-days);});\n  let mx=0;data.forEach(function(a){a.forEach(function(v){if(v>mx)mx=v;});});\n  const sc=chScale(mx*1.04),X=function(i){return L+i*pw/(days-1);},Y=function(v){return T+ph-(v/sc.max)*ph;};\n  let s='\u003csvg viewBox=\"0 0 '+W+' '+H+'\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\">';\n  s+='\u003cg class=\"ch-grid\">'+sc.ticks.map(function(t){return '\u003cline x1=\"'+L+'\" x2=\"'+(W-R)+'\" y1=\"'+Y(t).toFixed(1)+'\" y2=\"'+Y(t).toFixed(1)+'\"/>';}).join('')+'\u003c/g>';\n  const nx=Math.min(days,5),idx=[];for(let k=0;k\u003cnx;k++)idx.push(Math.round(k*(days-1)/(nx-1)));\n  s+='\u003cg class=\"ch-ax\">'+sc.ticks.map(function(t){return '\u003ctext x=\"'+(L-6)+'\" y=\"'+(Y(t)+3).toFixed(1)+'\" text-anchor=\"end\">'+chFmt(t)+'\u003c/text>';}).join('')+\n     idx.map(function(i,k){return '\u003ctext x=\"'+X(i).toFixed(1)+'\" y=\"'+(H-8)+'\" text-anchor=\"'+(k===0?'start':(k===nx-1?'end':'middle'))+'\">'+chDateLbl(days-1-i)+'\u003c/text>';}).join('')+'\u003c/g>';\n  const xs=[];for(let i=0;i\u003cdays;i++)xs.push(X(i));\n  vis.forEach(function(se,k){\n    const pts=data[k].map(function(v,i){return xs[i].toFixed(1)+' '+Y(v).toFixed(1);}),line='M'+pts.join(' L');\n    s+='\u003cpath d=\"'+line+' L'+xs[days-1].toFixed(1)+' '+(T+ph)+' L'+xs[0].toFixed(1)+' '+(T+ph)+' Z\" fill=\"'+se.color+'\" opacity=\".09\"/>';\n    s+='\u003cpath d=\"'+line+'\" fill=\"none\" stroke=\"'+se.color+'\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n    s+='\u003ccircle cx=\"'+xs[days-1].toFixed(1)+'\" cy=\"'+Y(data[k][days-1]).toFixed(1)+'\" r=\"4\" fill=\"#fff\" stroke=\"'+se.color+'\" stroke-width=\"2\"/>';\n  });\n  s+='\u003cline class=\"ch-vl\" y1=\"'+T+'\" y2=\"'+(T+ph)+'\" stroke=\"#94a3b8\" stroke-dasharray=\"3 3\" style=\"display:none\"/>';\n  vis.forEach(function(se,k){s+='\u003ccircle class=\"ch-dot\" data-k=\"'+k+'\" r=\"4.5\" fill=\"'+se.color+'\" stroke=\"#fff\" stroke-width=\"2\" style=\"display:none\"/>';});\n  s+='\u003crect class=\"ch-hit\" data-ch=\"'+id+'\" x=\"'+L+'\" y=\"'+T+'\" width=\"'+pw+'\" height=\"'+ph+'\" fill=\"transparent\"/>\u003c/svg>';\n  CCACHE[id]={W:W,L:L,pw:pw,days:days,xs:xs,ys:data.map(function(a){return a.map(Y);}),\n    series:vis.map(function(se,k){return {label:se.label,color:se.color,vals:data[k]};}),fmt:spec.fmt};\n  return s;\n}\n/* ---- stacked column chart ---- */\nfunction chBars(id,spec,ui){\n  const W=480,H=214,L=50,R=10,T=12,B=26,pw=W-L-R,ph=H-T-B,n=spec.days.length;\n  const segs=spec.segs.filter(function(g){return !ui.hidden[g.key];});\n  const tot=spec.days.map(function(d){return segs.reduce(function(a,g){return a+(d.vals[g.key]||0);},0);});\n  const sc=chScale(Math.max.apply(null,tot.concat([0]))*1.05),bw=pw/n,gap=Math.min(10,bw*.3),w=bw-gap;\n  let s='\u003csvg viewBox=\"0 0 '+W+' '+H+'\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\">';\n  s+='\u003cg class=\"ch-grid\">'+sc.ticks.map(function(t){const y=T+ph-(t/sc.max)*ph;return '\u003cline x1=\"'+L+'\" x2=\"'+(W-R)+'\" y1=\"'+y.toFixed(1)+'\" y2=\"'+y.toFixed(1)+'\"/>';}).join('')+'\u003c/g>';\n  s+='\u003cg class=\"ch-ax\">'+sc.ticks.map(function(t){const y=T+ph-(t/sc.max)*ph;return '\u003ctext x=\"'+(L-6)+'\" y=\"'+(y+3).toFixed(1)+'\" text-anchor=\"end\">'+chFmt(t)+'\u003c/text>';}).join('')+'\u003c/g>';\n  spec.days.forEach(function(d,i){\n    const x=L+i*bw+gap/2,rows=segs.map(function(g){return {label:g.label,color:g.color,value:d.vals[g.key]||0};}).filter(function(r){return r.value>0;});\n    const tip='\u003cb>'+d.full+(d.today?' (today)':'')+'\u003c/b>'+(rows.length?chTipRows(rows,tot[i],spec.fmt):'\u003cdiv class=\"k\">No activity\u003c/div>');\n    s+='\u003cg class=\"ch-col\" data-tip=\"'+chAttr(tip)+'\">\u003crect class=\"chov\" x=\"'+(L+i*bw).toFixed(1)+'\" y=\"'+T+'\" width=\"'+bw.toFixed(1)+'\" height=\"'+ph+'\" fill=\"transparent\"/>';\n    let y=T+ph;\n    segs.forEach(function(g){const v=d.vals[g.key]||0;if(v\u003c=0)return;const h=v/sc.max*ph;y-=h;\n      s+='\u003crect class=\"cbar\" x=\"'+x.toFixed(1)+'\" y=\"'+y.toFixed(1)+'\" width=\"'+w.toFixed(1)+'\" height=\"'+Math.max(1,h).toFixed(1)+'\" rx=\"2.5\" fill=\"'+g.color+'\"/>';});\n    s+='\u003c/g>\u003ctext class=\"ch-x'+(d.today?' today':'')+'\" x=\"'+(x+w/2).toFixed(1)+'\" y=\"'+(H-8)+'\" text-anchor=\"middle\">'+d.label+'\u003c/text>';\n  });\n  return s+'\u003c/svg>';\n}\n/* ---- donut ---- */\nfunction chDonut(id,spec,ui){\n  const segs=spec.segs.filter(function(g){return !ui.hidden[g.key]&&g.value>0;}),tot=segs.reduce(function(a,g){return a+g.value;},0);\n  const sf=spec.short||spec.fmt,r=52,C=2*Math.PI*r;let off=0,arcs='';\n  if(!tot)arcs='\u003ccircle cx=\"80\" cy=\"80\" r=\"'+r+'\" fill=\"none\" stroke=\"#eef0f4\" stroke-width=\"20\"/>';\n  segs.forEach(function(g){\n    const len=g.value/tot*C,gp=segs.length>1?2:0,pct=Math.round(g.value/tot*1000)/10;\n    arcs+='\u003ccircle class=\"dn-seg\" cx=\"80\" cy=\"80\" r=\"'+r+'\" fill=\"none\" stroke=\"'+g.color+'\" stroke-width=\"20\" stroke-dasharray=\"'+(len-gp).toFixed(2)+' '+(C-len+gp).toFixed(2)+'\" stroke-dashoffset=\"'+(-off).toFixed(2)+'\" transform=\"rotate(-90 80 80)\" '+\n      'data-tip=\"'+chAttr('\u003cb>'+g.label+'\u003c/b>\u003cdiv class=\"r\">\u003cspan class=\"k\">'+spec.unit+'\u003c/span>\u003cb>'+spec.fmt(g.value)+'\u003c/b>\u003c/div>\u003cdiv class=\"r\">\u003cspan class=\"k\">Share\u003c/span>\u003cb>'+pct+'%\u003c/b>\u003c/div>')+'\" data-cv=\"'+chAttr(sf(g.value))+'\" data-cl=\"'+chAttr(g.label)+'\"/>';\n    off+=len;});\n  const svg='\u003csvg viewBox=\"0 0 160 160\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\" data-cv=\"'+chAttr(sf(tot))+'\" data-cl=\"'+chAttr(spec.center)+'\">'+arcs+\n    '\u003ctext class=\"dn-cv\" x=\"80\" y=\"82\" text-anchor=\"middle\">'+sf(tot)+'\u003c/text>\u003ctext class=\"dn-cl\" x=\"80\" y=\"97\" text-anchor=\"middle\">'+spec.center+'\u003c/text>\u003c/svg>';\n  const all=spec.segs.reduce(function(a,g){return a+g.value;},0);\n  const leg='\u003cdiv class=\"dn-leg\">'+spec.segs.map(function(g){\n    return '\u003cbutton class=\"r'+(ui.hidden[g.key]?' off':'')+'\" onclick=\"chartToggle(\\''+id+'\\',\\''+g.key+'\\')\">\u003ci style=\"background:'+g.color+'\">\u003c/i>\u003cspan>'+g.label+'\u003c/span>\u003cb>'+sf(g.value)+'\u003c/b>\u003cem>'+(all?Math.round(g.value/all*100):0)+'%\u003c/em>\u003c/button>';}).join('')+'\u003c/div>';\n  return '\u003cdiv class=\"dn-wrap\">'+svg+leg+'\u003c/div>';\n}\n/* ---- horizontal bars ---- */\nfunction chHBars(id,spec,ui){\n  const rows=spec.rows.map(function(r){const parts=r.parts.filter(function(p){return !ui.hidden[p.key];});\n    return {label:r.label,parts:parts,total:parts.reduce(function(a,p){return a+p.value;},0),note:r.note||''};});\n  const mx=Math.max.apply(null,rows.map(function(r){return r.total;}).concat([1]));\n  return rows.map(function(r){\n    const tip='\u003cb>'+r.label+'\u003c/b>'+chTipRows(r.parts.filter(function(p){return p.value>0;}),r.total,spec.fmt)+(r.note?'\u003cdiv class=\"k\" style=\"margin-top:3px\">'+r.note+'\u003c/div>':'');\n    return '\u003cdiv class=\"hb\" data-tip=\"'+chAttr(tip)+'\">\u003cspan class=\"l\">'+r.label+'\u003c/span>\u003cdiv class=\"tr\">'+\n      r.parts.map(function(p){return '\u003ci style=\"width:'+(p.value/mx*100).toFixed(2)+'%;background:'+p.color+'\">\u003c/i>';}).join('')+'\u003c/div>\u003cspan class=\"v\">'+(spec.short||spec.fmt)(r.total)+'\u003c/span>\u003c/div>';}).join('');\n}\n/* ---- cards ---- */\nfunction chCardInner(d){\n  const ui=chui(d.id,d.ui),b=d.build(ui);\n  return '\u003cdiv class=\"chh\">\u003cdiv>\u003cdiv class=\"cht\">'+b.title+'\u003c/div>\u003cdiv class=\"chs\">'+b.sub+'\u003c/div>\u003c/div>\u003cdiv class=\"chc\">'+(b.controls||'')+'\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"chb\">'+b.body+'\u003c/div>'+(b.legend?'\u003cdiv class=\"chl\">'+b.legend+'\u003c/div>':'');\n}\nfunction chartsHtml(){\n  if(typeof DEMO_SEED!=='undefined'&&!DEMO_SEED)return '';\n  return '\u003cdiv class=\"sec-h\">\u003ch3>Trends &amp; Analytics\u003c/h3>\u003cdiv class=\"i\" title=\"Sample history plus live demo data. Hover for details, use the toggles to change the view.\">i\u003c/div>'+\n    '\u003cspan class=\"chnote\">Hover for details &middot; click a legend item to show or hide it\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"chgrid\">'+chartDefs().map(function(d){return '\u003cdiv class=\"chcard\" id=\"ch-'+d.id+'\">'+chCardInner(d)+'\u003c/div>';}).join('')+'\u003c/div>';\n}\nfunction chartRefresh(id){const d=chartDefs().find(function(x){return x.id===id;}),el=document.getElementById('ch-'+id);if(d&&el)el.innerHTML=chCardInner(d);}\nfunction chartOpt(id,k,v){chui(id)[k]=v;chartRefresh(id);}\nfunction chartToggle(id,key){\n  const d=chartDefs().find(function(x){return x.id===id;});if(!d)return;const ui=chui(id,d.ui),keys=d.build(ui).keys||[];\n  if(!ui.hidden[key]&&keys.filter(function(k){return !ui.hidden[k];}).length\u003c=1)return;   /* always keep one visible */\n  ui.hidden[key]=!ui.hidden[key];chartRefresh(id);\n}\n/* ---- one delegated hover layer for every chart (tooltip, crosshair, donut centre) ---- */\n(function chInit(){\n  const tip=document.createElement('div');tip.className='ctip';tip.style.display='none';document.body.appendChild(tip);\n  let lastSvg=null,lastDn=null;\n  function place(x,y){const w=tip.offsetWidth,h=tip.offsetHeight;let l=x+14,t=y+14;\n    if(l+w>window.innerWidth-6)l=x-w-14;if(t+h>window.innerHeight-6)t=y-h-14;tip.style.left=Math.max(4,l)+'px';tip.style.top=Math.max(4,t)+'px';}\n  function show(html,x,y){tip.innerHTML=html;tip.style.display='block';place(x,y);}\n  function clearLine(){if(lastSvg){const vl=lastSvg.querySelector('.ch-vl');if(vl)vl.style.display='none';\n    lastSvg.querySelectorAll('.ch-dot').forEach(function(d){d.style.display='none';});lastSvg=null;}}\n  function clearDn(){if(lastDn){const cv=lastDn.querySelector('.dn-cv'),cl=lastDn.querySelector('.dn-cl');\n    if(cv)cv.textContent=lastDn.getAttribute('data-cv');if(cl)cl.textContent=lastDn.getAttribute('data-cl');lastDn=null;}}\n  function hoverLine(hit,e){\n    const c=CCACHE[hit.getAttribute('data-ch')],svg=hit.ownerSVGElement;if(!c||!svg)return;\n    const r=svg.getBoundingClientRect();if(!r.width)return;\n    const x=(e.clientX-r.left)*(c.W/r.width);let i=Math.round((x-c.L)/c.pw*(c.days-1));i=Math.max(0,Math.min(c.days-1,i));\n    if(lastSvg&&lastSvg!==svg)clearLine();lastSvg=svg;\n    const vl=svg.querySelector('.ch-vl');vl.setAttribute('x1',c.xs[i]);vl.setAttribute('x2',c.xs[i]);vl.style.display='';\n    svg.querySelectorAll('.ch-dot').forEach(function(d){const k=+d.getAttribute('data-k');d.setAttribute('cx',c.xs[i]);d.setAttribute('cy',c.ys[k][i]);d.style.display='';});\n    const rows=c.series.map(function(s){return {label:s.label,color:s.color,value:s.vals[i]};});\n    show('\u003cb>'+chDateLbl(c.days-1-i)+(i===c.days-1?' (today, live)':'')+'\u003c/b>'+chTipRows(rows,null,c.fmt),e.clientX,e.clientY);\n  }\n  document.addEventListener('mousemove',function(e){\n    const el=e.target&&e.target.closest?e.target:null;if(!el){return;}\n    const hit=el.closest('.ch-hit');\n    if(hit){clearDn();hoverLine(hit,e);return;}\n    clearLine();\n    const t=el.closest('[data-tip]');\n    if(t){show(t.getAttribute('data-tip'),e.clientX,e.clientY);\n      if(t.hasAttribute('data-cv')&&t.ownerSVGElement){const svg=t.ownerSVGElement;if(lastDn&&lastDn!==svg)clearDn();lastDn=svg;\n        svg.querySelector('.dn-cv').textContent=t.getAttribute('data-cv');svg.querySelector('.dn-cl').textContent=t.getAttribute('data-cl');}\n      else clearDn();\n      return;}\n    clearDn();tip.style.display='none';\n  });\n  document.documentElement.addEventListener('mouseleave',function(){clearLine();clearDn();tip.style.display='none';});\n  document.addEventListener('scroll',function(){tip.style.display='none';},true);\n})();\n/* live API calls per external system (internal actors are skipped) */\nfunction chSystems(){\n  const m={};S.events.forEach(function(e){[e.from,e.to].forEach(function(n){\n    if(!n||/^(SI\\b|CUSTOMER|CORPORATE|TREASURY|OPS|RECONCILIATION|MAKER|CHECKER|HLB MOBILE)/.test(n))return;m[n]=(m[n]||0)+1;});});\n  return m;\n}\n\n/* ---- Case 1 chart data: sample plans + live plans ---- */\nfunction chDone(c){return ['LOCKED','CONFIRMED','FUNDED','CREATED','RELEASED','SETTLED','POSTED','PAID'].indexOf(c)>=0;}\nconst CH_CAT={done:{label:'Completed',color:CH_COL.green},esc:{label:'Awaiting milestone',color:CH_COL.blue},prog:{label:'In progress',color:CH_COL.amber},bad:{label:'Exception or hold',color:CH_COL.red}};\nfunction chLiveCat(s){return s==='COMPLETED'?'done':(s==='AWAITING_MILESTONE'?'esc':((s==='EXCEPTION'||s==='ON_HOLD')?'bad':'prog'));}\nfunction chPlanRows(){\n  const rows=[];\n  SEED_PLANS.forEach(function(s){const stg={};STAGES.forEach(function(k){stg[k]=chDone(SEED_STAGES[s.kind][k])?s.sgd:0;});\n    rows.push({day:chParseDay(s.when),sgd:s.sgd,cat:s.kind==='DONE'?'done':'esc',live:false,stg:stg});});\n  S.plans.forEach(function(p){if(p.status==='REJECTED')return;const stg={};\n    STAGES.forEach(function(k){stg[k]=PLAN_STAGES.indexOf(k)>=0?(chDone(p.st[k])?p.sgd:0):p.legs.reduce(function(a,l){return a+(chDone(l.st[k])?l.sgd:0);},0);});\n    rows.push({day:chParseDay(p.submitted),sgd:p.sgd,cat:chLiveCat(p.status),live:true,stg:stg});});\n  return rows;\n}\nfunction chTrendSpec(P){\n  const B=BASE1,n=90,mint=chHist('uc1-mint',B.tsgdMinted,n,.12),burn=chHist('uc1-burn',B.tsgdBurned,n,.02);\n  const minted=mint.slice(),out=mint.map(function(v,i){return Math.max(0,v-burn[i]);});\n  minted[n-1]=P.tsgdMinted;out[n-1]=P.tsgdOut;\n  return {aria:'tSGD minted and outstanding over time',fmt:function(v){return money(v,0)+' tSGD';},series:[\n    {key:'minted',label:'tSGD minted (cumulative)',color:CH_COL.blue,values:minted},\n    {key:'out',label:'tSGD outstanding',color:CH_COL.teal,values:out}]};\n}\nfunction chartDefs(){\n  const P=dpos(),rows=chPlanRows();\n  const catSegs=Object.keys(CH_CAT).map(function(k){return {key:k,label:CH_CAT[k].label,color:CH_CAT[k].color};});\n  return [\n   {id:'trend',ui:{range:'30D'},build:function(ui){const sp=chTrendSpec(P);\n     return {title:'tSGD minted vs outstanding',sub:'Cumulative position: sample history, today is live',\n       controls:chSeg('trend','range',[['7D','7D'],['30D','30D'],['90D','90D']],ui.range),body:chLine('trend',sp,ui),\n       legend:chLegend('trend',sp.series,ui),keys:sp.series.map(function(s){return s.key;})};}},\n   {id:'days',ui:{metric:'sgd'},build:function(ui){\n     const m=ui.metric,val=function(r){return m==='plans'?1:(m==='myr'?r.sgd*FX:r.sgd);};\n     const days=chDaysList(CH_DAYS).map(function(d){const vals={};rows.forEach(function(r){if(r.day===d.key)vals[r.cat]=(vals[r.cat]||0)+val(r);});\n       return {label:d.label,full:d.key,today:d.today,vals:vals};});\n     const fmt=m==='plans'?function(v){return v+(v===1?' plan':' plans');}:function(v){return money(v,0)+(m==='myr'?' MYR':' SGD');};\n     const sp={aria:'Plans created per day',days:days,segs:catSegs,fmt:fmt};\n     return {title:'Plans by day',sub:'Last '+CH_DAYS+' days, coloured by plan status',\n       controls:chSeg('days','metric',[['plans','Plans'],['sgd','SGD'],['myr','MYR']],m),body:chBars('days',sp,ui),\n       legend:chLegend('days',catSegs,ui),keys:catSegs.map(function(s){return s.key;})};}},\n   {id:'donut',ui:{metric:'sgd'},build:function(ui){\n     const m=ui.metric,segs=catSegs.map(function(g){return Object.assign({},g,{value:rows.filter(function(r){return r.cat===g.key;}).reduce(function(a,r){return a+(m==='plans'?1:r.sgd);},0)});});\n     const sp={aria:'Plan status mix',segs:segs,unit:m==='plans'?'Plans':'SGD',center:m==='plans'?'plans':'SGD',\n       fmt:m==='plans'?function(v){return String(v);}:function(v){return money(v,0)+' SGD';},short:m==='plans'?function(v){return String(v);}:chFmt};\n     return {title:'Plan status mix',sub:'Share of all plans, sample and live',\n       controls:chSeg('donut','metric',[['sgd','SGD'],['plans','Plans']],m),body:chDonut('donut',sp,ui),legend:'',keys:segs.map(function(s){return s.key;})};}},\n   {id:'funnel',ui:{},build:function(ui){\n     const lockedAll=rows.reduce(function(a,r){return a+r.stg.fiatLock;},0),parts=[{key:'sample',label:'Sample plans',color:CH_COL.slate},{key:'live',label:'This demo',color:CH_COL.blue}];\n     const rws=STAGES.map(function(k){const a=rows.filter(function(r){return !r.live;}).reduce(function(s,r){return s+r.stg[k];},0),b=rows.filter(function(r){return r.live;}).reduce(function(s,r){return s+r.stg[k];},0);\n       return {label:STAGE_LBL[k],note:lockedAll?'Reached by '+Math.round((a+b)/lockedAll*100)+'% of all locked SGD':'',\n         parts:[Object.assign({},parts[0],{value:a}),Object.assign({},parts[1],{value:b})]};});\n     const sp={rows:rws,fmt:function(v){return money(v,0)+' SGD';},short:chFmt};\n     return {title:'SGD through each stage',sub:'How far the value has travelled, from lock to payout',body:chHBars('funnel',sp,ui),\n       legend:chLegend('funnel',parts,ui),keys:['sample','live']};}}\n  ];\n}\n/* ============ CORPORATE PORTAL (customer pane) ============ */\nfunction buildCustomerShell(){\n  const ms=MILESTONES.map(function(a,i){\n    return '\u003cdiv class=\"rvr\">\u003cspan class=\"k\">Milestone '+(i+1)+'\u003c/span>\u003cspan class=\"v\">'+sgd(a)+' &rarr; '+myr(a*FX)+'\u003c/span>\u003c/div>';}).join('');\n  document.getElementById('paneCustomer').innerHTML=\n  '\u003cdiv class=\"cust-wrap\">\u003cdiv class=\"appcol\">\u003cdiv class=\"phone\">'+\n   '\u003cdiv class=\"aph\">\u003cdiv class=\"logo\">'+logoHtml()+'\u003c/div>\u003cdiv>&#128276;&nbsp;&nbsp;&#128100;\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-home\" class=\"view on\">'+\n     '\u003cdiv style=\"font-size:12.5px;color:var(--muted)\">Welcome back,\u003c/div>'+\n     '\u003cdiv style=\"font-size:18px;font-weight:800;margin-bottom:14px\">Guocoland Treasury\u003c/div>'+\n     '\u003cdiv class=\"balcard\">\u003cdiv class=\"l\">AVAILABLE BALANCE\u003c/div>\u003cdiv class=\"a\" id=\"cBal\">SGD 1,500,000.00\u003c/div>\u003cdiv class=\"c\">Current &middot; XXXXXX2210\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"qa\">\u003cbutton class=\"qab p\" onclick=\"cGo(\\'plan\\')\">\u003cspan class=\"i\">&#129534;\u003c/span>New Milestone Payment\u003c/button>'+\n       '\u003cbutton class=\"qab\">\u003cspan class=\"i\">&#128184;\u003c/span>Payments\u003c/button>'+\n       '\u003cbutton class=\"qab\" onclick=\"cGo(\\'track\\')\">\u003cspan class=\"i\">&#128274;\u003c/span>Escrow Plans\u003c/button>'+\n       '\u003cbutton class=\"qab\">\u003cspan class=\"i\">&#8943;\u003c/span>More\u003c/button>\u003c/div>'+\n     '\u003cdiv style=\"font-size:10.5px;font-weight:700;color:var(--muted);margin-bottom:9px\">RECENT ACTIVITY\u003c/div>'+\n     '\u003cdiv id=\"cRecent\">\u003c/div>'+\n   '\u003c/div>'+\n   '\u003cdiv id=\"cv-plan\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'home\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">New Milestone Payment\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">SUPPLIER\u003c/div>\u003cdiv class=\"rcp\">\u003cdiv class=\"av\">BM\u003c/div>\u003cdiv>\u003cdiv class=\"n\">Supplier account\u003c/div>\u003cdiv class=\"s\">Bank MY &middot; MYR\u003c/div>\u003c/div>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">YOU LOCK\u003c/div>'+\n       '\u003cdiv style=\"display:flex;align-items:baseline;gap:8px\">\u003cspan style=\"font-size:12px;color:var(--muted);font-weight:700\">SGD\u003c/span>'+\n       '\u003cdiv class=\"amtin\">'+money(PLAN_SGD,0)+'\u003c/div>\u003c/div>'+\n       '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Supplier receives\u003c/span>\u003cb>'+myr(PLAN_SGD*FX)+'\u003c/b>\u003c/div>'+\n       '\u003cdiv class=\"fxn\">Rate 1 SGD = 3.30 MYR &middot; Demo amounts are fixed\u003cbr>\u003cspan id=\"cApprNote\">\u003c/span>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">RELEASED IN 3 MILESTONES\u003c/div>\u003cdiv class=\"rvc\" style=\"background:transparent;padding:0;margin:0\">'+ms+'\u003c/div>\u003c/div>'+\n     '\u003cbutton class=\"pbtn\" id=\"cReviewBtn\" onclick=\"cGo(\\'review\\')\">Review Plan\u003c/button>\u003c/div>'+\n   '\u003cdiv id=\"cv-review\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'plan\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">Review Plan\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"eta\">&#128274; Funds are locked now and paid out as milestones complete\u003c/div>'+\n     '\u003cdiv class=\"rvc\" id=\"cReview\">\u003c/div>'+\n     '\u003cbutton class=\"pbtn\" onclick=\"cGo(\\'auth\\')\">Confirm &amp; Lock Funds\u003c/button>'+\n     '\u003cbutton class=\"gbtn\" onclick=\"cGo(\\'plan\\')\">Edit Plan\u003c/button>\u003c/div>'+\n   '\u003cdiv id=\"cv-auth\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'review\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">Authorize\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"pinw\">\u003cdiv style=\"font-size:12.5px;color:var(--muted)\">Enter your 6-digit PIN to authorize\u003c/div>'+\n     '\u003cdiv class=\"pind\" id=\"cPin\">\u003c/div>\u003cdiv class=\"kp\" id=\"cKp\">\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-track\" class=\"view\">'+\n     '\u003cdiv style=\"font-size:16px;font-weight:800;margin-bottom:14px\">Plan Status\u003c/div>'+\n     '\u003cdiv class=\"trs\">\u003cdiv class=\"cp\" id=\"cCap\">\u003c/div>\u003cdiv class=\"rf\" id=\"cRef\">\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cTrack\">\u003c/div>\u003cdiv id=\"cGate\">\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-done\" class=\"view\">'+\n     '\u003cdiv class=\"dicon\">&#10003;\u003c/div>'+\n     '\u003cdiv style=\"text-align:center;font-size:17px;font-weight:800\">Plan Complete\u003c/div>'+\n     '\u003cdiv style=\"text-align:center;font-size:12px;color:var(--muted);margin-bottom:18px\" id=\"cDoneSub\">\u003c/div>'+\n     '\u003cdiv class=\"rvc\" id=\"cDone\">\u003c/div>'+\n     '\u003cbutton class=\"pbtn\" onclick=\"setMode(\\'dash\\')\">View in Control Center\u003c/button>'+\n     '\u003cbutton class=\"gbtn\" onclick=\"cReset()\">New Milestone Payment\u003c/button>\u003c/div>'+\n  '\u003c/div>\u003c/div>'+ inspectorHtml() +'\u003c/div>';\n}\nfunction inspectorHtml(){\n  return '\u003cdiv class=\"inspcol\">'+\n   '\u003cdiv class=\"ipanel ev-panel\">\u003cdiv class=\"iph\">&#128225; Event Stream\u003cspan class=\"n\" id=\"iEvN\">0\u003c/span>\u003c/div>'+showcaseRowHtml()+'\u003cdiv class=\"ipb\" id=\"iEvents\">\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"detail-col\">'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#8593; Request\u003c/div>\u003cdiv class=\"ipb\">\u003cpre id=\"iReq\">Select an event.\u003c/pre>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#8595; Response\u003c/div>\u003cdiv class=\"ipb\">\u003cpre id=\"iRes\">\u003c/pre>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#9776; Headers &amp; Plan Details\u003c/div>\u003cdiv class=\"ipb\">\u003cdiv class=\"rr\">'+\n       '\u003cpre id=\"iHdr\">\u003c/pre>\u003cdiv class=\"kv\" id=\"iTx\" style=\"align-content:start\">\u003c/div>\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003c/div>'+\n  '\u003c/div>';\n}\n/* ============ INTEGRATION SHOWCASE (inside the Event Stream panel) ============\n   Lets a presenter demonstrate mint / burn / GL update / core banking / app-request auth on demand,\n   with full mTLS + OAuth2 detail, without first running a milestone plan to completion. A real plan's\n   own events still stream in normally below and carry the same Inspect integration button. */\nfunction showcaseRowHtml(){\n  return '\u003cdiv class=\"sc-row\">'+\n   '\u003cbutton class=\"scchip\" title=\"Corporate portal &rarr; SI auth\" onclick=\"showcase(\\'APPAUTH\\')\">&#128241; App Request\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Liminal issuance (tSGD)\" onclick=\"showcase(\\'MINT\\')\">&#129689; Mint\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Liminal redemption (tMYR)\" onclick=\"showcase(\\'BURN\\')\">&#128293; Burn\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Core (MY) GL posting\" onclick=\"showcase(\\'LEDGER\\')\">&#128209; Ledger\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"Core (SG) &rarr; SI auth\" onclick=\"showcase(\\'COREBANK\\')\">&#127974; Core Bank\u003c/button>'+\n  '\u003c/div>';\n}\nfunction showcaseSamples(){\n  return {\n    APPAUTH:['CORPORATE PORTAL','SI','POST /si/plans','SUCCESS','json',\n      {planId:'DEMO-PLAN',payer:'Guocoland',payerBank:'HLB Singapore',beneficiary:'Supplier account',beneficiaryBank:'Bank MY',\n       amount:PLAN_SGD,currency:'SGD',milestones:MILESTONES,fxRate:FX,destinationAmount:PLAN_SGD*FX,destinationCurrency:'MYR'},\n      {event:'si.plan.created',planId:'DEMO-PLAN',state:'INITIATED'}],\n    MINT:['SI','LIMINAL','POST /liminal/digital-assets/mint','SUCCESS','json',\n      {transactionId:'DEMO-MINT',asset:'tSGD',amount:String(PLAN_SGD),wallet:ADDR.guoco,org:'HLB Singapore',network:NETWORK,signingPolicy:'MPC 2-of-3'},\n      {liminalTransactionId:'LIM-M-DEMO-MINT',status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED',approvals:['policy-engine','risk-engine']}],\n    BURN:['SI','LIMINAL','POST /liminal/digital-assets/burn','SUCCESS','json',\n      {transactionId:'DEMO-BURN-L1',asset:'tMYR',amount:String(Math.round(PLAN_SGD*FX/3)),wallet:ADDR.hlbmy,org:'HLB Malaysia Cross Border'},\n      {liminalTransactionId:'LIM-B-DEMO-BURN-L1',status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'}],\n    LEDGER:['SI','CORE (MY)','POST /core/gl/postings','SUCCESS','json',\n      {transactionId:'DEMO-BURN-L1',swapIndex:1,burnHash:'0xDEMO',\n       entries:[{account:'TMYR_CONTROL',dc:'DEBIT',amount:Math.round(PLAN_SGD*FX/3),ccy:'MYR'},{account:'HLBMY_SETTLEMENT',dc:'CREDIT',amount:Math.round(PLAN_SGD*FX/3),ccy:'MYR'}]},\n      {glReference:'GL-DEMO-BURN-L1',postingStatus:'POSTED',evidence:'ACCOUNTING_EVIDENCE_STORED'}],\n    COREBANK:['CORE (SG)','SI','EVENT core.fiat.locked','WEBHOOK','json','N/A - asynchronous event received from Core Banking (SG).',\n      {event:'core.fiat.locked',planId:'DEMO-PLAN',amount:PLAN_SGD,currency:'SGD',lockRef:'LCK-DEMO-PLAN',state:'FIAT_LOCKED'}]\n  };\n}\nfunction showcase(cat){\n  const s=showcaseSamples()[cat];if(!s)return;\n  const fake={id:'DEMO-'+cat+'-'+Math.floor(100+Math.random()*900)};\n  const ev=E(fake,s[0],s[1],s[2],s[3],s[4],s[5],s[6]);\n  renderInspector();if(S.mode!=='customer')renderDash();\n  openIntegrationDrawer(ev.id);\n}\nfunction cGo(v){\n  const ap=activePlan();\n  if(v==='plan'&&ap){toast('A plan is already in progress - showing its status');v='track';S.cust.planId=ap.id;}\n  if(v==='track'&&!curPlan()){toast('No plan yet - create a milestone payment first');return;}\n  if(v==='track'&&!S.cust.planId){S.cust.planId=curPlan().id;}\n  if(v==='review'||v==='auth'){\n    if(PLAN_SGD>availableBalance()){toast('Insufficient funds - available balance is '+sgd(availableBalance()));return;}\n  }\n  S.cust.view=v;if(v==='auth'){S.cust.pin=0;}renderCustomer();}\nfunction cPinPress(){ if(S.cust.pin>=6)return; S.cust.pin++; renderCustomer();\n  if(S.cust.pin===6){ setTimeout(function(){ startPlan(); },350); } }\nfunction cPinDel(){ if(S.cust.pin>0){S.cust.pin--;renderCustomer();} }\nfunction cReset(){ S.cust.view='home'; S.cust.pin=0; renderCustomer(); }\nfunction row(k,v){return '\u003cdiv class=\"rvr\">\u003cspan class=\"k\">'+k+'\u003c/span>\u003cspan class=\"v\">'+v+'\u003c/span>\u003c/div>';}\nfunction actRow(w,m,a,x){return '\u003cdiv style=\"display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0f1f4\">'+\n  '\u003cdiv>\u003cdiv style=\"font-weight:700;font-size:12.5px\">'+w+'\u003c/div>\u003cdiv style=\"font-size:10.5px;color:var(--muted)\">'+m+' '+x+'\u003c/div>\u003c/div>'+\n  '\u003cdiv style=\"font-weight:700;font-size:12.5px\">'+a+'\u003c/div>\u003c/div>';}\nconst GATE_STEP={M1:3,M2:4,M3:5,SWAP:6,BURN:6};\nfunction trackModel(p){\n  const L=p.legs, allPaid=L.every(function(l){return l.st.glPayout==='PAID';});\n  const steps=[\n    {t:'Plan activated',s:'Your milestone payment plan has been received.',d:true},\n    {t:'Funds locked',s:sgd(p.sgd)+' secured in your account.',d:p.st.fiatLock==='LOCKED'},\n    {t:'Payment secured in escrow',s:'Held on-chain until each milestone is completed.',d:p.st.escrow==='FUNDED'},\n    {t:'Milestone 1 released',s:sgd(L[0].sgd)+' released to the supplier\\'s bank.',d:L[0].st.disburse==='RELEASED'},\n    {t:'Milestone 2 released',s:sgd(L[1].sgd)+' released to the supplier\\'s bank.',d:L[1].st.disburse==='RELEASED'},\n    {t:'Milestone 3 released',s:sgd(L[2].sgd)+' released to the supplier\\'s bank.',d:L[2].st.disburse==='RELEASED'},\n    {t:'Converted and paid',s:'Converted to MYR and paid to the supplier at Bank MY.',d:allPaid}];\n  let cur=steps.length;for(let i=0;i\u003csteps.length;i++){if(!steps[i].d){cur=i;break;}}\n  return {steps:steps,cur:cur};\n}\nfunction renderCustomer(){\n  ['home','plan','review','auth','track','done'].forEach(function(v){\n    const el=document.getElementById('cv-'+v); if(el) el.classList.toggle('on', S.cust.view===v);\n  });\n  const kp=document.getElementById('cKp');\n  if(kp&&!kp._b){kp._b=1;const keys=['1','2','3','4','5','6','7','8','9','','0','DEL'];\n    kp.innerHTML=keys.map(function(k){ if(k==='')return '\u003cdiv>\u003c/div>';\n      if(k==='DEL')return '\u003cbutton onclick=\"cPinDel()\" style=\"font-size:12px\">&#9003;\u003c/button>';\n      return '\u003cbutton onclick=\"cPinPress()\">'+k+'\u003c/button>';}).join('');}\n  const pd=document.getElementById('cPin');\n  if(pd)pd.innerHTML=[0,1,2,3,4,5].map(function(i){return '\u003cdiv class=\"pdot'+(i\u003cS.cust.pin?' f':'')+'\">\u003c/div>';}).join('');\n  const an=document.getElementById('cApprNote');\n  if(an){\n    const avail=availableBalance(), short=PLAN_SGD>avail;\n    if(short)an.innerHTML='\u003cb style=\"color:var(--red)\">Insufficient funds. Available balance is '+sgd(avail)+'.\u003c/b>';\n    else if(S.flags.makerChecker)an.innerHTML='\u003cb style=\"color:var(--amber)\">This plan requires treasury approval before funds are locked.\u003c/b>';\n    else an.innerHTML='\u003cspan style=\"color:var(--muted)\">Available balance '+sgd(avail)+'\u003c/span>';\n    const rb=document.getElementById('cReviewBtn');if(rb)rb.disabled=short;\n  }\n  const rv=document.getElementById('cReview');\n  if(rv){rv.innerHTML=row('Payer','Guocoland Treasury (HLB Singapore)')+row('Supplier','Supplier account, Bank MY')+\n    row('Funds to lock',sgd(PLAN_SGD))+MILESTONES.map(function(a,i){return row('Milestone '+(i+1),sgd(a)+' &rarr; '+myr(a*FX));}).join('')+\n    row('Exchange rate','1 SGD = 3.30 MYR')+row('Supplier receives',myr(PLAN_SGD*FX));}\n  const p=S.cust.planId?planById(S.cust.planId):null;\n  const tr=document.getElementById('cTrack');\n  if(tr&&p){\n    const M=trackModel(p);\n    const gi=p.awaiting?GATE_STEP[p.awaiting.key]:-1;\n    tr.innerHTML=M.steps.map(function(s,i){\n      let cls='pending'; if(i\u003cM.cur)cls='dn'; else if(i===M.cur)cls=(gi===i||p.status==='ON_HOLD'||p.status==='EXCEPTION')?'hl':'cu';\n      const mk=(i\u003cM.cur)?'&#10003;':String(i+1);\n      let extra='';\n      if(p.awaiting&&gi===i){\n        if(p.awaiting.key.charAt(0)==='M')extra='\u003cdiv style=\"margin-top:7px\">\u003cbutton class=\"sm pri\" onclick=\"releaseGate()\">Mark milestone complete\u003c/button>\u003c/div>';\n        else extra='\u003cdiv class=\"ts\" style=\"color:var(--amber);margin-top:3px\">Waiting for the bank to run this step.\u003c/div>';\n      }\n      return '\u003cdiv class=\"tstep '+cls+'\">\u003cdiv class=\"tdc\">\u003cdiv class=\"tdot\">'+mk+'\u003c/div>'+\n        (i\u003cM.steps.length-1?'\u003cdiv class=\"tln\">\u003c/div>':'')+'\u003c/div>\u003cdiv>\u003cdiv class=\"tt\">'+s.t+'\u003c/div>\u003cdiv class=\"ts\">'+s.s+'\u003c/div>'+extra+'\u003c/div>\u003c/div>';\n    }).join('');\n  }\n  const cap=document.getElementById('cCap'); if(cap)cap.textContent=S.cust.caption||'';\n  const rf=document.getElementById('cRef'); if(rf)rf.textContent=p?p.id:'';\n  const gt=document.getElementById('cGate');\n  if(gt){let g='';\n    if(p&&p.status==='AWAITING_APPROVAL')g='Your plan needs an additional bank approval. Our treasury team is reviewing it now.';\n    else if(p&&p.status==='REJECTED')g='Your plan could not be completed and was declined by the bank. No funds were locked.';\n    else if(p&&p.status==='ON_HOLD')g='Your plan is temporarily on hold at the bank. Our operations team is on it.';\n    else if(p&&p.status==='EXCEPTION'&&p.st.mint==='FAILED')g='We hit a delay issuing your secured payment. Our operations team is on it - your funds are safe and still locked.';\n    gt.innerHTML=g?('\u003cdiv class=\"warnnote\" style=\"margin-top:14px\">'+g+'\u003c/div>'):'';}\n  const dn=document.getElementById('cDone');\n  if(p&&dn){\n    dn.innerHTML=row('You locked',sgd(p.sgd))+row('Supplier received',myr(p.sgd*FX)+' in 3 payments')+row('Reference',p.id)+row('Completed',hhmmss(clock));\n    document.getElementById('cDoneSub').textContent='Reference '+p.id+' \\u00b7 Paid to the supplier at Bank MY';\n  }\n  const bal=document.getElementById('cBal'); if(bal)bal.textContent=sgd(availableBalance());\n  const rc=document.getElementById('cRecent');\n  if(rc){rc.innerHTML=S.plans.map(function(t){\n      const x=t.status==='COMPLETED'?'':(t.status==='REJECTED'?'(declined)':(t.status==='ON_HOLD'?'(on hold)':'(in progress)'));\n      return actRow('Milestone payment - Bank MY',t.submitted.slice(12),t.status==='REJECTED'?'-':'- '+sgd(t.sgd),x);}).join('')+\n      actRow('IRAS GST payment','Yesterday','- SGD 41,300.00','')+actRow('Client receipt - Marina Bay Ltd','3 days ago','+ SGD 250,000.00','');}\n  renderInspector();\n  renderRunner();\n}\n/* ============ PRESENTER RUNNER BAR ============ */\nfunction phaseState(p){\n  const L=p.legs;\n  return [p.st.escrow==='FUNDED',L.every(function(l){return l.st.disburse==='RELEASED';}),\n    L.every(function(l){return l.st.swap==='SETTLED';}),L.every(function(l){return l.st.glPayout==='PAID';})];\n}\nfunction renderRunner(){\n  const el=document.getElementById('runner');if(!el)return;\n  const p=curPlan();\n  const names=['1 Mint & lock','2 Milestones','3 Swap','4 Burn & payout'];\n  let flow,right;\n  const auto='\u003cbutton class=\"auto\" onclick=\"toggleFlag(\\'autoRun\\')\" title=\"When on, milestone, swap and burn steps run without waiting\">Auto-run: '+(S.flags.autoRun?'on':'off')+'\u003c/button>';\n  if(!p){\n    flow=names.map(function(n){return '\u003cspan class=\"n\">'+n+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n    right='\u003cspan style=\"color:var(--muted)\">No plan yet. Create one in the Corporate Portal to start.\u003c/span>';\n  } else {\n    const d=phaseState(p), cur=d.indexOf(false);\n    flow=names.map(function(n,i){const c=d[i]?'dn':(i===cur?'on':'');return '\u003cspan class=\"n '+c+'\">'+(d[i]?'&#10003; ':'')+n+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n    if(p.status==='COMPLETED')right='\u003cspan class=\"pill ok\">Plan complete\u003c/span> \u003cspan class=\"mono\">'+p.id+'\u003c/span>';\n    else if(p.status==='REJECTED')right='\u003cspan class=\"pill bad\">Plan rejected\u003c/span> \u003cspan class=\"mono\">'+p.id+'\u003c/span>';\n    else if(p.manualHold||p.status==='ON_HOLD')right='\u003cspan class=\"pill bad\">On hold\u003c/span> '+(p.holdReason==='SETTLEMENT'?'settlement window is held':(p.holdReason==='ISSUANCE'?'issuance is paused':'manual hold by Treasury Ops'));\n    else if(p.status==='AWAITING_APPROVAL')right='\u003cb>Next:\u003c/b> checker approval \u003cbutton class=\"sm pri\" onclick=\"approvePlan(\\''+p.id+'\\')\">Approve\u003c/button>';\n    else if(p.status==='EXCEPTION'&&p.breakId)right='\u003cspan class=\"pill bad\">Exception\u003c/span> \u003cbutton class=\"lnk\" onclick=\"openBreakDrawer(\\''+p.breakId+'\\')\">Open '+p.breakId+'\u003c/button>';\n    else if(p.awaiting)right='\u003cb>Next:\u003c/b> '+GATE_LBL[p.awaiting.key]+' \u003cbutton class=\"sm pri\" onclick=\"releaseGate()\">Run\u003c/button>';\n    else{const k=(p.steps[p.step]||'close').split(':')[0];right='\u003cspan style=\"color:var(--muted)\">Running: '+(STEP_LBL[k]||k)+'...\u003c/span>';}\n  }\n  el.innerHTML='\u003cspan class=\"rl\">DEMO SCRIPT\u003c/span>\u003cdiv class=\"stepflow\">'+flow+'\u003c/div>\u003cdiv class=\"nx\">'+right+auto+'\u003c/div>';\n}\n/* ============ ALWAYS-ON INSPECTOR ============ */\nfunction renderInspector(){\n  const n=document.getElementById('iEvN'); if(!n)return;\n  n.textContent=S.events.length;\n  const wrap=document.getElementById('iEvents');\n  if(!S.events.length){wrap.innerHTML='\u003cdiv class=\"ev-empty\">\u003cdiv class=\"ic\">&#128225;\u003c/div>\u003cb>Waiting for the first API call\u003c/b>\u003cspan>Create a milestone payment in the Corporate Portal. Every request, webhook and on-chain confirmation streams in here as it happens.\u003c/span>\u003cdiv class=\"tags\">\u003cspan class=\"pill ok\">SUCCESS\u003c/span>\u003cspan class=\"pill vio\">WEBHOOK\u003c/span>\u003cspan class=\"pill or\">LIMINAL API\u003c/span>\u003cspan class=\"pill tl\">ON-CHAIN\u003c/span>\u003c/div>\u003c/div>';}\n  else{\n    wrap.innerHTML=S.events.slice().reverse().map(function(e){\n      const sb=e.status==='SUCCESS'?'ok':(e.status==='WEBHOOK'?'vio':(e.status==='FAILED'?'bad':(e.status==='WARN'?'wait':'mute')));\n      const lm=(e.from==='LIMINAL'||e.to==='LIMINAL')?'\u003cspan class=\"pill or\">LIMINAL API\u003c/span>':'';\n      const iso=e.kind==='xml'?'\u003cspan class=\"pill tl\">ISO 20022\u003c/span>':'';\n      const ch=(e.res&&typeof e.res==='object'&&e.res.transactionHash)?'\u003cspan class=\"pill tl\">ON-CHAIN\u003c/span>':'';\n      const mj=e.major?'\u003cspan class=\"pill '+MAJOR_COLOR[e.major]+'\">'+MAJOR_LABEL[e.major]+'\u003c/span>':'';\n      const dir=(e.status==='WEBHOOK'&&e.to==='SI')?'\u003cspan class=\"pill vio\" title=\"SI pulling in an event fired by the sender\">&#8595; PULL\u003c/span>':'';\n      const owner=e.actId!=null?planById(e.actId):null;\n      const isPending=!!(owner&&owner.pendingInspect&&owner.pendingInspect.indexOf(e.id)>-1);\n      const need=isPending?'\u003cspan class=\"pill wait\">ACTION NEEDED\u003c/span>':'';\n      const insp=e.major?('\u003cbutton class=\"sm'+(isPending?' pri pulse':'')+'\" style=\"margin-top:6px\" onclick=\"event.stopPropagation();openIntegrationDrawer('+e.id+')\">'+(isPending?'&#128073; Inspect integration':'&#128274; Inspect integration')+'\u003c/button>'):'';\n      return '\u003cdiv class=\"evi s-'+sb+(e.id===S.sel.event?' sel':'')+(isPending?' awaiting':'')+'\" onclick=\"selEvent('+e.id+')\">'+\n        '\u003cdiv class=\"ev-l\">\u003cdiv class=\"fl2\">'+e.from+' &rarr; '+e.to+'\u003c/div>\u003cdiv class=\"op\">'+e.op+'\u003c/div>\u003c/div>'+\n        '\u003cdiv class=\"ev-r\">\u003cdiv class=\"fg\">\u003cspan class=\"pill '+sb+'\">'+e.status+'\u003c/span>'+dir+iso+lm+ch+mj+need+'\u003c/div>\u003cdiv class=\"tm\">'+e.time+'\u003c/div>'+insp+'\u003c/div>\u003c/div>';\n    }).join('');\n  }\n  const ev=S.events.find(function(x){return x.id===S.sel.event;});\n  const req=document.getElementById('iReq'),res=document.getElementById('iRes'),hd=document.getElementById('iHdr'),tb=document.getElementById('iTx');\n  if(!ev){req.textContent='Select an event from the Event Stream.';res.textContent='';hd.textContent='';}\n  else{\n    req.textContent=ev.req?(typeof ev.req==='string'?ev.req:json(ev.req)):'No request body (asynchronous inbound event).';\n    res.textContent=ev.res?(typeof ev.res==='string'?ev.res:json(ev.res)):'No response captured.';\n    hd.textContent=ev.headers?hblock(ev.headers):'No headers captured.';\n  }\n  const p=S.cust.planId?planById(S.cust.planId):null;\n  if(tb){\n    if(!p){tb.innerHTML='\u003cdiv class=\"k\">Status\u003c/div>\u003cdiv class=\"v\">No active plan\u003c/div>';}\n    else{\n      const pos=dpos();\n      tb.innerHTML=kvr('Plan ID',p.id)+kvr('Payer','Guocoland (HLB Singapore)')+kvr('Supplier','Bank MY')+\n        kvr('Source',sgd(p.sgd))+kvr('Destination',myr(p.sgd*FX))+kvr('FX Rate','1 SGD = 3.30 MYR')+\n        kvr('Mint Hash',p.refs.mintHash?hashLink(p.refs.mintHash):'&mdash;')+\n        kvr('Escrow','\u003cspan class=\"mono\" style=\"font-size:11px\">'+(p.st.escrow==='PENDING'?'&mdash;':sa(ADDR.escrow))+'\u003c/span>')+\n        kvr('tSGD in escrow',money(pos.tsgdEscrow,0))+kvr('tMYR outstanding',money(pos.tmyrOut,0))+\n        kvr('Status',p.status.replace(/_/g,' '))+\n        (ev&&ev.res&&typeof ev.res==='object'&&ev.res.transactionHash?kvr('Etherscan',hashLink(ev.res.transactionHash)):'');\n    }\n  }\n}\nfunction kvr(k,v){return '\u003cdiv class=\"k\">'+k+'\u003c/div>\u003cdiv class=\"v mono\" style=\"font-size:11px\">'+v+'\u003c/div>';}\nfunction selEvent(id){S.sel.event=id;renderInspector();if(S.mode!=='customer')renderDash();}\n/* ============ PLAN PIPELINE ============ */\n/* Endpoints marked PROPOSED are placeholders for the Liminal escrow, transfer and DvP swap APIs and are not confirmed. */\nfunction newPlanId(){S.seq.plan++;return 'PL-20250519-'+String(S.seq.plan).padStart(4,'0');}\nfunction mkPlan(){\n  const id=newPlanId();\n  const legs=MILESTONES.map(function(a,i){return {n:i+1,id:id+'-M'+(i+1),sgd:a,myr:Math.round(a*FX*100)/100,\n    st:{disburse:'PENDING',swap:'PENDING',burn:'PENDING',glPayout:'PENDING'},refs:{}};});\n  const steps=[];\n  if(S.flags.makerChecker)steps.push('approval');\n  if(S.flags.complianceStep)steps.push('compliance');\n  steps.push('lock','escrowCreate','mint','mintChain','fund');\n  legs.forEach(function(l){steps.push('gate:M'+l.n,'disburseSign:'+l.n,'disburseChain:'+l.n);});\n  steps.push('gate:SWAP');\n  legs.forEach(function(l){steps.push('swapSign:'+l.n,'swapChain:'+l.n);});\n  steps.push('gate:BURN');\n  legs.forEach(function(l){steps.push('burnSign:'+l.n,'burnChain:'+l.n,'gl:'+l.n,'payout:'+l.n);});\n  steps.push('recon','close');\n  return {id:id,payer:'Guocoland',sgd:PLAN_SGD,fx:FX,legs:legs,steps:steps,step:0,submitted:stamp(clock),owner:'Treasury Ops',\n    status:'IN_PROGRESS',breakId:null,awaiting:null,gateOpen:null,manualHold:false,holdReason:null,approval:null,apprOk:false,\n    st:{fiatLock:'PENDING',mint:'PENDING',escrow:'PENDING'},refs:{},history:[],pendingInspect:[],shownCats:{}};\n}\nfunction startPlan(){\n  const p=mkPlan();S.plans.unshift(p);\n  S.cust.planId=p.id;S.cust.view='track';S.cust.caption='Your plan has been received.';\n  E(p,'CORPORATE PORTAL','SI','POST /si/plans','SUCCESS','json',\n    {planId:p.id,payer:'Guocoland',payerBank:'HLB Singapore',beneficiary:'Supplier account',beneficiaryBank:'Bank MY',\n     amount:p.sgd,currency:'SGD',milestones:MILESTONES,fxRate:FX,destinationAmount:p.sgd*FX,destinationCurrency:'MYR'},\n    {event:'si.plan.created',planId:p.id,state:'INITIATED'});\n  addAudit('Corporate Portal','activated '+p.id+' ('+sgd(p.sgd)+' in 3 milestones)');\n  hist(p,'Plan created from the corporate portal');\n  renderAll();\n  setTimeout(function(){runStep(p.id);},450);\n}\nfunction runStep(id){\n  const p=planById(id);if(!p||p.status==='REJECTED'||p.status==='COMPLETED')return;\n  if(p.manualHold){p.status='ON_HOLD';renderAll();return;}\n  if(p.pendingInspect&&p.pendingInspect.length){\n    p.status='AWAITING_INSPECTION';\n    setCap(p,'Reviewing the last API call... Click Inspect integration above, then close it, to continue.');\n    renderAll();return;\n  }\n  const key=p.steps[p.step];if(!key)return;\n  const parts=key.split(':'),base=parts[0],arg=parts[1];\n  const r=STEP[base](p,arg);\n  if(r==='PAUSE'){renderAll();return;}\n  p.step++;\n  if(p.pendingInspect&&p.pendingInspect.length){\n    let newCat=false;\n    p.pendingInspect.forEach(function(id){\n      const ev=S.events.find(function(x){return x.id===id;});\n      const cat=ev&&ev.major;\n      if(cat){if(!p.shownCats[cat])newCat=true;p.shownCats[cat]=true;}\n    });\n    if(!newCat){\n      p.pendingInspect.length=0;\n    } else {\n      p.status='AWAITING_INSPECTION';\n      setCap(p,'Reviewing the last API call... Click Inspect integration above, then close it, to continue.');\n      renderAll();return;\n    }\n  }\n  renderAll();\n  setTimeout(function(){runStep(id);},STEP_DELAY);\n}\nfunction setCap(p,t){if(S.cust.planId===p.id)S.cust.caption=t;}\nfunction clearHold(p){if(p.status==='ON_HOLD'&&!p.manualHold)p.status='IN_PROGRESS';p.holdReason=null;}\nfunction setAwait(p,k){\n  if(k.charAt(0)==='M')p.legs[parseInt(k.slice(1),10)-1].st.disburse='AWAITING';\n  else p.legs.forEach(function(l){l.st[k==='SWAP'?'swap':'burn']='AWAITING';});\n}\nfunction clearAwait(p,k){\n  const f=k.charAt(0)==='M'?'disburse':(k==='SWAP'?'swap':'burn');\n  p.legs.forEach(function(l){if(l.st[f]==='AWAITING')l.st[f]='PENDING';});\n}\nfunction releaseGate(){\n  const p=activePlan();if(!p||!p.awaiting)return;\n  if(p.manualHold){toast('The plan is on hold - release it first');return;}\n  const k=p.awaiting.key;\n  p.gateOpen=k;p.awaiting=null;p.status='IN_PROGRESS';clearAwait(p,k);\n  hist(p,'Script run: '+GATE_LBL[k]);addAudit('Treasury Ops','ran script: '+GATE_LBL[k]);\n  renderAll();setTimeout(function(){runStep(p.id);},350);\n}\nconst STEP={};\nSTEP.approval=function(p){\n  if(p.apprOk)return 1;\n  p.approval='AWAITING_CHECKER';p.status='AWAITING_APPROVAL';\n  E(p,'SI','TREASURY (MAKER)','POST /approvals/submit','WARN','json',\n    {planId:p.id,amount:p.sgd,currency:'SGD',scope:'PLAN_ACTIVATION',submittedBy:'Ops Analyst'},\n    {approvalRef:'APR-'+p.id,status:'AWAITING_CHECKER',requiredRole:'Treasury Manager'});\n  p.refs.apprRef='APR-'+p.id;hist(p,'Submitted for maker-checker approval at plan activation');\n  addAudit('Ops Analyst','submitted '+p.id+' for approval');setCap(p,'Awaiting bank approval...');return 'PAUSE';};\nSTEP.compliance=function(p){\n  E(p,'SI','COMPLIANCE','POST /compliance/screen','SUCCESS','json',\n    {planId:p.id,counterparty:'Supplier account (Bank MY)',amount:p.sgd,currency:'SGD',checks:['SANCTIONS','AML','TRANSACTION_LIMIT','PEP']},\n    {screeningRef:'CMP-'+p.id,result:'PASS',riskScore:12,matches:[]});\n  p.refs.cmpRef='CMP-'+p.id;hist(p,'Compliance screening passed');return 1;};\n/* ---- Phase 1: mint and lock ---- */\nSTEP.lock=function(p){\n  setCap(p,'Locking '+sgd(p.sgd)+' in your account...');\n  E(p,'CORE (SG)','SI','EVENT core.fiat.locked','WEBHOOK','json','N/A - asynchronous event received from Core Banking (SG).',\n    {event:'core.fiat.locked',planId:p.id,amount:p.sgd,currency:'SGD',lockRef:'LCK-'+p.id,state:'FIAT_LOCKED'});\n  p.st.fiatLock='LOCKED';p.refs.lockRef='LCK-'+p.id;hist(p,'Core Banking (SG) locked '+sgd(p.sgd));return 1;};\nSTEP.escrowCreate=function(p){\n  setCap(p,'Setting up your payment escrow...');\n  const c=addChain(p,'ESCROW_CREATE','Create DvP Escrow',ADDR.escrow,[],ADDR.signerSG);\n  E(p,'SI','LIMINAL','POST /liminal/escrow/create','SUCCESS','json',   /* PROPOSED endpoint */\n    {transactionId:p.id,org:'HLB Singapore',beneficiaryOrg:'HLB Malaysia Cross Border',asset:'tSGD',milestones:MILESTONES,trigger:'MILESTONE_TOKEN'},\n    {liminalTransactionId:'LIM-E-'+p.id,escrowId:'ESC-'+p.id,status:'CREATED'});\n  E(p,'LIMINAL','SI','WEBHOOK escrow.created','WEBHOOK','json',WH,\n    {event:'escrow.created',transactionId:p.id,escrowId:'ESC-'+p.id,contractAddress:ADDR.escrow,transactionHash:c.hash,blockNumber:c.block,status:'CONFIRMED',finality:'FINAL'});\n  p.st.escrow='CREATED';p.refs.escrowHash=c.hash;hist(p,'DvP Escrow contract created at '+sa(ADDR.escrow));return 1;};\nSTEP.mint=function(p){\n  if(S.flags.issuancePaused){p.status='ON_HOLD';p.holdReason='ISSUANCE';hist(p,'Mint blocked - issuance is paused by Treasury');setCap(p,'Waiting for the bank...');return 'PAUSE';}\n  clearHold(p);setCap(p,'Preparing your secured payment...');\n  E(p,'SI','LIMINAL','POST /liminal/digital-assets/mint','SUCCESS','json',\n    {transactionId:p.id,asset:'tSGD',amount:String(p.sgd),wallet:ADDR.guoco,org:'HLB Singapore',network:NETWORK,signingPolicy:'MPC 2-of-3'},\n    {liminalTransactionId:'LIM-M-'+p.id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED',approvals:['policy-engine','risk-engine']});\n  p.st.mint='SIGNED';p.refs.liminalMint='LIM-M-'+p.id;hist(p,'Liminal signing policy + MPC/HSM signature complete (mint tSGD)');return 1;};\nfunction chainMint(p,retry){\n  const c=addChain(p,'MINT','Mint',ADDR.tsgd,[{token:'tSGD',from:ZERO,to:ADDR.guoco,amount:p.sgd}],ADDR.signerSG);\n  E(p,'LIMINAL','DLT','Submit signed MINT to smart contract','SUCCESS','json',\n    {op:'mint',asset:'tSGD',amount:p.sgd,to:ADDR.guoco,contract:ADDR.tsgd,signedBy:'MPC-HSM (2-of-3)'},\n    {transactionHash:c.hash,blockNumber:c.block,status:'CONFIRMED',finality:'FINAL',network:NETWORK});\n  E(p,'LIMINAL','SI','WEBHOOK digital_asset.mint.confirmed'+(retry?' (retry)':''),'WEBHOOK','json',WH,\n    {event:'digital_asset.mint.confirmed',transactionId:p.id,liminalTransactionId:p.refs.liminalMint||('LIM-M-'+p.id),asset:'tSGD',amount:String(p.sgd),\n     transactionHash:c.hash,blockNumber:c.block,status:'CONFIRMED',finality:'FINAL'});\n  p.refs.mintHash=c.hash;p.refs.mintBlock=c.block;p.st.mint='CONFIRMED';\n  hist(p,'tSGD minted into the Guocoland wallet - '+money(p.sgd,0)+' tSGD issued');\n}\nSTEP.mintChain=function(p){\n  if(S.flags.forceDltFail){\n    p.st.mint='FAILED';p.status='EXCEPTION';\n    E(p,'DLT','LIMINAL','MINT transaction reverted','FAILED','json',\n      {op:'mint',asset:'tSGD',amount:p.sgd,contract:ADDR.tsgd},\n      {status:'REVERTED',reason:'GAS_LIMIT_EXCEEDED_ON_MINT',blockNumber:null,finality:'NONE'});\n    E(p,'LIMINAL','SI','WEBHOOK digital_asset.mint.failed','WEBHOOK','json',WH,\n      {event:'digital_asset.mint.failed',transactionId:p.id,liminalTransactionId:p.refs.liminalMint,status:'FAILED',reason:'GAS_LIMIT_EXCEEDED_ON_MINT'});\n    const b=raiseBreak('DLT Execution',-p.sgd,'Mint transaction reverted on DLT - tSGD not issued',p.id);\n    hist(p,'DLT mint failed - exception raised '+b.id);\n    addAudit('SI Orchestrator','raised '+b.id+' for '+p.id+' (DLT mint failure)');\n    setCap(p,'Delay detected - under review by the bank');\n    S.flags.forceDltFail=false;return 'PAUSE';\n  }\n  chainMint(p,false);return 1;};\nSTEP.fund=function(p){\n  setCap(p,'Securing your payment in escrow...');\n  const c=addChain(p,'TRANSFER','Transfer',ADDR.tsgd,[{token:'tSGD',from:ADDR.guoco,to:ADDR.escrow,amount:p.sgd}],ADDR.signerSG);\n  E(p,'SI','LIMINAL','POST /liminal/digital-assets/transfer','SUCCESS','json',   /* PROPOSED endpoint */\n    {transactionId:p.id,asset:'tSGD',amount:String(p.sgd),from:ADDR.guoco,to:ADDR.escrow,network:NETWORK},\n    {liminalTransactionId:'LIM-T-'+p.id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  E(p,'LIMINAL','SI','WEBHOOK digital_asset.transfer.confirmed','WEBHOOK','json',WH,\n    {event:'digital_asset.transfer.confirmed',transactionId:p.id,asset:'tSGD',amount:String(p.sgd),from:ADDR.guoco,to:ADDR.escrow,\n     transactionHash:c.hash,blockNumber:c.block,status:'CONFIRMED',finality:'FINAL'});\n  p.st.escrow='FUNDED';p.refs.fundHash=c.hash;\n  hist(p,money(p.sgd,0)+' tSGD transferred from the Guocoland wallet to the DvP Escrow');\n  toast('Phase 1 done: '+money(p.sgd,0)+' tSGD minted and locked in the DvP Escrow');return 1;};\n/* ---- gates: the presenter's script triggers ---- */\nSTEP.gate=function(p,k){\n  if(p.gateOpen===k||S.flags.autoRun){p.gateOpen=null;p.awaiting=null;clearAwait(p,k);return 1;}\n  p.awaiting={key:k,label:GATE_LBL[k]};\n  p.status=k.charAt(0)==='M'?'AWAITING_MILESTONE':'AWAITING_SCRIPT';\n  setAwait(p,k);\n  setCap(p,k.charAt(0)==='M'?('Waiting for milestone '+k.slice(1)+' to be completed'):'Waiting for the bank to run the next step');\n  hist(p,'Waiting: '+GATE_LBL[k]);\n  return 'PAUSE';};\n/* ---- Phase 2: milestone disbursement ---- */\nSTEP.disburseSign=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];clearHold(p);\n  setCap(p,'Releasing milestone '+n+' ('+sgd(l.sgd)+')...');\n  E(p,'SI','LIMINAL','POST /liminal/escrow/ESC-'+p.id+'/disburse','SUCCESS','json',   /* PROPOSED endpoint */\n    {transactionId:l.id,milestoneIndex:n,trigger:'MILESTONE_TOKEN',asset:'tSGD',amount:String(l.sgd),to:ADDR.hlbmy,toOrg:'HLB Malaysia Cross Border'},\n    {liminalTransactionId:'LIM-D-'+l.id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  return 1;};\nSTEP.disburseChain=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  const c=addChain(p,'DISBURSE','Disburse milestone '+n,ADDR.escrow,[{token:'tSGD',from:ADDR.escrow,to:ADDR.hlbmy,amount:l.sgd}],ADDR.signerSG);\n  E(p,'LIMINAL','SI','WEBHOOK escrow.disbursed','WEBHOOK','json',WH,\n    {event:'escrow.disbursed',transactionId:l.id,milestoneIndex:n,asset:'tSGD',amount:String(l.sgd),to:ADDR.hlbmy,\n     transactionHash:c.hash,blockNumber:c.block,escrowBalanceAfter:String(balance(ADDR.escrow,'tSGD')),status:'CONFIRMED',finality:'FINAL'});\n  l.st.disburse='RELEASED';l.refs.disburseHash=c.hash;\n  hist(p,'Milestone '+n+': '+money(l.sgd,0)+' tSGD released from escrow to HLB Malaysia (not yet swapped)');\n  if(n===3)toast('Phase 2 done: '+money(p.sgd,0)+' tSGD disbursed to HLB Malaysia in 3 payments');\n  return 1;};\n/* ---- Phase 3: DvP swap tSGD to tMYR ---- */\nSTEP.swapSign=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  setCap(p,'Converting to MYR ('+n+' of 3)...');\n  E(p,'SI','LIMINAL','POST /liminal/dvp/swap','SUCCESS','json',   /* PROPOSED endpoint */\n    {transactionId:l.id,swapContract:ADDR.swap,tokenIn:'tSGD',tokenOut:'tMYR',amountIn:String(l.sgd),rate:FX,wallet:ADDR.hlbmy,org:'HLB Malaysia Cross Border'},\n    {liminalTransactionId:'LIM-S-'+l.id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  return 1;};\nSTEP.swapChain=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  const c=addChain(p,'SWAP','DvP swap '+n,ADDR.swap,\n    [{token:'tSGD',from:ADDR.hlbmy,to:ZERO,amount:l.sgd},{token:'tMYR',from:ZERO,to:ADDR.hlbmy,amount:l.myr}],ADDR.signerMY);\n  E(p,'LIMINAL','SI','WEBHOOK dvp.swap.settled','WEBHOOK','json',WH,\n    {event:'dvp.swap.settled',transactionId:l.id,tsgdBurned:String(l.sgd),tmyrMinted:String(l.myr),rate:FX,wallet:ADDR.hlbmy,\n     transactionHash:c.hash,blockNumber:c.block,status:'CONFIRMED',finality:'FINAL'});\n  l.st.swap='SETTLED';l.refs.swapHash=c.hash;\n  hist(p,'Swap '+n+': '+money(l.sgd,0)+' tSGD burned, '+money(l.myr,0)+' tMYR minted at 3.3');\n  if(n===3)toast('Phase 3 done: '+money(p.sgd*FX,0)+' tMYR minted by 3 DvP swaps');\n  return 1;};\n/* ---- Phase 4: burn tMYR, GL update, MYR payout ---- */\nSTEP.burnSign=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  setCap(p,'Settling to the supplier in Malaysia ('+n+' of 3)...');\n  E(p,'SI','LIMINAL','POST /liminal/digital-assets/burn','SUCCESS','json',\n    {transactionId:l.id,asset:'tMYR',amount:String(l.myr),wallet:ADDR.hlbmy,org:'HLB Malaysia Cross Border'},\n    {liminalTransactionId:'LIM-B-'+l.id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  return 1;};\nSTEP.burnChain=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  const c=addChain(p,'BURN','Burn tMYR '+n,ADDR.tmyr,[{token:'tMYR',from:ADDR.hlbmy,to:ZERO,amount:l.myr}],ADDR.signerMY);\n  E(p,'LIMINAL','SI','WEBHOOK digital_asset.burn.confirmed','WEBHOOK','json',WH,\n    {event:'digital_asset.burn.confirmed',transactionId:l.id,asset:'tMYR',amount:String(l.myr),transactionHash:c.hash,blockNumber:c.block,status:'CONFIRMED',finality:'FINAL'});\n  l.st.burn='CONFIRMED';l.refs.burnHash=c.hash;\n  hist(p,'Burn '+n+': '+money(l.myr,0)+' tMYR burned to keep tMYR 1:1 with fiat');return 1;};\nSTEP.gl=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  if(S.flags.settlementOnHold){\n    p.status='ON_HOLD';p.holdReason='SETTLEMENT';l.st.glPayout='ON_HOLD';\n    hist(p,'GL update blocked - settlement is on hold by Treasury');setCap(p,'Waiting for bank settlement window...');return 'PAUSE';}\n  if(l.st.glPayout==='ON_HOLD')l.st.glPayout='PENDING';\n  clearHold(p);\n  E(p,'SI','CORE (MY)','POST /core/gl/postings','SUCCESS','json',\n    {transactionId:l.id,swapIndex:n,burnHash:l.refs.burnHash,\n     entries:[{account:'TMYR_CONTROL',dc:'DEBIT',amount:l.myr,ccy:'MYR'},{account:'HLBMY_SETTLEMENT',dc:'CREDIT',amount:l.myr,ccy:'MYR'}]},\n    {glReference:'GL-'+l.id,postingStatus:'POSTED',evidence:'ACCOUNTING_EVIDENCE_STORED'});\n  l.st.glPayout='POSTED';l.refs.glRef='GL-'+l.id;hist(p,'GL updated in Core Banking (MY) for burn '+n);return 1;};\nSTEP.payout=function(p,n){\n  n=parseInt(n,10);const l=p.legs[n-1];\n  E(p,'HLB MALAYSIA','BANK MY','Domestic MYR payout (pacs.008)','SUCCESS','xml',\n    '\u003c!-- ISO 20022 pacs.008 domestic MYR payout. Rail label (domestic transfer / RTGS / RENTAS) to be confirmed. -->\\n\u003cDocument xmlns=\"urn:si:atom:pacs.008.payout\">\\n  \u003cCdtTrfTxInf>\\n    \u003cSIRef>'+l.id+'\u003c/SIRef>\\n    \u003cIntrBkSttlmAmt Ccy=\"MYR\">'+l.myr+'\u003c/IntrBkSttlmAmt>\\n    \u003cDbtr>\u003cNm>HL Bank Malaysia\u003c/Nm>\u003c/Dbtr>\\n    \u003cCdtrAgt>\u003cNm>Bank MY\u003c/Nm>\u003c/CdtrAgt>\\n    \u003cCdtr>\u003cNm>Supplier account\u003c/Nm>\u003c/Cdtr>\\n  \u003c/CdtTrfTxInf>\\n\u003c/Document>',\n    '\u003c!-- ISO 20022 pacs.002 status report -->\\n\u003cDocument xmlns=\"urn:si:atom:pacs.002\">\\n  \u003cTxSts>CREDITED\u003c/TxSts>\\n  \u003cPayoutRef>PAY-'+l.id+'\u003c/PayoutRef>\\n\u003c/Document>');\n  l.st.glPayout='PAID';l.refs.payRef='PAY-'+l.id;hist(p,'MYR '+money(l.myr,0)+' paid to the supplier at Bank MY (payment '+n+' of 3)');return 1;};\nSTEP.recon=function(p){\n  if(!(S.flags.reconOnClose||S.flags.forceBreak))return 1;\n  const brk=S.flags.forceBreak,total=p.sgd*FX;\n  const dltAmt=brk?(total-Math.round(total*0.004*100)/100):total;\n  const v=Math.round((dltAmt-total)*100)/100;\n  E(p,'SI','RECONCILIATION ENGINE','POST /reconciliation/run',brk?'FAILED':'SUCCESS','json',\n    {planId:p.id,controlPoints:['CORE_BANKING','DLT_LEDGER','ESCROW','GENERAL_LEDGER']},\n    {planId:p.id,tsgdMinted:p.sgd,sgdLocked:p.sgd,tmyrBurnedDlt:dltAmt,tmyrPostedGl:total,variance:v,result:brk?'MISMATCH':'MATCH'});\n  if(brk){\n    p.status='EXCEPTION';\n    const b=raiseBreak('Core vs DLT',v,'tMYR burned on DLT differs from the GL posting',p.id);\n    hist(p,'Reconciliation break raised '+b.id+' (variance '+money(v)+' tMYR)');\n    addAudit('SI Orchestrator','raised '+b.id+' for '+p.id+' (reconciliation variance)');\n    S.flags.forceBreak=false;\n  } else {hist(p,'All control points matched - plan reconciled');addAudit('SI Orchestrator','reconciled '+p.id+' - all control points matched');}\n  return 1;};\nSTEP.close=function(p){\n  if(!p.breakId)p.status='COMPLETED';\n  const pos=position();\n  hist(p,'Plan closed: tSGD supply '+money(pos.tsgdOut,0)+', tMYR supply '+money(pos.tmyrOut,0));\n  addAudit('SI Orchestrator','closed '+p.id+' (tSGD and tMYR supply at '+money(pos.tsgdOut+pos.tmyrOut,0)+')');\n  setCap(p,'Plan complete!');\n  toast('Phase 4 done: '+money(p.sgd*FX,0)+' tMYR burned and MYR paid to Bank MY');\n  setTimeout(function(){ if(S.cust.planId===p.id){S.cust.view='done';renderAll();} },700);\n  return 1;};\n/* ============ BREAK ENGINE ============ */\nfunction raiseBreak(source,variance,reason,planId){\n  S.seq.brk++;\n  const b={id:'BRK-20250519-'+String(S.seq.brk).padStart(4,'0'),source:source,variance:variance,reason:reason,\n    status:'OPEN',assignedTo:'Unassigned',planId:planId,remediation:null,\n    history:[{t:hhmmss(clock),x:'Break detected by '+(source==='DLT Execution'?'DLT execution monitor':'reconciliation engine')}]};\n  S.breaks.unshift(b);\n  const p=planById(planId); if(p){p.breakId=b.id;}\n  return b;\n}\nfunction bHist(b,x){b.history.push({t:hhmmss(clock),x:x});}\nfunction assignBreak(id,who){const b=brkById(id);if(!b)return;b.assignedTo=who;if(b.status==='OPEN')b.status='ASSIGNED';\n  bHist(b,'Assigned to '+who);addAudit('Treasury Ops','assigned '+id+' to '+who);\n  logEvent({from:'TREASURY OPS',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/assign',status:'SUCCESS',kind:'json',headers:headers('json',id),\n    req:{caseId:id,assignTo:who},res:{caseId:id,status:b.status,assignedTo:who}});\n  toast(id+' assigned to '+who);renderAll();}\nfunction investigateBreak(id){const b=brkById(id);if(!b)return;b.status='INVESTIGATING';\n  bHist(b,'Investigation started - pulling ledger snapshots and DLT proofs');\n  addAudit('Treasury Ops','started investigation on '+id);\n  const L=ledgers();\n  logEvent({from:'SI CASE MANAGEMENT',to:'RECONCILIATION ENGINE',op:'GET /reconciliation/cases/'+id+'/evidence',status:'SUCCESS',kind:'json',headers:headers('json',id),\n    req:{caseId:id,include:['core_snapshot','dlt_proof','gl_journal','escrow_balance']},\n    res:{caseId:id,sgdLocked:money(L.p.locked),tsgdMinted:money(L.p.tsgdMinted),tmyrBurnedDlt:money(L.p.tmyrBurned+L.coreVar),glPosted:money(L.glPosted),variance:money(b.variance),evidenceComplete:true}});\n  toast('Investigation started on '+id);renderAll();openBreakDrawer(id);}\nfunction proposeRemediation(id,remId){const b=brkById(id);if(!b)return;\n  const opt=(REMEDIATIONS[b.source]||[]).find(function(r){return r.id===remId;});if(!opt)return;\n  b.remediation={id:remId,label:opt.label,api:opt.api,proposedBy:'Ops Analyst',proposedAt:hhmmss(clock),approvedBy:null};\n  b.status='PENDING_APPROVAL';\n  bHist(b,'Remediation proposed: '+opt.label+' (awaiting checker approval)');\n  addAudit('Ops Analyst','proposed remediation \"'+opt.label+'\" on '+id);\n  logEvent({from:'OPS ANALYST (MAKER)',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/remediation/propose',status:'WARN',kind:'json',headers:headers('json',id),\n    req:{caseId:id,remediationType:remId,targetApi:opt.api,variance:b.variance,proposedBy:'Ops Analyst'},\n    res:{caseId:id,status:'PENDING_APPROVAL',requiredRole:'Treasury Manager'}});\n  toast('Remediation proposed - awaiting checker');renderAll();openBreakDrawer(id);}\nfunction approveRemediation(id){const b=brkById(id);if(!b||!b.remediation)return;\n  const r=b.remediation;r.approvedBy='Treasury Manager';r.approvedAt=hhmmss(clock);\n  bHist(b,'Remediation approved by Treasury Manager (checker)');\n  logEvent({from:'TREASURY MANAGER (CHECKER)',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/remediation/approve',status:'SUCCESS',kind:'json',headers:headers('json',id),\n    req:{caseId:id,remediationType:r.id,decision:'APPROVE',approvedBy:'Treasury Manager'},\n    res:{caseId:id,status:'APPROVED_FOR_EXECUTION',executeApi:r.api}});\n  startRecovery(b);\n  renderAll();openBreakDrawer(id);}\nfunction rejectRemediation(id){const b=brkById(id);if(!b)return;\n  bHist(b,'Remediation rejected by checker - returned to investigation');\n  b.status='INVESTIGATING';b.remediation=null;\n  addAudit('Treasury Manager','rejected proposed remediation on '+id);\n  logEvent({from:'TREASURY MANAGER (CHECKER)',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/remediation/reject',status:'FAILED',kind:'json',headers:headers('json',id),\n    req:{caseId:id,decision:'REJECT'},res:{caseId:id,status:'INVESTIGATING'}});\n  toast('Remediation rejected');renderAll();openBreakDrawer(id);}\nfunction executeRemediation(b){\n  const p=b.planId?planById(b.planId):null, r=b.remediation;\n  const fake=p||{id:b.id};\n  if(r.id==='RETRY_CORE_POSTING'){\n    E(fake,'SI','CORE / GL','POST /core/postings/retry','SUCCESS','json',\n      {caseId:b.id,planId:b.planId,action:'RETRY_POSTING',amount:Math.abs(b.variance)},\n      {glReference:'GL-ADJ-'+b.id,postingStatus:'POSTED',varianceAfter:0});\n  } else if(r.id==='DLT_RECONFIRM'){\n    const h=p&&p.refs.mintHash?p.refs.mintHash:null;\n    E(fake,'SI','DLT','GET /dlt/transactions/'+(h?h.slice(0,10):'0xabc')+'...','SUCCESS','json',\n      {caseId:b.id,transactionHash:h||'0x...',query:'finality'},\n      {status:'CONFIRMED',finality:'FINAL',confirmations:64,varianceAfter:0});\n  } else if(r.id==='RETRY_DLT_SUBMIT'){\n    E(fake,'SI','LIMINAL','POST /liminal/digital-assets/resubmit','SUCCESS','json',\n      {caseId:b.id,transactionId:b.planId,asset:'tSGD',amount:p?p.sgd:0,reason:'RETRY_AFTER_REVERT',gasStrategy:'ELEVATED'},\n      {liminalTransactionId:'LIM-M2-'+b.planId,status:'SIGNED'});\n    if(p&&p.st.mint!=='CONFIRMED')chainMint(p,true);\n  } else if(r.id==='RETRY_SETTLEMENT_MATCH'||r.id==='MANUAL_MATCH'){\n    E(fake,'SI','SETTLEMENT ENGINE',r.api,'SUCCESS','json',{caseId:b.id,action:r.id,amount:Math.abs(b.variance)},{matched:true,varianceAfter:0});\n  } else if(r.id==='GL_ADJUSTMENT'||r.id==='RETRY_GL_POSTING'){\n    E(fake,'SI','CORE / GL',r.api,'SUCCESS','json',\n      {caseId:b.id,journal:[{account:'RECONCILIATION_SUSPENSE',dc:b.variance\u003c0?'DEBIT':'CREDIT',amount:Math.abs(b.variance),ccy:'MYR'},\n        {account:'GENERAL_LEDGER_CONTROL',dc:b.variance\u003c0?'CREDIT':'DEBIT',amount:Math.abs(b.variance),ccy:'MYR'}]},\n      {glReference:'GL-ADJ-'+b.id,postingStatus:'POSTED',varianceAfter:0});\n  }\n}\n/* ===== POST-REMEDIATION RECOVERY (self-healing, no re-initiation) ===== */\nfunction recoverySteps(b){\n  const tx=b.planId||'plan';\n  if(b.source==='DLT Execution') return {mode:'RESUME',\n    note:'Value never moved on-chain, so SI resumes the SAME plan from the failed step. The customer does not re-initiate - the original fiat lock, correlation ID and idempotency key are reused, which prevents a double lock.',\n    steps:[{l:'Execute approved remediation call'},{l:'Re-submit signed transaction to DLT'},\n      {l:'Await DLT finality webhook from Liminal'},{l:'Resume orchestration from escrow funding'},\n      {l:'Continue escrow, milestones, swaps, burns and payout'},{l:'Close case'}]};\n  return {mode:'CORRECTION',\n    note:'The value movement already completed correctly - only the books disagreed. SI posts a correction and re-runs reconciliation. The plan is NOT replayed, because replaying it would move value twice.',\n    steps:[{l:'Execute approved correction posting'},{l:'Re-fetch core banking position'},\n      {l:'Re-fetch DLT ledger position'},{l:'Re-run reconciliation for '+tx},\n      {l:'Clear variance and close case'}]};\n}\nfunction startRecovery(b){\n  const plan=recoverySteps(b);\n  b.recovery={mode:plan.mode,note:plan.note,idx:0,running:true,\n    steps:plan.steps.map(function(x){return {l:x.l,s:'PENDING'};})};\n  bHist(b,'Post-remediation recovery started ('+plan.mode+' mode)');\n  toast('Recovery running - '+b.id);\n  renderAll();\n  setTimeout(function(){recoveryTick(b.id);},520);\n}\nfunction recoveryTick(id){\n  const b=brkById(id); if(!b||!b.recovery||!b.recovery.running)return;\n  const R=b.recovery, i=R.idx, st=R.steps[i];\n  if(!st){finishRecovery(b);return;}\n  st.s='DONE';\n  const p=b.planId?planById(b.planId):null, L=ledgers(), fake=p||{id:b.id};\n  if(i===0){ executeRemediation(b); }\n  else if(R.mode==='CORRECTION'){\n    if(i===1) E(fake,'SI','CORE BANKING','GET /core/positions','SUCCESS','json',{caseId:b.id,account:'SGD_LOCK_CONTROL',asOf:hhmmss(clock)},{sgdLocked:money(L.p.locked),currency:'SGD',source:'CORE_BANKING'});\n    if(i===2) E(fake,'SI','DLT','GET /dlt/ledger/supply','SUCCESS','json',{caseId:b.id,assets:['tSGD','tMYR']},{tsgdSupply:money(L.p.tsgdOut),tmyrSupply:money(L.p.tmyrOut),finality:'FINAL',source:'DLT_LEDGER'});\n    if(i===3) E(fake,'SI','RECONCILIATION ENGINE','POST /reconciliation/run','SUCCESS','json',\n      {caseId:b.id,planId:b.planId,controlPoints:['CORE_BANKING','DLT_LEDGER','ESCROW','GENERAL_LEDGER'],trigger:'POST_REMEDIATION'},\n      {planId:b.planId,varianceBefore:money(b.variance),varianceAfter:'0.00',result:'MATCH'});\n  } else {\n    if(i===3) E(fake,'SI','SI ORCHESTRATOR','POST /orchestration/resume','SUCCESS','json',\n      {planId:b.planId,resumeFromStage:'ESCROW_FUNDING',reuseIdempotencyKey:true,customerReinitiationRequired:false},\n      {planId:b.planId,status:'RESUMED',replayedStages:0,note:'Original fiat lock and correlation ID reused'});\n  }\n  R.idx++;\n  renderAll();\n  setTimeout(function(){recoveryTick(id);}, i===0?900:700);\n}\nfunction finishRecovery(b){\n  const R=b.recovery; R.running=false;\n  const p=b.planId?planById(b.planId):null, r=b.remediation;\n  b.varianceBefore=b.variance;b.variance=0;b.status='RESOLVED';b.resolvedAt=hhmmss(clock);\n  bHist(b,'Recovery complete via '+(r?r.api:'remediation')+' - variance cleared to 0.00');\n  addAudit('Treasury Manager','approved and executed remediation on '+b.id);\n  if(p){\n    if(R.mode==='RESUME'){\n      if(p.st.mint!=='CONFIRMED')chainMint(p,true);\n      p.breakId=null;p.status='IN_PROGRESS';hist(p,'DLT re-submission confirmed - orchestration resumed (no re-initiation)');\n      setCap(p,'Back on track - finalizing your plan...');\n      p.step++;renderAll();setTimeout(function(){runStep(p.id);},600);\n    } else {\n      p.breakId=null;p.status='COMPLETED';\n      hist(p,'Break '+b.id+' corrected - plan reconciled without replay');\n    }\n  }\n  toast(b.id+' resolved - variance cleared');\n  renderAll();\n}\nfunction escalateBreak(id){const b=brkById(id);if(!b)return;b.status='ESCALATED';b.assignedTo='Treasury Manager';\n  bHist(b,'Escalated to Treasury Manager (severity raised)');\n  addAudit('Treasury Ops','escalated '+id+' to Treasury Manager');\n  logEvent({from:'TREASURY OPS',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/escalate',status:'WARN',kind:'json',headers:headers('json',id),\n    req:{caseId:id,severity:'HIGH',escalateTo:'Treasury Manager',slaBreach:false},\n    res:{caseId:id,status:'ESCALATED',assignedTo:'Treasury Manager'}});\n  toast(id+' escalated');renderAll();openBreakDrawer(id);}\n/* ============ DASHBOARD ============ */\nconst NAV=[['control','&#9638;','Control Center'],['sysint','&#127760;','System Integration'],['txns','&#128203;','Plans &amp; Legs'],['wallets','&#128091;','Wallets'],['escrow','&#128274;','Escrow &amp; DvP'],\n ['recon','&#9878;','Reconciliation'],['breaks','&#9888;','Breaks &amp; Exceptions'],['appr','&#9989;','Approvals'],['hold','&#9208;','Hold &amp; Release'],\n ['issuance','&#127974;','Issuance Management'],['reports','&#128202;','Reports'],['audit','&#128220;','Audit Trail'],['config','&#9881;','Configuration']];\nfunction pendingAppr(){return S.plans.filter(function(p){return p.approval==='AWAITING_CHECKER'&&p.status==='AWAITING_APPROVAL';});}\nfunction renderDash(){\n  const ob=openBreaks().length;\n  const side='\u003cdiv class=\"side\">'+NAV.map(function(n){\n    const c=(n[0]==='breaks'&&ob)?'\u003cspan class=\"cnt\">'+ob+'\u003c/span>':(n[0]==='appr'&&pendingAppr().length?'\u003cspan class=\"cnt\">'+pendingAppr().length+'\u003c/span>':'');\n    return '\u003cbutton class=\"navitem'+(S.nav===n[0]?' on':'')+'\" onclick=\"setNav(\\''+n[0]+'\\')\">\u003cspan class=\"ic\">'+n[1]+'\u003c/span>'+n[2]+c+'\u003c/button>'