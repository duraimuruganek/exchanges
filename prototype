s(LINK_PTS.GUOCO)+' GUOCO';\n  if(a.type==='EARN')return pts(a.legs[0].amount)+' HLBP + '+pts(a.legs[1].amount)+' GUOCO';\n  const sw=a.legs.find(function(l){return l.op==='SWAP';});\n  return (sw?pts(sw.hlbp)+' HLBP swap, ':'')+pts(REWARD.guoco)+' GUOCO burn';\n}\nfunction buildSteps(a){\n  const s=[];if(S.flags.makerChecker)s.push('approval');\n  s.push('request');if(a.type==='EARN')s.push('requestCore');\n  s.push('rules');if(a.type==='LINK')s.push('rulesVault');\n  if(a.type==='RDM'){\n    const sw=a.legs.find(function(l){return l.op==='SWAP';});\n    if(sw)s.push('gate:S3','legSign:'+sw.n,'legChain:'+sw.n,'fulfil');else s.push('fulfil');\n    s.push('gate:S4');a.legs.filter(function(l){return l.op!=='SWAP';}).forEach(function(l){s.push('legSign:'+l.n,'legChain:'+l.n);});\n  } else {\n    s.push('gate:'+(a.type==='LINK'?'S1':'S2'));a.legs.forEach(function(l){s.push('legSign:'+l.n,'legChain:'+l.n);});s.push('fulfil');\n  }\n  s.push('ledger','close');return s;\n}\nfunction mkAct(type,meta){\n  S.seq[type]++;const id=TYPES[type].prefix+'-20250519-'+String(S.seq[type]).padStart(4,'0');\n  let defs;\n  if(type==='LINK')defs=[{op:'ISSUE',token:'HLBP',amount:LINK_PTS.HLBP,gate:'S1'},{op:'ISSUE',token:'GUOCO',amount:LINK_PTS.GUOCO,gate:'S1'}];\n  else if(type==='EARN')defs=[{op:'ISSUE',token:'HLBP',amount:PURCHASE.amount*EARN_RATE.HLBP,gate:'S2'},{op:'ISSUE',token:'GUOCO',amount:PURCHASE.amount*EARN_RATE.GUOCO,gate:'S2'}];\n  else{defs=[];\n    if(meta&&meta.lots>0)defs.push({op:'SWAP',token:'HLBP',amount:meta.hlbpIn,hlbp:meta.hlbpIn,guoco:meta.guocoOut,gate:'S3'});\n    defs.push({op:'TRANSFER',token:'GUOCO',amount:REWARD.guoco,gate:'S4'},{op:'BURN',token:'GUOCO',amount:REWARD.guoco,gate:'S4'});}\n  const a={id:id,type:type,meta:meta||{},submitted:stamp(clock),owner:'Treasury Ops',status:'IN_PROGRESS',breakId:null,awaiting:null,gateOpen:null,\n    manualHold:false,holdReason:null,approval:null,apprOk:false,step:0,\n    st:{request:'PENDING',rules:'PENDING',fulfil:'PENDING',ledger:'PENDING'},refs:{},history:[],pendingInspect:[],shownCats:{},\n    legs:defs.map(function(d,i){return Object.assign({n:i+1,id:id+'-L'+(i+1),st:{sign:'PENDING',chain:'PENDING'},refs:{}},d);})};\n  a.steps=buildSteps(a);return a;\n}\nfunction startAct(type,meta){\n  const a=mkAct(type,meta);S.acts.unshift(a);\n  S.cust.actId=a.id;S.cust.view='track';S.cust.caption='Your request has been received.';\n  addAudit('Customer App','Amir started '+TYPES[type].name.toLowerCase()+' '+a.id);\n  hist(a,TYPES[type].name+' started from the customer app');\n  renderAll();setTimeout(function(){runStep(a.id);},450);\n}\nfunction runStep(id){\n  const a=actById(id);if(!a||a.status==='REJECTED'||a.status==='COMPLETED')return;\n  if(a.manualHold){a.status='ON_HOLD';renderAll();return;}\n  if(a.pendingInspect&&a.pendingInspect.length){\n    a.status='AWAITING_INSPECTION';\n    setCap(a,'Reviewing the last API call... Click Inspect integration above, then close it, to continue.');\n    renderAll();return;\n  }\n  const key=a.steps[a.step];if(!key)return;\n  const parts=key.split(':'),base=parts[0],arg=parts[1];\n  const r=STEP[base](a,arg);\n  if(r==='PAUSE'){renderAll();return;}\n  a.step++;\n  if(a.pendingInspect&&a.pendingInspect.length){\n    let newCat=false;\n    a.pendingInspect.forEach(function(id){\n      const ev=S.events.find(function(x){return x.id===id;});\n      const cat=ev&&ev.major;\n      if(cat){if(!a.shownCats[cat])newCat=true;a.shownCats[cat]=true;}\n    });\n    if(!newCat){\n      a.pendingInspect.length=0;\n    } else {\n      a.status='AWAITING_INSPECTION';\n      setCap(a,'Reviewing the last API call... Click Inspect integration above, then close it, to continue.');\n      renderAll();return;\n    }\n  }\n  renderAll();\n  setTimeout(function(){runStep(id);},STEP_DELAY);\n}\nfunction setCap(a,t){if(S.cust.actId===a.id)S.cust.caption=t;}\nfunction clearHold(a){if(a.status==='ON_HOLD'&&!a.manualHold)a.status='IN_PROGRESS';a.holdReason=null;}\nfunction setAwait(a,k){a.legs.forEach(function(l){if(l.gate===k&&l.st.chain==='PENDING'){l.st.sign='AWAITING';l.st.chain='AWAITING';}});}\nfunction clearAwait(a,k){a.legs.forEach(function(l){if(l.gate===k){if(l.st.sign==='AWAITING')l.st.sign='PENDING';if(l.st.chain==='AWAITING')l.st.chain='PENDING';}});}\nfunction releaseGate(){\n  const a=activeAct();if(!a||!a.awaiting)return;\n  if(a.manualHold){toast('The activity is on hold - release it first');return;}\n  const k=a.awaiting.key;\n  a.gateOpen=k;a.awaiting=null;a.status='IN_PROGRESS';clearAwait(a,k);\n  hist(a,'Script run: '+GATE_LBL[k]);addAudit('Treasury Ops','ran script: '+GATE_LBL[k]);\n  renderAll();setTimeout(function(){runStep(a.id);},350);\n}\nconst STEP={};\nSTEP.approval=function(a){\n  if(a.apprOk)return 1;\n  a.approval='AWAITING_CHECKER';a.status='AWAITING_APPROVAL';\n  E(a,'SI','TREASURY (MAKER)','POST /approvals/submit','WARN','json',\n    {activityId:a.id,type:a.type,points:pointsSummary(a),scope:'ON_CHAIN_OPERATIONS',submittedBy:'Ops Analyst'},\n    {approvalRef:'APR-'+a.id,status:'AWAITING_CHECKER',requiredRole:'Treasury Manager'});\n  a.refs.apprRef='APR-'+a.id;hist(a,'Submitted for maker-checker approval before on-chain operations');\n  addAudit('Ops Analyst','submitted '+a.id+' for approval');setCap(a,'Awaiting bank approval...');return 'PAUSE';};\n/* ---- step 1: the request that starts each activity ---- */\nSTEP.request=function(a){\n  const m=S.member;\n  if(a.type==='LINK'){\n    setCap(a,'Checking your programme linking request...');\n    E(a,'CUSTOMER APP','SI','POST /si/loyalty/links','SUCCESS','json',\n      {memberId:m.id,programmes:[{programme:'HLB Rewards',asset:'HLBP',points:LINK_PTS.HLBP},{programme:'Guoco Points',asset:'GUOCO',points:LINK_PTS.GUOCO}],\n       consent:{reviewedByMember:true,benefits:['INSTANT_REDEMPTION','POINT_CONVERSION','UNIFIED_BALANCE']},channel:'HLB MOBILE'},\n      {event:'si.loyalty.link.created',linkId:a.id,state:'PENDING_ACTIVATION'});\n    hist(a,'Amir reviewed and confirmed the programme linking');\n  } else if(a.type==='EARN'){\n    setCap(a,'Payment received...');\n    const auth='A'+Math.floor(10000+Math.random()*89999);\n    E(a,'VISA','HLB CORE','EVENT card.purchase.authorised','WEBHOOK','json','N/A - asynchronous authorisation received from Visa.',\n      {event:'card.purchase.authorised',card:PURCHASE.card,merchant:PURCHASE.merchant,mcc:PURCHASE.mcc,amount:PURCHASE.amount,currency:'MYR',authCode:auth});\n    m.rm=Math.round((m.rm-PURCHASE.amount)*100)/100;a.refs.authCode=auth;\n    hist(a,rm(PURCHASE.amount)+' debited from HLB Visa Debit 4821 at '+PURCHASE.merchant);\n    return 1;\n  } else {\n    setCap(a,'Redemption requested...');\n    E(a,'CUSTOMER APP','SI','POST /si/loyalty/redemptions','SUCCESS','json',\n      {memberId:m.id,reward:REWARD.name,partner:REWARD.partner,guocoRequired:REWARD.guoco,conversionAccepted:a.meta&&a.meta.lots>0,channel:'HLB MOBILE'},\n      {event:'si.loyalty.redemption.created',redemptionId:a.id,state:'PENDING_FULFILMENT'});\n    hist(a,'Amir requested '+REWARD.name+' for '+pts(REWARD.guoco)+' Guoco Points');\n  }\n  a.st.request='RECEIVED';return 1;};\n/* ---- Core Banking posts the card transaction back to SI (EARN only) ---- */\nSTEP.requestCore=function(a){\n  const m=S.member;\n  E(a,'HLB CORE','SI','EVENT core.card.posted','WEBHOOK','json','N/A - asynchronous event received from Core Banking.',\n    {event:'core.card.posted',memberId:m.id,txnRef:'TXN-'+a.id,amount:PURCHASE.amount,currency:'MYR',merchant:PURCHASE.merchant,availableBalance:m.rm});\n  a.st.request='RECEIVED';return 1;};\n/* ---- step 2: rules, wallet and quote checks ---- */\nSTEP.rules=function(a){\n  const m=S.member;\n  if(a.type==='LINK'){\n    setCap(a,'Verifying your programmes and wallet...');\n    E(a,'SI','HLB CORE','POST /loyalty/eligibility','SUCCESS','json',{memberId:m.id,programmes:['HLB Rewards','Guoco Points']},\n      {eligible:true,segment:m.segment,kycStatus:m.kyc,consentOnFile:true});\n    hist(a,'Eligibility passed for HLB Rewards and Guoco Points');\n    return 1;\n  } else if(a.type==='EARN'){\n    setCap(a,'Calculating your points...');\n    E(a,'SI','LOYALTY RULES','POST /loyalty/earn/calculate','SUCCESS','json',\n      {memberId:m.id,merchant:PURCHASE.merchant,mcc:PURCHASE.mcc,amount:PURCHASE.amount,currency:'MYR',programmes:['HLB Rewards','Guoco Points']},\n      {earn:[{asset:'HLBP',points:a.legs[0].amount,rate:EARN_RATE.HLBP+' per RM 1'},{asset:'GUOCO',points:a.legs[1].amount,rate:EARN_RATE.GUOCO+' per RM 1'}],simultaneous:true});\n    hist(a,'Earn rule applied: +'+pts(a.legs[0].amount)+' HLBP and +'+pts(a.legs[1].amount)+' Guoco Points');\n  } else {\n    setCap(a,'Checking your balance...');\n    const q=a.meta||{};\n    E(a,'SI','LIMINAL','GET /liminal/vaults/orgs/HLB-MY-LOYALTY/wallets/HNWI','SUCCESS','json',{org:'HLB Malaysia Loyalty',wallet:'HNWI',include:'balances'},\n      {walletId:'W-HNWI-0001',balances:{HLBP:String(balance(ADDR.amir,'HLBP')),GUOCO:String(balance(ADDR.amir,'GUOCO'))},required:{GUOCO:String(REWARD.guoco)},shortfall:{GUOCO:String(q.short||0)}});\n    if(q.lots>0)E(a,'SI','LIMINAL','POST /liminal/dvp/quote','SUCCESS','json',   /* PROPOSED endpoint */\n      {swapContract:ADDR.swap,give:'HLBP',receive:'GUOCO',shortfall:q.short,lotSize:SWAPQ.guocoPerLot},\n      {quoteId:'Q-'+a.id,give:{asset:'HLBP',amount:String(q.hlbpIn)},receive:{asset:'GUOCO',amount:String(q.guocoOut)},rate:'2 HLBP = 1 GUOCO',counterparty:ADDR.guocoW,atomic:true,validFor:'120s'});\n    hist(a,q.lots>0?('Balance short by '+pts(q.short)+' Guoco. Quote: '+pts(q.hlbpIn)+' HLBP for '+pts(q.guocoOut)+' Guoco'):'Balance is sufficient');\n  }\n  a.st.rules='PASSED';return 1;};\n/* ---- Liminal confirms the HNWI wallet (LINK only) ---- */\nSTEP.rulesVault=function(a){\n  E(a,'SI','LIMINAL','GET /liminal/vaults/orgs/HLB-MY-LOYALTY/wallets/HNWI','SUCCESS','json',{org:'HLB Malaysia Loyalty',wallet:'HNWI',include:'balances'},\n    {walletId:'W-HNWI-0001',org:'HLB Ma