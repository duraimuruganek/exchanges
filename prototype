003c/div>'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#9776; Headers &amp; Activity Details\u003c/div>\u003cdiv class=\"ipb\">\u003cdiv class=\"rr\">'+\n       '\u003cpre id=\"iHdr\">\u003c/pre>\u003cdiv class=\"kv\" id=\"iTx\" style=\"align-content:start\">\u003c/div>\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003c/div>'+\n  '\u003c/div>';\n}\n/* ============ INTEGRATION SHOWCASE (inside the Event Stream panel) ============\n   Lets a presenter demonstrate mint / burn / ledger / core banking / app-request auth on demand,\n   with full mTLS + OAuth2 detail, without first running a customer activity to completion. A real\n   activity's own events still stream in normally below and carry the same Inspect integration button. */\nfunction showcaseRowHtml(){\n  return '\u003cdiv class=\"sc-row\">'+\n   '\u003cbutton class=\"scchip\" title=\"Customer app &rarr; SI auth\" onclick=\"showcase(\\'APPAUTH\\')\">&#128241; App Request\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Liminal issuance\" onclick=\"showcase(\\'MINT\\')\">&#129689; Mint\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Liminal redemption\" onclick=\"showcase(\\'BURN\\')\">&#128293; Burn\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Loyalty ledger sync\" onclick=\"showcase(\\'LEDGER\\')\">&#128209; Ledger\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; HLB CORE auth\" onclick=\"showcase(\\'COREBANK\\')\">&#127974; Core Bank\u003c/button>'+\n  '\u003c/div>';\n}\nfunction showcaseSamples(){\n  const m=S.member;\n  return {\n    APPAUTH:['CUSTOMER APP','SI','POST /si/loyalty/links','SUCCESS','json',\n      {memberId:m.id,programmes:[{programme:'HLB Rewards',asset:'HLBP',points:LINK_PTS.HLBP},{programme:'Guoco Points',asset:'GUOCO',points:LINK_PTS.GUOCO}],\n       consent:{reviewedByMember:true,benefits:['INSTANT_REDEMPTION','POINT_CONVERSION','UNIFIED_BALANCE']},channel:'HLB MOBILE'},\n      {event:'si.loya