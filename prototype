n(){recoveryTick(id);},i===0?900:700);\n}\nfunction finishRecovery(b){\n  const R=b.recovery;R.running=false;\n  const a=b.actId?actById(b.actId):null,r=b.remediation;\n  b.varianceBefore=b.variance;b.variance=0;b.status='RESOLVED';b.resolvedAt=hhmmss(clock);\n  bHist(b,'Recovery complete via '+(r?r.api:'remediation')+' - variance cleared');\n  addAudit('Treasury Manager','approved and executed remediation on '+b.id);\n  if(a){\n    if(R.mode==='RESUME'){\n      const l=b.legN?a.legs[b.legN-1]:null;\n      if(l&&l.st.chain!=='CONFIRMED')chainLeg(a,l,true);\n      a.breakId=null;a.status='IN_PROGRESS';hist(a,'DLT re-submission confirmed - orchestration resumed (no re-initiation)');\n      setCap(a,'Back on track - finalizing...');\n      a.step++;renderAll();setTimeout(function(){runStep(a.id);},600);\n    } else {\n      a.breakId=null;a.st.ledger='SYNCED';a.status='COMPLETED';\n      hist(a,'Break '+b.id+' corrected - ledger reconciled without replay');\n    }\n  }\n  toast(b.id+' resolved - variance cleared');renderAll();\n}\nfunction escalateBreak(id){const b=brkById(id);if(!b)return;b.status='ESCALATED';b.assignedTo='Treasury Manager';\n  bHist(b,'Escalated to Treasury Manager (severity raised)');\n  addAudit('Treasury Ops','escalated '+id+' to Treasury Manager');\n  logEvent({from:'TREASURY OPS',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/escalate',status:'WARN',kind:'json',headers:headers('json',id),\n    req:{caseId:id,severity:'HIGH',escalateTo:'Treasury Manager',slaBreach:false},\n    res:{caseId:id,status:'ESCALATED',assignedTo:'Treasury Manager'}});\n  toast(id+' escalated');renderAll();openBreakDrawer(id);}\n/* ============ BANK VIEW ============ */\nconst NAV=[['control','&#9638;','Control Center'],['sysint','&#127760;','System Integration'],['acts','&#128203;','Activities &amp; Legs'],['members','&#128100;','Members'],['vaults','&#128274;','Liminal Vaults'],\n ['swaps','&#8646;','DvP Swaps'],['ledger','&#127974;','Points Ledger'],['recon','&#9878;',