3c/th>\u003cth>Variance\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n     L.rows.map(function(r){return '\u003ctr>\u003ctd>'+r.src+'\u003c/td>\u003ctd style=\"font-size:11px;color:var(--muted)\">'+r.unit+'\u003c/td>\u003ctd class=\"mono\">'+pts(r.bal)+'\u003c/td>\u003ctd>'+vr(r.v)+'\u003c/td>\u003c/tr>';}).join('')+\n    '\u003c/tbody>\u003c/table>'+\n    '\u003cdiv class=\"donut\">\u003csvg width=\"100\" height=\"100\" viewBox=\"0 0 42 42\">'+\n     '\u003ccircle cx=\"21\" cy=\"21\" r=\"15.9\" fill=\"none\" stroke=\"#eef0f4\" stroke-width=\"5\">\u003c/circle>'+\n     '\u003ccircle cx=\"21\" cy=\"21\" r=\"15.9\" fill=\"none\" stroke=\"'+(over?'#b91c1c':'#15803d')+'\" stroke-width=\"5\" stroke-dasharray=\"'+(over?18:100)+' 100\" transform=\"rotate(-90 21 21)\">\u003c/circle>'+\n     '\u003c/svg>\u003cdiv class=\"ct\">Net Variance\u003c/div>\u003cdiv class=\"cv\" style=\"color:'+(over?'var(--red)':'var(--green)')+'\">'+pts(net)+'\u003c/div>\u003cdiv class=\"ct\">points\u003c/div>'+\n     '\u003cdiv class=\"thr\">Threshold: 0'+(over?'\u003cbr>\u003cb style=\"color:var(--red)\">BREACHED\u003c/b>':'')+'\u003c/div>\u003c/div>'+\n   '\u003c/div>'+reconRuns()+'\u003c/div>';\n}\nfunction breaksTableHtml(compact){\n  const list=compact?openBreaks().slice(0,4):S.breaks;\n  const rows=list.map(function(b){\n    const sc={OPEN:'bad',ASSIGNED:'wait',INVESTIGATING:'pend',PENDING_APPROVAL:'wait',ESCALATED:'bad',RESOLVED:'ok'}[b.status]||'mute';\n    return '\u003ctr class=\"trow\" onclick=\"openBreakDrawer(\\''+b.id+'\\')\">\u003ctd>\u003cspan class=\"txid\">'+b.id+'\u003c/span>\u003c/td>'+\n     '\u003ctd>'+b.source+'\u003c/td>\u003ctd class=\"mono\" style=\"color:'+(b.variance?'var(--red)':'var(--green)')+';font-weight:700\">'+pts(b.variance)+' '+b.token+'\u003c/td>'+\n     '\u003ctd style=\"font-size:11.5px\">'+b.reason+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+sc+'\">'+b.status.replace('_',' ')+'\u003c/span>\u003c/td>'+\n     '\u003ctd style=\"font-size:11.5px\">'+b.assignedTo+'\u003c/td>'+\n     '\u003ctd>\u003cbutton class=\"kebab\" onclick=\"event.stopPropagation();openBreakDrawer(\\''+b.id+'\\')\">&#8942;\u003c/button>\u003c/td>\u003c/tr>';\n  }).join('');\n  return '\u003cdiv class=\"card\" style=\"padding:14px 16px\">'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>Breaks / Exceptions\u003c/h3>\u003cspan class=\"pill bad\">'+openBreaks().length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Break ID\u003c/th>\u003cth>Source\u003c/th>\u003cth>Variance\u003c/th>\u003cth>Reason\u003c/th>\u003cth>Status\u003c/th>\u003cth>Assigned To\u003c/th>\u003cth>\u003c/th>\u003c/tr>\u003c/thead>'+\n   '\u003ctbody>'+(rows||'\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--green);font-weight:700;padding:16px\">&#10003; No open breaks - ledger and DLT match\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>'+\n   (compact?resolvedMini():'')+\n   (compact?'\u003cdiv style=\"margin-top:10px\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'breaks\\')\">View all breaks &rarr;\u003c/button>\u003c/div>':'')+'\u003c/div>';\n}\nfunction act(ic,label,fn){return '\u003cbutton class=\"actbtn\" onclick=\"'+fn+'\">\u003cspan class=\"ic\">'+ic+'\u003c/span>'+label+'\u003c/button>';}\nfunction railHtml(){\n  const ap=pendingAppr();\n  const mcHtml=ap.length?ap.slice(0,2).map(function(t){\n    return '\u003cdiv class=\"mc\">\u003cdiv class=\"t\">\u003cb>&#9203; Awaiting Checker Approval\u003c/b>\u003cspan class=\"id\">'+t.id+'\u003c/span>\u003c/div>'+\n     '\u003cdiv class=\"d\">'+TYPES[t.type].name+' &ndash; Amir (HNWI)\u003c/div>\u003cdiv class=\"m\">Submitted '+t.submitted+'\u003c/div>'+\n     '\u003cdiv class=\"m\" style=\"font-weight:700;color:var(--text)\">'+pointsSummary(t)+'\u003c/div>'+\n     '\u003cdiv class=\"mcflow\">\u003cdiv class=\"mcbox\">\u003cdiv class=\"r\">Maker\u003c/div>\u003cdiv class=\"n\">Ops Analyst\u003c/div>\u003cspan class=\"pill ok\">Submitted\u003c/span>\u003c/div>'+\n     '\u003cdiv style=\"color:var(--muted)\">&rarr;\u003c/div>'+\n     '\u003cdiv class=\"mcbox\">\u003cdiv class=\"r\">Checker\u003c/div>\u003cdiv class=\"n\">Treasury Manager\u003c/div>\u003cspan class=\"pill wait\">Pending\u003c/span>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"approveAct(\\''+t.id+'\\')\">Approve\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"rejectAct(\\''+t.id+'\\')\">Reject\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"openActDrawer(\\''+t.id+'\\')\">Details\u003c/button>\u003c/div>\u003c/div>';\n  }).join(''):'\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">Nothing awaiting checker approval. Maker-checker is off by default for this demo.\u003c/div>';\n  return '\u003cdiv class=\"rail\">'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">4) Treasury Actions\u003c/div>\u003cdiv class=\"actgrid\">'+\n    act('&#128101;','Maker-Checker Approval','setNav(\\'appr\\')')+\n    act('&#9208;',(S.flags.issuancePaused?'Resume On-chain Ops':'Pause On-chain Ops'),'toggleIssuance()')+\n    act('&#128274;','Open Liminal Vaults','setNav(\\'vaults\\')')+\n    act('&#128100;','Assign Break','setNav(\\'breaks\\')')+\n    act('&#9888;','Escalate Break','setNav(\\'breaks\\')')+\n    act('&#11015;','Download Reconciliation Report','downloadRecon()')+\n    '\u003cbutton class=\"actbtn wide\" onclick=\"setNav(\\'audit\\')\">\u003cspan class=\"ic\">&#128220;\u003c/span>Open Audit Trail\u003c/button>'+\n   '\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">&#8645; Maker-Checker Approval\u003cspan class=\"rt\" onclick=\"setNav(\\'appr\\')\">View all\u003c/span>\u003c/div>'+mcHtml+'\u003c/div>'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">Recent Activity / Audit Log\u003cspan class=\"rt\" onclick=\"setNav(\\'audit\\')\">View all\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"audit\">'+(auditAll().slice(0,6).map(function(x){return '\u003cdiv class=\"row\">\u003cspan class=\"tm\">'+x.time+'\u003c/span>\u003cspan>'+x.actor+' '+x.text+'\u003c/span>\u003c/div>';}).join('')||'\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">No activity yet.\u003c/div>')+'\u003c/div>'+\n    '\u003cdiv style=\"margin-top:9px\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'audit\\')\">Open full audit trail &rarr;\u003c/button>\u003c/div>\u003c/div>'+\n  '\u003c/div>';\n}\n/* ---- wallet helpers ---- */\nfunction histTable(h){\n  return '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>Type\u003c/th>\u003cth>Token\u003c/th>\u003cth>Amount\u003c/th>\u003cth>Counterparty\u003c/th>\u003cth>Method\u003c/th>\u003cth>Tx Hash\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (h.map(function(x){\n     const cls={IN:'in',OUT:'out',ISSUE:'mint',BURN:'burn'}[x.type];\n     const sign=(x.type==='IN'||x.type==='ISSUE')?'+':'-';\n     return '\u003ctr>\u003ctd class=\"mono\" style=\"font-size:11px\">'+x.tx.time.slice(12)+'\u003c/td>\u003ctd>\u003cspan class=\"dpill '+cls+'\">'+x.type+'\u003c/span>\u003c/td>\u003ctd>'+x.token+'\u003c/td>'+\n       '\u003ctd class=\"mono\">'+sign+' '+pts(x.amount)+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+esc(x.other==='Mint'||x.other==='Burn'?x.other:lbl(x.other))+'\u003c/td>'+\n       '\u003ctd class=\"mono\" style=\"font-size:11px\">'+x.tx.method+'\u003c/td>\u003ctd>'+hashLink(x.tx.hash)+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--muted2);padding:14px\">No transactions yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>';\n}\nfunction balBox(t,v,tok){return '\u003cdiv class=\"tile\">\u003cdiv class=\"th\">'+t+'\u003c/div>\u003cdiv class=\"tv\">\u003cdiv>\u003cspan class=\"amt\">'+pts(v)+'\u003c/span>\u003cspan class=\"cur\">'+tok+'\u003c/span>\u003c/div>\u003c/div>\u003c/div>';}\nfunction walletCard(w){\n  const zero=balance(w.addr,'HLBP')===0&&balance(w.addr,'GUOCO')===0&&addrHistory(w.addr).length===0;\n  return '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>'+w.name+'\u003c/h3>\u003cdiv style=\"font-size:11px;color:var(--muted)\">'+w.sub+'\u003c/div>\u003cdiv class=\"addrline\">'+w.addr+'\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+w.addr+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n   (zero&&w.addr===ADDR.amir?'\u003cdiv class=\"callout\" style=\"margin-top:12px\">Before minting: every balance in this wallet is 0.\u003c/div>':'')+\n   '\u003cdiv class=\"walbox\">'+balBox('HLBP balance',balance(w.addr,'HLBP'),'HLBP')+balBox('Guoco Points balance',balance(w.addr,'GUOCO'),'GUOCO')+'\u003c/div>'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>Transaction History\u003c/h3>\u003c/div>'+histTable(addrHistory(w.addr))+'\u003c/div>';\n}\nfunction delta(v,tok){return v?'\u003cspan class=\"'+(v>0?'dlt-up':'dlt-dn')+'\">'+(v>0?'+':'-')+pts(Math.abs(v))+' '+tok+'\u003c/span>':'';}\n/* ============ NAV VIEWS ============ */\nconst VIEWS={\n control:function(){return filtersHtml()+tilesHtml()+chartsHtml()+queueHtml(false)+'\u003cdiv class=\"two\" style=\"margin-top:16px\">'+reconHtml()+breaksTableHtml(true)+'\u003c/div>';},\n sysint:function(){\n   const flow1='\u003cspan class=\"n\">Customer App\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Core Banking (HLB CORE)\u003c/span>';\n   const flow2='\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Custody &amp; Tokenization\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">DLT (Etherscan-indexed)\u003c/span>';\n   const flow3='\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Loyalty Ledger\u003c/span>\u003cspan>&nbsp;&middot;&nbsp;\u003c/span>\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Notifications &amp; Partners\u003c/span>';\n   return '\u003cdiv class=\"sec-h\">\u003ch3>System Integration &ndash; Interconnectivity\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">The SI Orchestrator is the single integration layer between the customer channel, core banking and the digital asset custody / tokenization provider. No channel or custody vendor ever talks to core banking directly &mdash; every hop is authenticated, correlated and replay-safe.\u003c/div>'+\n   '\u003cdiv class=\"card wcard\" style=\"padding:16px\">\u003ch4 style=\"margin-bottom:8px\">Request lifecycle\u003c/h4>'+\n   '\u003cdiv class=\"stepflow\">'+flow1+'\u003c/div>\u003cdiv class=\"stepflow\">'+flow2+'\u003c/div>\u003cdiv class=\"stepflow\">'+flow3+'\u003c/div>'+\n   '\u003cdiv class=\"kv\" style=\"margin-top:14px\">'+\n     kv('Perimeter security','Mutual TLS (client + server certificate verification) on every external hop, starting with the customer app&#39;s first request')+\n     kv('Application security','OAuth 2.0 client-credentials, short-lived bearer tokens (5 min), scoped per downstream system')+\n     kv('Idempotency','X-Idempotency-Key on every write so a retried call cannot double-post or double-mint')+\n     kv('Correlation','X-Correlation-Id ties the app request, the Liminal call, the on-chain confirmation and the ledger sync back to one activity')+\n     kv('Async confirmation','On-chain finality and core banking postings arrive as signed webhooks, not polling')+\n     kv('Core banking connectivity','SI supports both directions: \u003cb>synchronous\u003c/b> request/response (e.g. POST /loyalty/eligibility, answered immediately) and \u003cb>asynchronous\u003c/b> webhook/event delivery (e.g. EVENT core.card.posted, fired whenever core banking is ready). Exactly which pattern a given core banking system uses is decided per integration &mdash; SI does not assume either one.')+\n     kv('Reconciliation','Loyalty ledger vs DLT balances are compared after every activity; a variance raises a case automatically')+\n     kv('Segregation of duties','Maker-checker approval gate in front of every on-chain mint / burn operation')+\n   '\u003c/div>\u003cdiv class=\"note\" style=\"margin-top:12px\">Click \u003cb>&#128274; Inspect integration\u003c/b> on a MINT, BURN, LEDGER UPDATE, CORE BANKING or APP REQUEST event in the Event Stream to see the full simulated mTLS handshake, the OAuth 2.0 token and the request/response headers, payload and footer for that call.\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\" style=\"padding:16px;margin-top:16px\">\u003ch4 style=\"margin-bottom:6px\">Custody &amp; tokenization: the vendor is pluggable behind SI\u003c/h4>'+\n   '\u003cdiv class=\"note\" style=\"margin:0 0 12px\">This rehearsal is scripted against \u003cb>Liminal\u003c/b> (managed MPC custody). Because SI owns the mint / burn / vault contract, an open-source stack can sit behind the same contract without the customer app, core banking or the ledger ever changing.\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Capability\u003c/th>\u003cth>Liminal (used in this demo)\u003c/th>\u003cth>Open-source alternative\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   '\u003ctr>\u003ctd>Token issuance API\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">POST /liminal/tokenization/mint\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">POST /fireflyapi/v1/tokens/mint\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Key custody\u003c/td>\u003ctd>MPC 2-of-3, managed HSM\u003c/td>\u003ctd>Hyperledger Fabric MSP identities signed via HSM / PKCS#11\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Ledger / network\u003c/td>\u003ctd>EVM network (Liminal-operated)\u003c/td>\u003ctd>Hyperledger Fabric channel (permissioned) fronted by a Hyperledger FireFly supernode\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Confirmation\u003c/td>\u003ctd>Webhook: digital_asset.mint.confirmed\u003c/td>\u003ctd>FireFly event listener: token_pool / token_transfer confirmed\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Auth to SI\u003c/td>\u003ctd>Mutual TLS + OAuth 2.0 client-credentials\u003c/td>\u003ctd>Mutual TLS + OAuth 2.0 client-credentials (same contract)\u003c/td>\u003c/tr>'+\n   '\u003c/tbody>\u003c/table>\u003c/div>'+\n   '\u003cdiv class=\"note\" style=\"margin-top:12px\">That is the SI role in one sentence: \u003cb>the DLT / custody vendor is a plug-in behind a stable, secured contract\u003c/b> &mdash; core banking, the ledger and the customer app never need to know which one is live.\u003c/div>\u003c/div>';\n },\n acts:function(){return filtersHtml()+queueHtml(true);},\n members:function(){\n   const m=S.member,p=position();\n   const led=function(t){return m.ledger[t];};\n   const chk=function(t){const dlt=balance(ADDR.amir,t);return led(t)===dlt?'\u003cspan class=\"pill ok\">Matched\u003c/span>':'\u003cspan class=\"pill bad\">Variance '+pts(led(t)-dlt)+'\u003c/span>';};\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Members\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:12px\">\u003cdiv class=\"av\" style=\"width:44px;height:44px;font-size:16px\">A\u003c/div>\u003cdiv>\u003ch3>Amir\u003c/h3>\u003cdiv style=\"font-size:11px;color:var(--muted)\">'+m.id+' &middot; '+m.segment+' member\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cspan class=\"pill '+(m.linked?'ok':'wait')+'\">'+(m.linked?'Programmes linked':'Not linked yet')+'\u003c/span>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"kv\" style=\"margin-top:14px\">'+kv('KYC',m.kyc)+kv('Card',PURCHASE.card)+kv('Account balance',rm(m.rm))+kv('Liminal org','HLB Malaysia Loyalty')+kv('Liminal wallet','HNWI &middot; '+addrLink(ADDR.amir))+\n   kv('Programmes','HLB Rewards (HLBP) + Guoco Points (GUOCO)')+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv class=\"sec-h\">\u003ch3>Programme Balances\u003c/h3>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Programme\u003c/th>\u003cth>Token\u003c/th>\u003cth>Loyalty Ledger (SI)\u003c/th>\u003cth>DLT (HNWI wallet)\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   '\u003ctr>\u003ctd>HLB Rewards\u003c/td>\u003ctd>HLBP\u003c/td>\u003ctd class=\"mono\">'+pts(led('HLBP'))+'\u003c/td>\u003ctd class=\"mono\">'+pts(p.memberH)+'\u003c/td>\u003ctd>'+chk('HLBP')+'\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Guoco Points\u003c/td>\u003ctd>GUOCO\u003c/td>\u003ctd class=\"mono\">'+pts(led('GUOCO'))+'\u003c/td>\u003ctd class=\"mono\">'+pts(p.memberG)+'\u003c/td>\u003ctd>'+chk('GUOCO')+'\u003c/td>\u003c/tr>\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv class=\"sec-h\">\u003ch3>Activity History\u003c/h3>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Activity\u003c/th>\u003cth>Type\u003c/th>\u003cth>Points\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.acts.map(function(a){return '\u003ctr class=\"trow\" onclick=\"openActDrawer(\\''+a.id+'\\')\">\u003ctd class=\"txid\">'+a.id+'\u003c/td>\u003ctd>'+TYPES[a.type].name+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+pointsSummary(a)+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+statusPill(a.status)+'\">'+STATUS_LBL(a.status)+'\u003c/span>\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"4\" style=\"color:var(--muted2);padding:14px\">No activity yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n vaults:function(){\n   const ws=WALLETS.filter(function(w){return w.org===S.org;});\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Liminal Vaults\u003c/h3>\u003cspan class=\"pill vio\">'+ORGS[S.org].name+'\u003c/span>\u003c/div>'+\n     '\u003cdiv class=\"c