ink'||v==='pay'||v==='redeem')&&ap&&S.cust.view!=='track'){toast('An activity is already in progress - showing its status');S.cust.actId=ap.id;v=(ap.st.fulfil==='DONE')?'done':'track';}\n  else if(v==='link'&&S.member.linked){toast('Your rewards are already linked');v='home';}\n  else if((v==='pay'||v==='rewards'||v==='redeem')&&!S.member.linked){toast('Link your rewards first');v='link';}\n  S.cust.view=v;if(v==='auth'){S.cust.pin=0;}renderCustomer();}\nfunction cAuthFor(f){\n  if(f==='redeem'){const q=redeemQuote();if(q.lots>0&&q.hlbpHave\u003cq.hlbpIn){toast('Not enough HLBP to convert');return;}}\n  S.cust.authFor=f;cGo('auth');}\nfunction cPinPress(){ if(S.cust.pin>=6)return; S.cust.pin++; renderCustomer();\n  if(S.cust.pin===6){ setTimeout(function(){ const f=S.cust.authFor;\n    if(f==='link')startAct('LINK'); else if(f==='pay')startAct('EARN'); else if(f==='redeem')startAct('RDM',redeemQuote()); },350); } }\nfunction cPinDel(){ if(S.cust.pin>0){S.cust.pin--;renderCustomer();} }\nfunction cReset(){ S.cust.view='home'; S.cust.pin=0; renderCustomer(); }\nfunction row(k,v){return '\u003cdiv class=\"rvr\">\u003cspan class=\"k\">'+k+'\u003c/span>\u003cspan class=\"v\">'+v+'\u003c/span>\u003c/div>';}\nfunction actRow(w,m,a,x){return '\u003cdiv style=\"display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #f0f1f4\">'+\n  '\u003cdiv>\u003cdiv style=\"font-weight:700;font-size:12.5px\">'+w+'\u003c/div>\u003cdiv style=\"font-size:10.5px;color:var(--muted)\">'+m+' '+x+'\u003c/div>\u003c/div>'+\n  '\u003cdiv style=\"font-weight:700;font-size:12.5px;text-align:right\">'+a+'\u003c/div>\u003c/div>';}\nfunction tokRow(tok,val,sub){const t=TOK[tok];\n  return '\u003cdiv class=\"prow\">\u003cdiv class=\"ptok\">\u003cdiv class=\"pdot2 '+t.cls+'\">'+(tok==='HLBP'?'HLB':'GH')+'\u003c/div>\u003cdiv>\u003cdiv class=\"n\">'+t.name+'\u003c/div>\u003cdiv class=\"s\">'+t.lbl+'\u003c/div>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"pval\">'+pts(val)+'\u003csmall>'+(sub||'points')+'\u003c/small>\u003c/div>\u003c/div>';}\nfunction trackModel(a){\n  const L=a.legs,ok=function(l){return l.st.chain==='CONFIRMED';},allOk=L.every(ok);\n  let steps,gi;\n  if(a.type==='LINK'){\n    steps=[{t:'Request received',s:'Your programme linking request is in.',d:a.st.request==='RECEIVED'},\n      {t:'Programmes verified',s:'Eligibility and your Liminal wallet are confirmed.',d:a.st.rules==='PASSED'},\n      {t:'Minting your points',s:pts(L[0].amount)+' HLB Rewards points and '+pts(L[1].amount)+' Guoco Points are issued to your wallet.',d:allOk},\n      {t:'Rewards activated',s:'Your unified balance is ready.',d:a.st.fulfil==='DONE'}];gi={S1:2};\n  } else if(a.type==='EARN'){\n    steps=[{t:'Payment received',s:rm(PURCHASE.amount)+' at '+PURCHASE.merchant+' with HLB Visa Debit \\u2022\\u2022\\u2022\\u2022'+PURCHASE.last4+'.',d:a.st.request==='RECEIVED'},\n      {t:'Points calculated',s:'+'+pts(L[0].amount)+' HLBP and +'+pts(L[1].amount)+' Guoco Points earned.',d:a.st.rules==='PASSED'},\n      {t:'Points credited',s:'Added to your wallet.',d:allOk&&a.st.fulfil==='DONE'}];gi={S2:2};\n  } else {\n    const sw=L.find(function(l){return l.op==='SWAP';});\n    steps=[{t:'Redemption requested',s:REWARD.name+' at '+REWARD.partner+' for '+pts(REWARD.guoco)+' Guoco Points.',d:a.st.request==='RECEIVED'},\n      {t:sw?'Converting your points':'Checking your balance',s:sw?('Swapping '+pts(sw.hlbp)+' HLBP for '+pts(sw.guoco)+' Guoco Points in one atomic transaction.'):'You have enough Guoco Points.',d:a.st.rules==='PASSED'&&(!sw||ok(sw))},\n      {t:'Redemption confirmed',s:'Booked with '+REWARD.partner+'.',d:a.st.fulfil==='DONE'}];gi={S3:1};\n  }\n  let cur=steps.length;for(let i=0;i\u003csteps.length;i++){if(!steps[i].d){cur=i;break;}}\n  return {steps:steps,cur:cur,gi:gi};\n}\nfunction doneModel(a){\n  if(a.type==='LINK')return {title:'Rewards Activated',sub:'HLB Rewards and Guoco Points are now linked',\n    rows:row('HLB Rewards','+'+pts(a.legs[0].amount)+' HLBP')+row('Guoco Points','+'+pts(a.legs[1].amount)+' pts')+row('Reference',a.id)};\n  if(a.type==='EARN')return {title:'Points Earned',sub:rm(PURCHASE.amount)+' at '+PURCHASE.merchant,\n    rows:row('HLB Rewards','+'+pts(a.legs[0].amount)+' HLBP')+row('Guoco Points','+'+pts(a.legs[1].amount)+' pts')+row('Paid with','HLB Visa Debit \\u2022\\u2022\\u2022\\u2022'+PURCHASE.last4)+row('Reference',a.id)};\n  const burnt=a.legs.filter(function(l){return l.op==='BURN';}).every(function(l){return l.st.chain==='CONFIRMED';});\n  return {title:'Redemption Success',sub:pts(REWARD.guoco)+' Guoco Points redeemed at '+REWARD.partner,\n    rows:row('Reward',REWARD.name)+row('Partner',REWARD.partner)+row('Booking reference',a.refs.booking||'&mdash;')+\n      row('Points settlement',burnt?'\u003cspan style=\"color:var(--green)\">Burned on-chain\u003c/span>':'\u003cspan style=\"color:var(--amber)\">Settling on-chain...\u003c/span>')+row('Reference',a.id)};\n}\nfunction renderCustomer(){\n  ['home','link','auth','pay','rewards','redeem','track','done'].forEach(function(v){\n    const el=document.getElementById('cv-'+v); if(el) el.classList.toggle('on', S.cust.view===v);\n  });\n  const kp=document.getElementById('cKp');\n  if(kp&&!kp._b){kp._b=1;const keys=['1','2','3','4','5','6','7','8','9','','0','DEL'];\n    kp.innerHTML=keys.map(function(k){ if(k==='')return '\u003cdiv>\u003c/div>';\n      if(k==='DEL')return '\u003cbutton onclick=\"cPinDel()\" style=\"font-size:12px\">&#9003;\u003c/button>';\n      return '\u003cbutton onclick=\"cPinPress()\">'+k+'\u003c/button>';}).join('');}\n  const pd=document.getElementById('cPin');\n  if(pd)pd.innerHTML=[0,1,2,3,4,5].map(function(i){return '\u003cdiv class=\"pdot'+(i\u003cS.cust.pin?' f':'')+'\">\u003c/div>';}).join('');\n  const m=S.member;\n  const bal=document.getElementById('cBal');if(bal)bal.textContent=rm(m.rm);\n  /* home: promo before activation, unified balance after */\n  const ht=document.getElementById('cHomeTop');\n  if(ht){\n    if(!m.linked)ht.innerHTML='\u003cdiv class=\"promo\">\u003cdiv class=\"a\">Link HLB Rewards and Guoco Points\u003c/div>\u003cdiv class=\"d\">One balance, instant redemption across partners.\u003c/div>\u003cbutton onclick=\"cGo(\\'link\\')\">Link Rewards\u003c/button>\u003c/div>';\n    else ht.innerHTML='\u003cdiv class=\"fc\">\u003cdiv class=\"l\">UNIFIED REWARDS BALANCE\u003c/div>\u003cdiv class=\"rvc\" style=\"background:transparent;padding:0;margin:0\">'+\n      tokRow('HLBP',availPts('HLBP'))+tokRow('GUOCO',availPts('GUOCO'))+'\u003c/div>'+\n      '\u003cdiv class=\"fxn\">Live from your Liminal wallet'+(m.reserved?' &middot; '+pts(m.reserved)+' Guoco reserved for a redemption':'')+'\u003c/div>\u003c/div>';\n  }\n  const rc=document.getElementById('cRecent');\n  if(rc){\n    const items=S.acts.filter(function(a){return a.status!=='REJECTED';}).map(function(a){\n      const pend=a.st.ledger==='SYNCED'||a.st.fulfil==='DONE'?'':'(in progress)';\n      if(a.type==='LINK')return actRow('Rewards activated',a.submitted.slice(12),'+'+pts(a.legs[0].amount)+' HLBP',pend);\n      if(a.type==='EARN')return actRow(PURCHASE.merchant,a.submitted.slice(12),'- '+rm(PURCHASE.amount),'+'+pts(a.legs[0].amount)+' HLBP, +'+pts(a.legs[1].amount)+' Guoco '+pend);\n      return actRow(REWARD.name,a.submitted.slice(12),'- '+pts(REWARD.guoco)+' Guoco',pend);}).join('');\n    rc.innerHTML=items+actRow('Village Grocer','Yesterday','- RM 236.40','')+actRow('Transfer from Savings','3 days ago','+ RM 20,000.00','');\n  }\n  const pb=document.getElementById('cPayBody');\n  if(pb)pb.innerHTML='\u003cdiv class=\"fc\">\u003cdiv class=\"l\">MERCHANT\u003c/div>\u003cdiv class=\"rcp\">\u003cdiv class=\"av\">MU\u003c/div>\u003cdiv>\u003cdiv class=\"n\">'+PURCHASE.merchant+'\u003c/div>\u003cdiv class=\"s\">Restaurant &middot; MCC '+PURCHASE.mcc+'\u003c/div>\u003c/div>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">AMOUNT\u003c/div>\u003cdiv style=\"font-size:27px;font-weight:800\">'+rm(PURCHASE.amount)+'\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Pay with\u003c/span>\u003cb>'+PURCHASE.card+'\u003c/b>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">YOU WILL EARN\u003c/div>\u003cdiv class=\"rvc\" style=\"background:transparent;padding:0;margin:0\">'+\n    tokRow('HLBP',PURCHASE.amount*EARN_RATE.HLBP,'HLBP, '+EARN_RATE.HLBP+' per RM 1')+tokRow('GUOCO',PURCHASE.amount*EARN_RATE.GUOCO,'points, '+EARN_RATE.GUOCO+' per RM 1')+'\u003c/div>\u003c/div>'+\n    '\u003cbutton class=\"pbtn\" onclick=\"cAuthFor(\\'pay\\')\">Pay '+rm(PURCHASE.amount)+'\u003c/button>';\n  const rw=document.getElementById('cRewardsBody');\n  if(rw)rw.innerHTML='\u003cdiv class=\"fc\" style=\"margin-bottom:14px\">\u003cdiv class=\"l\">YOUR BALANCE\u003c/div>\u003cdiv class=\"rvc\" style=\"background:transparent;padding:0;margin:0\">'+tokRow('HLBP',availPts('HLBP'))+tokRow('GUOCO',availPts('GUOCO'))+'\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"rwd\">\u003cdiv class=\"t\">'+REWARD.name+'\u003c/div>\u003cdiv class=\"s\">'+REWARD.partner+' &middot; '+pts(REWARD.guoco)+' Guoco Points\u003c/div>\u003cbutton class=\"pbtn\" style=\"margin:0\" onclick=\"cGo(\\'redeem\\')\">Redeem\u003c/button>\u003c/div>'+\n    '\u003cdiv class=\"rwd dis\">\u003cdiv class=\"t\">Pay with HLBP points\u003c/div>\u003cdiv class=\"s\">Use HLBP at checkout. Coming soon: ready after the first Visa rehearsal.\u003c/div>\u003cbutton class=\"gbtn\" style=\"margin:0\" disabled>Coming soon\u003c/button>\u003c/div>';\n  const rd=document.getElementById('cRedeemBody');\n  if(rd){const q=redeemQuote();const okH=q.lots===0||q.hlbpHave>=q.hlbpIn;\n    rd.innerHTML='\u003cdiv class=\"fc\">\u003cdiv class=\"l\">REWARD\u003c/div>\u003cdiv style=\"font-weight:800;font-size:14px\">'+REWARD.name+'\u003c/div>\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">'+REWARD.partner+'\u003c/div>'+\n      '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Cost\u003c/span>\u003cb>'+pts(q.need)+' Guoco Points\u003c/b>\u003c/div>'+\n      '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">You have\u003c/span>\u003cb>'+pts(q.have)+' Guoco Points\u003c/b>\u003c/div>\u003c/div>'+\n      (q.lots>0?'\u003cdiv class=\"warnnote\">\u003cb>You are '+pts(q.short)+' Guoco Points short.\u003c/b> Convert HLBP to Guoco Points in one atomic swap and redeem straight away.\u003c/div>'+\n        '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">CONVERT (DvP ATOMIC SWAP)\u003c/div>'+\n        '\u003cdiv class=\"cvt\">\u003cspan>You give\u003c/span>\u003cb>'+pts(q.hlbpIn)+' HLBP\u003c/b>\u003c/div>'+\n        '\u003cdiv class=\"cvt\">\u003cspan>You receive\u003c/span>\u003cb>'+pts(q.guocoOut)+' Guoco Points\u003c/b>\u003c/div>'+\n        '\u003cdiv class=\"fxn\">Rate 2 HLBP = 1 Guoco Point, converted in lots of '+pts(SWAPQ.guocoPerLot)+' Guoco Points.\u003c/div>\u003c/div>':\n        '\u003cdiv class=\"note\">You have enough Guoco Points. No conversion needed.\u003c/div>')+\n      '\u003cdiv class=\"rvc\">\u003cdiv class=\"rvr\">\u003cspan class=\"k\">HLBP after\u003c/span>\u003cspan class=\"v\">'+pts(q.hlbpHave-q.hlbpIn)+'\u003c/span>\u003c/div>'+\n      '\u003cdiv class=\"rvr\">\u003cspan class=\"k\">Guoco Points after\u003c/span>\u003cspan class=\"v\">'+pts(q.have+q.guocoOut-q.need)+'\u003c/span>\u003c/div>\u003c/div>'+\n      (okH?'':'\u003cdiv class=\"warnnote\">You do not have enough HLBP to cover the conversion.\u003c/div>')+\n      '\u003cbutton class=\"pbtn\" onclick=\"cAuthFor(\\'redeem\\')\"'+(okH?'':' disabled')+'>'+(q.lots>0?'Convert &amp; Redeem':'Redeem')+'\u003c/button>';}\n  const a=S.cust.actId?actById(S.cust.actId):null;\n  const tr=document.getElementById('cTrack');\n  if(tr&&a){\n    const M=trackModel(a);const gk=a.awaiting?a.awaiting.key:null;const gidx=(gk&&M.gi[gk]!==undefined)?M.gi[gk]:-1;\n    document.getElementById('cTrackTitle').textContent={LINK:'Activating Your Rewards',EARN:'Earning Your Points',RDM:'Redeeming Your Points'}[a.type];\n    tr.innerHTML=M.steps.map(function(s,i){\n      let cls='pending';if(i\u003cM.cur)cls='dn';else if(i===M.cur)cls=(gidx===i||a.status==='ON_HOLD'||a.status==='EXCEPTION')?'hl':'cu';\n      const mk=(i\u003cM.cur)?'&#10003;':String(i+1);\n      const extra=(gidx===i)?'\u003cdiv class=\"ts\" style=\"color:var(--amber);margin-top:3px\">Waiting for the bank to run this step.\u003c/div>':'';\n      return '\u003cdiv class=\"tstep '+cls+'\">\u003cdiv class=\"tdc\">\u003cdiv class=\"tdot\">'+mk+'\u003c/div>'+(i\u003cM.steps.length-1?'\u003cdiv class=\"tln\">\u003c/div>':'')+'\u003c/div>'+\n        '\u003cdiv>\u003cdiv class=\"tt\">'+s.t+'\u003c/div>\u003cdiv class=\"ts\">'+s.s+'\u003c/div>'+extra+'\u003c/div>\u003c/div>';}).join('');\n  }\n  const cap=document.getElementById('cCap');if(cap)cap.textContent=S.cust.caption||'';\n  const rf=document.getElementById('cRef');if(rf)rf.textContent=a?a.id:'';\n  const gt=document.getElementById('cGate');\n  if(gt){let g='';\n    if(a&&a.status==='AWAITING_APPROVAL')g='Your request needs an additional bank approval. Our team is reviewing it now.';\n    else if(a&&a.status==='REJECTED')g='Your request could not be completed and was declined by the bank.';\n    else if(a&&a.status==='ON_HOLD')g='Your request is temporarily on hold at the bank. Our operations team is on it.';\n    else if(a&&a.status==='EXCEPTION'&&a.legs.some(function(l){return l.st.chain==='FAILED';}))g='We hit a delay issuing your points. Our operations team is on it - nothing is lost and your request is still active.';\n    gt.innerHTML=g?('\u003cdiv class=\"warnnote\" style=\"margin-top:14px\">'+g+'\u003c/div>'):'';}\n  if(a&&S.cust.view==='done'){const d=doneModel(a);\n    document.getElementById('cDoneTitle').textContent=d.title;document.getElementById('cDoneSub').textContent=d.sub;document.getElementById('cDone').innerHTML=d.rows;}\n  renderInspector();\n  renderRunner();\n}\n/* ============ PRESENTER RUNNER BAR ============ */\nfunction phaseState(){\n  const r=S.acts.find(function(a){return a.type==='RDM';});\n  return [!!doneAct('LINK'),!!doneAct('EARN'),!!(r&&r.legs.some(function(l){return l.op==='SWAP'&&l.st.chain==='CONFIRMED';})),!!doneAct('RDM')];\n}\nfunction renderRunner(){\n  const el=document.getElementById('runner');if(!el)return;\n  const names=['1 Activation','2 Earning','3 Swap','4 Burn'];\n  const d=phaseState(),cur=d.indexOf(false);\n  const flow=names.map(function(n,i){const c=d[i]?'dn':(i===cur?'on':'');return '\u003cspan class=\"n '+c+'\">'+(d[i]?'&#10003; ':'')+n+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>')+\n    '\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\" style=\"opacity:.55\" title=\"Skipped for this rehearsal. Liminal is updating Figma and the script; ready a few days after the first Visa rehearsal.\">5 Pay with HLBP (next rehearsal)\u003c/span>';\n  const a=activeAct();\n  let right;\n  if(a){\n    if(a.manualHold||a.status==='ON_HOLD')right='\u003cspan class=\"pill bad\">On hold\u003c/span> '+(a.holdReason==='ISSUANCE'?'on-chain operations are paused':'manual hold by Treasury Ops');\n    else if(a.status==='AWAITING_APPROVAL')right='\u003cb>Next:\u003c/b> checker approval \u003cbutton class=\"sm pri\" onclick=\"approveAct(\\''+a.id+'\\')\">Approve\u003c/button>';\n    else if(a.status==='EXCEPTION'&&a.breakId)right='\u003cspan class=\"pill bad\">Exception\u003c/span> \u003cbutton class=\"lnk\" onclick=\"openBreakDrawer(\\''+a.breakId+'\\')\">Open '+a.breakId+'\u003c/button>';\n    else if(a.awaiting)right='\u003cb>Next:\u003c/b> '+GATE_LBL[a.awaiting.key]+' \u003cbutton class=\"sm pri\" onclick=\"releaseGate()\">Run\u003c/button>';\n    else{const k=(a.steps[a.step]||'close').split(':')[0];right='\u003cspan style=\"color:var(--muted)\">Running: '+(STEP_LBL[k]||k)+'...\u003c/span>';}\n  } else {\n    const hints=['Amir reviews and confirms the programme linking in the Customer App',\n      'Amir