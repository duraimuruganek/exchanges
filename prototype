r(Math.random()*16)];return s;}\nfunction sa(a){return a.slice(0,8)+'...'+a.slice(-4);}\nfunction lbl(a){return ADDR_LBL[a]||a;}\nfunction wn(a){return WNAME[a]||sa(a);}\nfunction tl(t){return TOK[t].lbl;}\nfunction pill(code){const d=ST[code]||['&mdash;','mute'];return '\u003cspan class=\"pill '+d[1]+'\">'+d[0]+'\u003c/span>';}\nfunction toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('on');\n  clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('on');},2800);}\nfunction headers(kind,corr,auth){\n  const h={'Content-Type':kind==='xml'?'application/xml; charset=utf-8':'application/json',\n    'X-Correlation-Id':'COR-'+(corr||'ATOM'),'X-Idempotency-Key':'IDEMP-'+Math.random().toString(36).slice(2,10).toUpperCase(),\n    'X-Channel':'SI-ORCHESTRATOR','Authorization':'Bearer ***REDACTED***','User-Agent':'SI-Orchestrator/1.0'};\n  if(auth){h['Authorization']='Bearer '+auth.oauth.accessToken;h['X-TLS-Version']=auth.mtls.tlsVersion;\n    h['X-Cipher-Suite']=auth.mtls.cipherSuite;h['X-Client-Cert-Thumbprint']=auth.mtls.clientCert.sha256Thumbprint;h['X-Mutual-TLS']=auth.mtls.mutualAuth;}\n  return h;\n}\nfunction hblock(h){return Object.keys(h).map(function(k){return k+': '+h[k];}).join('\\n');}\n/* ============ SI INTEGRATION SECURITY (simulated mTLS + OAuth2) ============\n   Illustrative only: certificates, tokens and signatures below are not connected to any real PKI,\n   OAuth server or blockchain network. Only four categories are \"major\" here (this use case has no\n   burn leg - a sukuk sell-back transfers the token back to the issuer instead of destroying it):\n   mint, updating the holdings register, connecting to core banking, and the app's first request. */\nconst MAJOR_LABEL={MINT:'MINT',BURN:'BURN',LEDGER:'LEDGER UPDATE',COREBANK:'CORE BANKING',APPAUTH:'APP REQUEST'};\nconst MAJOR_COLOR={MINT:'vio',BURN:'or',LEDGER:'tl',COREBANK:'ok',APPAUTH:'pend'};\nconst COREBANK_RE=/CORE/i; /* not /BANK/i too: \"HL Islamic Bank\" is the sukuk issuer/partner, not a core banking system */\nconst APP_RE=/^CUSTOMER APP$/;\nfunction classifyMajor(from,to,op){\n  /* Only SI's own integration hops are \"major\" - what a partner does on its own\n     side (e.g. Liminal submitting a signed transaction to the DLT) is that\n     partner's internal process, not part of SI's integration workflow. */\n  if(from!=='SI'&&to!=='SI')return null;\n  if(/mint/i.test(op))return 'MINT';\n  if(/burn/i.test(op))return 'BURN';\n  if(/ledger|gl\\/postings|register\\/sync/i.test(op))return 'LEDGER';\n  if(APP_RE.test(from))return 'APPAUTH';\n  if(COREBANK_RE.test(from)||COREBANK_RE.test(to))return 'COREBANK';\n  return null;\n}\nconst AUTH_PROFILES={\n  LIMINAL:{tokenEndpoint:'https://auth.liminal.example/oauth2/token',clientId:'si-orchestrator-hlib',scope:'liminal.tokenization.write liminal.dvp.write liminal.vaults.read',\n    audience:'https://api.liminal.example',issuer:'https://auth.liminal.example/',caIssuer:'CN=Liminal Enterprise CA, O=Liminal Custody Inc, C=US',serverSubject:'CN=api.liminal.example, O=Liminal Custody Inc'},\n  'HLB CORE':{tokenEndpoint:'https://auth.corebanking.hlb.internal/oauth2/token',clientId:'si-orchestrator-hlib',scope:'core.accounts.write core.suitability.read',\n    audience:'https://api.corebanking.hlb.internal',issuer:'https://auth.corebanking.hlb.internal/',caIssuer:'CN=HLB Enterprise Root CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=api.corebanking.hlb.internal, O=Hong Leong Bank'},\n  'HOLDINGS REGISTER':{tokenEndpoint:'https://auth.register.hlib.internal/oauth2/token',clientId:'si-orchestrator-hlib',scope:'register.write',\n    audience:'https://api.register.hlib.internal',issuer:'https://auth.register.hlib.internal/',caIssuer:'CN=HL Islamic Bank Root CA, O=HL Islamic Bank, C=MY',serverSubject:'CN=api.register.hlib.internal, O=HL Islamic Bank'},\n  'CUSTOMER APP':{tokenEndpoint:'https://auth.hlib.com.my/oauth2/token',clientId:'hlib-investor-app',scope:'si.sukuk.write si.sukuk.read',\n    audience:'https://si.hlib.com.my',issuer:'https://auth.hlib.com.my/',caIssuer:'CN=HL Islamic Bank Mobile CA, O=HL Islamic Bank, C=MY',serverSubject:'CN=si.hlib.com.my, O=HL Islamic Bank'},\n  DEFAULT:{tokenEndpoint:'https://auth.hlib.internal/oauth2/token',clientId:'si-orchestrator-hlib',scope:'si.default',\n    audience:'https://api.hlib.internal',issuer:'https://auth.hlib.internal/',caIssuer:'CN=HL Islamic Bank Root CA, O=HL Islamic Bank, C=MY',serverSubject:'CN=api.hlib.internal, O=HL Islamic Bank'}\n};\nfunction authTarget(category,from,to){\n  if(category==='MINT'||category==='BURN')return 'LIMINAL';\n  if(category==='APPAUTH')return from;\n  if(category==='COREBANK'){if(COREBANK_RE.test(to))return to;if(COREBANK_RE.test(from))return from;return to;}\n  return (from==='SI')?to:from;\n}\nfunction fp(bytes){const c='0123456789ABCDEF';const out=[];for(let i=0;i\u003cbytes;i++)out.push(c[Math.floor(Math.random()*16)]+c[Math.floor(Math.random()*16)]);return out.join(':');}\nfunction jwtCompact(payload){\n  const header={alg:'RS256',typ:'JWT',kid:'si-2025-09'};\n  const b64=function(o){return btoa(JSON.stringify(o)).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');};\n  const sig=Math.random().toString(36).slice(2,10)+Math.random().toString(36).slice(2,18);\n  return {compact:b64(header)+'.'+b64(payload)+'.'+sig,header:header,payload:payload};\n}\nfunction buildAuthSim(category,from,to){\n  const target=authTarget(category,from,to),profile=AUTH_PROFILES[target]||AUTH_PROFILES.DEFAULT;\n  const now=Math.floor(Date.now()/1000);\n  const payload={iss:profile.issuer,sub:'si-orchestrator@hlib-atom',aud:profile.audience,scope:profile.scope,iat:now,exp:now+300,jti:'jti-'+Math.random().toString(36).slice(2,10)};\n  const jwt=jwtCompact(payload);\n  return {category:category,target:target,\n    mtls:{tlsVersion:'TLS 1.3',cipherSuite:'TLS_AES_256_GCM_SHA384',\n      clientCert:{subject:'CN=si-orchestrator.hlib-atom.internal, OU=Digital Integration, O=HL Islamic Bank, C=MY',issuer:profile.caIssuer,serial:fp(8),sha256Thumbprint:fp(32)},\n      serverCert:{subject:profile.serverSubject,issuer:profile.caIssuer},mutualAuth:'PEER_VERIFIED'},\n    oauth:{tokenEndpoint:profile.tokenEndpoint,grantType:'client_credentials',clientId:profile.clientId,scope:profile.scope,tokenType:'Bearer',expiresIn:300,\n      accessToken:jwt.compact,decoded:{header:jwt.header,payload:jwt.payload}},\n    footer:{responseTimeMs:40+Math.floor(Math.random()*180),contentSha256:fp(32).replace(/:/g,'').toLowerCase(),traceId:'trace-'+Math.random().toString(36).slice(2,10),signature:'sig_'+Math.random().toString(36).slice(2,14)}\n  };\n}\nfunction logEvent(e){const id=S.events.length;const ev=Object.assign({id:id,time:tick()},e);S.events.push(ev);S.sel.event=id;return ev;}\nfunction E(a,from,to,op,status,kind,req,res){\n  const major=classifyMajor(from,to,op),auth=major?buildAuthSim(major,from,to):null;\n  const ev=logEvent({from:from,to:to,op:op,status:status,kind:kind,headers:headers(kind,a.id,auth),req:req,res:res,major:major,auth:auth,actId:a.id});\n  if(major&&a&&a.pendingInspect)a.pendingInspect.push(ev.id);\n  return ev;\n}\nconst WH='N/A - asynchronous webhook received from Liminal.';\nfunction addAudit(actor,text){S.audit.unshift({time:hhmmss(clock),actor:actor,text:text});if(S.audit.length>80)S.audit.pop();}\nfunction logoHtml(){return HLB_LOGO_URI?'\u003cimg src=\"'+HLB_LOGO_URI+'\" alt=\"HLB\">':'\u003cdiv class=\"wm\">HLB\u003c/div>';}\nfunction actById(id){return S.acts.find(function(a){return a.id===id;});}\nfunction brkById(id){return S.breaks.find(function(b){return b.id===id;});}\nfunction activeAct(){return S.acts.find(function(a){return a.status!=='COMPLETED'&&a.status!=='REJECTED';});}\nfunction curAct(){return actById(S.cust.actId)||activeAct()||S.acts[0]||null;}\nfunction doneAct(type){return S.acts.find(function(a){return a.type===type&&a.status==='COMPLETED';});}\nfunction hist(a,x){a.history.push({t:hhmmss(clock),x:x});}\nfunction hashLink(h){return h?'\u003ca class=\"xl\" title=\"Open the simulated Etherscan view\" onclick=\"event.stopPropagation();openExplorerTx(\\''+h+'\\')\">'+h.slice(0,10)+'...'+h.slice(-6)+'\u003c/a>':'&mdash;';}\nfunction addrLink(a){return '\u003ca class=\"xl\" title=\"Open the simulated Etherscan address page\" onclick=\"event.stopPropagation();openExplorerAddr(\\''+a+'\\')\">'+sa(a)+'\u003c/a>';}\n\n/* ============ ON-CHAIN REGISTRY (single source of truth for balances) ============ */\nfunction addChain(a,kind,to,moves,from,note){\n  S.block+=Math.floor(Math.random()*6)+2;\n  const tx={hash:hex(),block:S.block,kind:kind,method:METHOD[kind],actId:a.id,from:from,to:to,moves:moves,time:stamp(clock),note:note||''};\n  S.chain.push(tx);return tx;\n}\nfunction eachMove(fn){S.chain.forEach(function(t){t.moves.forEach(function(m){fn(m,t);});});}\nfunction balance(addr,token){let b=0;eachMove(function(m){if(m.token!==token)return;if(m.to===addr)b+=m.amount;if(m.from===addr)b-=m.amount;});return b;}\nfunction minted(token){let s=0;eachMove(function(m){if(m.token===token&&m.from===ZERO)s+=m.amount;});return s;}\nfunction burned(token){let s=0;eachMove(function(m){if(m.token===token&&m.to===ZERO)s+=m.amount;});return s;}\nfunction supply(token){return minted(token)-burned(token);}\n/* every token movement touching an address, newest first (what Etherscan calls token transfers) */\nfunction addrHistory(addr){\n  const out=[];\n  S.chain.forEach(function(t){t.moves.forEach(function(m){\n    if(m.to===addr||m.from===addr){\n      const inc=m.to===addr;\n      const type=m.from===ZERO?'ISSUE':(inc?'IN':'OUT');\n      const other=m.from===ZERO?'Mint':(inc?m.from:m.to);\n      out.push({tx:t,type:type,token:m.token,amount:m.amount,other:other});}\n  });});\n  return out.reverse();\n}\n\n/* ============ POSITION / REGISTER MATH ============ */\nfunction position(){\n  return {sukukOut:supply('SUKUK'),tmyrOut:supply('TMYR'),\n    buyerS:balance(ADDR.buyer,'SUKUK'),buyerT:balance(ADDR.buyer,'TMYR'),\n    hlibS:balance(ADDR.hlib,'SUKUK'),hlibT:balance(ADDR.hlib,'TMYR'),\n    dvpS:balance(ADDR.dvp,'SUKUK'),dvpT:balance(ADDR.dvp,'TMYR')};\n}\nfunction openBreaks(){return S.breaks.filter(function(b){return b.status!=='RESOLVED';});}\nfunction ledgers(){\n  const p=position();let sv=0,tv=0;\n  openBreaks().forEach(function(b){if(b.source==='Register vs DLT'){if(b.token==='SUKUK')sv+=b.variance;else tv+=b.variance;}});\n  return {p:p,sv:sv,tv:tv,net:sv+tv,\n    rows:[\n      {src:'DLT (Liminal)',unit:'Buyer wallet sukuk',bal:p.buyerS,v:0},\n      {src:'Holdings Register (SI)',unit:'Aisyah sukuk',bal:p.buyerS+sv,v:sv},\n      {src:'DLT (Liminal)',unit:'Buyer wallet tMYR',bal:p.buyerT,v:0},\n      {src:'Holdings Register (SI)',unit:'Aisyah tMYR',bal:p.buyerT+tv,v:tv},\n      {src:'DLT (Liminal)',unit:'DvP escrow (sukuk + tMYR, nil when idle)',bal:p.dvpS+p.dvpT,v:0}\n    ]};\n}\nfunction ledgerMatch(){\n  const L=ledgers();\n  if(!S.chain.length)return null;\n  if(!L.net)return 100;\n  const tot=L.p.buyerS*DEAL.price+L.p.buyerT;\n  return Math.max(0,100-Math.abs(L.sv*DEAL.price+L.tv)/Math.max(1,tot)*100);\n}\n\n/* ============ DEMO SAMPLE DATA (presentation only) ============\n   Display-only. It never touches the on-chain registry, wallets, activities, scripts or any calculation.\n   It gives the control center a realistic \"other investors\" backdrop. Set DEMO_SEED=false to remove all of it. */\nconst DEMO_SEED=true;\nconst SEED_ACTS=[\n  {id:'INV-20250516-0005',when:'16 May 16:02:44',type:'Sukuk purchase',who:'Rahim A., retail',pts:'3 sukuk x 10,000 tMYR'},\n  {id:'INV-20250516-0004',when:'16 May 11:18:09',type:'Sukuk purchase',who:'Mei Ling C., retail',pts:'1 sukuk x 10,000 tMYR'},\n  {id:'SEL-20250515-0003',when:'15 May 15:26:37',type:'Sukuk sale before maturity',who:'Ahmad Z., retail',pts:'2 sukuk x 10,000 tMYR'},\n  {id:'INV-20250515-0002',when:'15 May 10:41:52',type:'Sukuk purchase',who:'Ahmad Z., retail',pts:'5 sukuk x 10,000 tMYR'},\n  {id:'INV-20250514-0001',when:'14 May 14:09:30',type:'Sukuk purchase',who:'Farah N., retail',pts:'2 sukuk x 10,000 tMYR'}\n];\nconst SEED_STAGE={request:'RECEIVED',rules:'PASSED',sign:'SIGNED',chain:'CONFIRMED',fulfil:'DONE',ledger:'SYNCED'};\n/* holdings by other investors, so every screen agrees */\nconst BASE3={SUKUK:320,TMYR:1450000};\nconst SEED_AUDIT=[\n  {time:'10:24:18',actor:'Reconciliation Engine',text:'completed intraday reconciliation: holdings register and DLT balances matched, DvP escrow empty'},\n  {time:'10:05:42',actor:'Treasury Manager',text:'approved the daily sukuk position attestation'},\n  {time:'09:47:09',actor:'SI Orchestrator',text:'health check passed: Core Banking, Liminal Tokenization and DvP, DLT node'},\n  {time:'09:31:55',actor:'Ops Analyst',text:'confirmed static pricing: '+pts(DEAL.price)+' tMYR per sukuk (oracle pricing planned)'},\n  {time:'09:12:30',actor:'Treasury Ops',text:'opened the settlement window (token settlement runs 24/7, including Sundays)'},\n  {time:'08:58:03',actor:'SI Orchestrator',text:'refreshed instrument data for '+SUKUK_NAME},\n  {time:'08:45:12',actor:'Treasury Ops',text:'signed in to the control center'}\n];\nconst SEED_BREAKS=[\n  {id:'BRK-20250516-0002',source:'Register vs DLT',variance:-1,token:'SUKUK',label:'Post register adjustment',by:'Treasury Manager',at:'16 May 12:48:31'},\n  {id:'BRK-20250515-0001',source:'DLT Execution',variance:-10000,token:'TMYR',label:'Re-submit signed DLT transaction',by:'Treasury Manager',at:'15 May 15:02:19'}\n];\nfunction seedTok(t){return DEMO_SEED?BASE3[t]:0;}\nfunction seedOthers(t){return DEMO_SEED?' &middot; others '+pts(BASE3[t]):'';}\nfunction dpos(){\n  const p=position();if(!DEMO_SEED)return p;\n  return Object.assign({},p,{sukukOut:p.sukukOut+BASE3.SUKUK,tmyrOut:p.tmyrOut+BASE3.TMYR});\n}\nfunction dLedgerMatch(){const v=ledgerMatch();return (v===null&&DEMO_SEED)?100:v;}\nfunction auditAll(){return S.audit.concat(DEMO_SEED?SEED_AUDIT:[]);}\nfunction seedFiltered(){\n  if(!DEMO_SEED)return [];const f=S.filters;\n  return SEED_ACTS.filter(function(s){\n    if(f.status!=='All'&&f.status!=='Completed')return false;\n    if(f.q&&(s.id+' '+s.who+' '+s.type).toLowerCase().indexOf(f.q.toLowerCase())\u003c0)return false;\n    return true;});\n}\nfunction seedQueueRows(list){\n  return list.map(function(s){\n    return '\u003ctr class=\"seed\">\u003ctd>\u003cbutton class=\"kebab\" style=\"visibility:hidden\">&#9662;\u003c/button>\u003cspan class=\"txid\">'+s.id+'\u003c/span>'+\n      '\u003cdiv class=\"sub\">'+s.when+' &middot; Treasury Ops\u003c/div>\u003c/td>'+\n      '\u003ctd>\u003cdiv class=\"cust\">'+s.type+'\u003c/div>\u003cdiv class=\"chan\">('+s.who+')\u003c/div>\u003c/td>'+\n      '\u003ctd style=\"font-size:11px\">'+s.pts+'\u003c/td>'+\n      STAGES.map(function(k){return '\u003ctd>'+pill(SEED_STAGE[k])+'\u003c/td>';}).join('')+\n      '\u003ctd>\u003cspan class=\"pill ok\">Completed\u003c/span>\u003c/td>\u003c/tr>';}).join('');\n}\nfunction seedResolvedRows(){\n  if(!DEMO_SEED)return '';\n  return SEED_BREAKS.map(function(b){\n    return '\u003ctr class=\"seed\">\u003ctd class=\"txid\">'+b.id+'\u003c/td>\u003ctd>'+b.source+'\u003c/td>\u003ctd class=\"mono\">'+pts(b.variance)+' '+tl(b.token)+'\u003c/td>'+\n      '\u003ctd style=\"font-size:11.5px\">'+b.label+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+b.by+'\u003c/td>\u003ctd class=\"mono\">'+b.at.slice(7)+'\u003c/td>\u003c/tr>';}).join('');\n}\nfunction resolvedMini(){\n  if(!DEMO_SEED)return '';\n  return '\u003cdiv class=\"resolved-mini\">\u003cdiv class=\"h\">RECENTLY RESOLVED (LAST 7 DAYS)\u003c/div>'+SEED_BREAKS.map(function(b){\n    return '\u003cdiv class=\"r\">\u003cspan class=\"pill ok\">Resolved\u003c/span>\u003cspan class=\"id\">'+b.id+'\u003c/span>\u003cspan class=\"w\">'+b.source+' &middot; '+b.label+'\u003c/span>\u003cspan class=\"t\">'+b.at.slice(0,6)+'\u003c/span>\u003c/div>';}).join('')+'\u003c/div>';\n}\nfunction reconRuns(){\n  if(!DEMO_SEED)return '';\n  return '\u003cdiv class=\"runs\">\u003cspan>Last run \u003cb>10:24:18\u003c/b>\u003c/span>\u003cspan>Result \u003cb style=\"color:var(--green)\">Register, DLT and DvP escrow matched\u003c/b>\u003c/span>'+\n    '\u003cspan style=\"margin-left:auto\">Last 7 daily runs\u003c/span>\u003cspan class=\"dots\">\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003c/span>\u003c/div>';\n}\n\n/* ============ INTERACTIVE CHARTS (presentation only) ============\n   Pure inline SVG/HTML, no external library, so the file still works offline.\n   Charts blend the sample history with live demo data and only read state; they never change it.\n   UI choices (range, metric, hidden series) live in CHUI so they survive the control center re-rendering. */\nconst CHUI={};            /* per-chart UI state */\nconst CCACHE={};          /* geometry cache used by the hover handlers */\nconst CH_COL={blue:'#2563eb',teal:'#0e7490',green:'#15803d',orange:'#c2410c',violet:'#6d5ce7',amber:'#d9822b',slate:'#a7b1c2',red:'#b91c1c'};\nconst CHM=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nconst CHD=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];\nconst CH_DAYS=10;\nfunction chui(id,def){if(!CHUI[id])CHUI[id]=Object.assign({hidden:{}},def||{});return CHUI[id];}\nfunction chAttr(s){return esc(s).replace(/\"/g,'&quot;');}\nfunction chFmt(n){\n  const a=Math.abs(n),s=n\u003c0?'-':'';\n  if(a>=1e6)return s+(a/1e6).toFixed(a>=1e7?1:2).replace(/\\.0+$|0+$/,'').replace(/\\.$/,'')+'M';\n  if(a>=1e3)return s+(a/1e3).toFixed(a>=1e5?0:1).replace(/\\.0$/,'')+'k';\n  return s+(Math.round(a*10)/10);\n}\nfunction chRng(seed){let a=0;String(seed).split('').forEach(function(c){a=(a*31+c.charCodeAt(0))>>>0;});\n  return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\n/* a smooth, slightly noisy growth curve of 'days' points that always ends exactly on 'end' */\nfunction chHist(key,end,days,start){\n  const r=chRng(key),o=[];let drift=0;\n  for(let i=0;i\u003cdays;i++){const t=i/(days-1),base=start+(1-start)*Math.pow(t,1.35);\n    drift=drift*.6+(r()-.5)*.05;o.push(end*Math.max(0.02,base*(1+drift*(1-t))));}\n  o[days-1]=end;return o;\n}\nfunction chScale(max){\n  if(!(max>0))return {max:1,ticks:[0,1]};\n  const raw=max/4,p=Math.pow(10,Math.floor(Math.log10(raw))),f=raw/p;\n  const step=(f\u003c=1?1:f\u003c=2?2:f\u003c=2.5?2.5:f\u003c=5?5:10)*p,top=Math.ceil(max/step-1e-9)*step,ticks=[];\n  for(let v=0;v\u003c=top+1e-9;v+=step)ticks.push(v);\n  return {max:top,ticks:ticks};\n}\nfunction chDateOf(daysAgo){return new Date(clock.getFullYear(),clock.getMonth(),clock.getDate()-daysAgo);}\nfunction chDateLbl(daysAgo){const d=chDateOf(daysAgo);return d.getDate()+' '+CHM[d.getMonth()];}\nfunction chDaysList(n){const out=[];for(let k=n-1;k>=0;k--){const d=chDateOf(k);\n  out.push({key:d.getDate()+' '+CHM[d.getMonth()],label:CHD[d.getDay()]+' '+d.getDate(),today:k===0});}return out;}\nfunction chParseDay(s){const m=/(\\d{1,2}) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/.exec(s||'');return m?(+m[1])+' '+m[2]:'';}\nfunction chNums(s){return (String(s).match(/[\\d,]+/g)||[]).map(function(x){return +x.replace(/,/g,'');});}\n/* ---- small UI pieces ---- */\nfunction chSeg(id,k,opts,cur){\n  return '\u003cdiv class=\"seg\">'+opts.map(function(o){return '\u003cbutton class=\"'+(o[0]===cur?'on':'')+'\" onclick=\"chartOpt(\\''+id+'\\',\\''+k+'\\',\\''+o[0]+'\\')\">'+o[1]+'\u003c/button>';}).join('')+'\u003c/div>';\n}\nfunction chLegend(id,items,ui){\n  return items.map(function(it){return '\u003cbutton class=\"lg'+(ui.hidden[it.key]?' off':'')+'\" onclick=\"chartToggle(\\''+id+'\\',\\''+it.key+'\\')\">\u003ci style=\"background:'+it.color+'\">\u003c/i>'+it.label+'\u003c/button>';}).join('');\n}\nfunction chTipRows(rows,total,fmt){\n  return rows.map(function(r){return '\u003cdiv class=\"r\">\u003cspan>\u003ci style=\"background:'+r.color+'\">\u003c/i>\u003cspan class=\"k\">'+r.label+'\u003c/span>\u003c/span>\u003cb>'+fmt(r.value)+'\u003c/b>\u003c/div>';}).join('')+\n    (total!==null&&rows.length>1?'\u003cdiv class=\"r\" style=\"border-top:1px solid #33435c;margin-top:3px;padding-top:3px\">\u003cspan class=\"k\">Total\u003c/span>\u003cb>'+fmt(total)+'\u003c/b>\u003c/div>':'');\n}\n/* ---- line / area chart with crosshair ---- */\nfunction chLine(id,spec,ui){\n  const W=480,H=214,L=50,R=14,T=12,B=26,pw=W-L-R,ph=H-T-B;\n  const days=({'7D':7,'30D':30,'90D':90})[ui.range]||30;\n  const vis=spec.series.filter(function(s){return !ui.hidden[s.key];});\n  const data=vis.map(function(s){return s.values.slice(-days);});\n  let mx=0;data.forEach(function(a){a.forEach(function(v){if(v>mx)mx=v;});});\n  const sc=chScale(mx*1.04),X=function(i){return L+i*pw/(days-1);},Y=function(v){return T+ph-(v/sc.max)*ph;};\n  let s='\u003csvg viewBox=\"0 0 '+W+' '+H+'\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\">';\n  s+='\u003cg class=\"ch-grid\">'+sc.ticks.map(function(t){return '\u003cline x1=\"'+L+'\" x2=\"'+(W-R)+'\" y1=\"'+Y(t).toFixed(1)+'\" y2=\"'+Y(t).toFixed(1)+'\"/>';}).join('')+'\u003c/g>';\n  const nx=Math.min(days,5),idx=[];for(let k=0;k\u003cnx;k++)idx.push(Math.round(k*(days-1)/(nx-1)));\n  s+='\u003cg class=\"ch-ax\">'+sc.ticks.map(function(t){return '\u003ctext x=\"'+(L-6)+'\" y=\"'+(Y(t)+3).toFixed(1)+'\" text-anchor=\"end\">'+chFmt(t)+'\u003c/text>';}).join('')+\n     idx.map(function(i,k){return '\u003ctext x=\"'+X(i).toFixed(1)+'\" y=\"'+(H-8)+'\" text-anchor=\"'+(k===0?'start':(k===nx-1?'end':'middle'))+'\">'+chDateLbl(days-1-i)+'\u003c/text>';}).join('')+'\u003c/g>';\n  const xs=[];for(let i=0;i\u003cdays;i++)xs.push(X(i));\n  vis.forEach(function(se,k){\n    const pts=data[k].map(function(v,i){return xs[i].toFixed(1)+' '+Y(v).toFixed(1);}),line='M'+pts.join(' L');\n    s+='\u003cpath d=\"'+line+' L'+xs[days-1].toFixed(1)+' '+(T+ph)+' L'+xs[0].toFixed(1)+' '+(T+ph)+' Z\" fill=\"'+se.color+'\" opacity=\".09\"/>';\n    s+='\u003cpath d=\"'+line+'\" fill=\"none\" stroke=\"'+se.color+'\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n    s+='\u003ccircle cx=\"'+xs[days-1].toFixed(1)+'\" cy=\"'+Y(data[k][days-1]).toFixed(1)+'\" r=\"4\" fill=\"#fff\" stroke=\"'+se.color+'\" stroke-width=\"2\"/>';\n  });\n  s+='\u003cline class=\"ch-vl\" y1=\"'+T+'\" y2=\"'+(T+ph)+'\" stroke=\"#94a3b8\" stroke-dasharray=\"3 3\" style=\"display:none\"/>';\n  vis.forEach(function(se,k){s+='\u003ccircle class=\"ch-dot\" data-k=\"'+k+'\" r=\"4.5\" fill=\"'+se.color+'\" stroke=\"#fff\" stroke-width=\"2\" style=\"display:none\"/>';});\n  s+='\u003crect class=\"ch-hit\" data-ch=\"'+id+'\" x=\"'+L+'\" y=\"'+T+'\" width=\"'+pw+'\" height=\"'+ph+'\" fill=\"transparent\"/>\u003c/svg>';\n  CCACHE[id]={W:W,L:L,pw:pw,days:days,xs:xs,ys:data.map(function(a){return a.map(Y);}),\n    series:vis.map(function(se,k){return {label:se.label,color:se.color,vals:data[k]};}),fmt:spec.fmt};\n  return s;\n}\n/* ---- stacked column chart ---- */\nfunction chBars(id,spec,ui){\n  const W=480,H=214,L=50,R=10,T=12,B=26,pw=W-L-R,ph=H-T-B,n=spec.days.length;\n  const segs=spec.segs.filter(function(g){return !ui.hidden[g.key];});\n  const tot=spec.days.map(function(d){return segs.reduce(function(a,g){return a+(d.vals[g.key]||0);},0);});\n  const sc=chScale(Math.max.apply(null,tot.concat([0]))*1.05),bw=pw/n,gap=Math.min(10,bw*.3),w=bw-gap;\n  let s='\u003csvg viewBox=\"0 0 '+W+' '+H+'\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\">';\n  s+='\u003cg class=\"ch-grid\">'+sc.ticks.map(function(t){const y=T+ph-(t/sc.max)*ph;return '\u003cline x1=\"'+L+'\" x2=\"'+(W-R)+'\" y1=\"'+y.toFixed(1)+'\" y2=\"'+y.toFixed(1)+'\"/>';}).join('')+'\u003c/g>';\n  s+='\u003cg class=\"ch-ax\">'+sc.ticks.map(function(t){const y=T+ph-(t/sc.max)*ph;return '\u003ctext x=\"'+(L-6)+'\" y=\"'+(y+3).toFixed(1)+'\" text-anchor=\"end\">'+chFmt(t)+'\u003c/text>';}).join('')+'\u003c/g>';\n  spec.days.forEach(function(d,i){\n    const x=L+i*bw+gap/2,rows=segs.map(function(g){return {label:g.label,color:g.color,value:d.vals[g.key]||0};}).filter(function(r){return r.value>0;});\n    const tip='\u003cb>'+d.full+(d.today?' (today)':'')+'\u003c/b>'+(rows.length?chTipRows(rows,tot[i],spec.fmt):'\u003cdiv class=\"k\">No activity\u003c/div>');\n    s+='\u003cg class=\"ch-col\" data-tip=\"'+chAttr(tip)+'\">\u003crect class=\"chov\" x=\"'+(L+i*bw).toFixed(1)+'\" y=\"'+T+'\" width=\"'+bw.toFixed(1)+'\" height=\"'+ph+'\" fill=\"transparent\"/>';\n    let y=T+ph;\n    segs.forEach(function(g){const v=d.vals[g.key]||0;if(v\u003c=0)return;const h=v/sc.max*ph;y-=h;\n      s+='\u003crect class=\"cbar\" x=\"'+x.toFixed(1)+'\" y=\"'+y.toFixed(1)+'\" width=\"'+w.toFixed(1)+'\" height=\"'+Math.max(1,h).toFixed(1)+'\" rx=\"2.5\" fill=\"'+g.color+'\"/>';});\n    s+='\u003c/g>\u003ctext class=\"ch-x'+(d.today?' today':'')+'\" x=\"'+(x+w/2).toFixed(1)+'\" y=\"'+(H-8)+'\" text-anchor=\"middle\">'+d.label+'\u003c/text>';\n  });\n  return s+'\u003c/svg>';\n}\n/* ---- donut ---- */\nfunction chDonut(id,spec,ui){\n  const segs=spec.segs.filter(function(g){return !ui.hidden[g.key]&&g.value>0;}),tot=segs.reduce(function(a,g){return a+g.value;},0);\n  const sf=spec.short||spec.fmt,r=52,C=2*Math.PI*r;let off=0,arcs='';\n  if(!tot)arcs='\u003ccircle cx=\"80\" cy=\"80\" r=\"'+r+'\" fill=\"none\" stroke=\"#eef0f4\" stroke-width=\"20\"/>';\n  segs.forEach(function(g){\n    const len=g.value/tot*C,gp=segs.length>1?2:0,pct=Math.round(g.value/tot*1000)/10;\n    arcs+='\u003ccircle class=\"dn-seg\" cx=\"80\" cy=\"80\" r=\"'+r+'\" fill=\"none\" stroke=\"'+g.color+'\" stroke-width=\"20\" stroke-dasharray=\"'+(len-gp).toFixed(2)+' '+(C-len+gp).toFixed(2)+'\" stroke-dashoffset=\"'+(-off).toFixed(2)+'\" transform=\"rotate(-90 80 80)\" '+\n      'data-tip=\"'+chAttr('\u003cb>'+g.label+'\u003c/b>\u003cdiv class=\"r\">\u003cspan class=\"k\">'+spec.unit+'\u003c/span>\u003cb>'+spec.fmt(g.value)+'\u003c/b>\u003c/div>\u003cdiv class=\"r\">\u003cspan class=\"k\">Share\u003c/span>\u003cb>'+pct+'%\u003c/b>\u003c/div>')+'\" data-cv=\"'+chAttr(sf(g.value))+'\" data-cl=\"'+chAttr(g.label)+'\"/>';\n    off+=len;});\n  const svg='\u003csvg viewBox=\"0 0 160 160\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\" data-cv=\"'+chAttr(sf(tot))+'\" data-cl=\"'+chAttr(spec.center)+'\">'+arcs+\n    '\u003ctext class=\"dn-cv\" x=\"80\" y=\"82\" text-anchor=\"middle\">'+sf(tot)+'\u003c/text>\u003ctext class=\"dn-cl\" x=\"80\" y=\"97\" text-anchor=\"middle\">'+spec.center+'\u003c/text>\u003c/svg>';\n  const all=spec.segs.reduce(function(a,g){return a+g.value;},0);\n  const leg='\u003cdiv class=\"dn-leg\">'+spec.segs.map(function(g){\n    return '\u003cbutton class=\"r'+(ui.hidden[g.key]?' off':'')+'\" onclick=\"chartToggle(\\''+id+'\\',\\''+g.key+'\\')\">\u003ci style=\"background:'+g.color+'\">\u003c/i>\u003cspan>'+g.label+'\u003c/span>\u003cb>'+sf(g.value)+'\u003c/b>\u003cem>'+(all?Math.round(g.value/all*100):0)+'%\u003c/em>\u003c/button>';}).join('')+'\u003c/div>';\n  return '\u003cdiv class=\"dn-wrap\">'+svg+leg+'\u003c/div>';\n}\n/* ---- horizontal bars ---- */\nfunction chHBars(id,spec,ui){\n  const rows=spec.rows.map(function(r){const parts=r.parts.filter(function(p){return !ui.hidden[p.key];});\n    return {label:r.label,parts:parts,total:parts.reduce(function(a,p){return a+p.value;},0),note:r.note||''};});\n  const mx=Math.max.apply(null,rows.map(function(r){return r.total;}).concat([1]));\n  return rows.map(function(r){\n    const tip='\u003cb>'+r.label+'\u003c/b>'+chTipRows(r.parts.filter(function(p){return p.value>0;}),r.total,spec.fmt)+(r.note?'\u003cdiv class=\"k\" style=\"margin-top:3px\">'+r.note+'\u003c/div>':'');\n    return '\u003cdiv class=\"hb\" data-tip=\"'+chAttr(tip)+'\">\u003cspan class=\"l\">'+r.label+'\u003c/span>\u003cdiv class=\"tr\">'+\n      r.parts.map(function(p){return '\u003ci style=\"width:'+(p.value/mx*100).toFixed(2)+'%;background:'+p.color+'\">\u003c/i>';}).join('')+'\u003c/div>\u003cspan class=\"v\">'+(spec.short||spec.fmt)(r.total)+'\u003c/span>\u003c/div>';}).join('');\n}\n/* ---- cards ---- */\nfunction chCardInner(d){\n  const ui=chui(d.id,d.ui),b=d.build(ui);\n  return '\u003cdiv class=\"chh\">\u003cdiv>\u003cdiv class=\"cht\">'+b.title+'\u003c/div>\u003cdiv class=\"chs\">'+b.sub+'\u003c/div>\u003c/div>\u003cdiv class=\"chc\">'+(b.controls||'')+'\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"chb\">'+b.body+'\u003c/div>'+(b.legend?'\u003cdiv class=\"chl\">'+b.legend+'\u003c/div>':'');\n}\nfunction chartsHtml(){\n  if(typeof DEMO_SEED!=='undefined'&&!DEMO_SEED)return '';\n  return '\u003cdiv class=\"sec-h\">\u003ch3>Trends &amp; Analytics\u003c/h3>\u003cdiv class=\"i\" title=\"Sample history plus live demo data. Hover for details, use the toggles to change the view.\">i\u003c/div>'+\n    '\u003cspan class=\"chnote\">Hover for details &middot; click a legend item to show or hide it\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"chgrid\">'+chartDefs().map(function(d){return '\u003cdiv class=\"chcard\" id=\"ch-'+d.id+'\">'+chCardInner(d)+'\u003c/div>';}).join('')+'\u003c/div>';\n}\nfunction chartRefresh(id){const d=chartDefs().find(function(x){return x.id===id;}),el=document.getElementById('ch-'+id);if(d&&el)el.innerHTML=chCardInner(d);}\nfunction chartOpt(id,k,v){chui(id)[k]=v;chartRefresh(id);}\nfunction chartToggle(id,key){\n  const d=chartDefs().find(function(x){return x.id===id;});if(!d)return;const ui=chui(id,d.ui),keys=d.build(ui).keys||[];\n  if(!ui.hidden[key]&&keys.filter(function(k){return !ui.hidden[k];}).length\u003c=1)return;   /* always keep one visible */\n  ui.hidden[key]=!ui.hidden[key];chartRefresh(id);\n}\n/* ---- one delegated hover layer for every chart (tooltip, crosshair, donut centre) ---- */\n(function chInit(){\n  const tip=document.createElement('div');tip.className='ctip';tip.style.display='none';document.body.appendChild(tip);\n  let lastSvg=null,lastDn=null;\n  function place(x,y){const w=tip.offsetWidth,h=tip.offsetHeight;let l=x+14,t=y+14;\n    if(l+w>window.innerWidth-6)l=x-w-14;if(t+h>window.innerHeight-6)t=y-h-14;tip.style.left=Math.max(4,l)+'px';tip.style.top=Math.max(4,t)+'px';}\n  function show(html,x,y){tip.innerHTML=html;tip.style.display='block';place(x,y);}\n  function clearLine(){if(lastSvg){const vl=lastSvg.querySelector('.ch-vl');if(vl)vl.style.display='none';\n    lastSvg.querySelectorAll('.ch-dot').forEach(function(d){d.style.display='none';});lastSvg=null;}}\n  function clearDn(){if(lastDn){const cv=lastDn.querySelector('.dn-cv'),cl=lastDn.querySelector('.dn-cl');\n    if(cv)cv.textContent=lastDn.getAttribute('data-cv');if(cl)cl.textContent=lastDn.getAttribute('data-cl');lastDn=null;}}\n  function hoverLine(hit,e){\n    const c=CCACHE[hit.getAttribute('data-ch')],svg=hit.ownerSVGElement;if(!c||!svg)return;\n    const r=svg.getBoundingClientRect();if(!r.width)return;\n    const x=(e.clientX-r.left)*(c.W/r.width);let i=Math.round((x-c.L)/c.pw*(c.days-1));i=Math.max(0,Math.min(c.days-1,i));\n    if(lastSvg&&lastSvg!==svg)clearLine();lastSvg=svg;\n    const vl=svg.querySelector('.ch-vl');vl.setAttribute('x1',c.xs[i]);vl.setAttribute('x2',c.xs[i]);vl.style.display='';\n    svg.querySelectorAll('.ch-dot').forEach(function(d){const k=+d.getAttribute('data-k');d.setAttribute('cx',c.xs[i]);d.setAttribute('cy',c.ys[k][i]);d.style.display='';});\n    const rows=c.series.map(function(s){return {label:s.label,color:s.color,value:s.vals[i]};});\n    show('\u003cb>'+chDateLbl(c.days-1-i)+(i===c.days-1?' (today, live)':'')+'\u003c/b>'+chTipRows(rows,null,c.fmt),e.clientX,e.clientY);\n  }\n  document.addEventListener('mousemove',function(e){\n    const el=e.target&&e.target.closest?e.target:null;if(!el){return;}\n    const hit=el.closest('.ch-hit');\n    if(hit){clearDn();hoverLine(hit,e);return;}\n    clearLine();\n    const t=el.closest('[data-tip]');\n    if(t){show(t.getAttribute('data-tip'),e.clientX,e.clientY);\n      if(t.hasAttribute('data-cv')&&t.ownerSVGElement){const svg=t.ownerSVGElement;if(lastDn&&lastDn!==svg)clearDn();lastDn=svg;\n        svg.querySelector('.dn-cv').textContent=t.getAttribute('data-cv');svg.querySelector('.dn-cl').textContent=t.getAttribute('data-cl');}\n      else clearDn();\n      return;}\n    clearDn();tip.style.display='none';\n  });\n  document.documentElement.addEventListener('mouseleave',function(){clearLine();clearDn();tip.style.display='none';});\n  document.addEventListener('scroll',function(){tip.style.display='none';},true);\n})();\n/* live API calls per external system (internal actors are skipped) */\nfunction chSystems(){\n  const m={};S.events.forEach(function(e){[e.from,e.to].forEach(function(n){\n    if(!n||/^(SI\\b|CUSTOMER|CORPORATE|TREASURY|OPS|RECONCILIATION|MAKER|CHECKER|HLB MOBILE)/.test(n))return;m[n]=(m[n]||0)+1;});});\n  return m;\n}\n\n/* ---- Case 3 chart data: sample orders + live orders ---- */\nconst CH_SIDE={BUY:{label:'Purchases',color:CH_COL.blue},SELL:{label:'Sales before maturity',color:CH_COL.orange}};\nconst SEED_API={LIMINAL:212,DLT:187,'HLB CORE':96,'HOLDINGS REGISTER':71,'HL ISLAMIC BANK':64,NOTIFICATIONS:58,PRICING:49};\nfunction chOrders(){\n  const out=[];\n  SEED_ACTS.forEach(function(s){out.push({day:chParseDay(s.when),side:s.id.slice(0,3)==='SEL'?'SELL':'BUY',units:chNums(s.pts)[0],live:false});});\n  S.acts.forEach(function(a){if(a.status==='REJECTED')return;out.push({day:chParseDay(a.submitted),side:a.type==='SELL'?'SELL':'BUY',units:DEAL.units,live:true});});\n  return out;\n}\nfunction chTrendSpec(P){\n  const n=90,eS=BASE3.SUKUK*DEAL.price,eT=BASE3.TMYR;   /* start-of-demo values, so only \"today\" moves */\n  const s=chHist('uc3-sukuk',eS,n,.20),t=chHist('uc3-tmyr',eT,n,.12);s[n-1]=P.sukukOut*DEAL.price;t[n-1]=P.tmyrOut;\n  return {aria:'Sukuk outstanding and tMYR outstanding over time',fmt:function(v){return money(v,0)+' RM';},series:[\n    {key:'sukuk',label:'Sukuk outstanding (RM value)',color:CH_COL.blue,values:s},{key:'tmyr',label:'tMYR outstanding',color:CH_COL.teal,values:t}]};\n}\nfunction chartDefs(){\n  const P=dpos(),orders=chOrders(),segs=Object.keys(CH_SIDE).map(function(k){return {key:k,label:CH_SIDE[k].label,color:CH_SIDE[k].color};});\n  return [\n   {id:'trend',ui:{range:'30D'},build:function(ui){const sp=chTrendSpec(P);\n     return {title:'Sukuk and tMYR outstanding',sub:'Value in RM: sample history, today is live',\n       controls:chSeg('trend','range',[['7D','7D'],['30D','30D'],['90D','90D']],ui.range),body:chLine('trend',sp,ui),\n       legend:chLegend('trend',sp.series,ui),keys:sp.series.map(function(s){return s.key;})};}},\n   {id:'days',ui:{metric:'units'},build:function(ui){\n     const m=ui.metric,days=chDaysList(CH_DAYS).map(function(d){const vals={};\n       orders.forEach(function(o){if(o.day===d.key)vals[o.side]=(vals[o.side]||0)+(m==='units'?o.units:o.units*DEAL.price);});\n       return {label:d.label,full:d.key,today:d.today,vals:vals};});\n     const sp={aria:'Sukuk orders per day',days:days,segs:segs,fmt:m==='units'?function(v){return v+(v===1?' unit':' units');}:function(v){return money(v,0)+' tMYR';}};\n     return {title:'Orders by day',sub:'Last '+CH_DAYS+' days, purchases and sales',\n       controls:chSeg('days','metric',[['units','Units'],['value','Value']],m),body:chBars('days',sp,ui),\n       legend:chLegend('days',segs,ui),keys:segs.map(function(s){return s.key;})};}},\n   {id:'donut',ui:{},build:function(ui){\n     const sg=segs.map(function(g){return Object.assign({},g,{value:orders.filter(function(o){return o.side===g.key;}).length});});\n     const sp={aria:'Order mix',segs:sg,unit:'Orders',center:'orders',fmt:function(v){return String(v);}};\n     return {title:'Order mix',sub:'Purchases against sales before maturity',body:chDonut('donut',sp,ui),legend:'',keys:sg.map(function(s){return s.key;})};}},\n   {id:'api',ui:{scope:'all'},build:function(ui){\n     const live=chSystems(),names={};Object.keys(SEED_API).forEach(function(k){names[k]=1;});Object.keys(live).forEach(function(k){names[k]=1;});\n     const parts=[{key:'sample',label:'Earlier today (all investors)',color:CH_COL.slate},{key:'live',label:'This demo (live)',color:CH_COL.blue}];\n     const rws=Object.keys(names).map(function(k){return {label:k,parts:[Object.assign({},parts[0],{value:ui.scope==='live'?0:(SEED_API[k]||0)}),Object.assign({},parts[1],{value:live[k]||0})]};})\n       .filter(function(r){return ui.scope!=='live'||r.parts[1].value>0;}).sort(function(a,b){return (b.parts[0].value+b.parts[1].value)-(a.parts[0].value+a.parts[1].value);}).slice(0,7);\n     const sp={rows:rws,fmt:function(v){return v+(v===1?' call':' calls');},short:function(v){return String(v);}};\n     return {title:'API calls by system',sub:'Integration traffic across Liminal, DLT, Core and partners',\n       controls:chSeg('api','scope',[['all','Today'],['live','This demo']],ui.scope),\n       body:rws.length?chHBars('api',sp,ui):'\u003cdiv class=\"chs\" style=\"padding:34px 0;text-align:center\">No API calls yet in this demo. Start an activity in the Customer App.\u003c/div>',\n       legend:ui.scope==='live'?'':chLegend('api',parts,ui),keys:['sample','live']};}}\n  ];\n}\n/* ============ CUSTOMER APP (Aisyah, the buyer) ============ */\nfunction buildCustomerShell(){\n  document.getElementById('paneCustomer').innerHTML=\n  '\u003cdiv class=\"cust-wrap\">\u003cdiv class=\"appcol\">\u003cdiv class=\"phone\">'+\n   '\u003cdiv class=\"aph\">\u003cdiv class=\"logo\">'+logoHtml()+'\u003c/div>\u003cdiv>&#128276;&nbsp;&nbsp;&#128100;\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-home\" class=\"view on\">'+\n     '\u003cdiv style=\"font-size:12.5px;color:var(--muted)\">Welcome back,\u003c/div>'+\n     '\u003cdiv style=\"font-size:18px;font-weight:800;margin-bottom:14px\">Aisyah\u003c/div>'+\n     '\u003cdiv class=\"balcard\">\u003cdiv class=\"l\">AVAILABLE BALANCE\u003c/div>\u003cdiv class=\"a\" id=\"cBal\">RM 85,420.35\u003c/div>\u003cdiv class=\"c\">HLB Premier Account &bull;&bull;&bull;&bull; 2047\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cHomeTop\">\u003c/div>'+\n     '\u003cdiv class=\"qa\">\u003cbutton class=\"qab p\" onclick=\"cGo(\\'sukuk\\')\">\u003cspan class=\"i\">&#128200;\u003c/span>Invest\u003c/button>'+\n       '\u003cbutton class=\"qab\" onclick=\"cGo(\\'portfolio\\')\">\u003cspan class=\"i\">&#128188;\u003c/span>My Sukuk\u003c/button>'+\n       '\u003cbutton class=\"qab\" onclick=\"cGo(\\'sell\\')\">\u003cspan class=\"i\">&#128260;\u003c/span>Sell\u003c/button>'+\n       '\u003cbutton class=\"qab\">\u003cspan class=\"i\">&#8943;\u003c/span>More\u003c/button>\u003c/div>'+\n     '\u003cdiv style=\"font-size:10.5px;font-weight:700;color:var(--muted);margin-bottom:9px\">RECENT ACTIVITY\u003c/div>'+\n     '\u003cdiv id=\"cRecent\">\u003c/div>'+\n   '\u003c/div>'+\n   '\u003cdiv id=\"cv-sukuk\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'home\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">Sukuk Investment\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cSukukBody\">\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-invest\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'sukuk\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">Review Your Order\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cInvestBody\">\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-portfolio\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'home\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">My Sukuk\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cPortBody\">\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-sell\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'portfolio\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">Sell Before Maturity\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cSellBody\">\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-auth\" class=\"view\">'+\n     '\u003cdiv class=\"bkrow\">\u003cbutton onclick=\"cGo(\\'home\\')\">&larr;\u003c/button>\u003cdiv class=\"t\">Authorize\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"pinw\">\u003cdiv style=\"font-size:12.5px;color:var(--muted)\">Enter your 6-digit PIN to authorize\u003c/div>'+\n     '\u003cdiv class=\"pind\" id=\"cPin\">\u003c/div>\u003cdiv class=\"kp\" id=\"cKp\">\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-track\" class=\"view\">'+\n     '\u003cdiv style=\"font-size:16px;font-weight:800;margin-bottom:14px\" id=\"cTrackTitle\">Status\u003c/div>'+\n     '\u003cdiv class=\"trs\">\u003cdiv class=\"cp\" id=\"cCap\">\u003c/div>\u003cdiv class=\"rf\" id=\"cRef\">\u003c/div>\u003c/div>'+\n     '\u003cdiv id=\"cTrack\">\u003c/div>\u003cdiv id=\"cGate\">\u003c/div>\u003c/div>'+\n   '\u003cdiv id=\"cv-done\" class=\"view\">'+\n     '\u003cdiv class=\"dicon\">&#10003;\u003c/div>'+\n     '\u003cdiv style=\"text-align:center;font-size:17px;font-weight:800\" id=\"cDoneTitle\">\u003c/div>'+\n     '\u003cdiv style=\"text-align:center;font-size:12px;color:var(--muted);margin-bottom:18px\" id=\"cDoneSub\">\u003c/div>'+\n     '\u003cdiv class=\"rvc\" id=\"cDone\">\u003c/div>'+\n     '\u003cbutton class=\"pbtn\" onclick=\"cReset()\">Back to Home\u003c/button>'+\n     '\u003cbutton class=\"gbtn\" onclick=\"setMode(\\'dash\\')\">View in Bank View\u003c/button>\u003c/div>'+\n  '\u003c/div>\u003c/div>'+ inspectorHtml() +'\u003c/div>';\n}\nfunction inspectorHtml(){\n  return '\u003cdiv class=\"inspcol\">'+\n   '\u003cdiv class=\"ipanel ev-panel\">\u003cdiv class=\"iph\">&#128225; Event Stream\u003cspan class=\"n\" id=\"iEvN\">0\u003c/span>\u003c/div>'+showcaseRowHtml()+'\u003cdiv class=\"ipb\" id=\"iEvents\">\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"detail-col\">'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#8593; Request\u003c/div>\u003cdiv class=\"ipb\">\u003cpre id=\"iReq\">Select an event.\u003c/pre>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#8595; Response\u003c/div>\u003cdiv class=\"ipb\">\u003cpre id=\"iRes\">\u003c/pre>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"ipanel\">\u003cdiv class=\"iph\">&#9776; Headers &amp; Activity Details\u003c/div>\u003cdiv class=\"ipb\">\u003cdiv class=\"rr\">'+\n       '\u003cpre id=\"iHdr\">\u003c/pre>\u003cdiv class=\"kv\" id=\"iTx\" style=\"align-content:start\">\u003c/div>\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003c/div>'+\n  '\u003c/div>';\n}\n/* ============ INTEGRATION SHOWCASE (inside the Event Stream panel) ============\n   Lets a presenter demonstrate mint / register update / core banking / app-request auth on demand,\n   with full mTLS + OAuth2 detail, without first running an order to completion. A real order's own\n   events still stream in normally below and carry the same Inspect integration button. This use case\n   has no burn leg: selling the sukuk back transfers it to the issuer instead of destroying it. */\nfunction showcaseRowHtml(){\n  return '\u003cdiv class=\"sc-row\">'+\n   '\u003cbutton class=\"scchip\" title=\"Customer app &rarr; SI auth\" onclick=\"showcase(\\'APPAUTH\\')\">&#128241; App Request\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Liminal issuance\" onclick=\"showcase(\\'MINT\\')\">&#129689; Mint\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; Holdings register sync\" onclick=\"showcase(\\'LEDGER\\')\">&#128209; Ledger\u003c/button>'+\n   '\u003cbutton class=\"scchip\" title=\"SI &rarr; HLB CORE auth\" onclick=\"showcase(\\'COREBANK\\')\">&#127974; Core Bank\u003c/button>'+\n  '\u003c/div>';\n}\nfunction showcaseSamples(){\n  const m=S.member;\n  return {\n    APPAUTH:['CUSTOMER APP','SI','POST /si/sukuk/orders','SUCCESS','json',\n      {investorId:m.id,instrument:SUKUK_NAME,side:'BUY',units:DEAL.units,pricePerUnit:DEAL.price,currency:'MYR',settlement:'DVP_ATOMIC',channel:'HLB MOBILE'},\n      {event:'si.sukuk.order.created',orderId:'DEMO-APP-REQ',state:'PENDING_SETTLEMENT'}],\n    MINT:['SI','LIMINAL','POST /liminal/tokenization/mint','SUCCESS','json',\n      {transactionId:'DEMO-MINT-L1',asset:'SUKUK',amount:String(DEAL.units),wallet:ADDR.buyer,org:'HLB Malaysia',standard:'ERC-1400',network:NETWORK,signingPolicy:'MPC 2-of-3'},\n      {liminalTransactionId:'LIM-I-DEMO-MINT-L1',status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'}],\n    LEDGER:['SI','HOLDINGS REGISTER','POST /investors/register/sync','SUCCESS','json',\n      {investorId:m.id,activityId:'DEMO-LEDGER',deltas:{SUKUK:DEAL.units,TMYR:-DEAL.price},dltBalances:{SUKUK:balance(ADDR.buyer,'SUKUK'),TMYR:balance(ADDR.buyer,'TMYR')}},\n      {registerBalances:{SUKUK:m.ledger.SUKUK,TMYR:m.ledger.TMYR},status:'SYNCED'}],\n    COREBANK:['SI','HLB CORE','POST /core/accounts/debit','SUCCESS','json',\n      {investorId:m.id,account:'HLB Premier Account',amount:DEAL.price,currency:'MYR',purpose:'SUKUK_SUBSCRIPTION',reserveFor:'tMYR 1:1'},\n      {status:'DEBITED',reserveRef:'RSV-DEMO-APP-REQ',availableBalance:m.rm}]\n  };\n}\nfunction showcase(cat){\n  const s=showcaseSamples()[cat];if(!s)return;\n  const fake={id:'DEMO-'+cat+'-'+Math.floor(100+Math.random()*900)};\n  const ev=E(fake,s[0],s[1],s[2],s[3],s[4],s[5],s[6]);\n  renderInspector();if(S.mode!=='customer')renderDash();\n  openIntegrationDrawer(ev.id);\n}\nfunction holdsUnits(){return balance(ADDR.buyer,'SUKUK');}\nfunction cGo(v){\n  const ap=activeAct();\n  if((v==='invest'||v==='sell')&&ap&&S.cust.view!=='track'){toast('An activity is already in progress - showing its status');S.cust.actId=ap.id;v=(ap.st.fulfil==='DONE')?'done':'track';}\n  else if(v==='invest'&&holdsUnits()>0){toast('You already hold this sukuk - sell it first to invest again');v='portfolio';}\n  else if(v==='sell'&&holdsUnits()\u003c1){toast('You do not hold any sukuk to sell yet');v='sukuk';}\n  else if(v==='sell'){goSunday();}\n  S.cust.view=v;if(v==='auth'){S.cust.pin=0;}renderAll();}\nfunction cAuthFor(f){S.cust.authFor=f;cGo('auth');}\nfunction cPinPress(){ if(S.cust.pin>=6)return; S.cust.pin++; renderCustomer();\n  if(S.cust.pin===6){ setTimeout(function(){ const f=S.cust.authFor;\n    if(f==='buy')startAct('BUY'); else if(f==='sell')startAct('SELL'); },350); } }\nfunction cPinDel(){ if(S.cust.pin>0){S.cust.pin--;renderCustomer();} }\nfunction cReset(){ S.cust.view='home'; S.cust.pin=0; renderCustomer(); }\nfunction row(k,v){return '\u003cdiv class=\"rvr\">\u003cspan class=\"k\">'+k+'\u003c/span>\u003cspan class=\"v\">'+v+'\u003c/span>\u003c/div>';}\nfunction actRow(w,m,a,x){return '\u003cdiv style=\"display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #f0f1f4\">'+\n  '\u003cdiv>\u003cdiv style=\"font-weight:700;font-size:12.5px\">'+w+'\u003c/div>\u003cdiv style=\"font-size:10.5px;color:var(--muted)\">'+m+' '+x+'\u003c/div>\u003c/div>'+\n  '\u003cdiv style=\"font-weight:700;font-size:12.5px;text-align:right\">'+a+'\u003c/div>\u003c/div>';}\nfunction tokRow(tok,val,sub){const t=TOK[tok];\n  return '\u003cdiv class=\"prow\">\u003cdiv class=\"ptok\">\u003cdiv class=\"pdot2 '+t.cls+'\">'+t.short+'\u003c/div>\u003cdiv>\u003cdiv class=\"n\">'+t.name+'\u003c/div>\u003cdiv class=\"s\">'+t.lbl+'\u003c/div>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"pval\">'+pts(val)+'\u003csmall>'+(sub||'')+'\u003c/small>\u003c/div>\u003c/div>';}\nfunction trackModel(a){\n  const L=a.legs,nOk=L.filter(function(l){return l.st.chain==='CONFIRMED';}).length,allOk=nOk===L.length;\n  const settle='Funding the tokens and swapping them atomically ('+nOk+' of '+L.length+' steps done).';\n  let steps;\n  if(a.type==='BUY')steps=[\n    {t:'Order received',s:'1 '+SUKUK_NAME+' for '+rm(DEAL.price)+'.',d:a.st.request==='RECEIVED'},\n    {t:'Checks complete',s:'Price, eligibility and wallets are confirmed.',d:a.st.rules==='PASSED'},\n    {t:'Settling your investment',s:settle,d:allOk},\n    {t:'Investment complete',s:'The sukuk is in your wallet.',d:a.st.fulfil==='DONE'}];\n  else steps=[\n    {t:'Sell order received',s:'1 '+SUKUK_NAME+' back to HL Islamic Bank.',d:a.st.request==='RECEIVED'},\n    {t:'Price confirmed',s:'Fixed price of '+rm(DEAL.price)+' per unit.',d:a.st.rules==='PASSED'},\n    {t:'Settling your sale',s:'Both sides are sent to the swap contract and exchanged together ('+nOk+' of '+L.length+' steps done).',d:allOk},\n    {t:'Sale complete',s:'Your proceeds are in your wallet.',d:a.st.fulfil==='DONE'}];\n  let cur=steps.length;for(let i=0;i\u003csteps.length;i++){if(!steps[i].d){cur=i;break;}}\n  return {steps:steps,cur:cur,gi:a.type==='BUY'?{S1:2}:{S2:2}};\n}\nfunction doneModel(a){\n  const sw=a.legs[a.legs.length-1],ref=sw.refs.hash?sw.refs.hash.slice(0,10)+'...':'&mdash;';\n  if(a.type==='BUY')return {title:'Investment Complete',sub:'1 sukuk for '+rm(DEAL.price)+', settled by DvP swap',\n    rows:row('Instrument',SUKUK_NAME)+row('Units','1')+row('Price paid',rm(DEAL.price))+row('Settlement','Atomic DvP swap')+row('Swap transaction',ref)+row('Reference',a.id)};\n  return {title:'Sale Complete',sub:'Settled on '+DOW[clock.getDay()]+' '+clock.getDate()+' May 2025',\n    rows:row('Sold','1 '+SUKUK_NAME)+row('Received',pts(DEAL.price)+' tMYR')+row('Price','Fixed, '+rm(DEAL.price)+' per unit')+row('Settlement','Atomic DvP swap')+row('Swap transaction',ref)+row('Reference',a.id)};\n}\nfunction renderCustomer(){\n  ['home','sukuk','invest','portfolio','sell','auth','track','done'].forEach(function(v){\n    const el=document.getElementById('cv-'+v); if(el) el.classList.toggle('on', S.cust.view===v);\n  });\n  const kp=document.getElementById('cKp');\n  if(kp&&!kp._b){kp._b=1;const keys=['1','2','3','4','5','6','7','8','9','','0','DEL'];\n    kp.innerHTML=keys.map(function(k){ if(k==='')return '\u003cdiv>\u003c/div>';\n      if(k==='DEL')return '\u003cbutton onclick=\"cPinDel()\" style=\"font-size:12px\">&#9003;\u003c/button>';\n      return '\u003cbutton onclick=\"cPinPress()\">'+k+'\u003c/button>';}).join('');}\n  const pd=document.getElementById('cPin');\n  if(pd)pd.innerHTML=[0,1,2,3,4,5].map(function(i){return '\u003cdiv class=\"pdot'+(i\u003cS.cust.pin?' f':'')+'\">\u003c/div>';}).join('');\n  const m=S.member,p=position();\n  const bal=document.getElementById('cBal');if(bal)bal.textContent=rm(m.rm);\n  const everDone=!!doneAct('BUY');\n  const ht=document.getElementById('cHomeTop');\n  if(ht){\n    if(!everDone&&p.buyerS===0&&p.buyerT===0)ht.innerHTML='\u003cdiv class=\"promo\">\u003cdiv class=\"a\">'+SUKUK_NAME+'\u003c/div>\u003cdiv class=\"d\">'+rm(DEAL.price)+' per unit. Settled instantly by atomic swap, even on a Sunday.\u003c/div>\u003cbutton onclick=\"cGo(\\'sukuk\\')\">View &amp; Invest\u003c/button>\u003c/div>';\n    else ht.innerHTML='\u003cdiv class=\"fc\">\u003cdiv class=\"l\">MY INVESTMENTS\u003c/div>\u003cdiv class=\"rvc\" style=\"background:transparent;padding:0;margin:0\">'+\n      tokRow('SUKUK',p.buyerS,'unit'+(p.buyerS===1?'':'s'))+tokRow('TMYR',p.buyerT,'1 tMYR = RM 1')+'\u003c/div>'+\n      '\u003cdiv class=\"fxn\">Live from your Liminal wallet\u003c/div>\u003c/div>';\n  }\n  const rc=document.getElementById('cRecent');\n  if(rc){\n    const items=S.acts.filter(function(a){return a.status!=='REJECTED';}).map(function(a){\n      const pend=(a.st.ledger==='SYNCED'||a.st.fulfil==='DONE')?'':'(in progress)';\n      if(a.type==='BUY')return actRow('Invested in '+SUKUK_NAME,a.submitted.slice(4,10)+' '+a.submitted.slice(16),'- '+rm(DEAL.price),'1 unit '+pend);\n      return actRow('Sold '+SUKUK_NAME,a.submitted.slice(4,10)+' '+a.submitted.slice(16),'+ '+pts(DEAL.price)+' tMYR',pend);}).join('');\n    rc.innerHTML=items+actRow('Village Grocer','Last week','- RM 236.40','')+actRow('Salary credit','Last week','+ RM 6,850.00','');\n  }\n  const sb=document.getElementById('cSukukBody');\n  if(sb)sb.innerHTML='\u003cdiv class=\"fc\">\u003cdiv class=\"l\">INSTRUMENT\u003c/div>\u003cdiv style=\"font-weight:800;font-size:15px\">'+SUKUK_NAME+'\u003c/div>\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">Islamic sukuk &middot; tokenised on Liminal\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Issuer\u003c/span>\u003cb>HL Islamic Bank\u003c/b>\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Price per unit\u003c/span>\u003cb>'+rm(DEAL.price)+'\u003c/b>\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Pricing\u003c/span>\u003cb>Fixed\u003c/b>\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Settlement\u003c/span>\u003cb>Atomic DvP swap\u003c/b>\u003c/div>\u003c/div>'+\n    '\u003cul class=\"benef\">\u003cli>Delivery versus payment: you get the sukuk only if your payment goes through\u003c/li>\u003cli>Settles on any day, including Sunday\u003c/li>\u003cli>Sell back to HL Islamic Bank before maturity\u003c/li>\u003c/ul>'+\n    '\u003cbutton class=\"pbtn\" onclick=\"cGo(\\'invest\\')\">Invest\u003c/button>';\n  const iv=document.getElementById('cInvestBody');\n  if(iv)iv.innerHTML='\u003cdiv class=\"fc\">\u003cdiv class=\"l\">YOU ARE BUYING\u003c/div>\u003cdiv style=\"font-weight:800;font-size:14px\">1 &times; '+SUKUK_NAME+'\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Price per unit\u003c/span>\u003cb>'+rm(DEAL.price)+'\u003c/b>\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Units\u003c/span>\u003cb>1\u003c/b>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">YOU PAY\u003c/div>\u003cdiv style=\"font-size:27px;font-weight:800\">'+rm(DEAL.price)+'\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">From\u003c/span>\u003cb>HLB Premier Account\u003c/b>\u003c/div>'+\n    '\u003cdiv class=\"fxn\">Your payment is converted 1:1 into '+pts(DEAL.price)+' tMYR and swapped for the sukuk in one atomic step.\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"rvc\">\u003cdiv class=\"rvr\">\u003cspan class=\"k\">Balance after\u003c/span>\u003cspan class=\"v\">'+rm(m.rm-DEAL.price)+'\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"rvr\">\u003cspan class=\"k\">Settlement\u003c/span>\u003cspan class=\"v\">Atomic DvP swap\u003c/span>\u003c/div>\u003c/div>'+\n    '\u003cbutton class=\"pbtn\" onclick=\"cAuthFor(\\'buy\\')\"'+(m.rm\u003cDEAL.price?' disabled':'')+'>Confirm Investment\u003c/button>';\n  const pf=document.getElementById('cPortBody');\n  if(pf)pf.innerHTML=(p.buyerS>0?\n    '\u003cdiv class=\"rwd\">\u003cdiv class=\"t\">'+SUKUK_NAME+'\u003c/div>\u003cdiv class=\"s\">'+p.buyerS+' unit &middot; value '+rm(p.buyerS*DEAL.price)+' at the fixed price\u003c/div>\u003cbutton class=\"pbtn\" style=\"margin:0\" onclick=\"cGo(\\'sell\\')\">Sell before maturity\u003c/button>\u003c/div>':\n    '\u003cdiv class=\"note\">You do not hold any sukuk yet.\u003c/div>')+\n    '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">TMYR WALLET\u003c/div>\u003cdiv class=\"rvc\" style=\"background:transparent;padding:0;margin:0\">'+tokRow('TMYR',p.buyerT,'1 tMYR = RM 1')+'\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"rwd dis\">\u003cdiv class=\"t\">Convert tMYR to RM\u003c/div>\u003cdiv class=\"s\">Not part of this rehearsal. Coming soon.\u003c/div>\u003cbutton class=\"gbtn\" style=\"margin:0\" disabled>Coming soon\u003c/button>\u003c/div>';\n  const sl=document.getElementById('cSellBody');\n  if(sl)sl.innerHTML=(isSunday()?'\u003cdiv class=\"note\" style=\"margin-bottom:12px\">\u003cb>Today is Sunday.\u003c/b> Banks are closed, but tokenised sukuk still settles now.\u003c/div>':'')+\n    '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">YOU ARE SELLING\u003c/div>\u003cdiv style=\"font-weight:800;font-size:14px\">1 &times; '+SUKUK_NAME+'\u003c/div>\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">Back to HL Islamic Bank, before maturity\u003c/div>'+\n    '\u003cdiv class=\"cvt\">\u003cspan style=\"color:var(--muted)\">Price per unit\u003c/span>\u003cb>'+rm(DEAL.price)+'\u003c/b>\u003c/div>'+\n    '\u003cdiv class=\"fxn\">The price is fixed for now. Live pricing from an oracle is planned.\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"fc\">\u003cdiv class=\"l\">YOU RECEIVE\u003c/div>\u003cdiv style=\"font-size:27px;font-weight:800\">'+pts(DEAL.price)+' tMYR\u003c/div>\u003cdiv class=\"fxn\">Paid into your wallet. Both sides are sent to the swap contract and exchanged together.\u003c/div>\u003c/div>'+\n    '\u003cbutton class=\"pbtn\" onclick=\"cAuthFor(\\'sell\\')\">Confirm Sale\u003c/button>';\n  const a=S.cust.actId?actById(S.cust.actId):null;\n  const tr=document.getElementById('cTrack');\n  if(tr&&a){\n    const M=trackModel(a);const gk=a.awaiting?a.awaiting.key:null;const gidx=(gk&&M.gi[gk]!==undefined)?M.gi[gk]:-1;\n    document.getElementById('cTrackTitle').textContent={BUY:'Settling Your Investment',SELL:'Settling Your Sale'}[a.type];\n    tr.innerHTML=M.steps.map(function(s,i){\n      let cls='pending';if(i\u003cM.cur)cls='dn';else if(i===M.cur)cls=(gidx===i||a.status==='ON_HOLD'||a.status==='EXCEPTION')?'hl':'cu';\n      const mk=(i\u003cM.cur)?'&#10003;':String(i+1);\n      const extra=(gidx===i)?'\u003cdiv class=\"ts\" style=\"color:var(--amber);margin-top:3px\">Waiting for the bank to run this step.\u003c/div>':'';\n      return '\u003cdiv class=\"tstep '+cls+'\">\u003cdiv class=\"tdc\">\u003cdiv class=\"tdot\">'+mk+'\u003c/div>'+(i\u003cM.steps.length-1?'\u003cdiv class=\"tln\">\u003c/div>':'')+'\u003c/div>'+\n        '\u003cdiv>\u003cdiv class=\"tt\">'+s.t+'\u003c/div>\u003cdiv class=\"ts\">'+s.s+'\u003c/div>'+extra+'\u003c/div>\u003c/div>';}).join('');\n  }\n  const cap=document.getElementById('cCap');if(cap)cap.textContent=S.cust.caption||'';\n  const rf=document.getElementById('cRef');if(rf)rf.textContent=a?a.id:'';\n  const gt=document.getElementById('cGate');\n  if(gt){let g='';\n    if(a&&a.status==='AWAITING_APPROVAL')g='Your request needs an additional bank approval. Our team is reviewing it now.';\n    else if(a&&a.status==='REJECTED')g='Your request could not be completed and was declined by the bank.';\n    else if(a&&a.status==='ON_HOLD')g='Your request is temporarily on hold at the bank. Our operations team is on it.';\n    else if(a&&a.status==='EXCEPTION'&&a.legs.some(function(l){return l.st.chain==='FAILED';}))g='We hit a delay settling your request. Nothing has been lost: the swap is all-or-nothing and your request is still active.';\n    gt.innerHTML=g?('\u003cdiv class=\"warnnote\" style=\"margin-top:14px\">'+g+'\u003c/div>'):'';}\n  if(a&&S.cust.view==='done'){const d=doneModel(a);\n    document.getElementById('cDoneTitle').textContent=d.title;document.getElementById('cDoneSub').textContent=d.sub;document.getElementById('cDone').innerHTML=d.rows;}\n  renderInspector();\n  renderRunner();\n}\n/* ============ PRESENTER RUNNER BAR ============ */\nfunction phaseState(){return [!!doneAct('BUY'),!!doneAct('SELL')];}\nfunction renderRunner(){\n  const el=document.getElementById('runner');if(!el)return;\n  const names=['1 Minting + DvP Swap','2 Sunday Settlement'];\n  const d=phaseState(),cur=d.indexOf(false);\n  const flow=names.map(function(n,i){const c=d[i]?'dn':(i===cur?'on':'');return '\u003cspan class=\"n '+c+'\">'+(d[i]?'&#10003; ':'')+n+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n  const a=activeAct();\n  let right;\n  if(a){\n    if(a.manualHold||a.status==='ON_HOLD')right='\u003cspan class=\"pill bad\">On hold\u003c/span> '+(a.holdReason==='ISSUANCE'?'on-chain operations are paused':'manual hold by Treasury Ops');\n    else if(a.status==='AWAITING_APPROVAL')right='\u003cb>Next:\u003c/b> checker approval \u003cbutton class=\"sm pri\" onclick=\"approveAct(\\''+a.id+'\\')\">Approve\u003c/button>';\n    else if(a.status==='EXCEPTION'&&a.breakId)right='\u003cspan class=\"pill bad\">Exception\u003c/span> \u003cbutton class=\"lnk\" onclick=\"openBreakDrawer(\\''+a.breakId+'\\')\">Open '+a.breakId+'\u003c/button>';\n    else if(a.awaiting)right='\u003cb>Next:\u003c/b> '+GATE_LBL[a.awaiting.key]+' \u003cbutton class=\"sm pri\" onclick=\"releaseGate()\">Run\u003c/button>';\n    else{const k=(a.steps[a.step]||'close').split(':')[0];right='\u003cspan style=\"color:var(--muted)\">Running: '+(STEP_LBL[k]||k)+'...\u003c/span>';}\n  } else {\n    const hints=['Aisyah buys 1 sukuk for '+rm(DEAL.price)+' in the Customer App',\n      'Aisyah sells the sukuk back before maturity (Sunday settlement)'];\n    right=cur>=0?('\u003cspan style=\"color:var(--muted)\">\u003cb>Waiting for Aisyah:\u003c/b> '+hints[cur]+'\u003c/span>'):\n      '\u003cspan class=\"pill ok\">Rehearsal complete\u003c/span>';\n  }\n  el.innerHTML='\u003cspan class=\"rl\">DEMO SCRIPT\u003c/span>\u003cdiv class=\"stepflow\">'+flow+'\u003c/div>\u003cdiv class=\"nx\">'+right+\n    '\u003cbutton class=\"auto\" onclick=\"openVaults()\" title=\"Liminal Vaults, org and wallet view\">Liminal Vaults\u003c/button>'+\n    '\u003cbutton class=\"auto\" onclick=\"openExplorerAddr(\\''+ADDR.dvp+'\\')\" title=\"Simulated Etherscan page for the DvP swap contract\">Etherscan DvP\u003c/button>'+\n    '\u003cbutton class=\"auto\" onclick=\"toggleFlag(\\'autoRun\\')\" title=\"When on, every script step runs without waiting\">Auto-run: '+(S.flags.autoRun?'on':'off')+'\u003c/button>\u003c/div>';\n}\nfunction openVaults(){S.org='HLB';document.getElementById('org-HLB').classList.add('on');document.getElementById('org-HLIB').classList.remove('on');\n  S.nav='vaults';if(S.mode==='customer')S.mode='dash';setMode(S.mode);}\n/* ============ ALWAYS-ON INSPECTOR ============ */\nfunction renderInspector(){\n  const n=document.getElementById('iEvN'); if(!n)return;\n  n.textContent=S.events.length;\n  const wrap=document.getElementById('iEvents');\n  if(!S.events.length){wrap.innerHTML='\u003cdiv class=\"ev-empty\">\u003cdiv class=\"ic\">&#128225;\u003c/div>\u003cb>Waiting for the first API call\u003c/b>\u003cspan>Place the sukuk order in the Customer App. Every request, webhook and on-chain confirmation streams in here as it happens.\u003c/span>\u003cdiv class=\"tags\">\u003cspan class=\"pill ok\">SUCCESS\u003c/span>\u003cspan class=\"pill vio\">WEBHOOK\u003c/span>\u003cspan class=\"pill or\">LIMINAL API\u003c/span>\u003cspan class=\"pill tl\">ON-CHAIN\u003c/span>\u003c/div>\u003c/div>';}\n  else{\n    wrap.innerHTML=S.events.slice().reverse().map(function(e){\n      const sb=e.status==='SUCCESS'?'ok':(e.status==='WEBHOOK'?'vio':(e.status==='FAILED'?'bad':(e.status==='WARN'?'wait':'mute')));\n      const lm=(e.from==='LIMINAL'||e.to==='LIMINAL')?'\u003cspan class=\"pill or\">LIMINAL API\u003c/span>':'';\n      const ch=(e.res&&typeof e.res==='object'&&e.res.transactionHash)?'\u003cspan class=\"pill tl\">ON-CHAIN\u003c/span>':'';\n      const mj=e.major?'\u003cspan class=\"pill '+MAJOR_COLOR[e.major]+'\">'+MAJOR_LABEL[e.major]+'\u003c/span>':'';\n      const dir=(e.status==='WEBHOOK'&&e.to==='SI')?'\u003cspan class=\"pill vio\" title=\"SI pulling in an event fired by the sender\">&#8595; PULL\u003c/span>':'';\n      const owner=e.actId!=null?actById(e.actId):null;\n      const isPending=!!(owner&&owner.pendingInspect&&owner.pendingInspect.indexOf(e.id)>-1);\n      const need=isPending?'\u003cspan class=\"pill wait\">ACTION NEEDED\u003c/span>':'';\n      const insp=e.major?('\u003cbutton class=\"sm'+(isPending?' pri pulse':'')+'\" style=\"margin-top:6px\" onclick=\"event.stopPropagation();openIntegrationDrawer('+e.id+')\">'+(isPending?'&#128073; Inspect integration':'&#128274; Inspect integration')+'\u003c/button>'):'';\n      return '\u003cdiv class=\"evi s-'+sb+(e.id===S.sel.event?' sel':'')+(isPending?' awaiting':'')+'\" onclick=\"selEvent('+e.id+')\">'+\n        '\u003cdiv class=\"ev-l\">\u003cdiv class=\"fl2\">'+e.from+' &rarr; '+e.to+'\u003c/div>\u003cdiv class=\"op\">'+e.op+'\u003c/div>\u003c/div>'+\n        '\u003cdiv class=\"ev-r\">\u003cdiv class=\"fg\">\u003cspan class=\"pill '+sb+'\">'+e.status+'\u003c/span>'+dir+lm+ch+mj+need+'\u003c/div>\u003cdiv class=\"tm\">'+e.time+'\u003c/div>'+insp+'\u003c/div>\u003c/div>';\n    }).join('');\n  }\n  const ev=S.events.find(function(x){return x.id===S.sel.event;});\n  const req=document.getElementById('iReq'),res=document.getElementById('iRes'),hd=document.getElementById('iHdr'),tb=document.getElementById('iTx');\n  if(!ev){req.textContent='Select an event from the Event Stream.';res.textContent='';hd.textContent='';}\n  else{\n    req.textContent=ev.req?(typeof ev.req==='string'?ev.req:json(ev.req)):'No request body (asynchronous inbound event).';\n    res.textContent=ev.res?(typeof ev.res==='string'?ev.res:json(ev.res)):'No response captured.';\n    hd.textContent=ev.headers?hblock(ev.headers):'No headers captured.';\n  }\n  const a=S.cust.actId?actById(S.cust.actId):null;\n  if(tb){\n    const p=position();\n    tb.innerHTML=(a?kvr('Activity',a.id)+kvr('Type',TYPES[a.type].name):kvr('Activity','None yet'))+kvr('Investor','Aisyah (retail)')+\n      kvr('Buyer wallet',pts(p.buyerS)+' sukuk, '+pts(p.buyerT)+' tMYR')+kvr('HL Islamic Bank',pts(p.hlibS)+' sukuk, '+pts(p.hlibT)+' tMYR')+kvr('DvP escrow',pts(p.dvpS)+' sukuk, '+pts(p.dvpT)+' tMYR')+\n      (a?kvr('Status',a.status.replace(/_/g,' ')):'')+\n      (ev&&ev.res&&typeof ev.res==='object'&&ev.res.transactionHash?kvr('Etherscan',hashLink(ev.res.transactionHash)):'');\n  }\n}\nfunction kvr(k,v){return '\u003cdiv class=\"k\">'+k+'\u003c/div>\u003cdiv class=\"v mono\" style=\"font-size:11px\">'+v+'\u003c/div>';}\nfunction selEvent(id){S.sel.event=id;renderInspector();if(S.mode!=='customer')renderDash();}\n/* ============ ACTIVITY PIPELINE ============ */\n/* Endpoints marked PROPOSED are placeholders for the Liminal transfer and DvP swap APIs and are not confirmed. */\nfunction legLabel(l){\n  if(l.op==='ISSUE')return 'Mint '+pts(l.amount)+' '+tl(l.token)+' to '+wn(l.to)+' wallet';\n  if(l.op==='TRANSFER')return 'Send '+pts(l.amount)+' '+tl(l.token)+' from '+wn(l.from)+' to DvP';\n  return 'Execute DvP swap: '+l.sukuk+' sukuk for '+pts(l.tmyr)+' tMYR';\n}\nfunction pointsSummary(a){return DEAL.units+' sukuk x '+pts(DEAL.price)+' tMYR';}\nfunction legDefs(type){\n  if(type==='BUY')return [\n    {op:'ISSUE',token:'TMYR',amount:DEAL.price,to:ADDR.buyer},\n    {op:'ISSUE',token:'SUKUK',amount:DEAL.units,to:ADDR.hlib},\n    {op:'TRANSFER',token:'SUKUK',amount:DEAL.units,from:ADDR.hlib,to:ADDR.dvp},\n    {op:'TRANSFER',token:'TMYR',amount:DEAL.price,from:ADDR.buyer,to:ADDR.dvp},\n    {op:'SWAP',token:'TMYR',amount:DEAL.price,sukuk:DEAL.units,tmyr:DEAL.price,sukukTo:ADDR.buyer,tmyrTo:ADDR.hlib}];\n  return [\n    {op:'TRANSFER',token:'SUKUK',amount:DEAL.units,from:ADDR.buyer,to:ADDR.dvp},\n    {op:'TRANSFER',token:'TMYR',amount:DEAL.price,from:ADDR.hlib,to:ADDR.dvp},\n    {op:'SWAP',token:'TMYR',amount:DEAL.price,sukuk:DEAL.units,tmyr:DEAL.price,sukukTo:ADDR.hlib,tmyrTo:ADDR.buyer}];\n}\nfunction buildSteps(a){\n  const s=[];if(S.flags.makerChecker)s.push('approval');\n  s.push('request');if(a.type==='BUY')s.push('requestCore');\n  s.push('rules');if(a.type==='BUY')s.push('rulesVault');\n  s.push('gate:'+(a.type==='BUY'?'S1':'S2'));\n  a.legs.forEach(function(l){s.push('legSign:'+l.n,'legChain:'+l.n);});s.push('fulfil','ledger','close');return s;\n}\nfunction mkAct(type){\n  S.seq[type]++;const id=TYPES[type].prefix+'-'+dateKey()+'-'+String(S.seq[type]).padStart(4,'0');\n  const gate=type==='BUY'?'S1':'S2';\n  const a={id:id,type:type,submitted:stamp(clock),owner:'Treasury Ops',status:'IN_PROGRESS',breakId:null,awaiting:null,gateOpen:null,\n    manualHold:false,holdReason:null,approval:null,apprOk:false,step:0,\n    st:{request:'PENDING',rules:'PENDING',fulfil:'PENDING',ledger:'PENDING'},refs:{},history:[],pendingInspect:[],shownCats:{},\n    legs:legDefs(type).map(function(d,i){return Object.assign({n:i+1,id:id+'-L'+(i+1),gate:gate,st:{sign:'PENDING',chain:'PENDING'},refs:{}},d);})};\n  a.steps=buildSteps(a);return a;\n}\nfunction startAct(type){\n  if(type==='SELL')goSunday();\n  const a=mkAct(type);S.acts.unshift(a);\n  S.cust.actId=a.id;S.cust.view='track';S.cust.caption=type==='BUY'?'Your order has been received.':'Your sell order has been received.';\n  addAudit('Customer App','Aisyah started '+TYPES[type].name.toLowerCase()+' '+a.id);\n  hist(a,TYPES[type].name+' started from the customer app');\n  renderAll();setTimeout(function(){runStep(a.id);},450);\n}\nfunction runStep(id){\n  const a=actById(id);if(!a||a.status==='REJECTED'||a.status==='COMPLETED')return;\n  if(a.manualHold){a.status='ON_HOLD';renderAll();return;}\n  if(a.pendingInspect&&a.pendingInspect.length){\n    a.status='AWAITING_INSPECTION';\n    setCap(a,'Reviewing the last API call... Click Inspect integration above, then close it, to continue.');\n    renderAll();return;\n  }\n  const key=a.steps[a.step];if(!key)return;\n  const parts=key.split(':'),base=parts[0],arg=parts[1];\n  const r=STEP[base](a,arg);\n  if(r==='PAUSE'){renderAll();return;}\n  a.step++;\n  if(a.pendingInspect&&a.pendingInspect.length){\n    let newCat=false;\n    a.pendingInspect.forEach(function(id){\n      const ev=S.events.find(function(x){return x.id===id;});\n      const cat=ev&&ev.major;\n      if(cat){if(!a.shownCats[cat])newCat=true;a.shownCats[cat]=true;}\n    });\n    if(!newCat){\n      a.pendingInspect.length=0;\n    } else {\n      a.status='AWAITING_INSPECTION';\n      setCap(a,'Reviewing the last API call... Click Inspect integration above, then close it, to continue.');\n      renderAll();return;\n    }\n  }\n  renderAll();\n  setTimeout(function(){runStep(id);},STEP_DELAY);\n}\nfunction setCap(a,t){if(S.cust.actId===a.id)S.cust.caption=t;}\nfunction clearHold(a){if(a.status==='ON_HOLD'&&!a.manualHold)a.status='IN_PROGRESS';a.holdReason=null;}\nfunction setAwait(a,k){a.legs.forEach(function(l){if(l.gate===k&&l.st.chain==='PENDING'){l.st.sign='AWAITING';l.st.chain='AWAITING';}});}\nfunction clearAwait(a,k){a.legs.forEach(function(l){if(l.gate===k){if(l.st.sign==='AWAITING')l.st.sign='PENDING';if(l.st.chain==='AWAITING')l.st.chain='PENDING';}});}\nfunction releaseGate(){\n  const a=activeAct();if(!a||!a.awaiting)return;\n  if(a.manualHold){toast('The activity is on hold - release it first');return;}\n  const k=a.awaiting.key;\n  a.gateOpen=k;a.awaiting=null;a.status='IN_PROGRESS';clearAwait(a,k);\n  hist(a,'Script run: '+GATE_LBL[k]);addAudit('Treasury Ops','ran script: '+GATE_LBL[k]);\n  renderAll();setTimeout(function(){runStep(a.id);},350);\n}\nconst STEP={};\nSTEP.approval=function(a){\n  if(a.apprOk)return 1;\n  a.approval='AWAITING_CHECKER';a.status='AWAITING_APPROVAL';\n  E(a,'SI','TREASURY (MAKER)','POST /approvals/submit','WARN','json',\n    {activityId:a.id,type:a.type,instrument:SUKUK_NAME,units:DEAL.units,scope:'ON_CHAIN_OPERATIONS',submittedBy:'Ops Analyst'},\n    {approvalRef:'APR-'+a.id,status:'AWAITING_CHECKER',requiredRole:'Treasury Manager'});\n  a.refs.apprRef='APR-'+a.id;hist(a,'Submitted for maker-checker approval before on-chain operations');\n  addAudit('Ops Analyst','submitted '+a.id+' for approval');setCap(a,'Awaiting bank approval...');return 'PAUSE';};\n/* ---- step 1: the order that starts each activity ---- */\nSTEP.request=function(a){\n  const m=S.member;\n  if(a.type==='BUY'){\n    setCap(a,'Checking your order...');\n    E(a,'CUSTOMER APP','SI','POST /si/sukuk/orders','SUCCESS','json',\n      {investorId:m.id,instrument:SUKUK_NAME,side:'BUY',units:DEAL.units,pricePerUnit:DEAL.price,currency:'MYR',settlement:'DVP_ATOMIC',channel:'HLB MOBILE'},\n      {event:'si.sukuk.order.created',orderId:a.id,state:'PENDING_SETTLEMENT'});\n    return 1;\n  } else {\n    setCap(a,'Checking your sell order...');\n    E(a,'CUSTOMER APP','SI','POST /si/sukuk/orders','SUCCESS','json',\n      {investorId:m.id,instrument:SUKUK_NAME,side:'SELL',units:DEAL.units,pricingMode:'FIXED',pricePerUnit:DEAL.price,settlementDay:DOW[clock.getDay()].toUpperCase(),settlement:'DVP_ATOMIC',channel:'HLB MOBILE'},\n      {event:'si.sukuk.order.created',orderId:a.id,state:'PENDING_SETTLEMENT'});\n    hist(a,'Sell order received before maturity. Settlement day: '+DOW[clock.getDay()]);\n  }\n  a.st.request='RECEIVED';return 1;};\n/* ---- Core Banking debits and reserves the funds (BUY only) ---- */\nSTEP.requestCore=function(a){\n  const m=S.member;\n  m.rm=Math.round((m.rm-DEAL.price)*100)/100;\n  E(a,'SI','HLB CORE','POST /core/accounts/debit','SUCCESS','json',\n    {investorId:m.id,account:'HLB Premier Account',amount:DEAL.price,currency:'MYR',purpose:'SUKUK_SUBSCRIPTION',reserveFor:'tMYR 1:1'},\n    {status:'DEBITED',reserveRef:'RSV-'+a.id,availableBalance:m.rm});\n  hist(a,'Order received. '+rm(DEAL.price)+' debited from the HLB Premier Account and reserved against tMYR');\n  a.st.request='RECEIVED';return 1;};\n/* ---- step 2: pricing, eligibility and wallet checks ---- */\nSTEP.rules=function(a){\n  const m=S.member,p=position();\n  setCap(a,'Confirming the price and your wallets...');\n  E(a,'SI','PRICING','GET /pricing/sukuk/HLISB-SUKUK/quote','SUCCESS','json',{instrument:SUKUK_NAME,side:a.type,units:DEAL.units},\n    {mode:'STATIC',pricePerUnit:DEAL.price,currency:'tMYR',oracle:'NOT_AVAILABLE',note:'Dynamic pricing via an oracle is planned'});\n  if(a.type==='BUY'){\n    E(a,'SI','HLB CORE','POST /investors/suitability','SUCCESS','json',{investorId:m.id,product:SUKUK_NAME,amount:DEAL.price},\n      {eligible:true,segment:m.segment,kycStatus:m.kyc});\n    hist(a,'Eligibility passed. Static price '+pts(DEAL.price)+' tMYR per unit');\n    return 1;\n  } else {\n    E(a,'SI','LIMINAL','GET /liminal/vaults/wallets','SUCCESS','json',{wallets:['Buyer','HL Islamic Bank'],include:'balances'},\n      {wallets:[{name:'Buyer',address:ADDR.buyer,balances:{SUKUK:String(p.buyerS),TMYR:String(p.buyerT)}},\n                {name:'HL Islamic Bank',address:ADDR.hlib,balances:{SUKUK:String(p.hlibS),TMYR:String(p.hlibT)}}],\n       checks:{investorHoldsSukuk:p.buyerS>=DEAL.units,issuerCanPay:p.hlibT>=DEAL.price}});\n    hist(a,'Static price confirmed. Investor holds the sukuk and HL Islamic Bank holds '+pts(p.hlibT)+' tMYR to pay');\n  }\n  a.st.rules='PASSED';return 1;};\n/* ---- Liminal confirms the buyer and issuer wallets (BUY only) ---- */\nSTEP.rulesVault=function(a){\n  const p=position();\n  E(a,'SI','LIMINAL','GET /liminal/vaults/wallets','SUCCESS','json',{wallets:['Buyer','HL Islamic Bank'],include:'balances'},\n    {wallets:[{name:'Buyer',org:'HLB Malaysia',address:ADDR.buyer,balances:{SUKUK:String(p.buyerS),TMYR:String(p.buyerT)}},\n              {name:'HL Islamic Bank',org:'HL Islamic Bank',address:ADDR.hlib,balances:{SUKUK:String(p.hlibS),TMYR:String(p.hlibT)}}],\n     dvpEscrow:{address:ADDR.dvp,SUKUK:String(p.dvpS),TMYR:String(p.dvpT)}});\n  hist(a,'Wallets resolved in Liminal Vaults');\n  a.st.rules='PASSED';return 1;};\n/* ---- gates: the presenter's Liminal scripts ---- */\nSTEP.gate=function(a,k){\n  if(a.gateOpen===k||S.flags.autoRun){a.gateOpen=null;a.awaiting=null;clearAwait(a,k);return 1;}\n  a.awaiting={key:k,label:GATE_LBL[k]};a.status='AWAITING_SCRIPT';setAwait(a,k);\n  setCap(a,'Waiting for the bank to run the next step');hist(a,'Waiting: '+GATE_LBL[k]);\n  return 'PAUSE';};\n/* ---- on-chain legs: sign via Liminal API, then submit on-chain ---- */\nfunction legCaption(a,l){\n  if(l.op==='ISSUE')return 'Preparing '+pts(l.amount)+' '+tl(l.token)+' for settlement...';\n  if(l.op==='TRANSFER')return 'Sending '+pts(l.amount)+' '+tl(l.token)+' to the swap contract...';\n  return 'Exchanging both sides in one atomic swap...';\n}\nfunction signLeg(a,l){\n  const id='LIM-'+l.op.charAt(0)+'-'+l.id;\n  if(l.op==='ISSUE')E(a,'SI','LIMINAL','POST /liminal/tokenization/mint','SUCCESS','json',\n    {transactionId:l.id,asset:l.token,amount:String(l.amount),wallet:l.to,org:l.to===ADDR.buyer?'HLB Malaysia':'HL Islamic Bank',standard:'ERC-1400',network:NETWORK,signingPolicy:'MPC 2-of-3'},\n    {liminalTransactionId:id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  else if(l.op==='TRANSFER')E(a,'SI','LIMINAL','POST /liminal/tokenization/transfer','SUCCESS','json',   /* PROPOSED endpoint */\n    {transactionId:l.id,asset:l.token,amount:String(l.amount),from:l.from,to:ADDR.dvp,purpose:'DVP_ESCROW',network:NETWORK},\n    {liminalTransactionId:id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  else E(a,'SI','LIMINAL','POST /liminal/dvp/swap','SUCCESS','json',   /* PROPOSED endpoint */\n    {transactionId:l.id,swapContract:ADDR.dvp,atomic:true,\n     legs:[{asset:'SUKUK',amount:String(l.sukuk),from:ADDR.dvp,to:l.sukukTo},{asset:'TMYR',amount:String(l.tmyr),from:ADDR.dvp,to:l.tmyrTo}],pricing:'STATIC'},\n    {liminalTransactionId:id,status:'SIGNED',signingPolicy:'PASSED',mpcHsm:'SIGNATURE_GENERATED'});\n  l.st.sign='SIGNED';l.refs.liminalId=id;\n}\nfunction chainLeg(a,l,retry){\n  let tx,whOp,whEvt,body;\n  if(l.op==='ISSUE'){\n    tx=addChain(a,'ISSUE',TOK[l.token].contract,[{token:l.token,from:ZERO,to:l.to,amount:l.amount}],ADDR.signerHLB,'Minting: tokens created for the '+wn(l.to)+' wallet');\n    whOp='WEBHOOK digital_asset.mint.confirmed';whEvt='digital_asset.mint.confirmed';body={method:'issue',asset:l.token,amount:l.amount,to:l.to,contract:TOK[l.token].contract,signedBy:'MPC-HSM (2-of-3)'};\n  } else if(l.op==='TRANSFER'){\n    tx=addChain(a,'TRANSFER',TOK[l.token].contract,[{token:l.token,from:l.from,to:ADDR.dvp,amount:l.amount}],ADDR.signerHLB,pts(l.amount)+' '+tl(l.token)+' sent into DvP escrow');\n    whOp='WEBHOOK digital_asset.transfer.confirmed';whEvt='digital_asset.transfer.confirmed';body={method:'transfer',asset:l.token,amount:l.amount,from:l.from,to:ADDR.dvp,contract:TOK[l.token].contract};\n  } else {\n    tx=addChain(a,'SWAP',ADDR.dvp,[{token:'SUKUK',from:ADDR.dvp,to:l.sukukTo,amount:l.sukuk},{token:'TMYR',from:ADDR.dvp,to:l.tmyrTo,amount:l.tmyr}],ADDR.signerHLB,'Atomic DvP swap: both movements settle in one transaction');\n    whOp='WEBHOOK dvp.swap.settled';whEvt='dvp.swap.settled';body={method:'atomicSwap',sukukDelivered:l.sukuk,sukukTo:l.sukukTo,tmyrDelivered:l.tmyr,tmyrTo:l.tmyrTo,contract:ADDR.dvp};\n  }\n  E(a,'LIMINAL','DLT','Submit signed '+tx.method+' transaction to smart contract','SUCCESS','json',body,\n    {transactionHash:tx.hash,blockNumber:tx.block,status:'CONFIRMED',finality:'FINAL',network:NETWORK,method:tx.method});\n  E(a,'LIMINAL','SI',whOp+(retry?' (retry)':''),'WEBHOOK','json',WH,\n    {event:whEvt,transactionId:l.id,liminalTransactionId:l.refs.liminalId,asset:l.token,amount:String(l.amount),method:tx.method,transactionHash:tx.hash,blockNumber:tx.block,status:'CONFIRMED',finality:'FINAL'});\n  l.st.chain='CONFIRMED';l.refs.hash=tx.hash;l.refs.block=tx.block;\n  hist(a,legLabel(l)+' confirmed on-chain (method '+tx.method+')');\n  if(l.op==='SWAP')toast((a.type==='BUY'?'Phase 1':'Phase 2')+' done: DvP swap settled atomically, '+l.sukuk+' sukuk for '+pts(l.tmyr)+' tMYR');\n}\nSTEP.legSign=function(a,n){\n  n=parseInt(n,10);const l=a.legs[n-1];\n  if(S.flags.issuancePaused){a.status='ON_HOLD';a.holdReason='ISSUANCE';hist(a,'On-chain operation blocked: paused by Treasury');setCap(a,'Waiting for the bank...');return 'PAUSE';}\n  clearHold(a);setCap(a,legCaption(a,l));\n  signLeg(a,l);\n  return 1;};\nSTEP.legChain=function(a,n){\n  n=parseInt(n,10);const l=a.legs[n-1];\n  const failMint=S.flags.forceDltFail&&l.op==='ISSUE',failSwap=S.flags.forceSwapFail&&l.op==='SWAP';\n  if(failMint||failSwap){\n    l.st.chain='FAILED';a.status='EXCEPTION';\n    if(failSwap)E(a,'DLT','LIMINAL','DvP swap reverted (atomic rollback)','FAILED','json',{method:'atomicSwap',contract:ADDR.dvp,sukuk:l.sukuk,tmyr:l.tmyr},\n      {status:'REVERTED',reason:'SWAP_EXECUTION_REVERTED',stateChange:'NONE',escrow:'BOTH_SIDES_UNCHANGED',blockNumber:null});\n    else E(a,'DLT','LIMINAL','ISSUE transaction reverted','FAILED','json',{method:'issue',asset:l.token,amount:l.amount,contract:TOK[l.token].contract},\n      {status:'REVERTED',reason:'GAS_LIMIT_EXCEEDED_ON_ISSUE',blockNumber:null,finality:'NONE'});\n    E(a,'LIMINAL','SI',failSwap?'WEBHOOK dvp.swap.failed':'WEBHOOK digital_asset.mint.failed','WEBHOOK','json',WH,\n      {event:failSwap?'dvp.swap.failed':'digital_asset.mint.failed',transactionId:l.id,liminalTransactionId:l.refs.liminalId,status:'FAILED',reason:failSwap?'SWAP_EXECUTION_REVERTED':'GAS_LIMIT_EXCEEDED_ON_ISSUE'});\n    const b=raiseBreak('DLT Execution',-l.amount,failSwap?'Atomic swap reverted - nothing moved, both sides still in DvP escrow':'Mint transaction reverted on DLT - '+tl(l.token)+' not issued',a.id,l.token,n);\n    hist(a,(failSwap?'DvP swap reverted atomically':'DLT mint failed')+' - exception raised '+b.id);\n    addAudit('SI Orchestrator','raised '+b.id+' for '+a.id+(failSwap?' (swap reverted)':' (DLT mint failure)'));\n    setCap(a,'Delay detected - under review by the bank');\n    if(failSwap)S.flags.forceSwapFail=false;else S.flags.forceDltFail=false;\n    return 'PAUSE';\n  }\n  chainLeg(a,l,false);return 1;};\n/* ---- fulfilment: what the investor sees ---- */\nSTEP.fulfil=function(a){\n  const m=S.member,sw=a.legs[a.legs.length-1];\n  const ref=(a.type==='BUY'?'ALLOC-':'BUYBACK-')+Math.floor(10000+Math.random()*89999);\n  E(a,'SI','HL ISLAMIC BANK',a.type==='BUY'?'POST /partners/hl-islamic/subscriptions/confirm':'POST /partners/hl-islamic/buybacks/confirm','SUCCESS','json',\n    {orderId:a.id,units:DEAL.units,amount:DEAL.price,swapTransaction:sw.refs.hash},{status:'CONFIRMED',reference:ref});\n  a.refs.partnerRef=ref;\n  E(a,'SI','NOTIFICATIONS','POST /notifications/push','SUCCESS','json',\n    {investorId:m.id,template:a.type==='BUY'?'SUKUK_INVESTMENT_COMPLETE':'SUKUK_SALE_COMPLETE',data:{units:DEAL.units,amount:DEAL.price}},{status:'DELIVERED'});\n  hist(a,a.type==='BUY'?'Investment complete. Sukuk delivered to the investor wallet':'Sale complete. '+pts(DEAL.price)+' tMYR delivered to the investor wallet');\n  a.st.fulfil='DONE';\n  setTimeout(function(){if(S.cust.actId===a.id&&S.cust.view==='track'){S.cust.view='done';renderAll();}},700);\n  return 1;};\n/* ---- holdings register sync ---- */\nfunction memberDelta(a){\n  const d={};\n  S.chain.forEach(function(t){if(t.actId!==a.id)return;t.moves.forEach(function(m){\n    let x=0;if(m.to===ADDR.buyer)x+=m.amount;if(m.from===ADDR.buyer)x-=m.amount;if(x)d[m.token]=(d[m.token]||0)+x;});});\n  return d;\n}\nSTEP.ledger=function(a){\n  const m=S.member,d=memberDelta(a);let short=0,tok=null;\n  if(S.flags.forceBreak){tok=a.type==='BUY'?'SUKUK':'TMYR';short=a.type==='BUY'?1:Math.round(DEAL.price*0.01);d[tok]=(d[tok]||0)-short;}\n  Object.keys(d).forEach(function(t){m.ledger[t]+=d[t];});\n  E(a,'SI','HOLDINGS REGISTER','POST /investors/register/sync',short?'WARN':'SUCCESS','json',\n    {investorId:m.id,activityId:a.id,deltas:d,dltBalances:{SUKUK:balance(ADDR.buyer,'SUKUK'),TMYR:balance(ADDR.buyer,'TMYR')}},\n    {registerBalances:{SUKUK:m.ledger.SUKUK,TMYR:m.ledger.TMYR},status:short?'MISMATCH':'SYNCED'});\n  if(short){\n    a.st.ledger='BREAK';a.status='EXCEPTION';\n    const b=raiseBreak('Register vs DLT',-short,'Holdings register posted '+pts(short)+' '+tl(tok)+' short of the DLT balance',a.id,tok,0);\n    hist(a,'Register sync mismatch - break '+b.id+' raised ('+pts(short)+' '+tl(tok)+')');\n    addAudit('SI Orchestrator','raised '+b.id+' for '+a.id+' (register variance)');\n    S.flags.forceBreak=false;\n  } else {a.st.ledger='SYNCED';hist(a,'Holdings register synced. Balances match the DLT');}\n  return 1;};\nSTEP.close=function(a){\n  if(!a.breakId)a.status='COMPLETED';\n  hist(a,'Activity closed');addAudit('SI Orchestrator','closed '+a.id);\n  setCap(a,'All done!');return 1;};\n/* ============ BREAK ENGINE ============ */\nfunction raiseBreak(source,variance,reason,actId,token,legN){\n  S.seq.brk++;\n  const b={id:'BRK-'+dateKey()+'-'+String(S.seq.brk).padStart(4,'0'),source:source,variance:variance,token:token,legN:legN,reason:reason,\n    status:'OPEN',assignedTo:'Unassigned',actId:actId,remediation:null,\n    history:[{t:hhmmss(clock),x:'Break detected by '+(source==='DLT Execution'?'DLT execution monitor':'reconciliation engine')}]};\n  S.breaks.unshift(b);\n  const a=actById(actId);if(a)a.breakId=b.id;\n  return b;\n}\nfunction bHist(b,x){b.history.push({t:hhmmss(clock),x:x});}\nfunction assignBreak(id,who){const b=brkById(id);if(!b)return;b.assignedTo=who;if(b.status==='OPEN')b.status='ASSIGNED';\n  bHist(b,'Assigned to '+who);addAudit('Treasury Ops','assigned '+id+' to '+who);\n  logEvent({from:'TREASURY OPS',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/assign',status:'SUCCESS',kind:'json',headers:headers('json',id),\n    req:{caseId:id,assignTo:who},res:{caseId:id,status:b.status,assignedTo:who}});\n  toast(id+' assigned to '+who);renderAll();}\nfunction investigateBreak(id){const b=brkById(id);if(!b)return;b.status='INVESTIGATING';\n  bHist(b,'Investigation started - pulling register snapshots and DLT proofs');\n  addAudit('Treasury Ops','started investigation on '+id);\n  const L=ledgers();\n  logEvent({from:'SI CASE MANAGEMENT',to:'RECONCILIATION ENGINE',op:'GET /reconciliation/cases/'+id+'/evidence',status:'SUCCESS',kind:'json',headers:headers('json',id),\n    req:{caseId:id,include:['register_snapshot','dlt_proof','wallet_balances','escrow_balances']},\n    res:{caseId:id,dltSukuk:L.p.buyerS,dltTmyr:L.p.buyerT,registerSukuk:S.member.ledger.SUKUK,registerTmyr:S.member.ledger.TMYR,dvpEscrowSukuk:L.p.dvpS,dvpEscrowTmyr:L.p.dvpT,variance:money(b.variance,0)+' '+tl(b.token),evidenceComplete:true}});\n  toast('Investigation started on '+id);renderAll();openBreakDrawer(id);}\nfunction proposeRemediation(id,remId){const b=brkById(id);if(!b)return;\n  const opt=(REMEDIATIONS[b.source]||[]).find(function(r){return r.id===remId;});if(!opt)return;\n  b.remediation={id:remId,label:opt.label,api:opt.api,proposedBy:'Ops Analyst',proposedAt:hhmmss(clock),approvedBy:null};\n  b.status='PENDING_APPROVAL';\n  bHist(b,'Remediation proposed: '+opt.label+' (awaiting checker approval)');\n  addAudit('Ops Analyst','proposed remediation \"'+opt.label+'\" on '+id);\n  logEvent({from:'OPS ANALYST (MAKER)',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/remediation/propose',status:'WARN',kind:'json',headers:headers('json',id),\n    req:{caseId:id,remediationType:remId,targetApi:opt.api,variance:b.variance,proposedBy:'Ops Analyst'},\n    res:{caseId:id,status:'PENDING_APPROVAL',requiredRole:'Treasury Manager'}});\n  toast('Remediation proposed - awaiting checker');renderAll();openBreakDrawer(id);}\nfunction approveRemediation(id){const b=brkById(id);if(!b||!b.remediation)return;\n  const r=b.remediation;r.approvedBy='Treasury Manager';r.approvedAt=hhmmss(clock);\n  bHist(b,'Remediation approved by Treasury Manager (checker)');\n  logEvent({from:'TREASURY MANAGER (CHECKER)',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/remediation/approve',status:'SUCCESS',kind:'json',headers:headers('json',id),\n    req:{caseId:id,remediationType:r.id,decision:'APPROVE',approvedBy:'Treasury Manager'},\n    res:{caseId:id,status:'APPROVED_FOR_EXECUTION',executeApi:r.api}});\n  startRecovery(b);renderAll();openBreakDrawer(id);}\nfunction rejectRemediation(id){const b=brkById(id);if(!b)return;\n  bHist(b,'Remediation rejected by checker - returned to investigation');\n  b.status='INVESTIGATING';b.remediation=null;\n  addAudit('Treasury Manager','rejected proposed remediation on '+id);\n  logEvent({from:'TREASURY MANAGER (CHECKER)',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/remediation/reject',status:'FAILED',kind:'json',headers:headers('json',id),\n    req:{caseId:id,decision:'REJECT'},res:{caseId:id,status:'INVESTIGATING'}});\n  toast('Remediation rejected');renderAll();openBreakDrawer(id);}\nfunction executeRemediation(b){\n  const a=b.actId?actById(b.actId):null,r=b.remediation,fake=a||{id:b.id};\n  if(r.id==='RETRY_REGISTER_SYNC'||r.id==='POST_ADJUSTMENT'){\n    S.member.ledger[b.token]-=b.variance;\n    E(fake,'SI','HOLDINGS REGISTER',r.api,'SUCCESS','json',{caseId:b.id,activityId:b.actId,token:b.token,adjustment:-b.variance},\n      {registerBalances:{SUKUK:S.member.ledger.SUKUK,TMYR:S.member.ledger.TMYR},varianceAfter:0});\n  } else if(r.id==='DLT_RECONFIRM'){\n    const l=a&&b.legN?a.legs[b.legN-1]:null;\n    E(fake,'SI','DLT','GET /dlt/transactions/'+((l&&l.refs.hash)?l.refs.hash.slice(0,10):'0xabc')+'...','SUCCESS','json',\n      {caseId:b.id,query:'finality'},{status:'NOT_FOUND_ON_CHAIN',action:'RESUBMIT_REQUIRED',varianceAfter:0});\n  } else if(r.id==='RETRY_DLT_SUBMIT'){\n    const l=a&&b.legN?a.legs[b.legN-1]:null;\n    E(fake,'SI','LIMINAL','POST /liminal/tokenization/resubmit','SUCCESS','json',\n      {caseId:b.id,transactionId:l?l.id:b.actId,operation:l?l.op:'UNKNOWN',reason:'RETRY_AFTER_REVERT',gasStrategy:'ELEVATED'},\n      {liminalTransactionId:'LIM-R-'+(l?l.id:b.actId),status:'SIGNED'});\n    if(l&&l.st.chain!=='CONFIRMED')chainLeg(a,l,true);\n  }\n}\nfunction recoverySteps(b){\n  const tx=b.actId||'activity';\n  if(b.source==='DLT Execution') return {mode:'RESUME',\n    note:'Nothing moved on-chain for the failed step, so SI resumes the SAME activity from that step. The investor does not re-initiate: the original order, correlation ID and idempotency key are reused, which prevents a double settlement.',\n    steps:[{l:'Execute approved remediation call'},{l:'Re-submit signed transaction to DLT'},\n      {l:'Await DLT finality webhook from Liminal'},{l:'Resume orchestration from the failed step'},\n      {l:'Continue remaining on-chain operations and register sync'},{l:'Close case'}]};\n  return {mode:'CORRECTION',\n    note:'The on-chain settlement completed correctly - only the holdings register disagrees. SI posts a correction and re-runs reconciliation. The activity is NOT replayed, because replaying it would move the assets twice.',\n    steps:[{l:'Execute approved correction posting'},{l:'Re-fetch holdings register balance'},\n      {l:'Re-fetch DLT wallet balance'},{l:'Re-run reconciliation for '+tx},\n      {l:'Clear variance and close case'}]};\n}\nfunction startRecovery(b){\n  const plan=recoverySteps(b);\n  b.recovery={mode:plan.mode,note:plan.note,idx:0,running:true,steps:plan.steps.map(function(x){return {l:x.l,s:'PENDING'};})};\n  bHist(b,'Post-remediation recovery started ('+plan.mode+' mode)');\n  toast('Recovery running - '+b.id);renderAll();\n  setTimeout(function(){recoveryTick(b.id);},520);\n}\nfunction recoveryTick(id){\n  const b=brkById(id); if(!b||!b.recovery||!b.recovery.running)return;\n  const R=b.recovery,i=R.idx,st=R.steps[i];\n  if(!st){finishRecovery(b);return;}\n  st.s='DONE';\n  const a=b.actId?actById(b.actId):null,fake=a||{id:b.id};\n  if(i===0){executeRemediation(b);}\n  else if(R.mode==='CORRECTION'){\n    if(i===1)E(fake,'SI','HOLDINGS REGISTER','GET /investors/register/balances','SUCCESS','json',{investorId:S.member.id},{SUKUK:S.member.ledger.SUKUK,TMYR:S.member.ledger.TMYR,source:'HOLDINGS_REGISTER'});\n    if(i===2)E(fake,'SI','LIMINAL','GET /liminal/vaults/wallets','SUCCESS','json',{wallets:['Buyer'],include:'balances'},{SUKUK:balance(ADDR.buyer,'SUKUK'),TMYR:balance(ADDR.buyer,'TMYR'),source:'DLT'});\n    if(i===3)E(fake,'SI','RECONCILIATION ENGINE','POST /reconciliation/run','SUCCESS','json',{caseId:b.id,activityId:b.actId,trigger:'POST_REMEDIATION'},\n      {activityId:b.actId,varianceBefore:money(b.variance,0),varianceAfter:'0',result:'MATCH'});\n  } else {\n    if(i===3)E(fake,'SI','SI ORCHESTRATOR','POST /orchestration/resume','SUCCESS','json',\n      {activityId:b.actId,resumeFromLeg:b.legN,reuseIdempotencyKey:true,customerReinitiationRequired:false},\n      {activityId:b.actId,status:'RESUMED',replayedSteps:0,note:'Original order and correlation ID reused'});\n  }\n  R.idx++;renderAll();\n  setTimeout(function(){recoveryTick(id);},i===0?900:700);\n}\nfunction finishRecovery(b){\n  const R=b.recovery;R.running=false;\n  const a=b.actId?actById(b.actId):null,r=b.remediation;\n  b.varianceBefore=b.variance;b.variance=0;b.status='RESOLVED';b.resolvedAt=hhmmss(clock);\n  bHist(b,'Recovery complete via '+(r?r.api:'remediation')+' - variance cleared');\n  addAudit('Treasury Manager','approved and executed remediation on '+b.id);\n  if(a){\n    if(R.mode==='RESUME'){\n      const l=b.legN?a.legs[b.legN-1]:null;\n      if(l&&l.st.chain!=='CONFIRMED')chainLeg(a,l,true);\n      a.breakId=null;a.status='IN_PROGRESS';hist(a,'DLT re-submission confirmed - orchestration resumed (no re-initiation)');\n      setCap(a,'Back on track - finalizing...');\n      a.step++;renderAll();setTimeout(function(){runStep(a.id);},600);\n    } else {\n      a.breakId=null;a.st.ledger='SYNCED';a.status='COMPLETED';\n      hist(a,'Break '+b.id+' corrected - register reconciled without replay');\n    }\n  }\n  toast(b.id+' resolved - variance cleared');renderAll();\n}\nfunction escalateBreak(id){const b=brkById(id);if(!b)return;b.status='ESCALATED';b.assignedTo='Treasury Manager';\n  bHist(b,'Escalated to Treasury Manager (severity raised)');\n  addAudit('Treasury Ops','escalated '+id+' to Treasury Manager');\n  logEvent({from:'TREASURY OPS',to:'SI CASE MANAGEMENT',op:'POST /cases/'+id+'/escalate',status:'WARN',kind:'json',headers:headers('json',id),\n    req:{caseId:id,severity:'HIGH',escalateTo:'Treasury Manager',slaBreach:false},\n    res:{caseId:id,status:'ESCALATED',assignedTo:'Treasury Manager'}});\n  toast(id+' escalated');renderAll();openBreakDrawer(id);}\n/* ============ BANK VIEW ============ */\nconst NAV=[['control','&#9638;','Control Center'],['sysint','&#127760;','System Integration'],['acts','&#128203;','Activities &amp; Legs'],['members','&#128100;','Investors'],['vaults','&#128274;','Liminal Vaults'],\n ['swaps','&#8646;','DvP Swaps'],['ledger','&#127974;','Token Ledger'],['recon','&#9878;','Reconciliation'],['breaks','&#9888;','Breaks &amp; Exceptions'],\n ['appr','&#9989;','Approvals'],['reports','&#128202;','Reports'],['audit','&#128220;','Audit Trail'],['config','&#9881;','