display:inline-block;margin-right:6px}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\n\u003cdiv class=\"topbar\">\n  \u003cdiv class=\"brand\">\n    \u003cdiv class=\"logo\" id=\"brandLogo\">\u003c/div>\n    \u003cdiv>\n      \u003ch1>Project ATOM Loyalty Control Center\u003c/h1>\n      \u003cdiv class=\"sb\">SI Orchestration &middot; HLB Rewards (HLBP) &amp; Guoco Points &middot; Liminal Tokenization &middot; Use case 1\u003c/div>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv class=\"demoflag\">\n    \u003cb>&#9888; SIMULATED DEMO DATA ONLY\u003c/b>\n    \u003cspan>The data displayed mirrors the Amir loyalty rehearsal: link, earn, convert and redeem points.\u003c/span>\n  \u003c/div>\n  \u003cdiv class=\"switcher\">\n    \u003cbutton id=\"sw-customer\" class=\"on\" onclick=\"setMode('customer')\">Customer App\u003c/button>\n    \u003cbutton id=\"sw-dash\" onclick=\"setMode('dash')\">Bank View\u003c/button>\n    \u003cbutton id=\"sw-split\" onclick=\"setMode('split')\">Split View\u003c/button>\n  \u003c/div>\n  \u003cdiv class=\"orgsw\" title=\"Liminal org context. Filters the Liminal Vaults view.\">\n    \u003cbutton id=\"org-HLB\" class=\"on\" onclick=\"setOrg('HLB')\">HLB Malaysia Loyalty\u003c/button>\n    \u003cbutton id=\"org-GUO\" onclick=\"setOrg('GUO')\">Guoco Hotels\u003c/button>\n  \u003c/div>\n  \u003cdiv class=\"envchip\">\u003cspan>&#128197;\u003c/span>\u003cb id=\"clockLbl\">19 May 2025 10:32:00 MYT\u003c/b>\u003c/div>\n  \u003cdiv class=\"envchip\">\u003cspan class=\"pill vio\">Demo\u003c/span>\u003cspan class=\"pill bad\" id=\"brkChip\">0\u003c/span>\u003cb>Treasury Ops\u003c/b>\u003c/div>\n\u003c/div>\n\n\u003cdiv id=\"runner\" class=\"runner\">\u003c/div>\n\n\u003cdiv class=\"workspace\">\n  \u003cdiv id=\"paneCustomer\" class=\"pane\">\u003c/div>\n  \u003cdiv id=\"paneDash\" class=\"pane hidden\">\u003c/div>\n\u003c/div>\n\n\u003cdiv id=\"overlay\" class=\"ovl hidden\" onclick=\"if(event.target===this)closeDrawer()\">\n  \u003cdiv class=\"drawer\">\n    \u003cdiv class=\"drh\">\u003ch3 id=\"drTitle\">Detail\u003c/h3>\u003cbutton class=\"x\" onclick=\"closeDrawer()\">&times;\u003c/button>\u003c/div>\n    \u003cdiv class=\"drb\" id=\"drBody\">\u003c/div>\n  \u003c/div>\n\u003c/div>\n\u003cdiv id=\"toast\" class=\"toast\">\u003c/div>\n\n\u003cscript>\n/* ============ CONSTANTS ============ */\nconst HLB_LOGO_URI='data:image/png;base64,';\nconst STEP_DELAY=620;                        /* ms between pipeline steps */\nconst NETWORK='EVM network (Etherscan-indexed)';\nconst ZERO='0x0000000000000000000000000000000000000000';\nconst ADDR={\"amir\": \"0xeabB6553783faa73Fb88c003835952fE4d6c0eb2\", \"vault\": \"0x7669FeBD5d2401Db30F5A0D1Df97F136c8Fb370e\", \"guocoW\": \"0xDA72547e01d36235abF22A1e94546Df26c7bD9c5\", \"hlbp\": \"0xD02D5212917212b6021Fb09F61De28A7F7aB012D\", \"guoco\": \"0x8d7360333cF2bc670CcFB0f7b44c04abaBbd25D6\", \"swap\": \"0xe92d50F7f6eeB93d5bA52aB6F0B831094d2Ca0a5\", \"signerHLB\": \"0xb61F40A28AAFe84A8a8F0C1Dc2aFD1524e045423\", \"signerGuoco\": \"0xB3487266863E475Ec565989189Abe28Ae8DcC87F\"};\nconst ADDR_LBL={};\nADDR_LBL[ADDR.amir]='HNWI wallet (Amir), HLB Malaysia Loyalty';\nADDR_LBL[ADDR.vault]='Redemption Vault, HLB Malaysia Loyalty';\nADDR_LBL[ADDR.guocoW]='Guoco Points Wallet, Guoco Hotels';\nADDR_LBL[ADDR.hlbp]='HLBP Token Contract (ERC-1400)';\nADDR_LBL[ADDR.guoco]='Guoco Points Token Contract (ERC-1400)';\nADDR_LBL[ADDR.swap]='DvP Atomic Swap Contract (HLBP x Guoco)';\nADDR_LBL[ADDR.signerHLB]='HLB Malaysia Loyalty MPC Signer';\nADDR_LBL[ADDR.signerGuoco]='Guoco Hotels MPC Signer';\nADDR_LBL[ZERO]='Null Address (mint / burn)';\nconst TOK={HLBP:{name:'HLB Rewards',contract:ADDR.hlbp,cls:'h',lbl:'HLBP'},GUOCO:{name:'Guoco Points',contract:ADDR.guoco,cls:'g',lbl:'GUOCO'}};\nconst ORGS={HLB:{name:'HLB Malaysia Loyalty'},GUO:{name:'Guoco Hotels'}};\nconst WALLETS=[\n  {addr:ADDR.amir,name:'HNWI',sub:'Amir, HNWI member',org:'HLB'},\n  {addr:ADDR.vault,name:'Redemption Vault',sub:'Guoco Points staged here before they are burned',org:'HLB'},\n  {addr:ADDR.guocoW,name:'Guoco Points Wallet',sub:'Guoco Hotels partner wallet and swap counterparty',org:'GUO'}\n];\n/* ---- rehearsal parameters, taken from the Liminal script ---- */\nconst LINK_PTS={HLBP:10000,GUOCO:2000};\nconst EARN_RATE={HLBP:10,GUOCO:4};           /* points per RM 1 spent: RM 50 earns 500 HLBP + 200 Guoco */\nconst PURCHASE={merchant:'Marugame Udon',amount:50,card:'HLB Visa Debit - 4821',last4:'4821',mcc:'5812'};\nconst SWAPQ={hlbpPerLot:2000,guocoPerLot:1000};  /* 2 HLBP = 1 Guoco, swapped in lots of 1,000 Guoco */\nconst REWARD={name:'Suite Upgrade + Late Checkout',partner:'Guoco Hotels',guoco:3000};\nconst GUOCO_FLOAT=25000;                     /* opening Guoco float in the partner wallet (assumption) */\nconst START_RM=185420.35;\nconst STAGES=['request','rules','sign','chain','fulfil','ledger'];\nconst ACT_STAGES=['request','rules','fulfil','ledger'];\nconst LEG_STAGES=['sign','chain'];\nconst STAGE_LBL={request:'Request',rules:'Rules',sign:'Signed',chain:'On-chain',fulfil:'Fulfilment',ledger:'Ledger Sync'};\nconst ST={PENDING:['Pending','pend'],NA:['&mdash;','mute'],AWAITING:['Awaiting','wait'],RECEIVED:['Received','ok'],PASSED:['Passed','ok'],\n  SIGNED:['Signed','ok'],CONFIRMED:['Confirmed','ok'],DONE:['Done','ok'],SYNCED:['Synced','ok'],APPROVED:['Approved','ok'],\n  AWAITING_CHECKER:['Awaiting Checker','wait'],REJECTED:['Rejected','bad'],ON_HOLD:['On Hold','bad'],FAILED:['Failed','bad'],BREAK:['Break','bad']};\nconst TYPES={LINK:{prefix:'LNK',name:'Programme activation'},EARN:{prefix:'ERN',name:'Earn on purchase'},RDM:{prefix:'RDM',name:'Redemption'}};\nconst OWNERS=['Ops Analyst','Treasury Ops','Accounting Ops','Treasury Manager'];\nconst GATE_LBL={S1:'Run 1st script: first activation minting (10,000 HLBP + 2,000 Guoco)',\n  S2:'Run 2nd script: earning points minting (500 HLBP + 200 Guoco)',\n  S3:'Run 3rd script: atomic swap HLBP to Guoco (2,000 HLBP for 1,000 Guoco)',\n  S4:'Run 4th script: burn 3,000 Guoco Points'};\nconst STEP_LBL={approval:'Maker-checker approval',request:'Request received',requestCore:'Core banking posting',rules:'Rules and wallet checks',rulesVault:'Liminal wallet check',legSign:'Signing with Liminal',legChain:'On-chain settlement',\n  fulfil:'Fulfilment',ledger:'Loyalty ledger sync',close:'Closing activity'};\nconst METHOD={ISSUE:'issue',TRANSFER:'transfer',SWAP:'atomicSwap',BURN:'redeem'};\nconst SIG={issue:'issue(address tokenHolder, uint256 value, bytes data)',transfer:'transfer(address to, uint256 value)',\n  atomicSwap:'atomicSwap(address partyA, address partyB, uint256 amountA, uint256 amountB)',redeem:'redeem(uint256 value, bytes data)'};\nconst REMEDIATIONS={\n 'Ledger vs DLT':[{id:'RETRY_LEDGER_SYNC',label:'Re-run loyalty ledger sync',api:'POST /loyalty/ledger/resync'},\n                  {id:'POST_ADJUSTMENT',label:'Post ledger adjustment',api:'POST /loyalty/ledger/adjustment'}],\n 'DLT Execution':[{id:'RETRY_DLT_SUBMIT',label:'Re-submit signed DLT transaction',api:'POST /liminal/tokenization/resubmit'},\n                  {id:'DLT_RECONFIRM',label:'Re-confirm DLT finality',api:'GET /dlt/transactions/{hash}'}]\n};\nconst S={mode:'customer',nav:'control',org:'HLB',acts:[],chain:[],breaks:[],audit:[],events:[],inspectingEvent:null,\n  member:null,\n  flags:{autoRun:true,makerChecker:false,forceDltFail:false,forceBreak:false,issuancePaused:false},\n  sel:{event:null},filters:{status:'All',q:''},exp:{},seq:{LINK:0,EARN:0,RDM:0,brk:0},block:5238400,\n  cust:{view:'home',pin:0,authFor:null,actId:null,caption:''},drawer:null,drawerRef:null};\nfunction newMember(){return {id:'MBR-0001',name:'Amir',segment:'HNWI',kyc:'VERIFIED',rm:START_RM,linked:false,ledger:{HLBP:0,GUOCO:0},reserved:0};}\nS.member=newMember();\n\n/* ============ HELPERS ============ */\nlet clock=new Date(2025,4,19,10,32,0);\nfunction tick(){clock=new Date(clock.getTime()+1000*(1+Math.floor(Math.random()*2)));return hhmmss(clock);}\nfunction hhmmss(d){return d.toTimeString().slice(0,8);}\nfunction stamp(d){const m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n  return d.getDate()+' '+m[d.getMonth()]+' '+d.getFullYear()+' '+hhmmss(d);}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/\u003c/g,'&lt;').replace(/>/g,'&gt;');}\nfunction money(n,dp){dp=dp===undefined?2:dp;return Number(n).toLocaleString('en-US',{minimumFractionDigits:dp,maximumFractionDigits:dp});}\nfunction pts(n){return money(n,0);}\nfunction rm(n){return 'RM '+money(n);}\nfunction json(o){return JSON.stringify(o,null,2);}\nfunction hex(n){let s='0x',c='0123456789abcdef';for(let i=0;i\u003c(n||64);i++)s+=c[Math.floor(Math.random()*16)];return s;}\nfunction sa(a){return a.slice(0,8)+'...'+a.slice(-4);}\nfunction lbl(a){return ADDR_LBL[a]||a;}\nfunction pill(code){const d=ST[code]||['&mdash;','mute'];return '\u003cspan class=\"pill '+d[1]+'\">'+d[0]+'\u003c/span>';}\nfunction toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('on');\n  clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('on');},2800);}\nfunction headers(kind,corr,auth){\n  const h={'Content-Type':kind==='xml'?'application/xml; charset=utf-8':'application/json',\n    'X-Correlation-Id':'COR-'+(corr||'ATOM'),'X-Idempotency-Key':'IDEMP-'+Math.random().toString(36).slice(2,10).toUpperCase(),\n    'X-Channel':'SI-ORCHESTRATOR','Authorization':'Bearer ***REDACTED***','User-Agent':'SI-Orchestrator/1.0'};\n  if(auth){h['Authorization']='Bearer '+auth.oauth.accessToken;h['X-TLS-Version']=auth.mtls.tlsVersion;\n    h['X-Cipher-Suite']=auth.mtls.cipherSuite;h['X-Client-Cert-Thumbprint']=auth.mtls.clientCert.sha256Thumbprint;h['X-Mutual-TLS']=auth.mtls.mutualAuth;}\n  return h;\n}\nfunction hblock(h){return Object.keys(h).map(function(k){return k+': '+h[k];}).join('\\n');}\n/* ============ SI INTEGRATION SECURITY (simulated mTLS + OAuth2) ============\n   Illustrative only: certificates, tokens and signatures below are not connected to any real PKI,\n   OAuth server or blockchain network. They exist so the rehearsal can show what a genuinely secured\n   integration hop looks like end to end. Only the four categories below are \"major\": mint, burn,\n   updating the ledger and connecting to core banking - plus the customer app's very first request. */\nconst MAJOR_LABEL={MINT:'MINT',BURN:'BURN',LEDGER:'LEDGER UPDATE',COREBANK:'CORE BANKING',APPAUTH:'APP REQUEST'};\nconst MAJOR_COLOR={MINT:'vio',BURN:'or',LEDGER:'tl',COREBANK:'ok',APPAUTH:'pend'};\nconst COREBANK_RE=/CORE|BANK/i;\nconst APP_RE=/^CUSTOMER APP$/;\nfunction classifyMajor(from,to,op){\n  /* Only SI's own integration hops are \"major\" - what a partner does on its own\n     side (e.g. Liminal submitting a signed transaction to the DLT) is that\n     partner's internal process, not part of SI's integration workflow. */\n  if(from!=='SI'&&to!=='SI')return null;\n  if(/mint/i.test(op))return 'MINT';\n  if(/burn/i.test(op))return 'BURN';\n  if(/ledger|gl\\/postings|register\\/sync/i.test(op))return 'LEDGER';\n  if(APP_RE.test(from))return 'APPAUTH';\n  if(COREBANK_RE.test(from)||COREBANK_RE.test(to))return 'COREBANK';\n  return null;\n}\nconst AUTH_PROFILES={\n  LIMINAL:{tokenEndpoint:'https://auth.liminal.example/oauth2/token',clientId:'si-orchestrator-hlb',scope:'liminal.tokenization.write liminal.vaults.read',\n    audience:'https://api.liminal.example',issuer:'https://auth.liminal.example/',caIssuer:'CN=Liminal Enterprise CA, O=Liminal Custody Inc, C=US',serverSubject:'CN=api.liminal.example, O=Liminal Custody Inc'},\n  'HLB CORE':{tokenEndpoint:'https://auth.corebanking.hlb.internal/oauth2/token',clientId:'si-orchestrator-hlb',scope:'core.eligibility.read core.card.read',\n    audience:'https://api.corebanking.hlb.internal',issuer:'https://auth.corebanking.hlb.internal/',caIssuer:'CN=HLB Enterprise Root CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=api.corebanking.hlb.internal, O=Hong Leong Bank'},\n  'LOYALTY LEDGER':{tokenEndpoint:'https://auth.ledger.hlb.internal/oauth2/token',clientId:'si-orchestrator-hlb',scope:'ledger.write',\n    audience:'https://api.ledger.hlb.internal',issuer:'https://auth.ledger.hlb.internal/',caIssuer:'CN=HLB Enterprise Root CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=api.ledger.hlb.internal, O=Hong Leong Bank'},\n  'CUSTOMER APP':{tokenEndpoint:'https://auth.hlb.com.my/oauth2/token',clientId:'hlb-mobile-app',scope:'si.loyalty.write si.loyalty.read',\n    audience:'https://si.hlb.com.my',issuer:'https://auth.hlb.com.my/',caIssuer:'CN=HLB Mobile Channel CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=si.hlb.com.my, O=Hong Leong Bank'},\n  DEFAULT:{tokenEndpoint:'https://auth.hlb.internal/oauth2/token',clientId:'si-orchestrator-hlb',scope:'si.default',\n    audience:'https://api.hlb.internal',issuer:'https://auth.hlb.internal/',caIssuer:'CN=HLB Enterprise Root CA, O=Hong Leong Bank, C=MY',serverSubject:'CN=api.hlb.internal, O=Hong Leong Bank'}\n};\nfunction authTarget(category,from,to){\n  if(category==='MINT'||category==='BURN')return 'LIMINAL';\n  if(category==='APPAUTH')return from;\n  if(category==='COREBANK'){if(COREBANK_RE.test(to))return to;if(COREBANK_RE.test(from))return from;return to;}\n  return (from==='SI')?to:from;\n}\nfunction fp(bytes){const c='0123456789ABCDEF';const out=[];for(let i=0;i\u003cbytes;i++)out.push(c[Math.floor(Math.random()*16)]+c[Math.floor(Math.random()*16)]);return out.join(':');}\nfunction jwtCompact(payload){\n  const header={alg:'RS256',typ:'JWT',kid:'si-2025-09'};\n  const b64=function(o){return btoa(JSON.stringify(o)).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');};\n  const sig=Math.random().toString(36).slice(2,10)+Math.random().toString(36).slice(2,18);\n  return {compact:b64(header)+'.'+b64(payload)+'.'+sig,header:header,payload:payload};\n}\nfunction buildAuthSim(category,from,to){\n  const target=authTarget(category,from,to),profile=AUTH_PROFILES[target]||AUTH_PROFILES.DEFAULT;\n  const now=Math.floor(Date.now()/1000);\n  const payload={iss:profile.issuer,sub:'si-orchestrator@hlb-atom',aud:profile.audience,scope:profile.scope,iat:now,exp:now+300,jti:'jti-'+Math.random().toString(36).slice(2,10)};\n  const jwt=jwtCompact(payload);\n  return {category:category,target:target,\n    mtls:{tlsVersion:'TLS 1.3',cipherSuite:'TLS_AES_256_GCM_SHA384',\n      clientCert:{subject:'CN=si-orchestrator.hlb-atom.internal, OU=Digital Integration, O=Hong Leong Bank, C=MY',issuer:profile.caIssuer,serial:fp(8),sha256Thumbprint:fp(32)},\n      serverCert:{subject:profile.serverSubject,issuer:profile.caIssuer},mutualAuth:'PEER_VERIFIED'},\n    oauth:{tokenEndpoint:profile.tokenEndpoint,grantType:'client_credentials',clientId:profile.clientId,scope:profile.scope,tokenType:'Bearer',expiresIn:300,\n      accessToken:jwt.compact,decoded:{header:jwt.header,payload:jwt.payload}},\n    footer:{responseTimeMs:40+Math.floor(Math.random()*180),contentSha256:fp(32).replace(/:/g,'').toLowerCase(),traceId:'trace-'+Math.random().toString(36).slice(2,10),signature:'sig_'+Math.random().toString(36).slice(2,14)}\n  };\n}\nfunction logEvent(e){const id=S.events.length;const ev=Object.assign({id:id,time:tick()},e);S.events.push(ev);S.sel.event=id;return ev;}\nfunction E(a,from,to,op,status,kind,req,res){\n  const major=classifyMajor(from,to,op),auth=major?buildAuthSim(major,from,to):null;\n  const ev=logEvent({from:from,to:to,op:op,status:status,kind:kind,headers:headers(kind,a.id,auth),req:req,res:res,major:major,auth:auth,actId:a.id});\n  if(major&&a&&a.pendingInspect)a.pendingInspect.push(ev.id);\n  return ev;\n}\nconst WH='N/A - asynchronous webhook received from Liminal.';\nfunction addAudit(actor,text){S.audit.unshift({time:hhmmss(clock),actor:actor,text:text});if(S.audit.length>80)S.audit.pop();}\nfunction logoHtml(){return HLB_LOGO_URI?'\u003cimg src=\"'+HLB_LOGO_URI+'\" alt=\"HLB\">':'\u003cdiv class=\"wm\">HLB\u003c/div>';}\nfunction actById(id){return S.acts.find(function(a){return a.id===id;});}\nfunction brkById(id){return S.breaks.find(function(b){return b.id===id;});}\nfunction activeAct(){return S.acts.find(function(a){return a.status!=='COMPLETED'&&a.status!=='REJECTED';});}\nfunction curAct(){return actById(S.cust.actId)||activeAct()||S.acts[0]||null;}\nfunction doneAct(type){return S.acts.find(function(a){return a.type===type&&a.status==='COMPLETED';});}\nfunction hist(a,x){a.history.push({t:hhmmss(clock),x:x});}\nfunction hashLink(h){return h?'\u003ca class=\"xl\" title=\"Open the simulated Etherscan view\" onclick=\"event.stopPropagation();openExplorerTx(\\''+h+'\\')\">'+h.slice(0,10)+'...'+h.slice(-6)+'\u003c/a>':'&mdash;';}\nfunction addrLink(a){return '\u003ca class=\"xl\" title=\"Open the simulated Etherscan address page\" onclick=\"event.stopPropagation();openExplorerAddr(\\''+a+'\\')\">'+sa(a)+'\u003c/a>';}\n\n/* ============ ON-CHAIN REGISTRY (single source of truth for balances) ============ */\nfunction addChain(a,kind,to,moves,from,note){\n  S.block+=Math.floor(Math.random()*6)+2;\n  const tx={hash:hex(),block:S.block,kind:kind,method:METHOD[kind],actId:a.id,from:from,to:to,moves:moves,time:stamp(clock),note:note||''};\n  S.chain.push(tx);return tx;\n}\nfunction seedChain(){\n  S.chain=[{hash:hex(),block:5238121,kind:'ISSUE',method:'issue',actId:'SETUP',from:ADDR.signerGuoco,to:ADDR.guoco,\n    moves:[{token:'GUOCO',from:ZERO,to:ADDR.guocoW,amount:GUOCO_FLOAT}],time:'18 May 2025 17:05:12',note:'Opening Guoco float for the partner wallet (set up before the rehearsal)'}];\n}\nseedChain();\nfunction eachMove(fn){S.chain.forEach(function(t){t.moves.forEach(function(m){fn(m,t);});});}\nfunction balance(addr,token){let b=0;eachMove(function(m){if(m.token!==token)return;if(m.to===addr)b+=m.amount;if(m.from===addr)b-=m.amount;});return b;}\nfunction minted(token){let s=0;eachMove(function(m){if(m.token===token&&m.from===ZERO)s+=m.amount;});return s;}\nfunction burned(token){let s=0;eachMove(function(m){if(m.token===token&&m.to===ZERO)s+=m.amount;});return s;}\nfunction supply(token){return minted(token)-burned(token);}\nfunction addrHistory(addr){\n  const out=[];\n  S.chain.forEach(function(t){t.moves.forEach(function(m){\n    if(m.to===addr||m.from===addr){\n      const inc=m.to===addr;\n      const type=m.from===ZERO?'ISSUE':(m.to===ZERO?'BURN':(inc?'IN':'OUT'));\n      const other=m.from===ZERO?'Mint':(m.to===ZERO?'Burn':(inc?m.from:m.to));\n      out.push({tx:t,type:type,token:m.token,amount:m.amount,other:other});}\n  });});\n  return out.reverse();\n}\nfunction availPts(tok){return balance(ADDR.amir,tok)-(tok==='GUOCO'?S.member.reserved:0);}\n\n/* ============ POSITION / LEDGER MATH ============ */\nfunction earnedTotals(){\n  let h=0,g=0;\n  S.chain.forEach(function(t){if(String(t.actId).indexOf('ERN')===0)t.moves.forEach(function(m){if(m.from===ZERO){if(m.token==='HLBP')h+=m.amount;else g+=m.amount;}});});\n  return {h:h,g:g};\n}\nfunction position(){\n  const e=earnedTotals();\n  return {hlbpOut:supply('HLBP'),guocoOut:supply('GUOCO'),hlbpMinted:minted('HLBP'),guocoMinted:minted('GUOCO'),\n    hlbpBurned:burned('HLBP'),guocoBurned:burned('GUOCO'),\n    memberH:balance(ADDR.amir,'HLBP'),memberG:balance(ADDR.amir,'GUOCO'),\n    partnerG:balance(ADDR.guocoW,'GUOCO'),partnerH:balance(ADDR.guocoW,'HLBP'),vaultG:balance(ADDR.vault,'GUOCO'),\n    linked:S.member.linked?1:0,earnedH:e.h,earnedG:e.g};\n}\nfunction openBreaks(){return S.breaks.filter(function(b){return b.status!=='RESOLVED';});}\nfunction ledgers(){\n  const p=position();let hv=0,gv=0;\n  openBreaks().forEach(function(b){if(b.source==='Ledger vs DLT'){if(b.token==='HLBP')hv+=b.variance;else gv+=b.variance;}});\n  return {p:p,hv:hv,gv:gv,net:hv+gv,\n    rows:[\n      {src:'DLT (Liminal)',unit:'HNWI wallet HLBP',bal:p.memberH,v:0},\n      {src:'Loyalty Ledger (SI)',unit:'Amir HLBP',bal:p.memberH+hv,v:hv},\n      {src:'DLT (Liminal)',unit:'HNWI wallet Guoco Points',bal:p.memberG,v:0},\n      {src:'Loyalty Ledger (SI)',unit:'Amir Guoco Points',bal:p.memberG+gv,v:gv},\n      {src:'DLT (Liminal)',unit:'Guoco Points pending burn (vault)',bal:p.vaultG,v:0}\n    ]};\n}\nfunction ledgerMatch(){\n  const L=ledgers(),tot=L.p.memberH+L.p.memberG;\n  if(!S.member.linked&&tot===0)return null;\n  if(!L.net)return 100;\n  return Math.max(0,100-Math.abs(L.net)/Math.max(1,tot)*100);\n}\n\n/* ============ DEMO SAMPLE DATA (presentation only) ============\n   Display-only. It never touches the on-chain registry, wallets, activities, scripts or any calculation.\n   It gives the control center a realistic \"other members\" backdrop. Set DEMO_SEED=false to remove all of it. */\nconst DEMO_SEED=true;\nconst SEED_ACTS=[\n  {id:'RDM-20250516-0004',when:'16 May 15:42:10',type:'Redemption',who:'Nadia R., HNWI',pts:'2,000 HLBP swap, 3,000 GUOCO burn'},\n  {id:'ERN-20250516-0009',when:'16 May 13:05:27',type:'Earn on purchase',who:'Farid H., Premier',pts:'850 HLBP + 340 GUOCO'},\n  {id:'LNK-20250516-0003',when:'16 May 10:21:03',type:'Programme activation',who:'Wei Jie T., HNWI',pts:'10,000 HLBP + 2,000 GUOCO'},\n  {id:'ERN-20250515-0008',when:'15 May 17:48:52',type:'Earn on purchase',who:'Priya S., HNWI',pts:'1,200 HLBP + 480 GUOCO'},\n  {id:'LNK-20250515-0001',when:'15 May 09:14:36',type:'Programme activation',who:'Sofia M., Premier',pts:'10,000 HLBP + 2,000 GUOCO'}\n];\nconst SEED_STAGE={request:'RECEIVED',rules:'PASSED',sign:'SIGNED',chain:'CONFIRMED',fulfil:'DONE',ledger:'SYNCED'};\n/* programme-wide totals implied by other members, so every screen agrees */\nconst BASE2=(function(){\n  const members=120,rmSpent=186000,earnedH=rmSpent*EARN_RATE.HLBP,earnedG=rmSpent*EARN_RATE.GUOCO;\n  return {members:members,eligible:150,earnedH:earnedH,earnedG:earnedG,\n    HLBP:{minted:members*LINK_PTS.HLBP+earnedH,burned:0},GUOCO:{minted:members*LINK_PTS.GUOCO+earnedG,burned:318000}};\n})();\nconst SEED_AUDIT=[\n  {time:'10:24:18',actor:'Reconciliation Engine',text:'completed intraday reconciliation: loyalty ledger and DLT balances matched'},\n  {time:'10:05:42',actor:'Treasury Manager',text:'approved the daily points liability attestation'},\n  {time:'09:47:09',actor:'SI Orchestrator',text:'health check passed: Core Banking, Liminal Tokenization, DLT node, Visa gateway'},\n  {time:'09:31:55',actor:'Ops Analyst',text:'reviewed the partner float: Guoco Hotels wallet is above the minimum threshold'},\n  {time:'09:12:30',actor:'Treasury Ops',text:'opened the daily points operations window'},\n  {time:'08:58:03',actor:'SI Orchestrator',text:'refreshed the earn rules: '+EARN_RATE.HLBP+' HLBP and '+EARN_RATE.GUOCO+' Guoco Points per RM 1'},\n  {time:'08:45:12',actor:'Treasury Ops',text:'signed in to the control center'}\n];\nconst SEED_BREAKS=[\n  {id:'BRK-20250516-0003',source:'Ledger vs DLT',variance:-120,token:'HLBP',label:'Post ledger adjustment',by:'Treasury Manager',at:'16 May 12:48:31'},\n  {id:'BRK-20250515-0001',source:'DLT Execution',variance:-2000,token:'GUOCO',label:'Re-submit signed DLT transaction',by:'Treasury Manager',at:'15 May 15:02:19'}\n];\nfunction seedTok(t){return DEMO_SEED?BASE2[t]:{minted:0,burned:0};}\nfunction seedTokSupply(t){const b=seedTok(t);return b.minted-b.burned;}\nfunction seedEligible(){return DEMO_SEED?BASE2.eligible:1;}\nfunction seedMemberNote(){return DEMO_SEED?'Premier and HNWI segments':'HNWI segment &middot; Amir';}\nfunction seedOthersG(){return DEMO_SEED?' &middot; others '+pts(seedTokSupply('GUOCO')):'';}\nfunction dpos(){\n  const p=position();if(!DEMO_SEED)return p;const B=BASE2;\n  return Object.assign({},p,{hlbpOut:p.hlbpOut+seedTokSupply('HLBP'),guocoOut:p.guocoOut+seedTokSupply('GUOCO'),\n    hlbpMinted:p.hlbpMinted+B.HLBP.minted,hlbpBurned:p.hlbpBurned+B.HLBP.burned,guocoBurned:p.guocoBurned+B.GUOCO.burned,\n    earnedH:p.earnedH+B.earnedH,earnedG:p.earnedG+B.earnedG,linked:p.linked+B.members});\n}\nfunction dLedgerMatch(){const v=ledgerMatch();return (v===null&&DEMO_SEED)?100:v;}\nfunction auditAll(){return S.audit.concat(DEMO_SEED?SEED_AUDIT:[]);}\nfunction seedFiltered(){\n  if(!DEMO_SEED)return [];const f=S.filters;\n  return SEED_ACTS.filter(function(s){\n    if(f.status!=='All'&&f.status!=='Completed')return false;\n    if(f.q&&(s.id+' '+s.who+' '+s.type).toLowerCase().indexOf(f.q.toLowerCase())\u003c0)return false;\n    return true;});\n}\nfunction seedQueueRows(list){\n  return list.map(function(s){\n    return '\u003ctr class=\"seed\">\u003ctd>\u003cbutton class=\"kebab\" style=\"visibility:hidden\">&#9662;\u003c/button>\u003cspan class=\"txid\">'+s.id+'\u003c/span>'+\n      '\u003cdiv class=\"sub\">'+s.when+' &middot; Treasury Ops\u003c/div>\u003c/td>'+\n      '\u003ctd>\u003cdiv class=\"cust\">'+s.type+'\u003c/div>\u003cdiv class=\"chan\">('+s.who+')\u003c/div>\u003c/td>'+\n      '\u003ctd style=\"font-size:11px\">'+s.pts+'\u003c/td>'+\n      STAGES.map(function(k){return '\u003ctd>'+pill(SEED_STAGE[k])+'\u003c/td>';}).join('')+\n      '\u003ctd>\u003cspan class=\"pill ok\">Completed\u003c/span>\u003c/td>\u003c/tr>';}).join('');\n}\nfunction seedResolvedRows(){\n  if(!DEMO_SEED)return '';\n  return SEED_BREAKS.map(function(b){\n    return '\u003ctr class=\"seed\">\u003ctd class=\"txid\">'+b.id+'\u003c/td>\u003ctd>'+b.source+'\u003c/td>\u003ctd class=\"mono\">'+pts(b.variance)+' '+b.token+'\u003c/td>'+\n      '\u003ctd style=\"font-size:11.5px\">'+b.label+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+b.by+'\u003c/td>\u003ctd class=\"mono\">'+b.at.slice(7)+'\u003c/td>\u003c/tr>';}).join('');\n}\nfunction resolvedMini(){\n  if(!DEMO_SEED)return '';\n  return '\u003cdiv class=\"resolved-mini\">\u003cdiv class=\"h\">RECENTLY RESOLVED (LAST 7 DAYS)\u003c/div>'+SEED_BREAKS.map(function(b){\n    return '\u003cdiv class=\"r\">\u003cspan class=\"pill ok\">Resolved\u003c/span>\u003cspan class=\"id\">'+b.id+'\u003c/span>\u003cspan class=\"w\">'+b.source+' &middot; '+b.label+'\u003c/span>\u003cspan class=\"t\">'+b.at.slice(0,6)+'\u003c/span>\u003c/div>';}).join('')+'\u003c/div>';\n}\nfunction reconRuns(){\n  if(!DEMO_SEED)return '';\n  return '\u003cdiv class=\"runs\">\u003cspan>Last run \u003cb>10:24:18\u003c/b>\u003c/span>\u003cspan>Result \u003cb style=\"color:var(--green)\">Loyalty ledger and DLT matched\u003c/b>\u003c/span>'+\n    '\u003cspan style=\"margin-left:auto\">Last 7 daily runs\u003c/span>\u003cspan class=\"dots\">\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003c/span>\u003c/div>';\n}\n\n/* ============ INTERACTIVE CHARTS (presentation only) ============\n   Pure inline SVG/HTML, no external library, so the file still works offline.\n   Charts blend the sample history with live demo data and only read state; they never change it.\n   UI choices (range, metric, hidden series) live in CHUI so they survive the control center re-rendering. */\nconst CHUI={};            /* per-chart UI state */\nconst CCACHE={};          /* geometry cache used by the hover handlers */\nconst CH_COL={blue:'#2563eb',teal:'#0e7490',green:'#15803d',orange:'#c2410c',violet:'#6d5ce7',amber:'#d9822b',slate:'#a7b1c2',red:'#b91c1c'};\nconst CHM=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nconst CHD=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];\nconst CH_DAYS=10;\nfunction chui(id,def){if(!CHUI[id])CHUI[id]=Object.assign({hidden:{}},def||{});return CHUI[id];}\nfunction chAttr(s){return esc(s).replace(/\"/g,'&quot;');}\nfunction chFmt(n){\n  const a=Math.abs(n),s=n\u003c0?'-':'';\n  if(a>=1e6)return s+(a/1e6).toFixed(a>=1e7?1:2).replace(/\\.0+$|0+$/,'').replace(/\\.$/,'')+'M';\n  if(a>=1e3)return s+(a/1e3).toFixed(a>=1e5?0:1).replace(/\\.0$/,'')+'k';\n  return s+(Math.round(a*10)/10);\n}\nfunction chRng(seed){let a=0;String(seed).split('').forEach(function(c){a=(a*31+c.charCodeAt(0))>>>0;});\n  return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\n/* a smooth, slightly noisy growth curve of 'days' points that always ends exactly on 'end' */\nfunction chHist(key,end,days,start){\n  const r=chRng(key),o=[];let drift=0;\n  for(let i=0;i\u003cdays;i++){const t=i/(days-1),base=start+(1-start)*Math.pow(t,1.35);\n    drift=drift*.6+(r()-.5)*.05;o.push(end*Math.max(0.02,base*(1+drift*(1-t))));}\n  o[days-1]=end;return o;\n}\nfunction chScale(max){\n  if(!(max>0))return {max:1,ticks:[0,1]};\n  const raw=max/4,p=Math.pow(10,Math.floor(Math.log10(raw))),f=raw/p;\n  const step=(f\u003c=1?1:f\u003c=2?2:f\u003c=2.5?2.5:f\u003c=5?5:10)*p,top=Math.ceil(max/step-1e-9)*step,ticks=[];\n  for(let v=0;v\u003c=top+1e-9;v+=step)ticks.push(v);\n  return {max:top,ticks:ticks};\n}\nfunction chDateOf(daysAgo){return new Date(clock.getFullYear(),clock.getMonth(),clock.getDate()-daysAgo);}\nfunction chDateLbl(daysAgo){const d=chDateOf(daysAgo);return d.getDate()+' '+CHM[d.getMonth()];}\nfunction chDaysList(n){const out=[];for(let k=n-1;k>=0;k--){const d=chDateOf(k);\n  out.push({key:d.getDate()+' '+CHM[d.getMonth()],label:CHD[d.getDay()]+' '+d.getDate(),today:k===0});}return out;}\nfunction chParseDay(s){const m=/(\\d{1,2}) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/.exec(s||'');return m?(+m[1])+' '+m[2]:'';}\nfunction chNums(s){return (String(s).match(/[\\d,]+/g)||[]).map(function(x){return +x.replace(/,/g,'');});}\n/* ---- small UI pieces ---- */\nfunction chSeg(id,k,opts,cur){\n  return '\u003cdiv class=\"seg\">'+opts.map(function(o){return '\u003cbutton class=\"'+(o[0]===cur?'on':'')+'\" onclick=\"chartOpt(\\''+id+'\\',\\''+k+'\\',\\''+o[0]+'\\')\">'+o[1]+'\u003c/button>';}).join('')+'\u003c/div>';\n}\nfunction chLegend(id,items,ui){\n  return items.map(function(it){return '\u003cbutton class=\"lg'+(ui.hidden[it.key]?' off':'')+'\" onclick=\"chartToggle(\\''+id+'\\',\\''+it.key+'\\')\">\u003ci style=\"background:'+it.color+'\">\u003c/i>'+it.label+'\u003c/button>';}).join('');\n}\nfunction chTipRows(rows,total,fmt){\n  return rows.map(function(r){return '\u003cdiv class=\"r\">\u003cspan>\u003ci style=\"background:'+r.color+'\">\u003c/i>\u003cspan class=\"k\">'+r.label+'\u003c/span>\u003c/span>\u003cb>'+fmt(r.value)+'\u003c/b>\u003c/div>';}).join('')+\n    (total!==null&&rows.length>1?'\u003cdiv class=\"r\" style=\"border-top:1px solid #33435c;margin-top:3px;padding-top:3px\">\u003cspan class=\"k\">Total\u003c/span>\u003cb>'+fmt(total)+'\u003c/b>\u003c/div>':'');\n}\n/* ---- line / area chart with crosshair ---- */\nfunction chLine(id,spec,ui){\n  const W=480,H=214,L=50,R=14,T=12,B=26,pw=W-L-R,ph=H-T-B;\n  const days=({'7D':7,'30D':30,'90D':90})[ui.range]||30;\n  const vis=spec.series.filter(function(s){return !ui.hidden[s.key];});\n  const data=vis.map(function(s){return s.values.slice(-days);});\n  let mx=0;data.forEach(function(a){a.forEach(function(v){if(v>mx)mx=v;});});\n  const sc=chScale(mx*1.04),X=function(i){return L+i*pw/(days-1);},Y=function(v){return T+ph-(v/sc.max)*ph;};\n  let s='\u003csvg viewBox=\"0 0 '+W+' '+H+'\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\">';\n  s+='\u003cg class=\"ch-grid\">'+sc.ticks.map(function(t){return '\u003cline x1=\"'+L+'\" x2=\"'+(W-R)+'\" y1=\"'+Y(t).toFixed(1)+'\" y2=\"'+Y(t).toFixed(1)+'\"/>';}).join('')+'\u003c/g>';\n  const nx=Math.min(days,5),idx=[];for(let k=0;k\u003cnx;k++)idx.push(Math.round(k*(days-1)/(nx-1)));\n  s+='\u003cg class=\"ch-ax\">'+sc.ticks.map(function(t){return '\u003ctext x=\"'+(L-6)+'\" y=\"'+(Y(t)+3).toFixed(1)+'\" text-anchor=\"end\">'+chFmt(t)+'\u003c/text>';}).join('')+\n     idx.map(function(i,k){return '\u003ctext x=\"'+X(i).toFixed(1)+'\" y=\"'+(H-8)+'\" text-anchor=\"'+(k===0?'start':(k===nx-1?'end':'middle'))+'\">'+chDateLbl(days-1-i)+'\u003c/text>';}).join('')+'\u003c/g>';\n  const xs=[];for(let i=0;i\u003cdays;i++)xs.push(X(i));\n  vis.forEach(function(se,k){\n    const pts=data[k].map(function(v,i){return xs[i].toFixed(1)+' '+Y(v).toFixed(1);}),line='M'+pts.join(' L');\n    s+='\u003cpath d=\"'+line+' L'+xs[days-1].toFixed(1)+' '+(T+ph)+' L'+xs[0].toFixed(1)+' '+(T+ph)+' Z\" fill=\"'+se.color+'\" opacity=\".09\"/>';\n    s+='\u003cpath d=\"'+line+'\" fill=\"none\" stroke=\"'+se.color+'\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n    s+='\u003ccircle cx=\"'+xs[days-1].toFixed(1)+'\" cy=\"'+Y(data[k][days-1]).toFixed(1)+'\" r=\"4\" fill=\"#fff\" stroke=\"'+se.color+'\" stroke-width=\"2\"/>';\n  });\n  s+='\u003cline class=\"ch-vl\" y1=\"'+T+'\" y2=\"'+(T+ph)+'\" stroke=\"#94a3b8\" stroke-dasharray=\"3 3\" style=\"display:none\"/>';\n  vis.forEach(function(se,k){s+='\u003ccircle class=\"ch-dot\" data-k=\"'+k+'\" r=\"4.5\" fill=\"'+se.color+'\" stroke=\"#fff\" stroke-width=\"2\" style=\"display:none\"/>';});\n  s+='\u003crect class=\"ch-hit\" data-ch=\"'+id+'\" x=\"'+L+'\" y=\"'+T+'\" width=\"'+pw+'\" height=\"'+ph+'\" fill=\"transparent\"/>\u003c/svg>';\n  CCACHE[id]={W:W,L:L,pw:pw,days:days,xs:xs,ys:data.map(function(a){return a.map(Y);}),\n    series:vis.map(function(se,k){return {label:se.label,color:se.color,vals:data[k]};}),fmt:spec.fmt};\n  return s;\n}\n/* ---- stacked column chart ---- */\nfunction chBars(id,spec,ui){\n  const W=480,H=214,L=50,R=10,T=12,B=26,pw=W-L-R,ph=H-T-B,n=spec.days.length;\n  const segs=spec.segs.filter(function(g){return !ui.hidden[g.key];});\n  const tot=spec.days.map(function(d){return segs.reduce(function(a,g){return a+(d.vals[g.key]||0);},0);});\n  const sc=chScale(Math.max.apply(null,tot.concat([0]))*1.05),bw=pw/n,gap=Math.min(10,bw*.3),w=bw-gap;\n  let s='\u003csvg viewBox=\"0 0 '+W+' '+H+'\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\">';\n  s+='\u003cg class=\"ch-grid\">'+sc.ticks.map(function(t){const y=T+ph-(t/sc.max)*ph;return '\u003cline x1=\"'+L+'\" x2=\"'+(W-R)+'\" y1=\"'+y.toFixed(1)+'\" y2=\"'+y.toFixed(1)+'\"/>';}).join('')+'\u003c/g>';\n  s+='\u003cg class=\"ch-ax\">'+sc.ticks.map(function(t){const y=T+ph-(t/sc.max)*ph;return '\u003ctext x=\"'+(L-6)+'\" y=\"'+(y+3).toFixed(1)+'\" text-anchor=\"end\">'+chFmt(t)+'\u003c/text>';}).join('')+'\u003c/g>';\n  spec.days.forEach(function(d,i){\n    const x=L+i*bw+gap/2,rows=segs.map(function(g){return {label:g.label,color:g.color,value:d.vals[g.key]||0};}).filter(function(r){return r.value>0;});\n    const tip='\u003cb>'+d.full+(d.today?' (today)':'')+'\u003c/b>'+(rows.length?chTipRows(rows,tot[i],spec.fmt):'\u003cdiv class=\"k\">No activity\u003c/div>');\n    s+='\u003cg class=\"ch-col\" data-tip=\"'+chAttr(tip)+'\">\u003crect class=\"chov\" x=\"'+(L+i*bw).toFixed(1)+'\" y=\"'+T+'\" width=\"'+bw.toFixed(1)+'\" height=\"'+ph+'\" fill=\"transparent\"/>';\n    let y=T+ph;\n    segs.forEach(function(g){const v=d.vals[g.key]||0;if(v\u003c=0)return;const h=v/sc.max*ph;y-=h;\n      s+='\u003crect class=\"cbar\" x=\"'+x.toFixed(1)+'\" y=\"'+y.toFixed(1)+'\" width=\"'+w.toFixed(1)+'\" height=\"'+Math.max(1,h).toFixed(1)+'\" rx=\"2.5\" fill=\"'+g.color+'\"/>';});\n    s+='\u003c/g>\u003ctext class=\"ch-x'+(d.today?' today':'')+'\" x=\"'+(x+w/2).toFixed(1)+'\" y=\"'+(H-8)+'\" text-anchor=\"middle\">'+d.label+'\u003c/text>';\n  });\n  return s+'\u003c/svg>';\n}\n/* ---- donut ---- */\nfunction chDonut(id,spec,ui){\n  const segs=spec.segs.filter(function(g){return !ui.hidden[g.key]&&g.value>0;}),tot=segs.reduce(function(a,g){return a+g.value;},0);\n  const sf=spec.short||spec.fmt,r=52,C=2*Math.PI*r;let off=0,arcs='';\n  if(!tot)arcs='\u003ccircle cx=\"80\" cy=\"80\" r=\"'+r+'\" fill=\"none\" stroke=\"#eef0f4\" stroke-width=\"20\"/>';\n  segs.forEach(function(g){\n    const len=g.value/tot*C,gp=segs.length>1?2:0,pct=Math.round(g.value/tot*1000)/10;\n    arcs+='\u003ccircle class=\"dn-seg\" cx=\"80\" cy=\"80\" r=\"'+r+'\" fill=\"none\" stroke=\"'+g.color+'\" stroke-width=\"20\" stroke-dasharray=\"'+(len-gp).toFixed(2)+' '+(C-len+gp).toFixed(2)+'\" stroke-dashoffset=\"'+(-off).toFixed(2)+'\" transform=\"rotate(-90 80 80)\" '+\n      'data-tip=\"'+chAttr('\u003cb>'+g.label+'\u003c/b>\u003cdiv class=\"r\">\u003cspan class=\"k\">'+spec.unit+'\u003c/span>\u003cb>'+spec.fmt(g.value)+'\u003c/b>\u003c/div>\u003cdiv class=\"r\">\u003cspan class=\"k\">Share\u003c/span>\u003cb>'+pct+'%\u003c/b>\u003c/div>')+'\" data-cv=\"'+chAttr(sf(g.value))+'\" data-cl=\"'+chAttr(g.label)+'\"/>';\n    off+=len;});\n  const svg='\u003csvg viewBox=\"0 0 160 160\" role=\"img\" aria-label=\"'+chAttr(spec.aria)+'\" data-cv=\"'+chAttr(sf(tot))+'\" data-cl=\"'+chAttr(spec.center)+'\">'+arcs+\n    '\u003ctext class=\"dn-cv\" x=\"80\" y=\"82\" text-anchor=\"middle\">'+sf(tot)+'\u003c/text>\u003ctext class=\"dn-cl\" x=\"80\" y=\"97\" text-anchor=\"middle\">'+spec.center+'\u003c/text>\u003c/svg>';\n  const all=spec.segs.reduce(function(a,g){return a+g.value;},0);\n  const leg='\u003cdiv class=\"dn-leg\">'+spec.segs.map(function(g){\n    return '\u003cbutton class=\"r'+(ui.hidden[g.key]?' off':'')+'\" onclick=\"chartToggle(\\''+id+'\\',\\''+g.key+'\\')\">\u003ci style=\"background:'+g.color+'\">\u003c/i>\u003cspan>'+g.label+'\u003c/span>\u003cb>'+sf(g.value)+'\u003c/b>\u003cem>'+(all?Math.round(g.value/all*100):0)+'%\u003c/em>\u003c/button>';}).join('')+'\u003c/div>';\n  return '\u003cdiv class=\"dn-wrap\">'+svg+leg+'\u003c/div>';\n}\n/* ---- horizontal bars ---- */\nfunction chHBars(id,spec,ui){\n  const rows=spec.rows.map(function(r){const parts=r.parts.filter(function(p){return !ui.hidden[p.key];});\n    return {label:r.label,parts:parts,total:parts.reduce(function(a,p){return a+p.value;},0),note:r.note||''};});\n  const mx=Math.max.apply(null,rows.map(function(r){return r.total;}).concat([1]));\n  return rows.map(function(r){\n    const tip='\u003cb>'+r.label+'\u003c/b>'+chTipRows(r.parts.filter(function(p){return p.value>0;}),r.total,spec.fmt)+(r.note?'\u003cdiv class=\"k\" style=\"margin-top:3px\">'+r.note+'\u003c/div>':'');\n    return '\u003cdiv class=\"hb\" data-tip=\"'+chAttr(tip)+'\">\u003cspan class=\"l\">'+r.label+'\u003c/span>\u003cdiv class=\"tr\">'+\n      r.parts.map(function(p){return '\u003ci style=\"width:'+(p.value/mx*100).toFixed(2)+'%;background:'+p.color+'\">\u003c/i>';}).join('')+'\u003c/div>\u003cspan class=\"v\">'+(spec.short||spec.fmt)(r.total)+'\u003c/span>\u003c/div>';}).join('');\n}\n/* ---- cards ---- */\nfunction chCardInner(d){\n  const ui=chui(d.id,d.ui),b=d.build(ui);\n  return '\u003cdiv class=\"chh\">\u003cdiv>\u003cdiv class=\"cht\">'+b.title+'\u003c/div>\u003cdiv class=\"chs\">'+b.sub+'\u003c/div>\u003c/div>\u003cdiv class=\"chc\">'+(b.controls||'')+'\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"chb\">'+b.body+'\u003c/div>'+(b.legend?'\u003cdiv class=\"chl\">'+b.legend+'\u003c/div>':'');\n}\nfunction chartsHtml(){\n  if(typeof DEMO_SEED!=='undefined'&&!DEMO_SEED)return '';\n  return '\u003cdiv class=\"sec-h\">\u003ch3>Trends &amp; Analytics\u003c/h3>\u003cdiv class=\"i\" title=\"Sample history plus live demo data. Hover for details, use the toggles to change the view.\">i\u003c/div>'+\n    '\u003cspan class=\"chnote\">Hover for details &middot; click a legend item to show or hide it\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"chgrid\">'+chartDefs().map(function(d){return '\u003cdiv class=\"chcard\" id=\"ch-'+d.id+'\">'+chCardInner(d)+'\u003c/div>';}).join('')+'\u003c/div>';\n}\nfunction chartRefresh(id){const d=chartDefs().find(function(x){return x.id===id;}),el=document.getElementById('ch-'+id);if(d&&el)el.innerHTML=chCardInner(d);}\nfunction chartOpt(id,k,v){chui(id)[k]=v;chartRefresh(id);}\nfunction chartToggle(id,key){\n  const d=chartDefs().find(function(x){return x.id===id;});if(!d)return;const ui=chui(id,d.ui),keys=d.build(ui).keys||[];\n  if(!ui.hidden[key]&&keys.filter(function(k){return !ui.hidden[k];}).length\u003c=1)return;   /* always keep one visible */\n  ui.hidden[key]=!ui.hidden[key];chartRefresh(id);\n}\n/* ---- one delegated hover layer for every chart (tooltip, crosshair, donut centre) ---- */\n(function chInit(){\n  const tip=document.createElement('div');tip.className='ctip';tip.style.display='none';document.body.appendChild(tip);\n  let lastSvg=null,lastDn=null;\n  function place(x,y){const w=tip.offsetWidth,h=tip.offsetHeight;let l=x+14,t=y+14;\n    if(l+w>window.innerWidth-6)l=x-w-14;if(t+h>window.innerHeight-6)t=y-h-14;tip.style.left=Math.max(4,l)+'px';tip.style.top=Math.max(4,t)+'px';}\n  function show(html,x,y){tip.innerHTML=html;tip.style.display='block';place(x,y);}\n  function clearLine(){if(lastSvg){const vl=lastSvg.querySelector('.ch-vl');if(vl)vl.style.display='none';\n    lastSvg.querySelectorAll('.ch-dot').forEach(function(d){d.style.display='none';});lastSvg=null;}}\n  function clearDn(){if(lastDn){const cv=lastDn.querySelector('.dn-cv'),cl=lastDn.querySelector('.dn-cl');\n    if(cv)cv.textContent=lastDn.getAttribute('data-cv');if(cl)cl.textContent=lastDn.getAttribute('data-cl');lastDn=null;}}\n  function hoverLine(hit,e){\n    const c=CCACHE[hit.getAttribute('data-ch')],svg=hit.ownerSVGElement;if(!c||!svg)return;\n    const r=svg.getBoundingClientRect();if(!r.width)return;\n    const x=(e.clientX-r.left)*(c.W/r.width);let i=Math.round((x-c.L)/c.pw*(c.days-1));i=Math.max(0,Math.min(c.days-1,i));\n    if(lastSvg&&lastSvg!==svg)clearLine();lastSvg=svg;\n    const vl=svg.querySelector('.ch-vl');vl.setAttribute('x1',c.xs[i]);vl.setAttribute('x2',c.xs[i]);vl.style.display='';\n    svg.querySelectorAll('.ch-dot').forEach(function(d){const k=+d.getAttribute('data-k');d.setAttribute('cx',c.xs[i]);d.setAttribute('cy',c.ys[k][i]);d.style.display='';});\n    const rows=c.series.map(function(s){return {label:s.label,color:s.color,value:s.vals[i]};});\n    show('\u003cb>'+chDateLbl(c.days-1-i)+(i===c.days-1?' (today, live)':'')+'\u003c/b>'+chTipRows(rows,null,c.fmt),e.clientX,e.clientY);\n  }\n  document.addEventListener('mousemove',function(e){\n    const el=e.target&&e.target.closest?e.target:null;if(!el){return;}\n    const hit=el.closest('.ch-hit');\n    if(hit){clearDn();hoverLine(hit,e);return;}\n    clearLine();\n    const t=el.closest('[data-tip]');\n    if(t){show(t.getAttribute('data-tip'),e.clientX,e.clientY);\n      if(t.hasAttribute('data-cv')&&t.ownerSVGElement){const svg=t.ownerSVGElement;if(lastDn&&lastDn!==svg)clearDn();lastDn=svg;\n        svg.querySelector('.dn-cv').textContent=t.getAttribute('data-cv');svg.querySelector('.dn-cl').textContent=t.getAttribute('data-cl');}\n      else clearDn();\n      return;}\n    clearDn();tip.style.display='none';\n  });\n  document.documentElement.addEventListener('mouseleave',function(){clearLine();clearDn();tip.style.display='none';});\n  document.addEventListener('scroll',function(){tip.style.display='none';},true);\n})();\n/* live API calls per external system (internal actors are skipped) */\nfunction chSystems(){\n  const m={};S.events.forEach(function(e){[e.from,e.to].forEach(function(n){\n    if(!n||/^(SI\\b|CUSTOMER|CORPORATE|TREASURY|OPS|RECONCILIATION|MAKER|CHECKER|HLB MOBILE)/.test(n))return;m[n]=(m[n]||0)+1;});});\n  return m;\n}\n\n/* ---- Case 2 chart data: sample activity + live activity ---- */\nconst CH_KIND={LNK:{label:'Programme activation',color:CH_COL.violet},ERN:{label:'Earn on purchase',color:CH_COL.green},RDM:{label:'Redemption',color:CH_COL.orange}};\nconst SEED_API={LIMINAL:184,DLT:143,'HLB CORE':96,'LOYALTY LEDGER':88,NOTIFICATIONS:74,VISA:61,'LOYALTY RULES':52};\nfunction chFlows(){\n  const out=[];\n  SEED_ACTS.forEach(function(s){const k=s.id.slice(0,3),nn=chNums(s.pts);\n    out.push({day:chParseDay(s.when),kind:k,h:k==='RDM'?0:nn[0],g:k==='RDM'?0:nn[1],b:k==='RDM'?nn[nn.length-1]:0,live:false});});\n  S.acts.forEach(function(a){if(a.status==='REJECTED')return;let h=0,g=0,b=0;\n    a.legs.forEach(function(l){if(l.st.chain!=='CONFIRMED')return;if(l.op==='ISSUE'){if(l.token==='HLBP')h+=l.amount;else g+=l.amount;}else if(l.op==='BURN')b+=l.amount;});\n    out.push({day:chParseDay(a.submitted),kind:a.type==='LINK'?'LNK':(a.type==='EARN'?'ERN':'RDM'),h:h,g:g,b:b,live:true});});\n  return out;\n}\nfunction chTrendSpec(P){\n  const n=90,eH=seedTokSupply('HLBP'),eG=seedTokSupply('GUOCO')+GUOCO_FLOAT;   /* start-of-demo values, so only \"today\" moves */\n  const h=chHist('uc2-hlbp',eH,n,.16),g=chHist('uc2-guoco',eG,n,.10);h[n-1]=P.hlbpOut;g[n-1]=P.guocoOut;\n  return {aria:'HLBP and Guoco Points outstanding over time',fmt:function(v){return money(v,0)+' pts';},series:[\n    {key:'hlbp',label:'HLBP outstanding',color:CH_COL.blue,values:h},{key:'guoco',label:'Guoco Points outstanding',color:CH_COL.teal,values:g}]};\n}\nfunction chartDefs(){\n  const P=dpos(),flows=chFlows();\n  return [\n   {id:'trend',ui:{range:'30D'},build:function(ui){const sp=chTrendSpec(P);\n     return {title:'Points outstanding',sub:'HLBP and Guoco Points: sample history, today is live',\n       controls:chSeg('trend','range',[['7D','7D'],['30D','30D'],['90D','90D']],ui.range),body:chLine('trend',sp,ui),\n       legend:chLegend('trend',sp.series,ui),keys:sp.series.map(function(s){return s.key;})};}},\n   {id:'days',ui:{metric:'h'},build:function(ui){\n     const m=ui.metric,segs=m==='b'?[{key:'rdm',label:'Redeemed (burned)',color:CH_COL.orange}]:[{key:'act',label:'Activation',color:CH_COL.violet},{key:'earn',label:'Earn on purchase',color:CH_COL.green}];\n     const days=chDaysList(CH_DAYS).map(function(d){const vals={};\n       flows.forEach(function(f){if(f.day!==d.key)return;\n         if(m==='b'){if(f.kind==='RDM')vals.rdm=(vals.rdm||0)+f.b;}\n         else{const key=f.kind==='LNK'?'act':(f.kind==='ERN'?'earn':null);if(key)vals[key]=(vals[key]||0)+f[m];}});\n       return {label:d.label,full:d.key,today:d.today,vals:vals};});\n     const sp={aria:'Points issued and redeemed per day',days:days,segs:segs,fmt:function(v){return money(v,0)+(m==='h'?' HLBP':' GUOCO');}};\n     return {title:'Points per day',sub:'Issued and redeemed, last '+CH_DAYS+' days, on-chain confirmed',\n       controls:chSeg('days','metric',[['h','HLBP'],['g','Guoco'],['b','Redeemed']],m),body:chBars('days',sp,ui),\n       legend:chLegend('days',segs,ui),keys:segs.map(function(s){return s.key;})};