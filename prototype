DvP Escrow contract')+\n   tile('tMYR Outstanding',ic('#c2410c','#fdf1e7','&#8645;'),money(p.tmyrOut,0),'tMYR','Minted '+money(p.tmyrMinted,0)+' &middot; burned '+money(p.tmyrBurned,0))+\n   '\u003cdiv class=\"tile\">\u003cdiv class=\"th\">'+ic('#4338ca','#efedfd','&#9201;')+'tSGD Reserve Coverage\u003c/div>\u003cdiv class=\"tv\">'+\n     '\u003cdiv>\u003cspan class=\"amt\">'+(p.coverage===null?'&mdash;':p.coverage.toFixed(0)+'%')+'\u003c/span>\u003c/div>\u003c/div>'+gaugeHtml(p)+'\u003c/div>'+\n  '\u003c/div>';\n}\nfunction gaugeHtml(p){\n  const pos=p.coverage===null?0:Math.max(0,Math.min(100,(p.coverage/150)*100));\n  return '\u003cdiv class=\"gauge\">\u003cdiv class=\"lbl\">SGD locked vs tSGD minted\u003c/div>'+\n   '\u003cdiv class=\"scale\">\u003cspan>0%\u003c/span>\u003cspan>100%\u003c/span>\u003cspan>150%\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"bar\">'+(p.coverage===null?'':'\u003cdiv class=\"ndl\" style=\"left:'+pos+'%\">\u003c/div>')+'\u003c/div>'+\n   '\u003cdiv class=\"legend\">\u003cdiv>SGD Locked\u003cb>'+money(p.locked,0)+'\u003c/b>\u003c/div>'+\n   '\u003cdiv style=\"text-align:right\">tSGD Minted\u003cb>'+money(p.tsgdMinted,0)+'\u003c/b>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"thr\">Must stay at or above 100%\u003c/div>\u003c/div>';\n}\nfunction queueRows(list){\n  let out='';\n  list.forEach(function(p){\n    const open=S.exp[p.id]!==false;\n    out+='\u003ctr class=\"trow\" onclick=\"openPlanDrawer(\\''+p.id+'\\')\">'+\n      '\u003ctd>\u003cbutton class=\"kebab\" title=\"Expand or collapse the milestone legs\" onclick=\"event.stopPropagation();toggleExp(\\''+p.id+'\\')\">'+(open?'&#9662;':'&#9656;')+'\u003c/button>\u003cspan class=\"txid\">'+p.id+'\u003c/span>'+\n      '\u003cdiv class=\"sub\">'+p.submitted.replace(' 2025','')+' &middot; '+p.owner+'\u003c/div>\u003c/td>'+\n      '\u003ctd>\u003cdiv class=\"cust\">Guocoland\u003c/div>\u003cdiv class=\"chan\">(to Bank MY)\u003c/div>\u003c/td>'+\n      '\u003ctd class=\"mono\">'+money(p.sgd,0)+'\u003c/td>'+\n      PLAN_STAGES.map(function(s){return '\u003ctd>'+pill(p.st[s])+'\u003c/td>';}).join('')+\n      LEG_STAGES.map(function(){return '\u003ctd>\u003c/td>';}).join('')+\n      '\u003ctd>\u003cspan class=\"pill '+statusPill(p.status)+'\">'+STATUS_LBL(p.status)+'\u003c/span>\u003c/td>\u003c/tr>';\n    if(open)p.legs.forEach(function(l){\n      out+='\u003ctr class=\"trow leg\" onclick=\"openPlanDrawer(\\''+p.id+'\\')\">'+\n        '\u003ctd>\u003cspan class=\"txid\">'+l.id+'\u003c/span>\u003c/td>'+\n        '\u003ctd>\u003cdiv class=\"cust\">Milestone '+l.n+'\u003c/div>\u003cdiv class=\"chan\">(MYR '+money(l.myr,0)+')\u003c/div>\u003c/td>'+\n        '\u003ctd class=\"mono\">'+money(l.sgd,0)+'\u003c/td>'+\n        PLAN_STAGES.map(function(){return '\u003ctd>\u003c/td>';}).join('')+\n        LEG_STAGES.map(function(s){return '\u003ctd>'+pill(l.st[s])+'\u003c/td>';}).join('')+\n        '\u003ctd>\u003c/td>\u003c/tr>';\n    });\n  });\n  return out;\n}\nfunction STATUS_LBL(s){return {IN_PROGRESS:'In progress',AWAITING_APPROVAL:'Awaiting approval',AWAITING_MILESTONE:'Awaiting milestone',AWAITING_SCRIPT:'Awaiting script',AWAITING_INSPECTION:'Awaiting inspection',\n  ON_HOLD:'On hold',EXCEPTION:'Exception',REJECTED:'Rejected',COMPLETED:'Completed'}[s]||s;}\nfunction queueHtml(showAll){\n  const list=filtered(), sd=seedFiltered(), total=list.length+sd.length;\n  const hdr=STAGES.map(function(s){return '\u003cth>'+STAGE_LBL[s]+'\u003c/th>';}).join('');\n  return '\u003cdiv class=\"card\" style=\"padding:14px 16px\">'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>2) Plan Control Queue\u003c/h3>\u003cdiv class=\"i\" title=\"Each plan expands into three milestone legs. Plan-level stages fill on the plan row, leg-level stages on the leg rows.\">i\u003c/div>'+\n   '\u003cspan class=\"pill pend\">'+total+' Plan'+(total===1?'':'s')+'\u003c/span>\u003cdiv class=\"rt\">\u003cspan style=\"font-size:11.5px;color:var(--muted)\">Auto refresh\u003c/span>'+\n   '\u003cbutton class=\"sm\" onclick=\"exportCsv()\">Export\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable class=\"qt\">\u003cthead>\u003ctr>\u003cth>Plan / Leg ID\u003c/th>\u003cth>Counterparty\u003c/th>\u003cth>SGD\u003c/th>'+hdr+'\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>'+\n   '\u003ctbody>'+(total?queueRows(list)+seedQueueRows(sd):'\u003ctr>\u003ctd colspan=\"11\" style=\"color:var(--muted2);padding:18px\">No plans yet. Create a milestone payment in the Corporate Portal to see it here.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>'+\n   (showAll?'':'\u003cdiv class=\"pager\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'txns\\')\">View all plans &rarr;\u003c/button>\u003c/div>')+'\u003c/div>';\n}\nfunction reconHtml(){\n  const L=dledgers();\n  const net=L.net, over=Math.abs(net)>1000;\n  const vr=function(v){return v?('\u003cspan style=\"color:var(--red);font-weight:700\">'+money(v)+'\u003c/span>'):'\u003cspan style=\"color:var(--muted2)\">&mdash;\u003c/span>';};\n  return '\u003cdiv class=\"card\" style=\"padding:14px 16px\">'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>3) Reconciliation and Breaks\u003c/h3>\u003cdiv class=\"i\" title=\"Core banking vs DLT vs escrow vs GL\">i\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"font-size:11.5px;font-weight:700;margin-bottom:8px\">Ledger Balance Comparison\u003c/div>'+\n   '\u003cdiv style=\"display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:12px;align-items:center\">'+\n    '\u003ctable>\u003cthead>\u003ctr>\u003cth>Source\u003c/th>\u003cth>Measure\u003c/th>\u003cth>Balance\u003c/th>\u003cth>Variance\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n     L.rows.map(function(r){return '\u003ctr>\u003ctd>'+r.src+'\u003c/td>\u003ctd style=\"font-size:11px;color:var(--muted)\">'+r.unit+'\u003c/td>\u003ctd class=\"mono\">'+money(r.bal)+'\u003c/td>\u003ctd>'+vr(r.v)+'\u003c/td>\u003c/tr>';}).join('')+\n    '\u003c/tbody>\u003c/table>'+\n    '\u003cdiv class=\"donut\">\u003csvg width=\"112\" height=\"112\" viewBox=\"0 0 42 42\">'+\n     '\u003ccircle cx=\"21\" cy=\"21\" r=\"15.9\" fill=\"none\" stroke=\"#eef0f4\" stroke-width=\"5\">\u003c/circle>'+\n     '\u003ccircle cx=\"21\" cy=\"21\" r=\"15.9\" fill=\"none\" stroke=\"'+(net?'#b91c1c':'#15803d')+'\" stroke-width=\"5\" stroke-dasharray=\"'+(net?18:100)+' 100\" transform=\"rotate(-90 21 21)\">\u003c/circle>'+\n     '\u003c/svg>\u003cdiv class=\"ct\">Net Variance\u003c/div>\u003cdiv class=\"cv\" style=\"color:'+(net?'var(--red)':'var(--green)')+'\">'+money(net)+'\u003c/div>\u003cdiv class=\"ct\">tMYR\u003c/div>'+\n     '\u003cdiv class=\"thr\">Threshold: &plusmn;1,000 tMYR'+(over?'\u003cbr>\u003cb style=\"color:var(--red)\">BREACHED\u003c/b>':'')+'\u003c/div>\u003c/div>'+\n   '\u003c/div>'+reconRuns()+'\u003c/div>';\n}\nfunction breaksTableHtml(compact){\n  const list=compact?openBreaks().slice(0,4):S.breaks;\n  const rows=list.map(function(b){\n    const sc={OPEN:'bad',ASSIGNED:'wait',INVESTIGATING:'pend',PENDING_APPROVAL:'wait',ESCALATED:'bad',RESOLVED:'ok'}[b.status]||'mute';\n    return '\u003ctr class=\"trow\" onclick=\"openBreakDrawer(\\''+b.id+'\\')\">\u003ctd>\u003cspan class=\"txid\">'+b.id+'\u003c/span>\u003c/td>'+\n     '\u003ctd>'+b.source+'\u003c/td>\u003ctd class=\"mono\" style=\"color:'+(b.variance?'var(--red)':'var(--green)')+';font-weight:700\">'+money(b.variance)+'\u003c/td>'+\n     '\u003ctd style=\"font-size:11.5px\">'+b.reason+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+sc+'\">'+b.status.replace('_',' ')+'\u003c/span>\u003c/td>'+\n     '\u003ctd style=\"font-size:11.5px\">'+b.assignedTo+'\u003c/td>'+\n     '\u003ctd>\u003cbutton class=\"kebab\" onclick=\"event.stopPropagation();openBreakDrawer(\\''+b.id+'\\')\">&#8942;\u003c/button>\u003c/td>\u003c/tr>';\n  }).join('');\n  return '\u003cdiv class=\"card\" style=\"padding:14px 16px\">'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>Breaks / Exceptions\u003c/h3>\u003cspan class=\"pill bad\">'+openBreaks().length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Break ID\u003c/th>\u003cth>Source\u003c/th>\u003cth>Variance\u003c/th>\u003cth>Reason\u003c/th>\u003cth>Status\u003c/th>\u003cth>Assigned To\u003c/th>\u003cth>\u003c/th>\u003c/tr>\u003c/thead>'+\n   '\u003ctbody>'+(rows||'\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--green);font-weight:700;padding:16px\">&#10003; No open breaks - all control points matched\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>'+\n   (compact?resolvedMini():'')+\n   (compact?'\u003cdiv style=\"margin-top:10px\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'breaks\\')\">View all breaks &rarr;\u003c/button>\u003c/div>':'')+'\u003c/div>';\n}\nfunction railHtml(){\n  const ap=pendingAppr();\n  const mcHtml=ap.length?ap.slice(0,2).map(function(t){\n    return '\u003cdiv class=\"mc\">\u003cdiv class=\"t\">\u003cb>&#9203; Awaiting Checker Approval\u003c/b>\u003cspan class=\"id\">'+t.id+'\u003c/span>\u003c/div>'+\n     '\u003cdiv class=\"d\">Plan activation &ndash; Guocoland to Bank MY supplier\u003c/div>'+\n     '\u003cdiv class=\"m\">Submitted '+t.submitted+'\u003c/div>'+\n     '\u003cdiv class=\"m\" style=\"font-weight:700;color:var(--text)\">'+money(t.sgd,0)+' SGD\u003c/div>'+\n     '\u003cdiv class=\"mcflow\">\u003cdiv class=\"mcbox\">\u003cdiv class=\"r\">Maker\u003c/div>\u003cdiv class=\"n\">Ops Analyst\u003c/div>\u003cspan class=\"pill ok\">Submitted\u003c/span>\u003c/div>'+\n     '\u003cdiv style=\"color:var(--muted)\">&rarr;\u003c/div>'+\n     '\u003cdiv class=\"mcbox\">\u003cdiv class=\"r\">Checker\u003c/div>\u003cdiv class=\"n\">Treasury Manager\u003c/div>\u003cspan class=\"pill wait\">Pending\u003c/span>\u003c/div>\u003c/div>'+\n     '\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"approvePlan(\\''+t.id+'\\')\">Approve\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"rejectPlan(\\''+t.id+'\\')\">Reject\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"openPlanDrawer(\\''+t.id+'\\')\">Details\u003c/button>\u003c/div>\u003c/div>';\n  }).join(''):'\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">Nothing awaiting checker approval. Maker-checker is off by default for this demo.\u003c/div>';\n  return '\u003cdiv class=\"rail\">'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">4) Treasury Actions\u003c/div>\u003cdiv class=\"actgrid\">'+\n    act('&#128101;','Maker-Checker Approval','setNav(\\'appr\\')')+\n    act('&#128274;',(S.flags.settlementOnHold?'Release Settlement':'Hold Settlement'),'toggleSettlement()')+\n    act('&#9208;',(S.flags.issuancePaused?'Resume Issuance':'Pause Issuance'),'toggleIssuance()')+\n    act('&#128100;','Assign Break','setNav(\\'breaks\\')')+\n    act('&#9888;','Escalate Break','setNav(\\'breaks\\')')+\n    act('&#11015;','Download Reconciliation Report','downloadRecon()')+\n    '\u003cbutton class=\"actbtn wide\" onclick=\"setNav(\\'audit\\')\">\u003cspan class=\"ic\">&#128220;\u003c/span>Open Audit Trail\u003c/button>'+\n   '\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">&#8645; Maker-Checker Approval\u003cspan class=\"rt\" onclick=\"setNav(\\'appr\\')\">View all\u003c/span>\u003c/div>'+mcHtml+'\u003c/div>'+\n   '\u003cdiv class=\"railcard\">\u003cdiv class=\"railh\">Recent Activity / Audit Log\u003cspan class=\"rt\" onclick=\"setNav(\\'audit\\')\">View all\u003c/span>\u003c/div>'+\n    '\u003cdiv class=\"audit\">'+(auditAll().slice(0,6).map(function(a){return '\u003cdiv class=\"row\">\u003cspan class=\"tm\">'+a.time+'\u003c/span>\u003cspan>'+a.actor+' '+a.text+'\u003c/span>\u003c/div>';}).join('')||'\u003cdiv style=\"font-size:11.5px;color:var(--muted)\">No activity yet.\u003c/div>')+'\u003c/div>'+\n    '\u003cdiv style=\"margin-top:9px\">\u003cbutton class=\"lnk\" onclick=\"setNav(\\'audit\\')\">Open full audit trail &rarr;\u003c/button>\u003c/div>\u003c/div>'+\n  '\u003c/div>';\n}\nfunction act(ic,label,fn){return '\u003cbutton class=\"actbtn\" onclick=\"'+fn+'\">\u003cspan class=\"ic\">'+ic+'\u003c/span>'+label+'\u003c/button>';}\n/* ---- wallet, escrow and swap helpers ---- */\nfunction histTable(h){\n  return '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>Type\u003c/th>\u003cth>Token\u003c/th>\u003cth>Amount\u003c/th>\u003cth>Counterparty\u003c/th>\u003cth>Tx Hash\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (h.map(function(x){\n     const cls={IN:'in',OUT:'out',MINT:'mint',BURN:'burn'}[x.type];\n     const sign=(x.type==='IN'||x.type==='MINT')?'+':'-';\n     return '\u003ctr>\u003ctd class=\"mono\" style=\"font-size:11px\">'+x.tx.time.slice(12)+'\u003c/td>\u003ctd>\u003cspan class=\"dpill '+cls+'\">'+x.type+'\u003c/span>\u003c/td>\u003ctd>'+x.token+'\u003c/td>'+\n       '\u003ctd class=\"mono\">'+sign+' '+money(x.amount,0)+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+esc(x.other==='Mint'||x.other==='Burn'?x.other:lbl(x.other))+'\u003c/td>\u003ctd>'+hashLink(x.tx.hash)+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"6\" style=\"color:var(--muted2);padding:14px\">No transactions yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>';\n}\nfunction balBox(t,v,tok){return '\u003cdiv class=\"tile\">\u003cdiv class=\"th\">'+t+'\u003c/div>\u003cdiv class=\"tv\">\u003cdiv>\u003cspan class=\"amt\">'+money(v,0)+'\u003c/span>\u003cspan class=\"cur\">'+tok+'\u003c/span>\u003c/div>\u003c/div>\u003c/div>';}\nfunction walletCard(w){\n  return '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>'+w.name+'\u003c/h3>\u003cdiv class=\"addrline\">'+w.addr+'\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+w.addr+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"walbox\">'+balBox('tSGD balance',balance(w.addr,'tSGD'),'tSGD')+balBox('tMYR balance',balance(w.addr,'tMYR'),'tMYR')+'\u003c/div>'+\n   '\u003cdiv class=\"sec-h\">\u003ch3>Transaction History\u003c/h3>\u003c/div>'+histTable(addrHistory(w.addr))+'\u003c/div>';\n}\nfunction shortNum(n){return money(n,0);}\n/* ============ NAV VIEWS ============ */\nconst VIEWS={\n control:function(){return filtersHtml()+tilesHtml()+chartsHtml()+queueHtml(false)+\n   '\u003cdiv class=\"two\" style=\"margin-top:16px\">'+reconHtml()+breaksTableHtml(true)+'\u003c/div>';},\n sysint:function(){\n   const flow1='\u003cspan class=\"n\">Corporate Portal\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Core Banking SG / MY\u003c/span>';\n   const flow2='\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Custody &amp; Tokenization\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">DLT (Etherscan-indexed)\u003c/span>';\n   const flow3='\u003cspan class=\"n on\">SI Orchestrator\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Core Banking (MY) GL\u003c/span>\u003cspan>&nbsp;&middot;&nbsp;\u003c/span>\u003cspan class=\"n\">HLB Malaysia\u003c/span>\u003cspan>&rarr;\u003c/span>\u003cspan class=\"n\">Bank MY (correspondent)\u003c/span>';\n   return '\u003cdiv class=\"sec-h\">\u003ch3>System Integration &ndash; Interconnectivity\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">The SI Orchestrator is the single integration layer between the corporate channel, both sides of core banking (Singapore and Malaysia), the escrow smart contract and the digital asset custody provider. No channel or custody vendor ever talks to core banking directly &mdash; every hop is authenticated, correlated and replay-safe.\u003c/div>'+\n   '\u003cdiv class=\"card wcard\" style=\"padding:16px\">\u003ch4 style=\"margin-bottom:8px\">Request lifecycle\u003c/h4>'+\n   '\u003cdiv class=\"stepflow\">'+flow1+'\u003c/div>\u003cdiv class=\"stepflow\">'+flow2+'\u003c/div>\u003cdiv class=\"stepflow\">'+flow3+'\u003c/div>'+\n   '\u003cdiv class=\"kv\" style=\"margin-top:14px\">'+\n     kv('Perimeter security','Mutual TLS (client + server certificate verification) on every external hop, starting with the corporate portal&#39;s first request')+\n     kv('Application security','OAuth 2.0 client-credentials, short-lived bearer tokens (5 min), scoped per downstream system')+\n     kv('Idempotency','X-Idempotency-Key on every write so a retried call cannot double-post or double-mint')+\n     kv('Correlation','X-Correlation-Id ties the fiat lock, the Liminal mint/burn and the GL posting back to one milestone plan')+\n     kv('Async confirmation','On-chain finality and core banking postings arrive as signed webhooks, not polling')+\n     kv('Core banking connectivity','SI supports both directions: \u003cb>synchronous\u003c/b> request/response (e.g. POST /core/gl/postings, answered immediately) and \u003cb>asynchronous\u003c/b> webhook/event delivery (e.g. EVENT core.fiat.locked, fired whenever core banking is ready). Exactly which pattern a given core banking system uses is decided per integration &mdash; SI does not assume either one.')+\n     kv('Cross-border settlement','tMYR burn is matched against the Bank MY correspondent payout (ISO 20022 pacs.008) before the plan closes')+\n     kv('Reconciliation','Core banking vs DLT vs GL balances are compared after every milestone; a variance raises a case automatically')+\n     kv('Segregation of duties','Maker-checker approval gate in front of every on-chain mint / burn operation')+\n   '\u003c/div>\u003cdiv class=\"note\" style=\"margin-top:12px\">Click \u003cb>&#128274; Inspect integration\u003c/b> on a MINT, BURN, LEDGER UPDATE, CORE BANKING or APP REQUEST event in the Event Stream to see the full simulated mTLS handshake, the OAuth 2.0 token and the request/response headers, payload and footer for that call.\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\" style=\"padding:16px;margin-top:16px\">\u003ch4 style=\"margin-bottom:6px\">Custody &amp; tokenization: the vendor is pluggable behind SI\u003c/h4>'+\n   '\u003cdiv class=\"note\" style=\"margin:0 0 12px\">This rehearsal is scripted against \u003cb>Liminal\u003c/b> (managed MPC custody) for tSGD / tMYR. Because SI owns the mint / burn / escrow contract, an open-source stack can sit behind the same contract without the corporate portal, core banking or the GL ever changing.\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Capability\u003c/th>\u003cth>Liminal (used in this demo)\u003c/th>\u003cth>Open-source alternative\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   '\u003ctr>\u003ctd>Token issuance API\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">POST /liminal/digital-assets/mint\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">POST /fireflyapi/v1/tokens/mint\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Key custody\u003c/td>\u003ctd>MPC 2-of-3, managed HSM\u003c/td>\u003ctd>Hyperledger Fabric MSP identities signed via HSM / PKCS#11\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Ledger / network\u003c/td>\u003ctd>EVM network (Liminal-operated)\u003c/td>\u003ctd>Hyperledger Fabric channel (permissioned) fronted by a Hyperledger FireFly supernode\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Confirmation\u003c/td>\u003ctd>Webhook: digital_asset.mint.confirmed / .burn.confirmed\u003c/td>\u003ctd>FireFly event listener: token_pool / token_transfer confirmed\u003c/td>\u003c/tr>'+\n   '\u003ctr>\u003ctd>Auth to SI\u003c/td>\u003ctd>Mutual TLS + OAuth 2.0 client-credentials\u003c/td>\u003ctd>Mutual TLS + OAuth 2.0 client-credentials (same contract)\u003c/td>\u003c/tr>'+\n   '\u003c/tbody>\u003c/table>\u003c/div>'+\n   '\u003cdiv class=\"note\" style=\"margin-top:12px\">That is the SI role in one sentence: \u003cb>the DLT / custody vendor is a plug-in behind a stable, secured contract\u003c/b> &mdash; core banking, the escrow logic and the corporate portal never need to know which one is live.\u003c/div>\u003c/div>';\n },\n txns:function(){return filtersHtml()+queueHtml(true);},\n wallets:function(){\n   const list=WALLETS.filter(function(w){return w.org===S.org;});\n   const on=S.org==='SG'?'HLB Singapore':'HLB Malaysia Cross Border';\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Wallets\u003c/h3>\u003cspan class=\"pill vio\">'+on+'\u003c/span>\u003c/div>'+\n     '\u003cdiv class=\"note\">Use the organisation chips in the top bar to switch. Each organisation sees only its own wallets, keys and approvals.\u003c/div>'+\n     list.map(walletCard).join('');},\n escrow:function(){\n   const p=curPlan();\n   const eBal=balance(ADDR.escrow,'tSGD')+seedEscrow();\n   const eSt=p?(p.st.escrow==='PENDING'?'Not created':p.st.escrow):'Not created';\n   const sched=p?p.legs.map(function(l){\n     const canRun=p.awaiting&&p.awaiting.key==='M'+l.n&&!p.manualHold;\n     return '\u003ctr>\u003ctd>Milestone '+l.n+'\u003c/td>\u003ctd class=\"mono\">'+money(l.sgd,0)+' tSGD\u003c/td>\u003ctd>'+pill(l.st.disburse)+'\u003c/td>\u003ctd>'+hashLink(l.refs.disburseHash)+'\u003c/td>'+\n       '\u003ctd>'+(canRun?'\u003cbutton class=\"sm pri\" onclick=\"releaseGate()\">Mark complete\u003c/button>':'')+'\u003c/td>\u003c/tr>';}).join(''):\n     '\u003ctr>\u003ctd colspan=\"5\" style=\"color:var(--muted2);padding:14px\">No plan yet.\u003c/td>\u003c/tr>';\n   const swaps=p?p.legs.map(function(l){\n     return '\u003ctr>\u003ctd>Swap '+l.n+'\u003c/td>\u003ctd class=\"mono\">'+money(l.sgd,0)+' tSGD\u003c/td>\u003ctd class=\"mono\">'+money(l.myr,0)+' tMYR\u003c/td>\u003ctd>'+pill(l.st.swap)+'\u003c/td>\u003ctd>'+hashLink(l.refs.swapHash)+'\u003c/td>\u003c/tr>';}).join(''):\n     '\u003ctr>\u003ctd colspan=\"5\" style=\"color:var(--muted2);padding:14px\">No plan yet.\u003c/td>\u003c/tr>';\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Escrow &amp; DvP\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>DvP Escrow Contract\u003c/h3>\u003cdiv class=\"addrline\">'+ADDR.escrow+'\u003c/div>\u003c/div>'+\n    '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+ADDR.escrow+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"walbox\">'+balBox('Escrow balance',eBal,'tSGD')+\n      '\u003cdiv class=\"tile\">\u003cdiv class=\"th\">Status\u003c/div>\u003cdiv class=\"tv\">\u003cdiv>\u003cspan class=\"amt\" style=\"font-size:17px\">'+eSt+'\u003c/span>\u003c/div>\u003c/div>'+\n      '\u003cdiv class=\"ft\">Owner org: HLB Singapore &middot; Beneficiary: HLB Malaysia Cross Border\u003c/div>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"note\">Release trigger: a MILESTONE token. The demo uses a script; production would use a custom smart contract.\u003c/div>'+\n    '\u003cdiv class=\"sec-h\">\u003ch3>Milestone Schedule\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Milestone\u003c/th>\u003cth>Amount\u003c/th>\u003cth>Status\u003c/th>\u003cth>Tx Hash\u003c/th>\u003cth>\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+sched+'\u003c/tbody>\u003c/table>\u003c/div>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>Escrow History\u003c/h3>\u003c/div>'+histTable(addrHistory(ADDR.escrow))+'\u003c/div>'+\n   '\u003cdiv class=\"card wcard\">\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cdiv>\u003ch3>DvP Swap Contract (tMYR x tSGD)\u003c/h3>\u003cdiv class=\"addrline\">'+ADDR.swap+'\u003c/div>\u003c/div>'+\n    '\u003cdiv style=\"margin-left:auto\">\u003cbutton class=\"sm\" onclick=\"openExplorerAddr(\\''+ADDR.swap+'\\')\">Open in Etherscan\u003c/button>\u003c/div>\u003c/div>'+\n    '\u003cdiv class=\"note\" style=\"margin-top:12px\">Each swap burns tSGD and mints tMYR in one transaction at 1 SGD = 3.3 MYR. Production would use an AMM; the demo reuses DvP.\u003c/div>'+\n    '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Swap\u003c/th>\u003cth>tSGD burned\u003c/th>\u003cth>tMYR minted\u003c/th>\u003cth>Status\u003c/th>\u003cth>Tx Hash\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+swaps+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n recon:function(){return '\u003cdiv class=\"sec-h\">\u003ch3>Reconciliation\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">Not part of the demo walkthrough. Turn on \u003cb>Run reconciliation at plan close\u003c/b> in Configuration to run it after the last payout.\u003c/div>'+reconHtml()+\n   '\u003cdiv style=\"margin-top:16px\">'+breaksTableHtml(false)+'\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Per-Plan Control Points\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Plan\u003c/th>\u003cth>SGD locked\u003c/th>\u003cth>tSGD minted\u003c/th>\u003cth>tMYR minted\u003c/th>\u003cth>tMYR burned\u003c/th>\u003cth>GL posted (MYR)\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.plans.map(function(p){\n     const mt=p.st.mint==='CONFIRMED'?p.sgd:0;\n     let tm=0,tb=0,gl=0;p.legs.forEach(function(l){if(l.st.swap==='SETTLED')tm+=l.myr;if(l.st.burn==='CONFIRMED')tb+=l.myr;if(l.st.glPayout==='POSTED'||l.st.glPayout==='PAID')gl+=l.myr;});\n     return '\u003ctr class=\"trow\" onclick=\"openPlanDrawer(\\''+p.id+'\\')\">\u003ctd class=\"txid\">'+p.id+'\u003c/td>\u003ctd class=\"mono\">'+(p.st.fiatLock==='LOCKED'?money(p.sgd,0):'&mdash;')+'\u003c/td>\u003ctd class=\"mono\">'+money(mt,0)+'\u003c/td>'+\n       '\u003ctd class=\"mono\">'+money(tm,0)+'\u003c/td>\u003ctd class=\"mono\">'+money(tb,0)+'\u003c/td>\u003ctd class=\"mono\">'+money(gl,0)+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+statusPill(p.status)+'\">'+p.status.replace(/_/g,' ')+'\u003c/span>\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"7\" style=\"color:var(--muted2);padding:14px\">No plans yet.\u003c/td>\u003c/tr>')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n breaks:function(){return '\u003cdiv class=\"sec-h\">\u003ch3>Breaks &amp; Exceptions\u003c/h3>\u003cdiv class=\"i\" title=\"Detection, assignment, investigation, maker-checker remediation\">i\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"note\">\u003cb>Remediation lifecycle:\u003c/b> Open &rarr; Assigned &rarr; Investigating &rarr; Remediation Proposed (maker) &rarr; Checker Approval &rarr; Resolved. Escalation can be raised at any point. Use the failure toggles in Configuration to raise a case on demand.\u003c/div>'+\n   breaksTableHtml(false)+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Resolved Cases\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Break ID\u003c/th>\u003cth>Source\u003c/th>\u003cth>Original Variance\u003c/th>\u003cth>Remediation\u003c/th>\u003cth>Approved By\u003c/th>\u003cth>Resolved\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.breaks.filter(function(b){return b.status==='RESOLVED';}).map(function(b){\n     return '\u003ctr class=\"trow\" onclick=\"openBreakDrawer(\\''+b.id+'\\')\">\u003ctd class=\"txid\">'+b.id+'\u003c/td>\u003ctd>'+b.source+'\u003c/td>'+\n      '\u003ctd class=\"mono\">'+money(b.varianceBefore||0)+'\u003c/td>\u003ctd style=\"font-size:11.5px\">'+(b.remediation?b.remediation.label:'&mdash;')+'\u003c/td>'+\n      '\u003ctd style=\"font-size:11.5px\">'+(b.remediation&&b.remediation.approvedBy?b.remediation.approvedBy:'&mdash;')+'\u003c/td>\u003ctd class=\"mono\">'+(b.resolvedAt||'&mdash;')+'\u003c/td>\u003c/tr>';\n   }).join('')+seedResolvedRows()||'\u003ctr>\u003ctd colspan=\"6\" style=\"color:var(--muted2);padding:16px\">No resolved cases yet.\u003c/td>\u003c/tr>')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n appr:function(){const ap=pendingAppr();\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Approvals &ndash; Maker / Checker\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">Not part of the demo walkthrough. When \u003cb>Maker-checker approval at plan activation\u003c/b> is on in Configuration, a plan waits here for a second-person (checker) approval before funds are locked.\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Plan\u003c/th>\u003cth>Counterparty\u003c/th>\u003cth>Amount (SGD)\u003c/th>\u003cth>Maker\u003c/th>\u003cth>Checker\u003c/th>\u003cth>Actions\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (ap.map(function(t){return '\u003ctr>\u003ctd class=\"txid\">'+t.id+'\u003c/td>\u003ctd>Guocoland to Bank MY supplier\u003c/td>'+\n     '\u003ctd class=\"mono\">'+money(t.sgd,0)+'\u003c/td>\u003ctd>Ops Analyst \u003cspan class=\"pill ok\">Submitted\u003c/span>\u003c/td>\u003ctd>Treasury Manager \u003cspan class=\"pill wait\">Pending\u003c/span>\u003c/td>'+\n     '\u003ctd>\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"approvePlan(\\''+t.id+'\\')\">Approve\u003c/button>\u003cbutton class=\"sm\" onclick=\"rejectPlan(\\''+t.id+'\\')\">Reject\u003c/button>'+\n     '\u003cbutton class=\"sm\" onclick=\"openPlanDrawer(\\''+t.id+'\\')\">Details\u003c/button>\u003c/div>\u003c/td>\u003c/tr>';}).join('')||\n     '\u003ctr>\u003ctd colspan=\"6\" style=\"color:var(--muted2);padding:16px\">Nothing awaiting approval.\u003c/td>\u003c/tr>')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n hold:function(){\n   const held=S.plans.filter(function(p){return p.status==='ON_HOLD';});\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Hold &amp; Release\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-bottom:16px\">\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Settlement Window\u003c/b>\u003cdiv class=\"d\">Blocks the GL update (step 4.2) and the MYR payout bank-wide\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cspan class=\"pill '+(S.flags.settlementOnHold?'bad':'ok')+'\">'+(S.flags.settlementOnHold?'ON HOLD':'RUNNING')+'\u003c/span>'+\n   '\u003cbutton class=\"'+(S.flags.settlementOnHold?'pri':'')+'\" onclick=\"toggleSettlement()\">'+(S.flags.settlementOnHold?'Release Settlement':'Hold Settlement')+'\u003c/button>\u003c/div>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"sec-h\">\u003ch3>Plans On Hold\u003c/h3>\u003c/div>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Plan\u003c/th>\u003cth>Amount (SGD)\u003c/th>\u003cth>Reason\u003c/th>\u003cth>Actions\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (held.map(function(t){\n     const why=t.manualHold?'Manual hold':(t.holdReason==='SETTLEMENT'?'Settlement on hold':(t.holdReason==='ISSUANCE'?'Issuance paused':'Hold'));\n     return '\u003ctr>\u003ctd class=\"txid\">'+t.id+'\u003c/td>\u003ctd class=\"mono\">'+money(t.sgd,0)+'\u003c/td>\u003ctd>'+why+'\u003c/td>'+\n     '\u003ctd>\u003cdiv class=\"abar\">'+(t.manualHold?'\u003cbutton class=\"sm pri\" onclick=\"releasePlan(\\''+t.id+'\\')\">Release\u003c/button>':'')+\n     '\u003cbutton class=\"sm\" onclick=\"openPlanDrawer(\\''+t.id+'\\')\">Details\u003c/button>\u003c/div>\u003c/td>\u003c/tr>';}).join('')||\n     '\u003ctr>\u003ctd colspan=\"4\" style=\"color:var(--muted2);padding:16px\">No plans on hold.\u003c/td>\u003c/tr>')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n issuance:function(){\n   const p=dpos();\n   const mints=[],burns=[];\n   S.chain.forEach(function(t){t.moves.forEach(function(m){\n     if(m.from===ZERO)mints.push({t:t,m:m});if(m.to===ZERO)burns.push({t:t,m:m});});});\n   const row=function(x,kind){return '\u003ctr class=\"trow\" onclick=\"openExplorerTx(\\''+x.t.hash+'\\')\">\u003ctd class=\"txid\">'+x.t.planId+'\u003c/td>'+\n     '\u003ctd>\u003cspan class=\"pill '+(kind==='MINT'?'ok':'bad')+'\">'+kind+'\u003c/span>\u003c/td>\u003ctd>'+x.m.token+'\u003c/td>\u003ctd class=\"mono\">'+money(x.m.amount,0)+'\u003c/td>'+\n     '\u003ctd>'+hashLink(x.t.hash)+'\u003c/td>\u003ctd class=\"mono\">'+x.t.block+'\u003c/td>\u003ctd>\u003cspan class=\"pill ok\">FINAL\u003c/span>\u003c/td>\u003c/tr>';};\n   const hd='\u003cthead>\u003ctr>\u003cth>Plan\u003c/th>\u003cth>Type\u003c/th>\u003cth>Token\u003c/th>\u003cth>Amount\u003c/th>\u003cth>DLT Tx Hash\u003c/th>\u003cth>Block\u003c/th>\u003cth>Finality\u003c/th>\u003c/tr>\u003c/thead>';\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Issuance Management &ndash; Mint / Burn Ledger\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-bottom:16px\">\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Issuance Status\u003c/b>\u003cdiv class=\"d\">Pausing blocks the tSGD mint (step 1.3) for new and waiting plans\u003c/div>\u003c/div>'+\n   '\u003cdiv style=\"display:flex;align-items:center;gap:10px\">\u003cspan class=\"pill '+(S.flags.issuancePaused?'bad':'ok')+'\">'+(S.flags.issuancePaused?'PAUSED':'OPEN')+'\u003c/span>'+\n   '\u003cbutton class=\"'+(S.flags.issuancePaused?'pri':'')+'\" onclick=\"toggleIssuance()\">'+(S.flags.issuancePaused?'Resume Issuance':'Pause Issuance')+'\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>tSGD Outstanding\u003c/b>\u003cdiv class=\"d\">Minted '+money(p.tsgdMinted,0)+' &middot; burned by swaps '+money(burned('tSGD')+seedBurnedTsgd(),0)+'\u003c/div>\u003c/div>\u003cb class=\"mono\">'+money(p.tsgdOut,0)+' tSGD\u003c/b>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>tMYR Outstanding\u003c/b>\u003cdiv class=\"d\">Minted by swaps '+money(p.tmyrMinted,0)+' &middot; burned '+money(p.tmyrBurned,0)+'\u003c/div>\u003c/div>\u003cb class=\"mono\">'+money(p.tmyrOut,0)+' tMYR\u003c/b>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>tSGD Reserve Coverage\u003c/b>\u003cdiv class=\"d\">SGD locked divided by tSGD minted. Must stay at or above 100%\u003c/div>\u003c/div>'+\n   '\u003cb class=\"mono\" style=\"color:'+(p.coverage===null||p.coverage>=100?'var(--green)':'var(--red)')+'\">'+(p.coverage===null?'&mdash;':p.coverage.toFixed(2)+'%')+'\u003c/b>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"two\">\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"sec-h\">\u003ch3>Mint Activity\u003c/h3>\u003cspan class=\"pill ok\">'+mints.length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>'+hd+'\u003ctbody>'+(mints.map(function(x){return row(x,'MINT');}).join('')||'\u003ctr>\u003ctd colspan=\"7\" style=\"padding:14px;color:var(--muted2)\">No mints yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"sec-h\">\u003ch3>Burn Activity\u003c/h3>\u003cspan class=\"pill bad\">'+burns.length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>'+hd+'\u003ctbody>'+(burns.map(function(x){return row(x,'BURN');}).join('')||'\u003ctr>\u003ctd colspan=\"7\" style=\"padding:14px;color:var(--muted2)\">No burns yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>\u003c/div>';},\n reports:function(){\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Reports\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px\">\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Reconciliation Report\u003c/b>\u003cdiv class=\"d\">Ledger comparison, variances and open breaks (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"downloadRecon()\">Download\u003c/button>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Plan Control Queue\u003c/b>\u003cdiv class=\"d\">All plans and legs with stage-level status (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"exportCsv()\">Download\u003c/button>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Mint / Burn Issuance Register\u003c/b>\u003cdiv class=\"d\">On-chain mints and burns for tSGD and tMYR (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"downloadIssuance()\">Download\u003c/button>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Audit Trail Export\u003c/b>\u003cdiv class=\"d\">Full operator action log (CSV)\u003c/div>\u003c/div>\u003cbutton class=\"pri\" onclick=\"downloadAudit()\">Download\u003c/button>\u003c/div>\u003c/div>';},\n audit:function(){\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Audit Trail\u003c/h3>\u003cdiv class=\"rt\">\u003cbutton class=\"sm\" onclick=\"downloadAudit()\">Export CSV\u003c/button>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px\">\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>Actor\u003c/th>\u003cth>Action\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (auditAll().map(function(a){return '\u003ctr>\u003ctd class=\"mono\" style=\"width:90px\">'+a.time+'\u003c/td>\u003ctd style=\"width:150px;font-weight:600\">'+a.actor+'\u003c/td>\u003ctd>'+a.text+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"3\" style=\"padding:16px;color:var(--muted2)\">No activity yet.\u003c/td>\u003c/tr>')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:14px 16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>API / Message Log\u003c/h3>\u003cspan class=\"pill pend\">'+S.events.length+'\u003c/span>\u003c/div>'+\n   '\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Time\u003c/th>\u003cth>From\u003c/th>\u003cth>To\u003c/th>\u003cth>Operation\u003c/th>\u003cth>Status\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (S.events.slice().reverse().slice(0,40).map(function(e){\n     const sb=e.status==='SUCCESS'?'ok':(e.status==='WEBHOOK'?'vio':(e.status==='FAILED'?'bad':'wait'));\n     return '\u003ctr class=\"trow\" onclick=\"selEvent('+e.id+');setMode(\\'split\\')\">\u003ctd class=\"mono\">'+e.time+'\u003c/td>\u003ctd>'+e.from+'\u003c/td>\u003ctd>'+e.to+'\u003c/td>'+\n      '\u003ctd class=\"mono\" style=\"font-size:10.5px\">'+e.op+'\u003c/td>\u003ctd>\u003cspan class=\"pill '+sb+'\">'+e.status+'\u003c/span>\u003c/td>\u003c/tr>';}).join('')||\n     '\u003ctr>\u003ctd colspan=\"5\" style=\"padding:16px;color:var(--muted2)\">No API activity yet - create a plan from the Corporate Portal.\u003c/td>\u003c/tr>')+\n   '\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';},\n config:function(){\n   const t=function(k,label,desc){return '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>'+label+'\u003c/b>\u003cdiv class=\"d\">'+desc+'\u003c/div>\u003c/div>'+\n     '\u003cbutton class=\"tg'+(S.flags[k]?' on':'')+'\" onclick=\"toggleFlag(\\''+k+'\\')\">\u003c/button>\u003c/div>';};\n   return '\u003cdiv class=\"sec-h\">\u003ch3>Configuration &amp; Demo Controls\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"note\">These switches shape the \u003cb>next plan you create in the Corporate Portal\u003c/b>. Everything below the first row is outside the demo walkthrough and is off by default.\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px\">'+\n   t('autoRun','Auto-run the script','Runs milestone, swap and burn steps without waiting for the presenter. Off by default so each step can be narrated.')+'\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Optional controls\u003c/h3>\u003c/div>'+\n   t('complianceStep','Compliance screening before the fiat lock','Adds a screening call ahead of step 1.1.')+\n   t('makerChecker','Maker-checker approval at plan activation','The plan waits for a checker before funds are locked.')+\n   t('reconOnClose','Run reconciliation when the plan closes','Compares core, DLT and GL positions after the last payout.')+\n   t('forceDltFail','Simulate a DLT mint failure on the next plan','The tSGD mint reverts on-chain and raises a DLT Execution exception for remediation.')+\n   t('forceBreak','Raise a reconciliation break on the next plan','Creates a Core vs DLT variance at reconciliation.')+\n   t('issuancePaused','Pause issuance','Blocks the tSGD mint (step 1.3).')+\n   t('settlementOnHold','Hold settlement','Blocks the GL update and MYR payout (steps 4.2 and 4.3).')+\n   '\u003c/div>'+\n   '\u003cdiv class=\"card\" style=\"padding:16px;margin-top:16px\">\u003cdiv class=\"sec-h\">\u003ch3>Reset\u003c/h3>\u003c/div>'+\n   '\u003cdiv class=\"cfgrow\">\u003cdiv>\u003cb>Reset demo data\u003c/b>\u003cdiv class=\"d\">Clears plans, on-chain history, breaks and the API log, and restores the starting balance.\u003c/div>\u003c/div>'+\n   '\u003cbutton class=\"dgr\" onclick=\"resetAll()\">Reset Demo\u003c/button>\u003c/div>\u003c/div>';}\n};\n/* ============ DRAWERS ============ */\nfunction closeDrawer(){\n  if(S.inspectingEvent!=null){\n    const evId=S.inspectingEvent;S.inspectingEvent=null;\n    const ev=S.events.find(function(x){return x.id===evId;});\n    const p=ev&&ev.actId!=null?planById(ev.actId):null;\n    if(p&&p.pendingInspect){\n      const idx=p.pendingInspect.indexOf(evId);if(idx>-1)p.pendingInspect.splice(idx,1);\n      if(!p.pendingInspect.length&&p.status==='AWAITING_INSPECTION'){\n        p.status='IN_PROGRESS';setTimeout(function(){runStep(p.id);},250);\n      }\n    }\n  }\n  S.drawer=null;S.drawerRef=null;document.getElementById('overlay').classList.add('hidden');renderAll();\n}\nfunction showDrawer(title,html){S.drawer=title;document.getElementById('drTitle').innerHTML=title;\n  document.getElementById('drBody').innerHTML=html;document.getElementById('overlay').classList.remove('hidden');}\nfunction kv(k,v){return '\u003cdiv class=\"k\">'+k+'\u003c/div>\u003cdiv class=\"v\">'+v+'\u003c/div>';}\n/* ============ INTEGRATION TRACE DRAWER (mint / burn / ledger / core banking / app request) ============ */\nfunction openIntegrationDrawer(id){\n  const ev=S.events.find(function(x){return x.id===id;});\n  if(!ev||!ev.auth){toast('No integration security trace captured for this event');return;}\n  S.sel.event=id;S.inspectingEvent=id;renderInspector();\n  const au=ev.auth,mt=au.mtls,oa=au.oauth,ft=au.footer;\n  const stb=({SUCCESS:'ok',WEBHOOK:'vio',FAILED:'bad',WARN:'wait'})[ev.status]||'mute';\n  const h='\u003cdiv class=\"note\" style=\"margin-bottom:14px\">\u003cb>Simulated for this demo.\u003c/b> The certificate, token and signature values below are illustrative. They are not issued by a real PKI or OAuth server and are not connected to a live blockchain network.\u003c/div>'+\n    '\u003cdiv class=\"sec-h\">\u003ch3>Route\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('From',ev.from)+kv('To',ev.to)+kv('Operation',esc(ev.op))+\n      kv('Category','\u003cspan class=\"pill '+MAJOR_COLOR[ev.major]+'\">'+MAJOR_LABEL[ev.major]+'\u003c/span>')+\n      (ev.status==='WEBHOOK'&&ev.to==='SI'?kv('Direction','\u003cspan class=\"pill vio\">&#8595; PULL (SI pulling in an async event)\u003c/span>'):'')+\n      kv('Status','\u003cspan class=\"pill '+stb+'\">'+ev.status+'\u003c/span>')+kv('Time',ev.time+' SGT')+'\u003c/div>'+\n    (ev.major==='COREBANK'?('\u003cdiv class=\"note\" style=\"margin-top:10px\">\u003cb>Core banking connectivity is bidirectional.\u003c/b> SI supports both patterns, since not every core banking system offers the same integration options: \u003cb>synchronous\u003c/b> request/response for calls that need an immediate answer, and \u003cb>asynchronous\u003c/b> webhook/event delivery for calls the core system fires independently. This particular call is '+(ev.status==='WEBHOOK'?'\u003cb>asynchronous\u003c/b> &mdash; an event pushed by core banking, not requested by SI.':'\u003cb>synchronous\u003c/b> &mdash; SI called core banking directly and got this response back immediately.')+'\u003c/div>'):'')+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#128274; Transport security &mdash; mutual TLS\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('TLS version',mt.tlsVersion)+kv('Cipher suite',mt.cipherSuite)+\n      kv('Client certificate',esc(mt.clientCert.subject))+kv('Client cert issuer',esc(mt.clientCert.issuer))+\n      kv('Client cert serial',mt.clientCert.serial)+kv('Client cert SHA-256',mt.clientCert.sha256Thumbprint)+\n      kv('Server certificate',esc(mt.serverCert.subject))+kv('Mutual auth result','\u003cspan class=\"pill ok\">'+mt.mutualAuth+'\u003c/span>')+'\u003c/div>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#128273; Application security &mdash; OAuth 2.0\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('Token endpoint',esc(oa.tokenEndpoint))+kv('Grant type',oa.grantType)+kv('Client ID',oa.clientId)+\n      kv('Scope',esc(oa.scope))+kv('Token type',oa.tokenType)+kv('Expires in',oa.expiresIn+'s')+'\u003c/div>'+\n    '\u003cdiv style=\"margin-top:10px\">\u003cdiv class=\"k\" style=\"margin-bottom:4px\">Decoded access token (JWT)\u003c/div>\u003cpre>'+json({header:oa.decoded.header,payload:oa.decoded.payload})+'\u003c/pre>\u003c/div>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#8593; Request\u003c/h3>\u003c/div>'+\n    '\u003cpre>'+hblock(ev.headers)+'\u003c/pre>'+\n    '\u003cpre style=\"margin-top:8px\">'+(ev.req?(typeof ev.req==='string'?esc(ev.req):json(ev.req)):'No request body (asynchronous inbound event).')+'\u003c/pre>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>&#8595; Response\u003c/h3>\u003c/div>'+\n    '\u003cpre>'+(ev.res?(typeof ev.res==='string'?esc(ev.res):json(ev.res)):'No response captured.')+'\u003c/pre>'+\n    '\u003cdiv class=\"sec-h\" style=\"margin-top:16px\">\u003ch3>Response footer / trailer\u003c/h3>\u003c/div>'+\n    '\u003cdiv class=\"kv\">'+kv('Trace ID',ft.traceId)+kv('Processing time','~'+ft.responseTimeMs+' ms')+\n      kv('Content digest','sha256:'+ft.contentSha256)+kv('Response signature',ft.signature)+'\u003c/div>';\n  showDrawer('&#128274; Integration trace &middot; '+MAJOR_LABEL[ev.major],h);\n}\nfunction stageClass(v){return (v==='PENDING'||v==='NA')?'':(v==='BREAK'||v==='ON_HOLD'||v==='FAILED'||v==='REJECTED'?'bd':(v==='AWAITING'||v==='AWAITING_CHECKER'?'on':'dn'));}\nfunction openPlanDrawer(id){\n  const p=planById(id);if(!p)return;S.drawerRef={type:'plan',id:id};\n  const flow=PLAN_STAGES.map(function(s){return '\u003cspan class=\"n '+stageClass(p.st[s])+'\">'+STAGE_LBL[s]+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n  const evs=S.events.filter(function(e){return (e.headers&&e.headers['X-Correlation-Id']==='COR-'+id);});\n  let h='\u003cdiv class=\"blk\">\u003ch4>Plan\u003c/h4>\u003cdiv class=\"kv\">'+\n    kv('Plan ID',p.id)+kv('Payer','Guocoland (HLB Singapore)')+kv('Supplier','Supplier account, Bank MY')+\n    kv('Amount',sgd(p.sgd))+kv('Destination',myr(p.sgd*FX))+kv('FX Rate','1 SGD = 3.30 MYR')+\n    kv('Submitted',p.submitted)+kv('Owner',p.owner)+kv('Status','\u003cspan class=\"pill '+statusPill(p.status)+'\">'+p.status.replace(/_/g,' ')+'\u003c/span>')+\n    '\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Plan-level Stages\u003c/h4>\u003cdiv class=\"stepflow\">'+flow+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Milestone Legs\u003c/h4>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Leg\u003c/th>\u003cth>SGD\u003c/th>\u003cth>MYR\u003c/th>'+LEG_STAGES.map(function(s){return '\u003cth>'+STAGE_LBL[s]+'\u003c/th>';}).join('')+'\u003c/tr>\u003c/thead>\u003ctbody>'+\n    p.legs.map(function(l){return '\u003ctr>\u003ctd class=\"txid\">'+l.id+'\u003c/td>\u003ctd class=\"mono\">'+money(l.sgd,0)+'\u003c/td>\u003ctd class=\"mono\">'+money(l.myr,0)+'\u003c/td>'+\n      LEG_STAGES.map(function(s){return '\u003ctd>'+pill(l.st[s])+'\u003c/td>';}).join('')+'\u003c/tr>';}).join('')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>';\n  const refs=[];\n  if(p.st.escrow!=='PENDING')refs.push(kv('Escrow Contract',addrLink(ADDR.escrow)));\n  if(p.refs.escrowHash)refs.push(kv('Escrow Creation Tx',hashLink(p.refs.escrowHash)));\n  if(p.refs.mintHash)refs.push(kv('tSGD Mint Tx',hashLink(p.refs.mintHash)));\n  if(p.refs.fundHash)refs.push(kv('Escrow Funding Tx',hashLink(p.refs.fundHash)));\n  p.legs.forEach(function(l){\n    if(l.refs.disburseHash)refs.push(kv('M'+l.n+' Release Tx',hashLink(l.refs.disburseHash)));\n    if(l.refs.swapHash)refs.push(kv('M'+l.n+' Swap Tx',hashLink(l.refs.swapHash)));\n    if(l.refs.burnHash)refs.push(kv('M'+l.n+' tMYR Burn Tx',hashLink(l.refs.burnHash)));\n    if(l.refs.glRef)refs.push(kv('M'+l.n+' GL Ref',l.refs.glRef));\n    if(l.refs.payRef)refs.push(kv('M'+l.n+' Payment Ref',l.refs.payRef));\n  });\n  if(p.refs.lockRef)refs.unshift(kv('Fiat Lock Ref',p.refs.lockRef));\n  if(refs.length)h+='\u003cdiv class=\"blk\">\u003ch4>Ledger &amp; Chain References\u003c/h4>\u003cdiv class=\"kv\">'+refs.join('')+'\u003c/div>\u003c/div>';\n  if(p.breakId){const b=brkById(p.breakId);\n    if(b)h+='\u003cdiv class=\"blk\" style=\"border-color:var(--red-bd);background:var(--red-bg)\">\u003ch4>Linked Exception\u003c/h4>'+\n      '\u003cdiv class=\"kv\">'+kv('Case',b.id)+kv('Source',b.source)+kv('Variance',money(b.variance)+' '+(b.source==='DLT Execution'?'tSGD':'tMYR'))+kv('Status',b.status.replace('_',' '))+'\u003c/div>'+\n      '\u003cdiv class=\"abar\">\u003cbutton class=\"sm pri\" onclick=\"closeDrawer();openBreakDrawer(\\''+b.id+'\\')\">Open Case\u003c/button>\u003c/div>\u003c/div>';}\n  h+='\u003cdiv class=\"blk\">\u003ch4>Plan History\u003c/h4>\u003cdiv class=\"tl\">'+\n    (p.history.length?p.history.map(function(x){return '\u003cdiv class=\"it\">\u003cdiv class=\"tm\">'+x.t+'\u003c/div>'+x.x+'\u003c/div>';}).join(''):'\u003cdiv style=\"color:var(--muted2)\">No history yet.\u003c/div>')+'\u003c/div>\u003c/div>';\n  let acts='';\n  if(p.status==='AWAITING_APPROVAL')acts+='\u003cbutton class=\"pri\" onclick=\"approvePlan(\\''+p.id+'\\')\">Approve (Checker)\u003c/button>\u003cbutton onclick=\"rejectPlan(\\''+p.id+'\\')\">Reject\u003c/button>';\n  if(p.awaiting&&!p.manualHold)acts+='\u003cbutton class=\"pri\" onclick=\"closeDrawer();releaseGate()\">'+GATE_LBL[p.awaiting.key]+'\u003c/button>';\n  if(p.manualHold)acts+='\u003cbutton class=\"pri\" onclick=\"releasePlan(\\''+p.id+'\\')\">Release Hold\u003c/button>';\n  else if(p.status!=='COMPLETED'&&p.status!=='REJECTED'&&p.status!=='EXCEPTION')acts+='\u003cbutton onclick=\"holdPlan(\\''+p.id+'\\')\">Place Hold\u003c/button>';\n  if(evs.length)acts+='\u003cbutton onclick=\"closeDrawer();setMode(\\'split\\');selEvent('+evs[evs.length-1].id+')\">View API Calls ('+evs.length+')\u003c/button>';\n  if(acts)h+='\u003cdiv class=\"blk\">\u003ch4>Actions\u003c/h4>\u003cdiv class=\"abar\">'+acts+'\u003c/div>\u003c/div>';\n  showDrawer(p.id+' &middot; Milestone Plan',h);\n}\nfunction openBreakDrawer(id){\n  const b=brkById(id);if(!b)return;S.drawerRef={type:'break',id:id};\n  const L=dledgers(), unit=b.source==='DLT Execution'?'tSGD':'tMYR';\n  const steps=['OPEN','ASSIGNED','INVESTIGATING','PENDING_APPROVAL','RESOLVED'];\n  const cur=steps.indexOf(b.status==='ESCALATED'?'INVESTIGATING':b.status);\n  const flow=steps.map(function(s,i){\n    const c=i\u003ccur?'dn':(i===cur?'on':'');\n    return '\u003cspan class=\"n '+c+'\">'+s.replace('_',' ')+'\u003c/span>';}).join('\u003cspan>&rarr;\u003c/span>');\n  const sc={OPEN:'bad',ASSIGNED:'wait',INVESTIGATING:'pend',PENDING_APPROVAL:'wait',ESCALATED:'bad',RESOLVED:'ok'}[b.status]||'mute';\n  let h='\u003cdiv class=\"blk\">\u003ch4>Exception Case\u003c/h4>\u003cdiv class=\"kv\">'+\n   kv('Case ID',b.id)+kv('Source',b.source)+kv('Variance',(b.variance?money(b.variance):money(b.varianceBefore||0)+' (cleared)')+' '+unit)+\n   kv('Reason',b.reason)+kv('Status','\u003cspan class=\"pill '+sc+'\">'+b.status.replace('_',' ')+'\u003c/span>')+\n   kv('Assigned To',b.assignedTo)+(b.planId?kv('Plan',b.planId):'')+\n   kv('Recovery Method',b.source==='DLT Execution'\n     ?'\u003cspan class=\"pill pend\">RESUME\u003c/span> pipeline resumes from the failed step'\n     :'\u003cspan class=\"pill vio\">CORRECTION\u003c/span> posting only, no replay')+\n   kv('Customer Re-initiation','\u003cspan class=\"pill ok\">Not required\u003c/span>')+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Remediation Lifecycle\u003c/h4>\u003cdiv class=\"stepflow\">'+flow+'\u003c/div>'+\n   (b.status==='ESCALATED'?'\u003cdiv class=\"warnnote\">Escalated to Treasury Manager - severity raised, SLA clock running.\u003c/div>':'')+'\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Ledger Evidence\u003c/h4>\u003cdiv class=\"kv\">'+\n   L.rows.map(function(r){return kv(r.src+' &middot; '+r.unit,money(r.bal));}).join('')+kv('Net Book Variance',money(L.net)+' tMYR')+'\u003c/div>\u003c/div>';\n  if(b.remediation){\n    h+='\u003cdiv class=\"blk\">\u003ch4>Proposed Remediation (Maker-Checker)\u003c/h4>\u003cdiv class=\"kv\">'+\n     kv('Action',b.remediation.label)+kv('Target API','\u003cspan class=\"mono\" style=\"font-size:11px\">'+b.remediation.api+'\u003c/span>')+\n     kv('Proposed By',b.remediation.proposedBy+' at '+b.remediation.proposedAt)+\n     kv('Approved By',b.remediation.approvedBy?(b.remediation.approvedBy+' at '+b.remediation.approvedAt):'\u003cspan class=\"pill wait\">Pending checker\u003c/span>')+'\u003c/div>\u003c/div>';\n  }\n  if(b.recovery){\n    const R=b.recovery;\n    const done=R.steps.filter(function(x){return x.s==='DONE';}).length;\n    h+='\u003cdiv class=\"blk\" style=\"border-color:'+(R.running?'var(--blue-bd)':'var(--green-bd)')+';background:'+(R.running?'#f7faff':'#f6fdf8')+'\">'+\n     '\u003ch4>'+(R.running?'Post-Remediation Processing - running':'Post-Remediation Processing - complete')+\n     ' \u003cspan class=\"pill '+(R.running?'pend':'ok')+'\" style=\"float:right\">'+R.mode+' MODE\u003c/span>\u003c/h4>'+\n     '\u003cdiv style=\"font-size:11.5px;color:var(--muted);margin-bottom:10px\">'+R.note+'\u003c/div>'+\n     R.steps.map(function(x,i){\n       const cu=R.running&&i===R.idx;\n       const mark=x.s==='DONE'?'\u003cspan class=\"pill ok\">&#10003;\u003c/span>':(cu?'\u003cspan class=\"pill pend\">running\u003c/span>':'\u003cspan class=\"pill mute\">queued\u003c/span>');\n       return '\u003cdiv style=\"display:flex;align-items:center;gap:9px;padding:5px 0;font-size:11.8px'+(x.s==='DONE'?'':';color:var(--muted)')+'\">'+\n         '\u003cspan style=\"width:64px;flex-shrink:0\">'+mark+'\u003c/span>\u003cspan>'+(i+1)+'. '+x.l+'\u003c/span>\u003c/div>';}).join('')+\n     '\u003cdiv style=\"margin-top:9px;font-size:11px;color:var(--muted)\">'+done+' of '+R.steps.length+' steps complete'+\n     (R.running?' - SI is driving this automatically':'')+'\u003c/div>\u003c/div>';\n  }\n  h+='\u003cdiv class=\"blk\">\u003ch4>Case History\u003c/h4>\u003cdiv class=\"tl\">'+\n   b.history.map(function(x){return '\u003cdiv class=\"it\">\u003cdiv class=\"tm\">'+x.t+'\u003c/div>'+x.x+'\u003c/div>';}).join('')+'\u003c/div>\u003c/div>';\n  let a='';\n  if(b.status!=='RESOLVED'){\n    a+='\u003cdiv style=\"display:flex;gap:8px;align-items:center;margin-bottom:10px\">\u003cselect id=\"asgSel\">'+\n      OWNERS.map(function(o){return '\u003coption'+(b.assignedTo===o?' selected':'')+'>'+o+'\u003c/option>';}).join('')+'\u003c/select>'+\n      '\u003cbutton class=\"sm\" onclick=\"assignBreak(\\''+b.id+'\\',document.getElementById(\\'asgSel\\').value)\">Assign\u003c/button>\u003c/div>';\n    if(b.status==='OPEN'||b.status==='ASSIGNED')a+='\u003cbutton class=\"pri\" onclick=\"investigateBreak(\\''+b.id+'\\')\">Start Investigation\u003c/button>';\n    if(b.status==='INVESTIGATING'||b.status==='ESCALATED'){\n      a+='\u003cdiv style=\"display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap\">\u003cselect id=\"remSel\">'+\n        (REMEDIATIONS[b.source]||[]).map(function(r){return '\u003coption value=\"'+r.id+'\">'+r.label+'\u003c/option>';}).join('')+'\u003c/select>'+\n        '\u003cbutton class=\"pri\" onclick=\"proposeRemediation(\\''+b.id+'\\',document.getElementById(\\'remSel\\').value)\">Propose Remediation (Maker)\u003c/button>\u003c/div>';\n    }\n    if(b.status==='PENDING_APPROVAL'){\n      a+='\u003cdiv class=\"warnnote\">Segregation of duties: the proposing maker cannot approve. A Treasury Manager (checker) must authorise execution.\u003cbr>\u003cbr>'+\n        'On approval SI runs the recovery automatically - \u003cb>'+(b.source==='DLT Execution'\n          ?'the original plan resumes from the failed step'\n          :'a correction is posted and reconciliation re-runs')+'\u003c/b>. The customer does not need to submit anything again.\u003c/div>'+\n        '\u003cbutton class=\"pri\" onclick=\"approveRemediation(\\''+b.id+'\\')\">Approve &amp; Execute (Checker)\u003c/button>'+\n        '\u003cbutton onclick=\"rejectRemediation(\\''+b.id+'\\')\">Reject\u003c/button>';\n    }\n    if(b.status!=='ESCALATED')a+='\u003cbutton onclick=\"escalateBreak(\\''+b.id+'\\')\">Escalate\u003c/button>';\n  } else {\n    a+='\u003cdiv class=\"note\">Case resolved at '+(b.resolvedAt||'')+'. Variance cleared to 0.00 and the linked plan has been reconciled.\u003c/div>';\n  }\n  h+='\u003cdiv class=\"blk\">\u003ch4>Case Actions\u003c/h4>\u003cdiv class=\"abar\">'+a+'\u003c/div>\u003c/div>';\n  if(b.planId)h+='\u003cdiv class=\"abar\">\u003cbutton onclick=\"closeDrawer();openPlanDrawer(\\''+b.planId+'\\')\">Open linked plan '+b.planId+'\u003c/button>\u003c/div>';\n  showDrawer(b.id+' &middot; '+b.source,h);\n}\n/* ---- simulated block explorer (Etherscan-style) ---- */\nfunction openExplorerTx(hash){\n  const t=S.chain.find(function(x){return x.hash===hash;});if(!t)return;\n  S.drawerRef={type:'xtx',id:hash};\n  const logs=t.moves.map(function(m){\n    const what=m.from===ZERO?'Mint':(m.to===ZERO?'Burn':'Transfer');\n    return '\u003cdiv class=\"lg\">\u003cb>'+what+'\u003c/b> &middot; '+money(m.amount,0)+' '+m.token+\n      '\u003cbr>\u003cspan style=\"color:var(--muted)\">From\u003c/span> '+esc(lbl(m.from))+'\u003cbr>\u003cspan style=\"color:var(--muted)\">To\u003c/span> '+esc(lbl(m.to))+'\u003c/div>';}).join('');\n  const h='\u003cdiv class=\"xpl\">\u003cdiv class=\"note\">Simulated view. It imitates what Etherscan shows for this transaction. Hashes in this demo are generated, so they do not exist on a public chain.\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Transaction Details\u003c/h4>\u003cdiv class=\"kv\">'+\n    kv('Transaction Hash','\u003cspan class=\"mono\" style=\"font-size:11px\">'+t.hash+'\u003c/span>')+\n    kv('Status','\u003cspan class=\"pill ok\">Success\u003c/span>')+kv('Block',t.block+' &middot; Finalized')+kv('Timestamp',t.time+' SGT')+\n    kv('From',esc(lbl(t.from))+'\u003cbr>\u003cspan class=\"mono\" style=\"font-size:10.5px;color:var(--muted)\">'+t.from+'\u003c/span>')+\n    kv(t.kind==='ESCROW_CREATE'?'Contract Created':'Interacted With (To)',esc(lbl(t.to))+'\u003cbr>\u003cspan class=\"mono\" style=\"font-size:10.5px;color:var(--muted)\">'+t.to+'\u003c/span>')+\n    kv('Method',t.method)+kv('Plan',t.planId)+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Token Transfers &amp; Logs\u003c/h4>'+(logs||'\u003cdiv style=\"color:var(--muted2);font-size:12px\">Contract creation. No token movements.\u003c/div>')+'\u003c/div>\u003c/div>';\n  showDrawer('Etherscan &middot; Transaction',h);\n}\nfunction openExplorerAddr(a){\n  S.drawerRef={type:'xaddr',id:a};\n  const isTok=(a===ADDR.tsgd||a===ADDR.tmyr);\n  const txs=S.chain.filter(function(t){return t.from===a||t.to===a||t.moves.some(function(m){return m.from===a||m.to===a;});}).reverse();\n  let info='';\n  if(isTok){const tk=a===ADDR.tsgd?'tSGD':'tMYR';info=kv('Total Supply',money(supply(tk)+seedSupply(tk),0)+' '+tk)+kv('Standard','ERC-1400 security token');}\n  else info=kv('tSGD Balance',money(balance(a,'tSGD')+(a===ADDR.escrow?seedEscrow():0),0))+kv('tMYR Balance',money(balance(a,'tMYR'),0));\n  const h='\u003cdiv class=\"xpl\">\u003cdiv class=\"note\">Simulated view. It imitates an Etherscan address page for demo data.\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Overview\u003c/h4>\u003cdiv class=\"kv\">'+kv('Address','\u003cspan class=\"mono\" style=\"font-size:11px\">'+a+'\u003c/span>')+kv('Label',esc(lbl(a)))+info+kv('Transactions',String(txs.length))+'\u003c/div>\u003c/div>'+\n   '\u003cdiv class=\"blk\">\u003ch4>Transactions\u003c/h4>\u003cdiv class=\"tblwrap\">\u003ctable>\u003cthead>\u003ctr>\u003cth>Tx Hash\u003c/th>\u003cth>Method\u003c/th>\u003cth>Block\u003c/th>\u003cth>Time\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>'+\n   (txs.map(function(t){return '\u003ctr>\u003ctd>'+hashLink(t.hash)+'\u003c/td>\u003ctd>'+t.method+'\u003c/td>\u003ctd class=\"mono\">'+t.block+'\u003c/td>\u003ctd class=\"mono\" style=\"font-size:11px\">'+t.time.slice(12)+'\u003c/td>\u003c/tr>';}).join('')||\n    '\u003ctr>\u003ctd colspan=\"4\" style=\"color:var(--muted2);padding:12px\">No transactions yet.\u003c/td>\u003c/tr>')+'\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>\u003c/div>';\n  showDrawer('Etherscan &middot; Address',h);\n}\n/* ============ TREASURY ACTIONS ============ */\nfunction approvePlan(id){\n  const p=planById(id);if(!p)return;\n  p.apprOk=true;p.approval='APPROVED';\n  E(p,'TREASURY MANAGER (CHECKER)','SI','POST /approvals/'+id+'/approve','SUCCESS','json',\n    {planId:id,decision:'APPROVE',approvedBy:'Treasury Manager',role:'CHECKER'},{planId:id,status:'APPROVED',releasedToStage:'FIAT_LOCK'});\n  addAudit('Treasury Manager','approved '+id);hist(p,'Approved by Treasury Manager (checker)');\n  toast(id+' approved');p.status='IN_PROGRESS';setCap(p,'Approved by the bank - continuing...');\n  closeDrawer();renderAll();setTimeout(function(){runStep(id);},400);\n}\nfunction rejectPlan(id){\n  const p=planById(id);if(!p)return;\n  p.approval='REJECTED';p.status='REJECTED';\n  E(p,'TREASURY MANAGER (CHECKER)','SI','POST /approvals/'+id+'/reject','FAILED','json',\n    {planId:id,decision:'REJECT',rejectedBy:'Treasury Manager',reason:'RISK_REVIEW_REQUIRED'},{planId:id,status:'REJECTED',fiatLock:'NOT_PLACED'});\n  addAudit('Treasury Manager','rejected '+id);hist(p,'Rejected by checker - no funds were locked');\n  setCap(p,'Plan declined');toast(id+' rejected');closeDrawer();renderAll();\n}\nfunction holdPlan(id){\n  const p=planById(id);if(!p)return;\n  p.manualHold=true;p.status='ON_HOLD';\n  E(p,'TREASURY OPS','SI','POST /plans/'+id+'/hold','WARN','json',{planId:id,action:'HOLD',reason:'MANUAL_TREASURY_HOLD'},{planId:id,status:'ON_HOLD'});\n  addAudit('Treasury Ops','placed hold on '+id);hist(p,'Manual hold placed by Treasury Ops');\n  toast(id+' placed on hold');closeDrawer();renderAll();\n}\nfunction releasePlan(id){\n  const p=planById(id);if(!p)return;\n  p.manualHold=false;\n  E(p,'TREASURY OPS','SI','POST /plans/'+id+'/release','SUCCESS','json',{planId:id,action:'RELEASE',releasedBy:'Treasury Ops'},{planId:id,status:'RELEASED'});\n  addAudit('Treasury Ops','released '+id);hist(p,'Hold released by Treasury Ops');\n  toast(id+' released');closeDrawer();\n  if(p.awaiting){p.status=p.awaiting.key.charAt(0)==='M'?'AWAITING_MILESTONE':'AWAITING_SCRIPT';renderAll();}\n  else{p.status='IN_PROGRESS';renderAll();setTimeout(function(){runStep(id);},300);}\n}\nfunction toggleIssuance(){S.flags.issuancePaused=!S.flags.issuancePaused;\n  E({id:'ISSUANCE'},'TREASURY OPS','SI','POST /issuance/'+(S.flags.issuancePaused?'pause':'resume'),'WARN','json',\n    {action:S.flags.issuancePaused?'PAUSE_ISSUANCE':'RESUME_ISSUANCE',scope:'ALL_CHANNELS'},{issuanceStatus:S.flags.issuancePaused?'PAUSED':'OPEN'});\n  addAudit('Treasury Ops',(S.flags.issuancePaused?'paused':'resumed')+' token issuance');\n  toast('Issuance '+(S.flags.issuancePaused?'paused':'resumed'));\n  if(!S.flags.issuancePaused){\n    S.plans.filter(function(p){return p.status==='ON_HOLD'&&p.holdReason==='ISSUANCE'&&!p.manualHold;}).forEach(function(p){\n      p.status='IN_PROGRESS';p.holdReason=null;runStep(p.id);});\n  }\n  renderAll();}\nfunction toggleSettlement(){S.flags.settlementOnHold=!S.flags.settlementOnHold;\n  E({id:'SETTLEMENT'},'TREASURY OPS','SI','POST /settlement/'+(S.flags.settlementOnHold?'hold':'release'),'WARN','json',\n    {action:S.flags.settlementOnHold?'HOLD_SETTLEMENT':'RELEASE_SETTLEMENT',scope:'BANK_WIDE'},{settlementStatus:S.flags.settlementOnHold?'ON_HOLD':'RUNNING'});\n  addAudit('Treasury Ops',(S.flags.settlementOnHold?'held':'released')+' settlement window');\n  toast('Settlement '+(S.flags.settlementOnHold?'on hold':'running'));\n  if(!S.flags.settlementOnHold){\n    S.plans.filter(function(p){return p.status==='ON_HOLD'&&p.holdReason==='SETTLEMENT'&&!p.manualHold;}).forEach(function(p){\n      p.status='IN_PROGRESS';p.holdReason=null;runStep(p.id);});\n  }\n  renderAll();}\nconst FLAG_LBL={autoRun:'Auto-run',complianceStep:'Compliance screening',makerChecker:'Maker-checker approval',reconOnClose:'Reconciliation at close',\n  forceDltFail:'DLT mint failure on next plan',forceBreak:'Reconciliation break on next plan'};\nfunction toggleFlag(k){\n  if(k==='issuancePaused'){toggleIssuance();return;}\n  if(k==='settlementOnHold'){toggleSettlement();return;}\n  S.flags[k]=!S.flags[k];\n  toast((FLAG_LBL[k]||k)+': '+(S.flags[k]?'on':'off'));\n  if(k==='autoRun'&&S.flags.autoRun){const p=activePlan();if(p&&p.awaiting&&!p.manualHold){renderAll();releaseGate();return;}}\n  renderAll();\n}\n/* ============ EXPORTS ============ */\nfunction dl(name,rows){\n  const csv=rows.map(function(r){return r.map(function(c){return '\"'+String(c).replace(/\"/g,'\"\"')+'\"';}).join(',');}).join('\\n');\n  const b=new Blob([csv],{type:'text/csv'});const u=URL.createObjectURL(b);\n  const a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();\n  document.body.removeChild(a);URL.revokeObjectURL(u);toast('Downloaded '+name);\n}\nfunction exportCsv(){\n  const rows=[['Plan / L